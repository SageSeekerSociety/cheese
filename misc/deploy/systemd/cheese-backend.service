[Unit]
Description=Cheese backend (FastAPI / uvicorn :8080)
Requires=cheese-infra.service
After=cheese-infra.service network-online.target

[Service]
Type=simple
User=nictheboy
Group=nictheboy
WorkingDirectory=/home/nictheboy/repo/SageSeekerSociety/cheese-backend-py/backend
Environment=HOME=/home/nictheboy
Environment=PATH=/home/nictheboy/.local/bin:/usr/local/bin:/usr/bin:/bin
# Wait for Postgres to accept connections before starting the app.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 60); do /usr/bin/docker exec cheese_py_postgres pg_isready -U postgres >/dev/null 2>&1 && exit 0; sleep 1; done; exit 1'
ExecStart=/home/nictheboy/.local/bin/uv run uvicorn app.main:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
