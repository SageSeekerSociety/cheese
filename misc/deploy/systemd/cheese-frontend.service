[Unit]
Description=Cheese frontend (vite dev server :3000, proxies /api and /connector to backend)
After=cheese-backend.service network-online.target
Wants=cheese-backend.service

[Service]
Type=simple
User=nictheboy
Group=nictheboy
WorkingDirectory=/home/nictheboy/repo/SageSeekerSociety/cheese-backend-py/frontend
Environment=HOME=/home/nictheboy
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/home/nictheboy/repo/SageSeekerSociety/cheese-backend-py/frontend/node_modules/.bin/vite --host 0.0.0.0 --port 3000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
