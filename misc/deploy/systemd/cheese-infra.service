[Unit]
Description=Cheese infra (Postgres / Valkey / Elasticsearch via docker compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=nictheboy
Group=nictheboy
WorkingDirectory=/home/nictheboy/repo/SageSeekerSociety/cheese-backend-py
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
