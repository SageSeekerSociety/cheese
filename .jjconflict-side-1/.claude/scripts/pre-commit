#!/usr/bin/env bash
# pre-commit — run the backend gate before every commit.
# Blocks commit if any check fails. Bypass with: git commit --no-verify
#
# Install with `task hooks` — a fresh clone has no hook and this file does
# nothing on its own.
#
# WHAT THIS COVERS vs CI, and the deliberate gaps. Keep this list current when
# either side changes; a local gate that silently diverges from CI is worse than
# no local gate, because it buys confidence it cannot back.
#
#   local (via check.sh)          CI job
#   ruff check + format           test.yml / lint
#   pyright                       test.yml / lint
#   alembic single head           test.yml / migration-heads
#   repo rules                    repo-guards.yml / guards
#   actions pinned to a SHA       repo-guards.yml / guards
#   migration fork vs main        repo-guards.yml / guards
#   pytest (whole suite, -n 4)    test.yml / test
#
# Deliberately NOT run locally:
#   - e2e (e2e.yml). Needs Playwright browsers and a running stack; minutes, not
#     seconds. CI is the right place.
#   - the frontend gate (frontend.yml: eslint + the vue-tsc ratchet). NOT a
#     considered trade-off — a real gap: check.sh cds into backend/ and runs
#     nothing else, so a frontend-only commit pays ~60s of pytest and gets zero
#     frontend checks. Until check.sh grows per-path dispatch, run
#     `task fe:check` yourself when you touch frontend/.
#   - deploy script tests (deploy-scripts-test.yml). Bash against fakes, seconds
#     in CI, and deploy/ changes are rare enough not to tax every commit.
set -euo pipefail

echo "==> Pre-commit: ruff + pyright + pytest"
REPO_ROOT="$(git rev-parse --show-toplevel)"
if bash "$REPO_ROOT/.claude/scripts/check.sh"; then
    echo "==> Pre-commit: PASS"
    exit 0
else
    echo ""
    echo "=============================================="
    echo "  Pre-commit FAILED — commit blocked."
    echo "  Fix errors above, or bypass with:"
    echo "    git commit --no-verify"
    echo "=============================================="
    exit 1
fi
