# Cheese Backend (Python) - Sample Environment Configuration
# Copy this file to .env and fill in your values

# ===== Application =====
APP_NAME=Cheese Backend (Python)
ENVIRONMENT=development

# Frontend URL (for building links like password reset)
FRONTEND_URL=http://localhost:5173

# Base URL for avatar images (this backend or CDN)
AVATAR_BASE_URL=http://localhost:8081

# ===== Database =====
# PostgreSQL connection string
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cheese

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== Authentication =====
# JWT secret key (change in production!)
JWT_SECRET=change-this-in-production-use-a-long-random-string

# Token expiration (in seconds)
ACCESS_TOKEN_EXPIRES_SECONDS=900
REFRESH_TOKEN_EXPIRES_SECONDS=2592000

# ===== Encryption =====
# Base64 Fernet key for user real-name encryption
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
REALNAME_ENCRYPTION_KEY=

# ===== Email / SMTP =====
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=user@example.com
EMAIL_SMTP_PASSWORD=your-smtp-password
EMAIL_FROM_ADDRESS=noreply@example.com

# ===== Storage =====
# Storage type: "local" or "s3"
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_LOCAL_URL=/uploads

# S3 configuration (if STORAGE_TYPE=s3)
S3_BUCKET=cheese
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_PUBLIC_URL=

# ===== OpenAI / LLM =====
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_REASONING_MODEL=o1-mini
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=4096
AI_DAILY_QUOTA=10.0

# ===== Search (Meilisearch) =====
# When set, Meilisearch is used as the primary search engine with PG FTS fallback.
# Leave empty to use PostgreSQL full-text search only.
MEILISEARCH_URL=
MEILISEARCH_API_KEY=

# ===== Task / Application Rules =====
APPLICATION_RANK_CHECK_ENFORCED=false
APPLICATION_RANK_JUMP=1
APPLICATION_ENFORCE_TASK_PARTICIPANT_LIMIT_CHECK=false

# ===== Notification =====
NOTIFICATION_DEDUP_TTL_SECONDS=600
NOTIFICATION_EMAIL_QUEUE_KEY=cheese:notifications:email
NOTIFICATION_EMAIL_BATCH_SIZE=100
NOTIFICATION_EMAIL_MAX_RETRIES=3

# ===== CORS =====
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ===== WebAuthn (Passkey) =====
WEBAUTHN_RP_NAME=Cheese Community
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173

# ===== OAuth (social / SSO login) =====
# Comma-separated list of enabled providers: github, google, ruc (微人大)
OAUTH_ENABLED_PROVIDERS=
# GitHub
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_REDIRECT_URL=
# Google
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URL=
# 微人大 (Renmin University of China) — endpoints are hardcoded in RUCProvider.
# The redirect URL must EXACTLY match the callback registered on the 微人大 platform.
OAUTH_RUC_CLIENT_ID=
OAUTH_RUC_CLIENT_SECRET=
OAUTH_RUC_REDIRECT_URL=
# Frontend landing pages the OAuth callback 302-redirects to (combined with FRONTEND_URL).
# Defaults below already match the frontend routes; override only if they change.
FRONTEND_OAUTH_SUCCESS_PATH=/account/oauth/success
FRONTEND_OAUTH_ERROR_PATH=/account/oauth/error
