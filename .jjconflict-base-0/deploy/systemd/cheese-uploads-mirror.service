[Unit]
Description=Cheese uploads incremental mirror to Cloudflare R2 (off-site backup)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=nictheboy
# Additive mirror of the local uploads/ dir (STORAGE_TYPE=local user files, e.g.
# PDF 赛题) to R2. Only new/changed files upload; nothing is deleted remotely.
Environment=UPLOADS_PREFIX=prod-uploads
ExecStart=/home/nictheboy/cheese-backend-py/backend/.venv/bin/python /home/nictheboy/ops/r2-sync-uploads.py /home/nictheboy/cheese-backend-py/backend/uploads
Nice=10
