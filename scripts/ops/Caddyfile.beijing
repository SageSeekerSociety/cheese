# Beijing edge for okcheese (deployed at /etc/caddy/Caddyfile on 47.95.114.66).
# Mainland counterpart of the HK box's okcheese site: TLS ends here and plain
# HTTP goes into two reverse SSH tunnels from the dev box, each landing on the
# dev front door's 127.0.0.1:18080.
#
# okcheese.cn is ICP-filed (京ICP备2026068086号), so this box may serve it on
# 80/443. Only okcheese.cn names belong here: okcheese.com resolves to Hong
# Kong, and a .com site block would only make Caddy try for a certificate it
# cannot get. Plain http is Caddy's automatic redirect to https.

www.okcheese.cn {
	redir https://okcheese.cn{uri} permanent
}

okcheese.cn {
	# Reads only, as on HK (scripts/ops/Caddyfile): a request already sent down
	# a stalled tunnel hangs until ssh notices the line is dead. A read with no
	# response headers after 10 s counts as failed and is retried on the other
	# tunnel; lb_try_duration must outlast the 10 s. Freezing tunnel A on
	# 2026-10-16 left 1 of 25 requests hanging without this. Writes keep the
	# block below with no header timeout: Caddy does not retry them.
	@read method GET HEAD
	reverse_proxy @read 127.0.0.1:18463 127.0.0.1:18464 {
		lb_policy least_conn
		lb_try_duration 15s
		lb_try_interval 250ms
		fail_duration 10s
		max_fails 1
		health_uri /_internal/edge-health
		health_status 404
		health_interval 3s
		health_timeout 2s
		flush_interval -1
		stream_close_delay 10m
		transport http {
			response_header_timeout 10s
			keepalive 60s
			keepalive_idle_conns 64
			keepalive_idle_conns_per_host 32
		}
	}

	reverse_proxy 127.0.0.1:18463 127.0.0.1:18464 {
		# Same reasoning as HK: neither line is reliably faster, so requests
		# in flight decide (a slow line collects them).
		lb_policy least_conn
		lb_try_duration 5s
		lb_try_interval 250ms
		fail_duration 10s
		max_fails 1
		# The dev front door answers /_internal/ with 404 itself.
		health_uri /_internal/edge-health
		health_status 404
		health_interval 3s
		health_timeout 2s
		flush_interval -1
		stream_close_delay 10m
		transport http {
			keepalive 60s
			keepalive_idle_conns 64
			keepalive_idle_conns_per_host 32
		}
	}
}
