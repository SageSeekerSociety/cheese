{
	# Caddy never binds a port just to synthesise a redirect. It did that once on
	# :443 and took the box down with it (2026-07-10), and every redirect this
	# file wants is written out below, on a port Caddy already owns.
	auto_https disable_redirects

	# The public :443 belongs to the layer4 router below, not to the HTTP sites.
	# HTTPS sites here listen on loopback :8443 and are reached through it.
	https_port 8443

	# Connections arrive at the HTTPS sites through the layer4 router, which
	# prepends a PROXY header; without this every visitor would look like
	# 127.0.0.1.
	servers 127.0.0.1:8443 {
		# No HTTP/3: these sites listen on loopback :8443 behind the layer4
		# router, which carries TCP only, so an advertised h3=":8443" pointed
		# browsers at a UDP port nobody can reach.
		protocols h1 h2
		listener_wrappers {
			proxy_protocol {
				allow 127.0.0.1/32
			}
			tls
		}
	}

	layer4 {
		172.26.10.144:443 {
			# The dev box's reverse SSH tunnels to this box arrive wrapped in TLS
			# under this name; socat on 127.0.0.1:2222 unwraps it for sshd.
			# Bare SSH on :22 from the dev box's egress stalls for minutes at a
			# time (docs/infrastructure.md, "Public edge").
			@relay tls sni relay.okcheese.com
			route @relay {
				proxy {
					upstream 127.0.0.1:2222
				}
			}
			# Everything else (okcheese.com and its aliases, ruc-etrip.cn and its
			# TLS-ALPN challenge) is handed unchanged to this Caddy's own HTTPS sites.
			route {
				proxy {
					proxy_protocol v1
					upstream 127.0.0.1:8443
				}
			}
		}
	}
}

# The etrip box's edge (deployed at /etc/caddy/Caddyfile).
#
#   :443 (layer4)          -> by SNI: relay.okcheese.com goes to socat on
#                             127.0.0.1:2222, the TLS-wrapped way the dev box's
#                             reverse SSH tunnels log in; every other name goes
#                             to this Caddy's HTTPS sites on 127.0.0.1:8443.
#   okcheese.com, www, hk  -> TLS ends here; plain HTTP through the dev box's
#   docs.okcheese.com         tunnels (127.0.0.1:18453 and :18454) to its front
#                             door on 127.0.0.1:18080. docs has a site block of
#                             its own; the frontend container answers that Host
#                             with the docs server.
#   *.cheeseusercontent.com -> the preview content domain. TLS ends here with a
#                             wildcard certificate (DNS-01); plain HTTP through
#                             the same tunnels (127.0.0.1:18455 and :18456) to
#                             the dev box's content entry on 127.0.0.1:8081.
#   ruc-etrip.cn           -> 127.0.0.1:80, the etrip deployment's frontend
#                             container (cheese_prod_frontend), loopback only.
#   any other Host on :80  -> the same container, so visiting the bare IP still
#                             lands where it always did.
#   :8080                  -> CheeseX, served from /opt/cheesex.
#
# Plain http for the names above is a permanent redirect to https; see the
# redirect block at the end for why that has to be spelled out here.

:8080 {
	root * /opt/cheesex/frontend/dist
	encode gzip

	handle_path /papi/* {
		# 原版知是(1.0 老栈, cheese_prod_backend)的同源反代——界面级合入:
		# 同源 ⇒ 无 CORS、共享 localStorage,原版登录态可被壳读取。
		reverse_proxy 127.0.0.1:8081
	}
	handle /api/* {
		# WebSocket (/api/rooms/live) works out of the box via reverse_proxy
		reverse_proxy 127.0.0.1:8099
	}
	handle /debug/* {
		reverse_proxy 127.0.0.1:8099
	}
	handle {
		try_files {path} /index.html
		file_server
	}
}

# okcheese.com — TLS ends here, on the Hong Kong box. Requests go on as plain
# HTTP inside the dev box's reverse SSH tunnels (which encrypt them) to the dev
# box's front door on its 127.0.0.1:18080: tunnel A holds 18453 here, tunnel B
# 18454. Caddy keeps those upstream connections open and shares them between
# visitors, so a new visitor's connection no longer pays tunnel round trips for
# its TLS handshake. Sharing is why this is not TLS + PROXY protocol to the dev
# box's :18443: with PROXY on, Caddy pools upstream connections per client
# address (reverseproxy.go, "add client address to the host"), so each new
# visitor would still open its own. The client address travels in
# X-Forwarded-For instead: Caddy drops whatever the visitor sent and writes the
# address the layer4 router's PROXY header gave it.
okcheese.com, www.okcheese.com, hk.okcheese.com {
	bind 127.0.0.1
	header Strict-Transport-Security "max-age=31536000"

	# www and hk are aliases. Send them to the name sign-in callbacks and CORS
	# are registered for.
	@alias host www.okcheese.com hk.okcheese.com
	redir @alias https://okcheese.com{uri} permanent

	# Built /assets/ from the copy on this box (cheese-edge-asset-sync); a
	# file not there yet falls through to the tunnels below.
	import /etc/caddy/okcheese-edge-assets.caddy

	# Reads only. When a tunnel stalls, requests already sent down it hang
	# until ssh notices the line is dead (about 20 s) and then fail with 502
	# (29 of them on 2026-10-09, all on tunnel A, all 21-24 s long). Here a
	# read with no response headers after 10 s counts as failed: max_fails
	# marks that tunnel down and Caddy retries the request on the other one.
	# lb_try_duration must outlast the 10 s or the retry window has closed.
	# Writes keep the block below with no header timeout, because Caddy does
	# not retry them and a slow write would be cut off instead.
	@read method GET HEAD
	reverse_proxy @read 127.0.0.1:18453 127.0.0.1:18454 {
		lb_policy least_conn
		lb_try_duration 15s
		lb_try_interval 250ms
		fail_duration 10s
		max_fails 1
		health_uri /_internal/edge-health
		health_status 404
		health_interval 3s
		health_timeout 2s
		flush_interval -1
		stream_close_delay 10m
		transport http {
			response_header_timeout 10s
			keepalive 60s
			keepalive_idle_conns 64
			keepalive_idle_conns_per_host 32
		}
	}

	reverse_proxy 127.0.0.1:18453 127.0.0.1:18454 {
		# Neither line is reliably the faster one: tunnel A (dorm Unicom line)
		# answered in 47 ms one minute and 0.3-1.5 s the next, while tunnel B
		# (campus line) held at 90-170 ms (2026-10-04). least_conn counts
		# requests in flight, so a line that slows down collects them and new
		# requests go to the other. Pinning to one line with "first" would
		# stay on A while it is slow but alive; dropping a slow line through
		# a short health timeout would take the site down when both are slow.
		lb_policy least_conn
		lb_try_duration 5s
		lb_try_interval 250ms
		fail_duration 10s
		max_fails 1
		# The dev front door answers /_internal/ with 404 itself, so this
		# checks the tunnel and the front door without depending on a
		# backend or frontend rollout.
		health_uri /_internal/edge-health
		health_status 404
		health_interval 3s
		health_timeout 2s
		flush_interval -1
		# A reload otherwise closes every proxied WebSocket at once.
		stream_close_delay 10m
		transport http {
			# Under nginx's 75 s keepalive_timeout, so Caddy never reuses a
			# connection the front door has just closed.
			keepalive 60s
			keepalive_idle_conns 64
			keepalive_idle_conns_per_host 32
		}
	}
}

# docs.okcheese.com — the docs site's own host. Same tunnels and front door as
# okcheese.com; the frontend container answers this Host with the docs server
# (frontend/nginx/docs/host.conf). Not part of the okcheese.com block: that
# block serves /assets/ from the SPA's copy on this box, and the docs' /assets/
# are different files.
docs.okcheese.com {
	bind 127.0.0.1
	header Strict-Transport-Security "max-age=31536000"

	# Reads only. When a tunnel stalls, requests already sent down it hang
	# until ssh notices the line is dead (about 20 s) and then fail with 502
	# (29 of them on 2026-10-09, all on tunnel A, all 21-24 s long). Here a
	# read with no response headers after 10 s counts as failed: max_fails
	# marks that tunnel down and Caddy retries the request on the other one.
	# lb_try_duration must outlast the 10 s or the retry window has closed.
	# Writes keep the block below with no header timeout, because Caddy does
	# not retry them and a slow write would be cut off instead.
	@read method GET HEAD
	reverse_proxy @read 127.0.0.1:18453 127.0.0.1:18454 {
		lb_policy least_conn
		lb_try_duration 15s
		lb_try_interval 250ms
		fail_duration 10s
		max_fails 1
		health_uri /_internal/edge-health
		health_status 404
		health_interval 3s
		health_timeout 2s
		flush_interval -1
		stream_close_delay 10m
		transport http {
			response_header_timeout 10s
			keepalive 60s
			keepalive_idle_conns 64
			keepalive_idle_conns_per_host 32
		}
	}

	reverse_proxy 127.0.0.1:18453 127.0.0.1:18454 {
		# Neither line is reliably the faster one: tunnel A (dorm Unicom line)
		# answered in 47 ms one minute and 0.3-1.5 s the next, while tunnel B
		# (campus line) held at 90-170 ms (2026-10-04). least_conn counts
		# requests in flight, so a line that slows down collects them and new
		# requests go to the other. Pinning to one line with "first" would
		# stay on A while it is slow but alive; dropping a slow line through
		# a short health timeout would take the site down when both are slow.
		lb_policy least_conn
		lb_try_duration 5s
		lb_try_interval 250ms
		fail_duration 10s
		max_fails 1
		# The dev front door answers /_internal/ with 404 itself, so this
		# checks the tunnel and the front door without depending on a
		# backend or frontend rollout.
		health_uri /_internal/edge-health
		health_status 404
		health_interval 3s
		health_timeout 2s
		flush_interval -1
		# A reload otherwise closes every proxied WebSocket at once.
		stream_close_delay 10m
		transport http {
			# Under nginx's 75 s keepalive_timeout, so Caddy never reuses a
			# connection the front door has just closed.
			keepalive 60s
			keepalive_idle_conns 64
			keepalive_idle_conns_per_host 32
		}
	}
}

# *.cheeseusercontent.com — the preview content domain. TLS ends here with a
# wildcard certificate obtained over DNS-01 (one certificate covers every
# preview-<topic>[-<resource>] host; per-host certificates would hit Let's
# Encrypt's rate limits). The token in the secrets file may only edit DNS in
# this one zone, from this box's address. It is read through {file.…}, not an
# environment variable, because the unit runs `caddy run --environ`, which
# prints the environment to the journal.
# Requests go on as plain HTTP through the dev box's tunnels (A holds 18455,
# B 18456) to its content entry 127.0.0.1:8081, the api-front server for this
# domain, with Host preserved. Preview auth and the security headers are the
# backend's; nothing here adds or strips them.
*.cheeseusercontent.com {
	bind 127.0.0.1
	tls {
		dns cloudflare {file./etc/caddy/secrets/cf-cheeseusercontent-dns01.token}
	}

	reverse_proxy 127.0.0.1:18455 127.0.0.1:18456 {
		# Same balancing and failover as okcheese.com; see that block.
		lb_policy least_conn
		lb_try_duration 5s
		lb_try_interval 250ms
		fail_duration 10s
		max_fails 1
		# The content entry answers /_internal/ with 404 itself. It only
		# serves this domain's names, so the check sends one.
		health_uri /_internal/edge-health
		health_headers {
			Host cheeseusercontent.com
		}
		health_status 404
		health_interval 3s
		health_timeout 2s
		flush_interval -1
		# A reload otherwise closes every proxied WebSocket (app previews) at once.
		stream_close_delay 10m
		transport http {
			keepalive 60s
			keepalive_idle_conns 64
			keepalive_idle_conns_per_host 32
		}
	}
}

# ruc-etrip.cn — the etrip deployment, reached through its own container. The
# challenge stays on TLS-ALPN: this name was first served when :80 belonged to
# that container and http-01 was impossible, and pinning it keeps renewal on the
# one path that has always worked here. The ACME validator's TLS-ALPN
# connection reaches this site through the layer4 router like any visitor.
ruc-etrip.cn {
	encode zstd gzip
	bind 127.0.0.1
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
	reverse_proxy 127.0.0.1:80
}

# Backend reachable FROM SANDBOX CONTAINERS (host.docker.internal = 172.17.0.1):
# uvicorn binds loopback only, so bridge docker0 -> loopback here for the cheese
# CLI and Claude Code hook delivery (tmux backend). Binds the docker0 IP only —
# not public, regardless of the security group.
http://:8099 {
	bind 172.17.0.1
	reverse_proxy 127.0.0.1:8099
}

# Why these redirects are written out rather than left to auto_https: the
# frontend container used to publish :80 on every address and answered every
# Host with its own SPA, so http://okcheese.com served a build months behind the
# one https served — a visitor typing the bare domain reached a login page whose
# provider list was empty and read it as a broken site. The container now
# publishes 127.0.0.1:80 only and Caddy holds the public port.
http://okcheese.com, http://docs.okcheese.com, http://ruc-etrip.cn {
	bind 172.26.10.144
	redir https://{host}{uri} permanent
}

# Previews only ever load over https (their session cookie is Secure); without
# this block plain http for them would fall to the catch-all below and land on
# the etrip deployment.
http://*.cheeseusercontent.com {
	bind 172.26.10.144
	redir https://{host}{uri} permanent
}

# www and hk are aliases: they go straight to the canonical name in one hop.
http://www.okcheese.com, http://hk.okcheese.com {
	bind 172.26.10.144
	redir https://okcheese.com{uri} permanent
}

# Every other Host on :80 (a bare-IP visitor, a scanner) keeps reaching the
# etrip deployment's frontend exactly as before.
http://:80 {
	bind 172.26.10.144
	reverse_proxy 127.0.0.1:80
}
