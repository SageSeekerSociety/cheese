{
	# 80 belongs to the legacy 1.0 stack — never auto-bind it for redirects
	auto_https disable_redirects
}

# CheeseX production Caddyfile (deployed at /etc/caddy/Caddyfile on etrip)
#
# NOTE (port): port 80/443 on this server are occupied by the legacy Cheese 1.0
# stack (docker: cheese_prod_frontend). CheeseX therefore listens on :8080.
# Public entry: http://8.217.1.152:8080
#
# NOTE (domain plan): when the domain okcheese.com is ready, the plan is to put
# a single front reverse-proxy in charge of 80/443 for BOTH stacks (route by
# Host header, auto-HTTPS there), instead of this bare :8080 block. Do NOT
# simply change this to `okcheese.com { ... }` while cheese_prod_frontend still
# holds port 80 — that migration needs to be planned separately.

:8080 {
	root * /opt/cheesex/frontend/dist
	encode gzip

	handle /api/* {
		# WebSocket (/api/topics/*/chat) works out of the box via reverse_proxy
		reverse_proxy 127.0.0.1:8099
	}
	handle /debug/* {
		reverse_proxy 127.0.0.1:8099
	}
	handle {
		try_files {path} /index.html
		file_server
	}
}

