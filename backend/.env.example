# --- Database ---
# Async SQLAlchemy URL (asyncpg driver). Matches docker-compose.yml (port 5433).
DATABASE_URL=postgresql+asyncpg://cheesex:cheesex@localhost:5433/cheesex

# --- Agent (Claude Agent SDK) ---
# API key for Claude. The Agent SDK picks this up from the environment.
ANTHROPIC_API_KEY=sk-ant-...

# Model used by 芝士. Route through a LiteLLM gateway later without code changes.
AGENT_MODEL=claude-sonnet-4-6
