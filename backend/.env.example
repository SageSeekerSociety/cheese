# Cheese backend — local development template.
#
# Copy to backend/.env and edit. Every KEY here is a real field on
# app.core.config.Settings, and tests/unit/test_env_example_matches_settings.py
# fails the build if one stops being. That test exists because Settings sets
# `extra="ignore"`: an env var that matches no field is dropped in silence, so a
# stale template (this file once advertised ANTHROPIC_API_KEY, which no field
# ever read) reads as configured while configuring nothing.
#
# The values below match `docker compose up -d` from the repo root — the one
# infra stack (see README.md "Quick Start"). The Postgres image is ParadeDB, not
# stock postgres: the 知是 search paths need pg_search.

# --- Database / cache -------------------------------------------------------
# Root docker-compose.yml publishes the dev database on :5432 and a separate
# test database on :5433 (the test suite reaches that one via TEST_PG_BASE).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cheese
REDIS_URL=redis://localhost:6379/0

# --- App --------------------------------------------------------------------
ENVIRONMENT=development
# Signs BOTH generations' tokens: the 知是 access/refresh JWT and the cheesex
# session token are one token (a `handle` claim carries the second identity).
JWT_SECRET=dev-secret-change-me
# Master key for every secret stored encrypted in the database (2FA secrets,
# forge passwords, OAuth tokens, real-name fields). Empty uses a public
# development key; a deployment refuses to boot without a real one. A
# comma-separated list rotates it: the first key encrypts, all of them decrypt.
# python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
DATA_ENCRYPTION_KEY=
# Where the browser reaches the SPA — `task dev` serves vite on :3000.
FRONTEND_URL=http://localhost:3000
# Absolute avatar URLs in notification payloads point back at the backend,
# which `task dev` runs on :8081.
AVATAR_BASE_URL=http://localhost:8081
# WebAuthn refuses a passkey whose origin differs by even a port, so this must
# be exactly what the address bar shows. rp_id is the domain, no port.
WEBAUTHN_ORIGIN=http://localhost:3000
WEBAUTHN_RP_ID=localhost

# --- 反馈 (feedback) ----------------------------------------------------------
# Handles that may read and route the whole feedback queue (/admin/feedback).
# JSON list, matched against the account handle exactly.
# REQUIRED on a deployment (see deploy/.env.prod.example) — empty there means a
# feedback queue that accepts submissions and can never be worked, and the boot
# now refuses rather than leave that surface silently write-only.
# Locally it can stay empty: the admin console is simply unreachable, and the
# rest of the feedback feature (submit, list, comment, support) works normally.
PLATFORM_ADMIN_HANDLES=[]

# --- Uploads ----------------------------------------------------------------
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_LOCAL_URL=/uploads

# --- 芝士 (agent) -----------------------------------------------------------
# The SDK/CLI talks to any Anthropic-compatible gateway; leave the token empty
# and agent turns are simply unavailable — nothing else breaks.
AGENT_MODEL=glm-5.2
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
# Signs the scoped tokens the `cheese` CLI presents from a screen. Left empty
# it is regenerated per process, which invalidates every live screen's token on
# restart — fine locally, pin it anywhere that keeps screens around.
SANDBOX_TOKEN=
# Project git repos / topic worktrees / claude sessions live here.
WORKSPACE_ROOT=./.workspaces

# ===== 浏览器推送（Web Push）=====
# 两个都空 = 这个部署不开推送，订阅接口如实回 available: false。
# 生成命令见 docs/topics/浏览器推送.md；两个值都是 base64url 的裸值，不是 PEM。
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@okcheese.com

# --- Optional ---------------------------------------------------------------
# The proxies whose X-Forwarded-For uvicorn believes (addresses or CIDRs,
# comma-separated). It decides the client address that sessions, audits and the
# request log record: uvicorn walks the header right to left past these and
# takes the first address that is not one of them. List only the proxies of
# this deployment — any address listed here can name any client it likes.
# Unset trusts loopback alone, so behind a remote proxy every request records
# the proxy's address. uvicorn reads it from the process environment, which a
# container's env_file sets; `task dev` needs none, its proxy is on loopback.
# FORWARDED_ALLOW_IPS=127.0.0.1,172.18.0.0/16
