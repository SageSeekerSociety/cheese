# Cheese backend — local development template.
#
# Copy to backend/.env and edit. Every KEY here is a real field on
# app.core.config.Settings, and tests/unit/test_env_example_matches_settings.py
# fails the build if one stops being. That test exists because Settings sets
# `extra="ignore"`: an env var that matches no field is dropped in silence, so a
# stale template (this file once advertised ANTHROPIC_API_KEY, which no field
# ever read) reads as configured while configuring nothing.
#
# The values below match `docker compose up -d` from the repo root — the one
# infra stack (see README.md "Quick Start"). The Postgres image is ParadeDB, not
# stock postgres: the 知是 search paths need pg_search.

# --- Database / cache -------------------------------------------------------
# Root docker-compose.yml publishes the dev database on :5432 and a separate
# test database on :5433 (the test suite reaches that one via TEST_PG_BASE).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cheese
REDIS_URL=redis://localhost:6379/0

# --- App --------------------------------------------------------------------
ENVIRONMENT=development
# Signs BOTH generations' tokens: the 知是 access/refresh JWT and the cheesex
# session token are one token (a `handle` claim carries the second identity).
JWT_SECRET=dev-secret-change-me
# Where the browser reaches the SPA — `task dev` serves vite on :3000.
FRONTEND_URL=http://localhost:3000
# Absolute avatar URLs in notification payloads point back at the backend,
# which `task dev` runs on :8081.
AVATAR_BASE_URL=http://localhost:8081
# WebAuthn refuses a passkey whose origin differs by even a port, so this must
# be exactly what the address bar shows. rp_id is the domain, no port.
WEBAUTHN_ORIGIN=http://localhost:3000
WEBAUTHN_RP_ID=localhost

# --- Uploads ----------------------------------------------------------------
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_LOCAL_URL=/uploads

# --- 芝士 (agent) -----------------------------------------------------------
# The SDK/CLI talks to any Anthropic-compatible gateway; leave the token empty
# and agent turns are simply unavailable — nothing else breaks.
AGENT_MODEL=glm-5.2
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
# Which local transport runs a turn: "sdk" (Claude Agent SDK in a per-topic
# container) or "tmux" (interactive claude in a tmux session, hooks report
# back). Both need Docker; without it turns degrade to a plain model reply.
AGENT_BACKEND=sdk
AGENT_SANDBOX_ENABLED=false
# Signs the scoped tokens the in-container `cheese` CLI presents. Left empty it
# is regenerated per process, which invalidates every existing sandbox's token
# on restart — fine locally, pin it anywhere that keeps containers around.
SANDBOX_TOKEN=
# Project git repos / jj worktrees / claude sessions live here.
WORKSPACE_ROOT=./.workspaces

# --- 记忆整理 (dreaming) -----------------------------------------------------
# Before an idle sandbox is destroyed, give 芝士 one turn to reread the topic
# and organize what it learned into the project's memory pools — merge the
# duplicates, date the 「上周」s, retire what the work disproved. It runs in the
# box because the job is checking remembered claims against the workspace.
#
# OFF by default because it SPENDS MODEL BUDGET on a background trigger: about
# one agent turn per organized topic, capped per sweep. Turn it on only where
# that is a cost you want to pay. Nothing else changes when it is off.
DREAM_ENABLED=false
# At most this many topics organized per reaper sweep (sweep interval is
# SANDBOX_REAP_INTERVAL_SECONDS, 1h by default). The rest wait for the next one.
DREAM_MAX_PER_SWEEP=1
# Topics with fewer blocks than this are skipped — not enough happened in them
# to be worth a turn.
DREAM_MIN_BLOCKS=20

# --- Optional ---------------------------------------------------------------
# 0 = no automatic 定期巡检 (default locally, so dev does not burn model calls).
SCHEDULER_INTERVAL_SECONDS=0
# Fernet key for real-name encryption; only the 实名 paths need it.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
REALNAME_ENCRYPTION_KEY=
