# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual env
.venv/

# Environment / secrets
.env

# Agent workspaces (git-backed project repos)
.workspaces/

# Test / tool caches
.pytest_cache/
.ruff_cache/
.pyright/
.cheesed-workspaces/
.testmondata


# self-hosted connector binaries (built artifacts, not source; see
# scripts/build-connector.sh). The cli source is vendored at the repo root cli/.
connector-dist/

# legacy connector build cache (cli/ is now vendored in-repo; kept ignored so any
# stale extraction from the old build flow never gets committed).
backend/.cli-src/
.cli-src/
uploads/

# VAPID keys, if someone runs `uv run vapid --gen` in place. The private one is
# the credential for "send push as this site" — it must never be committed.
*.pem

# The generated API schema (`uv run python -m scripts.export_openapi --schema`,
# the `be:openapi` task). It was committed for review to see contract changes,
# but it changes with every route, so any two branches that each touched a route
# collided in a file neither of them had a decision in. It is generated where it
# is read — the frontend type check (frontend/scripts/gen-api-types.mjs runs the
# same command) and `be:openapi` — so it is not in the tree.
/openapi.json
