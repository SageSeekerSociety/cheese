# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual env
.venv/

# Environment / secrets
.env

# Agent workspaces (git-backed project repos)
.workspaces/

# Test / tool caches
.pytest_cache/
.ruff_cache/
.pyright/
.cheesed-workspaces/
.testmondata

# OpenViking embedded memory store (local data + generated ov.conf with keys)
.viking/

# Raw Claude session files uploaded from device homes (settings.transcripts_dir)
.transcripts/

# self-hosted connector binaries (built artifacts, not source; see
# scripts/build-connector.sh). The cli source is vendored at the repo root cli/.
connector-dist/

# legacy connector build cache (cli/ is now vendored in-repo; kept ignored so any
# stale extraction from the old build flow never gets committed).
backend/.cli-src/
.cli-src/
uploads/

# VAPID keys, if someone runs `uv run vapid --gen` in place. The private one is
# the credential for "send push as this site" — it must never be committed.
*.pem
