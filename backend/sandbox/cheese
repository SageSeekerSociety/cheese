#!/usr/bin/env python3
"""cheese — 芝士 的平台 CLI（在沙箱里调,平台动作走 REST,不用 MCP）。

代码/文件的事用原生工具（Bash/Write/Read）；改平台状态的事用本 CLI。
环境变量（容器注入）：
  CHEESE_API     平台 API 基址；直连后端用 http://host.docker.internal:8099，
                 经公共网关用 https://example.com/api
  CHEESE_PROJECT 当前项目 id
  CHEESE_TOPIC   当前话题 id
  CHEESE_AUTHOR  当前作者 handle（默认 cheese）

例:
  cheese doc set DOC.md            # 把 DOC.md 设为本话题实况文档
  cheese doc get                   # 打印本话题实况文档
  cheese split "数据清洗"           # 在本房间开一条活(开完自己起分身去做)
  cheese bind <task_id> <agent_id>  # 告诉平台这条活归哪个分身
  cheese decision "用 item-based CF" # 记一条决策
  cheese remember "技术栈=FastAPI"  # 记入项目记忆
  cheese recall "技术选型"          # 按需检索记忆(关键词检索)
  cheese notify --title "看下" --to mentor-1 --level strong
  cheese accept-request mentor-1 "验收证据" --subject "feat: add report"
  cheese close-task <task_id>                # 放弃或撤销任务
  cheese tell "数据清洗" "口径改了,按新的来"    # 在那条活上留一句话(不叫醒任何人)
  cheese milestone "中期汇报" --due 2026-06-20
  cheese status                             # 平台状态快照
  cheese artifact report.html               # 把产物设为本话题当前预览(进预览窗口)
  cheese artifact 评审简报.docx              # 文档类交付物同理,用户可以打开和下载
  cheese recalc 预算表.xlsx                 # 重算表格里的公式,并报出算不出来的格
  cheese convert 旧稿.doc --to docx         # 老格式升级;--to pdf 用来自己看版面
  cheese serve 5173 "Vue dev server"        # 应用起在 127.0.0.1:5173 后,设为预览
"""

