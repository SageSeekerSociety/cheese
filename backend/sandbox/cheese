    if tool == "cheese_routine.list":
        # 带上话题：沙箱 token 是为一轮、一个地方铸的，后端要凭它确认这个凭据属于谁。
        where = urllib.parse.quote(topic)
        return {
            "method": "GET",
            "path": f"/projects/{project}/routines?topic={where}",
        }
    if tool == "cheese_routine.update":
        body = _given(
            args,
            "title",
            "instructions",
            "note",
            "trigger",
            "spec",
            "timezone",
            "agent_handle",
        )
        if not body:
            raise ValueError("没有要改的字段：至少给一项")
        routine_spec_checked(
            trigger=body.get("trigger"),
            spec=body.get("spec"),
            timezone=body.get("timezone"),
