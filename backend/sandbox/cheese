def request_plan(tool: str, args: dict, environ: dict | None = None) -> dict:
    """Build the HTTP request shared by the CLI and native MCP transport."""
    env = os.environ if environ is None else environ
    topic = TOPIC if environ is None else env.get("CHEESE_TOPIC", "")
    project = PROJECT if environ is None else env.get("CHEESE_PROJECT", "")
    if tool in {
        "cheese_ask",
        "cheese_bind",
        "cheese_close_task",
        "cheese_decision",
        "cheese_feedback_propose",
        "cheese_members",
        "cheese_status",
        "cheese_tell",
        "cheese_title",
    } and not topic:
        raise ValueError("Missing CHEESE_TOPIC")
    if tool in {
        "cheese_milestone",
        "cheese_notify",
        "cheese_recall",
        "cheese_remember",
    } and not project:
        raise ValueError("Missing CHEESE_PROJECT")
    if tool == "cheese_bind":
        return {
            "method": "POST",
            "path": f"/topics/{topic}/tasks/{args['task_id']}/bind",
            "body": {"agent_id": args["agent_id"]},
        }
    if tool == "cheese_close_task":
        body = {"conclusion": args.get("conclusion", "")}
        if args.get("reported_by") is not None:
            body["reporter_handle"] = args["reported_by"]
        if args.get("contributor") is not None:
            body["contributor_handles"] = args["contributor"]
        return {
            "method": "POST",
            "path": f"/topics/{topic}/tasks/{args['task_id']}/close",
            "body": body,
        }
    if tool == "cheese_decision":
        return {
            "method": "POST",
            "path": f"/topics/{topic}/decision",
            "body": {"decision": args["text"]},
        }
    if tool == "cheese_title":
        path = (
            f"/topics/{topic}/tasks/{args['task']}/title"
            if args.get("task")
            else f"/topics/{topic}/title"
        )
        return {"method": "POST", "path": path, "body": {"title": args["text"]}}
    if tool == "cheese_fetch":
        body = {
            "url": args["url"],
            "topic": topic,
            "project": project,
        }
        if args.get("prompt"):
            body["prompt"] = args["prompt"]
        return {"method": "POST", "path": "/fetch", "body": body}
    if tool in {"cheese_remember", "cheese_recall"}:
        body = {
            "content" if tool == "cheese_remember" else "query": (
                args["fact"] if tool == "cheese_remember" else args["query"]
            ),
            "topic": topic,
        }
        if tool == "cheese_remember" and args.get("core"):
            body["layer"] = "core"
        memory_scope = (
            MEMORY_SCOPE
            if environ is None
            else env.get("CHEESE_MEMORY_SCOPE", "project")
        )
        owner = OWNER if environ is None else env.get("CHEESE_OWNER", "")
        if memory_scope == "personal" and owner:
            body.update(scope="user", owner=owner)
        suffix = "" if tool == "cheese_remember" else "/search"
        return {
            "method": "POST",
            "path": f"/projects/{project}/memory{suffix}",
            "body": body,
        }
    if tool == "cheese_ask":
        options = [value.strip() for value in args["option"] if value.strip()]
        if not 2 <= len(options) <= 4:
            raise ValueError("ask requires 2-4 options")
        return {
            "method": "POST",
            "path": f"/topics/{topic}/ask",
            "body": {"question": args["question"], "options": options},
        }
    if tool == "cheese_notify":
        payload = {}
        if args.get("options"):
            payload["options"] = [
                value.strip() for value in args["options"].split("|") if value.strip()
            ]
        return {
            "method": "POST",
            "path": f"/projects/{project}/alerts",
            "body": {
                "level": args.get("level", "light"),
                "kind": args.get("kind", "change_alert"),
                "title": args["title"],
                "body": args.get("body", ""),
                "target_handle": args.get("to"),
                "topic_id": topic or None,
                "payload": payload,
            },
        }
    if tool == "cheese_tell":
        return {
            "method": "POST",
            "path": f"/topics/{topic}/tell",
            "body": {"target": args["target"], "content": args["message"]},
        }
    if tool == "cheese_milestone":
        body = {"title": args["title"]}
        if args.get("due"):
            due = args["due"]
            body["due_date"] = due if "T" in due else f"{due}T00:00:00Z"
        return {
            "method": "POST",
            "path": f"/projects/{project}/milestones",
            "body": body,
        }
    if tool == "cheese_gh_token":
        return {"method": "GET", "path": "/sandbox/github-token"}
    if tool == "cheese_feedback_propose":
        # 话题级:配额、指纹去重、拒绝的记忆全挂在话题上,而「这个人能不能在这个
        # 话题里提」的答案就是 authorize_topic 已经算过的那个。
        body: dict = {
            "title": args["title"],
            "kind": args["kind"],
            "visibility": args["visibility"],
        }
        for key, arg in (
            ("why", "why"),
            ("what_happened", "what_happened"),
            ("expectation", "expectation"),
            ("repro", "repro"),
            ("evidence", "evidence"),
            ("summary", "summary"),
            ("problem", "problem"),
            ("session_id", "session_id"),
            ("environment", "environment"),
        ):
            if args.get(arg):
                body[key] = args[arg]
        if args.get("user_said"):
            body["user_said"] = args["user_said"]
        if args.get("tags"):
            body["tags"] = [
                value.strip() for value in args["tags"].split(",") if value.strip()
            ]
        if args.get("attach_logs"):
            body["logs"] = collect_session_snapshot()
        return {
            "method": "POST",
            "path": f"/topics/{topic}/feedback-proposals",
            "body": body,
        }
    if tool == "cheese_members":
        return {"method": "GET", "path": f"/topics/{topic}/members"}
    if tool == "cheese_status":
        return {"method": "GET", "path": f"/topics/{topic}/status"}
    raise ValueError(f"No direct platform request plan for {tool}")


def _call(
    method: str,
    path: str,
    body: dict | None = None,
    *,
    token: str | None = None,
    tolerate: tuple[int, ...] = (),
    timeout: int = 20,
) -> dict:
    """Call the platform. Any HTTP error is fatal, except the statuses in
    `tolerate` — those come back as ``{"ok": False, "status": ..., "error": ...}``
    for a caller that has something better to say than the raw response.

    ``timeout`` is generous by default because these calls are small. One is
    not: reading a web page can climb a ladder of fetch strategies ending in a
    real browser, which measured 22 s on a page that answered and longer on one
    that had to try every rung. That caller passes its own."""
    url = f"{API}{path}"
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method)
    req.add_header("Content-Type", "application/json")
    auth = token if token is not None else TOKEN
    if auth:
        req.add_header("X-Cheese-Token", auth)
    if TURN:
        req.add_header("X-Cheese-Turn", TURN)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        raw = e.read().decode(errors="replace")
        if e.code in tolerate:
            try:
                payload = json.loads(raw)
            except ValueError:
                payload = {}
            return {"ok": False, "status": e.code, "error": payload.get("error") or {}}
        print(
            f"[cheese] {method} {path} 失败 HTTP {e.code}: {raw[:400]}", file=sys.stderr
        )
        sys.exit(1)
    except Exception as e:  # noqa: BLE001
        print(f"[cheese] {method} {path} 出错: {e}", file=sys.stderr)
        sys.exit(1)


def _planned_call(tool: str, args: argparse.Namespace, *, timeout: int = 20) -> dict:
    plan = request_plan(tool, vars(args))
    positional = [plan["method"], plan["path"]]
    if "body" in plan:
        positional.append(plan["body"])
    return _call(*positional, **({"timeout": timeout} if timeout != 20 else {}))


def _task_root() -> Path:
    return Path.home() / ".cheese" / "tasks"


# Which directory holds the environment runner depends on which launcher
# prepared this place, and that is not something the CLI can know: the machine
# launcher writes `.cheese/`, the claude-code remote-execution payload writes
# the harness config dir `.claude/`. The copies are byte-identical, so the
# first one on disk answers — the order matching the platform's own probe
# (`ENVIRONMENT_RUNNER_PATHS`). Naming one of them was how a room on a machine
# prepared by the other launcher could not create a task at all.
ENVIRONMENT_RUNNER_PATHS = (".cheese", ".claude")


def _environment_runner() -> Path | None:
    for directory in ENVIRONMENT_RUNNER_PATHS:
        candidate = Path.home() / directory / "cheese-environment.py"
        if candidate.is_file():
            return candidate
    return None


def _task_id(explicit: str | None = None) -> str:
    if explicit:
        return str(uuid.UUID(explicit))
    result = subprocess.run(
        ["git", "rev-parse", "--git-path", "cheese-task.json"],
        capture_output=True,
        text=True,
    )
    if result.returncode == 0:
        marker = Path(result.stdout.strip())
        if marker.is_file():
            return str(uuid.UUID(json.loads(marker.read_text())["task_id"]))
    raise SystemExit("[cheese] 请在任务工作目录内执行，或指定 --task <id>")


def _git_task(
    cwd: Path, *args: str, extra_env: dict | None = None, input_text: str | None = None
) -> str:
    env = {
        key: value for key, value in os.environ.items() if not key.startswith("GIT_")
    }
    # The credential only travels in the child's environment, never argv or
    # repository config. This cache is owned by Cheese, not a user's checkout.
    env.update(
        {
            "GIT_CONFIG_COUNT": "1",
            "GIT_CONFIG_KEY_0": "http.extraHeader",
            "GIT_CONFIG_VALUE_0": f"X-Cheese-Token: {TOKEN}",
        }
    )
    if extra_env:
        env.update(extra_env)
    result = subprocess.run(
        ["git", "-C", str(cwd), *args],
        env=env,
        input=input_text,
        capture_output=True,
        text=True,
        timeout=300,
    )
    if result.returncode:
        raise RuntimeError(result.stderr.strip())
    return result.stdout.strip()


def _task_worktree(task_id: str) -> Path:
    task_id = str(uuid.UUID(task_id))
    project = _need("CHEESE_PROJECT", PROJECT)
    data = _call("GET", f"/projects/{project}/git/tasks/{task_id}")["data"]
    if data["room_id"] != TOPIC:
        raise SystemExit("[cheese] 这条任务不属于当前房间")
    if data["closed"]:
        raise SystemExit("[cheese] 这条任务已结束，请创建新任务")
    cache = Path.home() / ".cheese" / "repositories"
    cache.mkdir(parents=True, exist_ok=True)
    repo = cache / f"{project}.git"
    task_dir = _task_root() / task_id
    task_dir.parent.mkdir(parents=True, exist_ok=True)
    remote = os.environ.get("CHEESE_GIT_REMOTE") or f"{API}/projects/{project}/git"
    # Native subagents can request worktrees concurrently. Serialize creation
    # so an interrupted clone cannot be mistaken for a complete repository.
    with (cache / f"{project}.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if not repo.exists():
            _git_task(cache, "init", "--bare", str(repo))
        if "origin" not in _git_task(repo, "remote").splitlines():
            _git_task(repo, "remote", "add", "origin", remote)
        _git_task(
            repo,
            "fetch",
            "origin",
            f"refs/heads/{data['branch']}:refs/remotes/origin/{data['branch']}",
        )
        _git_task(
            repo,
            "fetch",
            "origin",
            f"refs/heads/{data['base']}:refs/remotes/origin/{data['base']}",
        )
        if not (task_dir / ".git").exists():
            existing = _git_task(repo, "branch", "--list", data["branch"])
            create = [] if existing else ["-b", data["branch"]]
            start = (
                data["branch"] if existing else f"refs/remotes/origin/{data['branch']}"
            )
            _git_task(repo, "worktree", "prune")
            _git_task(
                repo,
                "worktree",
                "add",
                *create,
                str(task_dir),
                start,
            )
        marker = Path(
            _git_task(task_dir, "rev-parse", "--git-path", "cheese-task.json")
        )
        if not marker.is_absolute():
            marker = task_dir / marker
        marker.write_text(json.dumps(data))
        _git_task(
            repo, "config", "user.name", os.environ.get("GIT_AUTHOR_NAME", AUTHOR)
        )
        _git_task(
            repo,
            "config",
            "user.email",
            os.environ.get("GIT_AUTHOR_EMAIL", f"{AUTHOR}@agent.cheese.local"),
        )
        hooks = repo / "hooks"
        hook = hooks / "post-commit"
        hook.write_text("#!/bin/sh\nexec cheese sync\n")
        hook.chmod(0o755)
    # The room has no checkout. Branch dependencies belong to this task and
    # must be prepared on every open, including after local branch changes.
    if (Path.home() / ".cheese-environment/config.json").exists():
        # That config is the runner's own output, so a place that has one had a
        # runner: it going missing is a broken place, not an unprepared one, and
        # silently skipping would hand back a task directory whose dependencies
        # were never installed.
        runner = _environment_runner()
        if runner is None:
            raise SystemExit("[cheese] 这台机器的环境准备脚本不见了，任务目录没法准备")
        result = subprocess.run([sys.executable, str(runner), "task", str(task_dir)])
        if result.returncode:
            raise SystemExit(result.returncode)
    return task_dir


def _report_task_sync(
    task_id: str, status: str, *, head: str | None = None, branch: str | None = None
) -> None:
    """The installed hook durably spools failures for the room's visible warning."""
    hook = shutil.which("cheese-hook")
    if hook is None:
        return  # A human using the CLI directly already receives its exit status.
    payload = {
        "hook_event_name": "CheeseSync",
        "status": status,
        "branch": branch or f"任务 {task_id}",
        "task_id": task_id,
        "commit": head,
    }
    try:
        result = subprocess.run(
            [hook],
            input=json.dumps(payload),
            text=True,
            capture_output=True,
            timeout=30,
        )
    except (OSError, subprocess.TimeoutExpired):
        result = None
    if result is None or result.returncode:
        print(
            f"[cheese] 同步通知未送达，任务 {task_id} 的 cheese-sync.log 保留了结果",
            file=sys.stderr,
        )


def _sync_task(task_id: str) -> None:
    task_id = str(uuid.UUID(task_id))
    worktree = _task_root() / task_id
    if not (worktree / ".git").exists():
        worktree = _task_worktree(task_id)
    admin = Path(_git_task(worktree, "rev-parse", "--absolute-git-dir"))
    log = admin / "cheese-sync.log"
    with log.open("a") as record:
        # A post-commit hook and the room's Stop hook can arrive together.
        fcntl.flock(record, fcntl.LOCK_EX)
        record.write(f"{datetime.now(UTC).isoformat()} start task={task_id}\n")
        record.flush()
        branch = None
        try:
            project = _need("CHEESE_PROJECT", PROJECT)
            data = _call("GET", f"/projects/{project}/git/tasks/{task_id}")["data"]
            if data["room_id"] != TOPIC:
                raise RuntimeError("Task belongs to another room")
            branch = _git_task(worktree, "symbolic-ref", "--short", "HEAD")
            if branch != data["branch"]:
                raise RuntimeError(
                    f"Expected task branch {data['branch']}, found {branch}"
                )
            head = _git_task(worktree, "rev-parse", "HEAD")
            # Keep unfinished work off the PR. An alternate index preserves the
            # worker's staging choices while backing up its files at turn end.
            snapshot_env = {"GIT_INDEX_FILE": str(admin / "cheese-snapshot-index")}
            _git_task(worktree, "read-tree", "HEAD", extra_env=snapshot_env)
            _git_task(worktree, "add", "-A", extra_env=snapshot_env)
            tree = _git_task(worktree, "write-tree", extra_env=snapshot_env)
            snapshot = (
                head
                if tree == _git_task(worktree, "rev-parse", "HEAD^{tree}")
                else _git_task(
                    worktree,
                    "commit-tree",
                    tree,
                    "-p",
                    head,
                    input_text=f"Work in progress for task {task_id}\n",
                )
            )
            _git_task(
                worktree,
                "push",
                "origin",
                f"{snapshot}:refs/cheese/snapshots/task/{task_id}/{snapshot}",
            )
            if data["closed"]:
                record.write(
                    f"{datetime.now(UTC).isoformat()} archived snapshot={snapshot}; "
                    "delivery is closed\n"
                )
                return
            _git_task(worktree, "push", "origin", f"{head}:refs/heads/{branch}")
            record.write(
                f"{datetime.now(UTC).isoformat()} success head={head} "
                f"snapshot={snapshot}\n"
            )
            _report_task_sync(task_id, "ok", head=head, branch=branch)
        except BaseException as exc:
            record.write(
                f"{datetime.now(UTC).isoformat()} failed {type(exc).__name__}: {exc}\n"
            )
            _report_task_sync(task_id, "failed", branch=branch)
            raise


def _sync_all_tasks() -> None:
    root = _task_root()
    if not root.exists():
        return
    failed = []
    for worktree in sorted(root.iterdir()):
        if not (worktree / ".git").exists():
            continue
        try:
            _sync_task(worktree.name)
        except (Exception, SystemExit) as exc:
            failed.append(worktree.name)
            print(f"[cheese] 任务 {worktree.name} 同步失败：{exc}", file=sys.stderr)
    if failed:
        raise SystemExit(1)


def _doc_version_path(topic: str) -> str:
    """Where the version `cheese doc get` last showed for this topic is kept.

    The living doc has no partial write: `doc set` replaces the whole thing. So
    a write has to say which version it is replacing, and that number must be
    EVIDENCE OF A READ rather than something the caller states. A flag would let
    you assert a version you only heard about — the platform pushes 「文档已更新
    到第 7 版」 into a running session — and write ten-minute-old content over it
    claiming to be based on it, which is the exact overwrite the version exists
    to stop.

    Lives on the session mount (host-backed, survives a container rebuild): a
    rebuild mid-turn must not turn a read the agent really did into a read the
    CLI has forgotten.
    """
    home = os.environ.get("HOME") or "/tmp"
    session = os.path.join(home, ".claude")
    base = (
        os.path.join(session, "cheese-doc")
        if os.path.isdir(session)
        else os.path.join(home, ".cheese", "doc")
    )
    os.makedirs(base, exist_ok=True)
    return os.path.join(base, f"{topic}.version")


def _remember_doc_version(topic: str, version: int) -> None:
    try:
        with open(_doc_version_path(topic), "w", encoding="utf-8") as f:
            f.write(str(version))
    except OSError:
        # Losing the note costs a rejected `doc set` and a re-read, which is the
        # safe direction. Failing the `doc get` over it is not.
        pass


def _read_doc_version(topic: str) -> int:
    """The version this CLI last showed the agent. 0 — "I have not read it" —
    when there is no note, which is also the only version under which `doc set`
    may CREATE a doc. Not having read a doc that exists is exactly when a write
    must be refused."""
    try:
        with open(_doc_version_path(topic), encoding="utf-8") as f:
            return int(f.read().strip() or 0)
    except (OSError, ValueError):
        return 0


def _need(name: str, value: str) -> str:
    if not value:
        print(f"[cheese] 缺少 {name}（环境变量未注入）", file=sys.stderr)
        sys.exit(2)
    return value


def _api_root() -> str:
    """The API surface base exactly as the launcher supplied it.

    A direct backend URL is the app root. A public URL includes the gateway's
    ``/api`` mount, which nginx strips before forwarding. Removing that suffix
    here makes device calls to ``/openapi.json`` and ``/sandbox/github-token``
    miss the gateway and hit the frontend instead.
    """
    return API


def _raw_request(
    method: str, path: str, data: str | None, out: str | None = None
) -> None:
    """Raw API escape hatch (fusion-design §5.2): hit our backend directly with
    the container's existing auth (CHEESE_TOKEN), printing the response body
    verbatim. NOT a no-auth backdoor — it still carries the token, and the
    backend still authorizes the actor per call; it is just the low-ceremony
    channel for the 20% of cases the curated commands don't cover. Prefer the
    curated `cheese <verb>` commands (title/doc/ask/remember/...) — see SKILL.md.

    `out` writes the body to a file as BYTES. Without it the body is decoded as
    text, which is right for JSON and destroys anything else: `decode(errors=
    "replace")` turns every byte over 0x7f into U+FFFD, so a PNG arrives with
    its own signature (`\x89PNG`) mangled and no way to tell that happened
    apart from the file not opening. Attachments are reachable over this
    channel, so text-only was not a limitation of the API — only of this
    function."""
    if not path.startswith("/"):
        path = "/" + path
    body = data.encode() if data else None
    req = urllib.request.Request(f"{API}{path}", data=body, method=method.upper())
    req.add_header("Content-Type", "application/json")
    if TOKEN:
        req.add_header("X-Cheese-Token", TOKEN)
    if TURN:
        req.add_header("X-Cheese-Turn", TURN)
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            payload = r.read()
    except urllib.error.HTTPError as e:
        # Surface the backend's error body (auth failures, validation, etc.)
        # verbatim so the caller sees exactly why — then exit non-zero. Always
        # as text: an error body is JSON even when the success body would not
        # have been, and writing it to `out` would leave a file that looks like
        # the download succeeded.
        print(e.read().decode(errors="replace"))
        sys.exit(1)
    except Exception as e:  # noqa: BLE001
        print(f"[cheese] api {method} {path} 出错: {e}", file=sys.stderr)
        sys.exit(1)
    if out:
        with open(out, "wb") as f:
            f.write(payload)
        print(f"已写入 {out}（{len(payload)} 字节）")
    else:
        print(payload.decode(errors="replace"))


def collect_session_snapshot() -> str:
    """The environment-and-logs snapshot `--attach-logs` sends.

    Bounded on purpose: the whole point of the flag is that the reporter opts in,
    and a snapshot that can be arbitrarily large is one nobody can read at the
    other end. Records the facts that make a report reproducible — CLI
    fingerprint, container, working directory — and the tail of nothing else.
    """
    facts = {
        "cheese_fingerprint": source_fingerprint(),
        "api": API,
        "topic": TOPIC,
        "project": PROJECT,
        "turn": TURN,
        "cwd": os.getcwd(),
        "platform": platform.platform(),
        "python": platform.python_version(),
    }
    return "\n".join(f"{key}: {value}" for key, value in facts.items() if value)


def _format_status(d: dict) -> str:
    """Human/agent-readable rendering of /topics/{id}/status (盲飞防护): the
    turn's state, every accept card with its gate tail, and the platform
    waterlines — the questions agents used to hand-poll the API for.

    A running turn is shown as 正常运行中 or 接近硬顶, never as a live countdown
    of seconds. A literal "还剩 Ns" figure was observed making the agent rush
    against what's only ever meant to be a wedged-turn safety net."""
    lines: list[str] = []
    topic = d.get("topic") or {}
    head = f"话题: {topic.get('title', '?')}（{topic.get('status', '?')}"
    if topic.get("branch"):
        head += f", 分支 {topic['branch']}"
    lines.append(head + "）")
    turn = d.get("turn")
    if turn:
        t = f"本轮: {turn.get('status')}"
        if turn.get("status") == "running":
            if turn.get("near_ceiling"):
                t += "，接近硬顶（即将触发兜底结束）"
            else:
                t += "，正常运行中"
        elif turn.get("duration_s") is not None:
            t += f"，用时 {turn['duration_s']}s"
        if turn.get("detail"):
            t += f"（{turn['detail']}）"
        lines.append(t)
    cards = d.get("cards") or []
    lines.append(f"验收卡: {len(cards)} 张" if cards else "验收卡: 无")
    for c in cards:
        row = f"- [{c.get('status')}] 递给 @{c.get('reviewer')}"
        if c.get("decided_by"):
            row += f"，{c['decided_by']} 处理于 {c.get('decided_at')}"
        if c.get("note"):
            row += f"；note: {c['note']}"
        lines.append(row)
        if c.get("pr_url"):
            lines.append(f"  PR: #{c.get('pr_number')} {c['pr_url']}")
            # The repo name is already sitting in the PR url — spell the CI
            # lookup out rather than leaving "用 gh 查" as an exercise.
            m = re.match(r"https://github\.com/([^/]+/[^/]+)/pull/", c["pr_url"])
            if m:
                lines.append(
                    f"  查 CI: export GH_TOKEN=$(cheese gh-token); "
                    f"gh api repos/{m.group(1)}/commits/<head_sha>/check-runs"
                )
        if c.get("status") == "gate_failed" and c.get("gate_output_tail"):
            lines.append("  闸门输出（尾部）:")
            lines.extend("    " + ln for ln in c["gate_output_tail"].splitlines()[-15:])
    bg = d.get("background") or {}
    for t in bg.get("tasks") or []:
        lines.append(
            f"后台任务: 「{t.get('label')}」已跑 {t.get('running_s')}s"
            f"（上限 {t.get('timeout_s')}s）；输出: {t.get('log_path')}"
        )
    plat = d.get("platform") or {}
    disk = plat.get("disk")
    if disk:
        lines.append(
            f"磁盘: 可用 {disk.get('free_gb')}G / {disk.get('total_gb')}G"
            f"（已用 {disk.get('used_pct')}%）"
        )
    credits = plat.get("credits") or {}
    cred = "不限" if credits.get("unlimited") else f"剩 {credits.get('remaining')}"
    lines.append(
        f"并发: 全站运行中 {plat.get('active_turns', '?')} 轮，"
        f"本项目排队 {plat.get('queued_turns', 0)}；额度: {cred}"
    )
    return "\n".join(lines)


def _print_api_index() -> None:
    """List available operations from our FastAPI /openapi.json (like Restish,
    but built from OUR live spec). Lets `cheese api` self-describe what raw calls
    are possible without hardcoding anything."""
    url = f"{_api_root()}/openapi.json"
    try:
        with urllib.request.urlopen(url, timeout=20) as r:
            spec = json.load(r)
    except Exception as e:  # noqa: BLE001
        print(f"[cheese] 拉取 openapi 失败: {e}", file=sys.stderr)
        sys.exit(1)
    print("可用的原始 API 操作（优先用 curated 命令，这些是兜底逃生口）：")
    for path in sorted(spec.get("paths", {})):
        methods = spec["paths"][path]
        for method in sorted(methods):
            if method.lower() in ("get", "post", "put", "delete", "patch"):
                print(f"  {method.upper():6} {path}")
    print("\n用法: cheese api <METHOD> <path> [--data '<json>']")
    print("例:   cheese api GET /topics/$CHEESE_TOPIC/blocks")


def source_fingerprint() -> str:
    """A short digest of THIS file's bytes.

    The box's `cheese` is bind-mounted from the backend's own copy, so the only
    way to tell — from inside a box — whether that plumbing actually worked is
    to compare what runs here against what the backend shipped. `cheese
    --version` prints this; a mismatch means the mount is stale."""
    try:
        with open(__file__, "rb") as f:
            return hashlib.sha256(f.read()).hexdigest()[:12]
    except OSError:
        return "unknown"


def _chat_message_text(block: dict) -> str:
    """Keep typed payloads visible, including fields added by future messages."""
    lines = [
        f"[{block.get('created_at', '')}] {block.get('author', '')} "
        f"({block.get('author_type', '')}, {block.get('kind', '')}) id={block['id']}"
    ]
    for key, value in block.items():
        if key in {"id", "created_at", "author", "author_type", "kind", "content"}:
            continue
        if value is not None and value != [] and value != {}:
            lines.append(
                f"{key}: {json.dumps(value, ensure_ascii=False, sort_keys=True)}"
            )
    lines.append(block.get("content") or "")
    return "\n".join(lines)


_CHAT_TEXT_BUDGET = 12000
_CHAT_PREVIEW = 1500


def _chat_call(name: str, **kwargs) -> str:
    """A continuation the agent can act on. It reaches these commands as the
    `cheese_chat_*` tools (cli_worker publishes every leaf of this parser), so
    the hint is written as that tool call, not as a shell line."""
    args = ", ".join(
        f"{k}={json.dumps(v, ensure_ascii=False)}" for k, v in kwargs.items()
    )
    return f"{name}({args})"


def _chat_scope(a) -> dict:
    scope = {}
    if a.topic:
        scope["topic"] = a.topic
    if getattr(a, "task", None):
        scope["task"] = a.task
    return scope


def _chat_read(a, parser) -> None:
    topic = a.topic or _need("CHEESE_TOPIC", TOPIC)
    base = f"/topics/{urllib.parse.quote(topic, safe='')}/history"
    if a.chatcmd == "get":
        if not 1 <= a.length <= _CHAT_TEXT_BUDGET or a.offset < 0:
            parser.error(
                f"chat get: length must be 1..{_CHAT_TEXT_BUDGET}, offset >= 0"
            )
        if a.json and (a.offset or a.length != _CHAT_TEXT_BUDGET):
            parser.error("--json returns complete data; omit --offset and --length")
        block = _call("GET", base + "/" + urllib.parse.quote(a.message_id, safe=""))[
            "data"
        ]
        if a.task is not None and block.get("task_id") != a.task:
            parser.error("Message does not belong to --task")
        if a.json:
            print(json.dumps(block, ensure_ascii=False))
            return
        text = _chat_message_text(block)
        end = a.offset + a.length
        print(text[a.offset : end])
        if end < len(text):
            more = _chat_call(
                "cheese_chat_get", message_id=a.message_id, offset=end, **_chat_scope(a)
            )
            print(f"\n[More text: {more}]")
        return

    if not 1 <= a.limit <= 500:
        parser.error("chat: limit must be 1..500")
    params = {"limit": a.limit}
    for key, val in (
        ("before", a.before),
        ("after", a.after),
        ("task_id", a.task),
        ("kind", a.kind),
        ("author", a.author),
    ):
        if val is not None:
            params[key] = val
    tool = f"cheese_chat_{a.chatcmd}"
    own: dict = {}
    if a.chatcmd == "search":
        params["q"] = a.query
        own["query"] = a.query
    elif a.chatcmd == "replies":
        params["reply_to"] = a.message_id
        own["message_id"] = a.message_id
    data = _call("GET", base + "?" + urllib.parse.urlencode(params))["data"]
    if a.json:
        print(json.dumps(data, ensure_ascii=False))
        return

    def preview(block):
        text = _chat_message_text(block)
        if len(text) > _CHAT_PREVIEW:
            text = (
                text[:_CHAT_PREVIEW]
                + "\n[Truncated; "
                + _chat_call(
                    "cheese_chat_get", message_id=block["id"], **_chat_scope(a)
                )
                + "]"
            )
        return text

    remaining = _CHAT_TEXT_BUDGET
    if parent := data.get("reply_to"):
        parent_text = "Replying to:\n" + preview(parent) + "\n"
        print(parent_text)
        remaining -= len(parent_text) + 1
    blocks = data.get("data") or []
    if not blocks:
        print("No messages matched this conversation and filter.")
        return
    # Walk from the requested edge. The next cursor must refer to the last
    # displayed block, including when the text budget cuts a server page short.
    selected = []
    for block in blocks if a.after else reversed(blocks):
        text = preview(block)
        if selected and len(text) + 2 > remaining:
            break
        selected.append((block, text))
        remaining -= len(text) + 2
    if not a.after:
        selected.reverse()
    print("\n\n".join(text for _, text in selected))
    if data.get("has_more") or len(selected) < len(blocks):
        cursor = selected[-1 if a.after else 0][0]["id"]
        filters = {k: v for k, v in (("kind", a.kind), ("author", a.author)) if v}
        more = _chat_call(
            tool,
            **own,
            **_chat_scope(a),
            **filters,
            limit=a.limit,
            **({"after": cursor} if a.after else {"before": cursor}),
        )
        print(f"\n[More messages: {more}]")


