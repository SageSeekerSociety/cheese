#: 要本话题 / 本项目才答得出的那些。缺了就在发出去之前说清楚，不让后端去猜。
#: 文档检索不在其中：个人芝士没有话题，只读谁都能读的那些页。
_NEEDS_TOPIC = frozenset(PLATFORM_TOOLS.names()) - {
    "cheese_fetch",
    "platform_request",
    "cheese_docs_search",
    "cheese_docs_read",
    # 文档自己有编号（CHEESE_DOCUMENT）；只有话题时，从话题查出它的文档。
    "cheese_doc_get",
    "cheese_doc_set",
    "cheese_doc_edit",
} | {"cheese_attachment_read"}
_NEEDS_DOCUMENT = frozenset({"cheese_doc_get", "cheese_doc_edit"})
_NEEDS_PROJECT = frozenset(
    {
        "cheese_project_search",
        "cheese_memory_read",
        "cheese_notify",
        "cheese_library_ls",
        "cheese_routine_list",
    }
)


def _given(args: dict, *keys: str) -> dict:
    """The optional fields the caller actually filled, under the backend's names.

    「没说」和「说了空的」在后端是两件事（例如省略验收人 = 用项目默认值），所以
    空值不发。"""
    body = {}
    for key in keys:
        name, _, field = key.partition(":")
        if args.get(name) not in (None, "", []):
            body[field or name] = args[name]
    return body


def _ask_body(args: dict) -> dict:
    """Validate the entire group before publishing its one HTTP request."""
    questions = args.get("questions")
    if not isinstance(questions, list) or not 1 <= len(questions) <= 8:
        raise ValueError("ask requires 1-8 questions")
    for question in questions:
        if not isinstance(question, dict):
            raise ValueError("each question must be an object")
        text = question.get("question")
        if not isinstance(text, str) or not text.strip():
            raise ValueError("each question requires nonempty question text")
        options = question.get("options")
        if not isinstance(options, list) or not 2 <= len(options) <= 3:
            raise ValueError("each question requires 2-3 object options")
        for option in options:
            if not isinstance(option, dict):
                raise ValueError("each option must be a {text, explain?} object")
            text = option.get("text")
            if not isinstance(text, str) or not text.strip():
                raise ValueError("each option requires nonempty text")
            if "explain" in option and not isinstance(option["explain"], str):
                raise ValueError("option explain must be a string")
        for flag in ("allow_other", "reject_option"):
            if flag in question and not isinstance(question[flag], bool):
                raise ValueError(f"{flag} must be a boolean")
    if "ask_group" in args:
        group = args["ask_group"]
        if not isinstance(group, str) or not group.strip():
            raise ValueError("ask_group must be a nonempty string when provided")
    # Identity is supplied by the host credential, never an author in args.
    return {"questions": questions, **_given(args, "ask_group")}


def routine_spec_checked(
    *, trigger: str | None = None, spec: dict | None = None, timezone: str | None = None
) -> None:
    """拒在发出之前。

    这几样后端也会拒（`routine/schedule.py` 的 `normalize`，话是同一套），但那时
    agent 已经等了一个来回、还是不知道自己错在哪。这里只做**不用问平台就知道**的
    那部分：取值在不在枚举里、定时有没有说清什么时候跑（freq、HH:MM、星期几和几号）、
    事件触发的 scope 认不认识。

    时区是唯一一处「本机判不了」的：会话容器里可能没装 tzdata，那时每一个名字都
    查不到——查不到就是不知道，不知道就不该拒，交给后端。
    """
    if trigger is not None and trigger not in ROUTINE_TRIGGERS:
        raise ValueError("trigger 只能是 " + "、".join(ROUTINE_TRIGGERS) + " 之一")
    if timezone and not _zone_is_known(timezone):
        raise ValueError(f"不认识的时区：{timezone}")
    if spec is None:
        return
    if not isinstance(spec, dict):
        raise ValueError("spec 是一个对象，不是一个字符串")
    event = trigger is not None and trigger != "schedule"
    if "freq" not in spec:
        if event or trigger is None:
            # 事件触发（或改规则时没说触发方式）：spec 只说从哪儿算起。
            if spec.get("scope") not in (None, "room", "project"):
                raise ValueError("事件的 scope 只有 room 和 project 两个值")
            return
        # 起草时的默认触发方式就是定时：不说清什么时候跑，后端也只会拒。
        raise ValueError(
            "定时规则要写 freq（hourly、daily、weekly、monthly），"
            '例如 {"freq": "weekly", "weekdays": [0], "time": "09:00"}'
        )
    if event:
        raise ValueError(f"{trigger} 触发不用给 freq，spec 只写 scope")
    freq = spec["freq"]
    if freq not in ROUTINE_FREQS:
        raise ValueError("频率只能是 hourly、daily、weekly、monthly 之一")
    if freq == "hourly":
        if not _is_int(spec.get("minute"), 0, 59):
            raise ValueError("每小时执行要给出第几分钟（0–59）")
        return
    raw = str(spec.get("time") or "")
    try:
        # 24 小时制、当天以内的那一刻：`time()` 自己会拒 25:00 这种。
        hour, minute = (int(part) for part in raw.split(":"))
        time(hour, minute)
    except (ValueError, TypeError) as exc:
        raise ValueError("执行时间要写成 HH:MM，例如 09:00") from exc
    if freq == "weekly":
        days = spec.get("weekdays")
        if (
            not isinstance(days, list)
            or not days
            or any(not _is_int(day, 0, 6) for day in days)
        ):
            raise ValueError("每周执行要给出星期几（0=周一 … 6=周日）")
    if freq == "monthly" and not _is_int(spec.get("day"), 1, 31):
        raise ValueError("每月执行要给出几号（1–31）")


def _is_int(value, low: int, high: int) -> bool:
    # bool 是 int 的子类：`True` 当第 1 分钟收下就成了另一种意思。
    return (
        isinstance(value, int) and not isinstance(value, bool) and low <= value <= high
    )


def _zone_is_known(name: str) -> bool:
    """这个名字是个时区吗——**判不出来时算它是**。

    会话容器里可能没装 tzdata，那时每个名字都查不到，而「查不到」是这台机器不知
    道，不是这个名字错了。这样的名字交给后端判；后端那台有 tzdata。
    """
    try:
        ZoneInfo(name)
    except ZoneInfoNotFoundError:
        return not _has_tz_database()
    except ValueError:
        return False
    return True


def _has_tz_database() -> bool:
    """这台机器上有 tzdata 吗——没有的话「查不到」说明不了任何事。"""
    try:
        ZoneInfo("UTC")
    except Exception:  # noqa: BLE001 — 判不出来就是判不出来
        return False
    return True


def request_plan(tool: str, args: dict, environ: dict | None = None) -> dict:
    """The one backend request a platform tool is, as data.

    Pure: nothing here reads the machine or the network, so a plan can be built
    and checked with no session around it. Tools that take more than one request
    (`_STEPS`) build theirs from the same pieces."""
    env = os.environ if environ is None else environ
    topic = env.get("CHEESE_TOPIC", "")
    project = env.get("CHEESE_PROJECT", "")
    document = env.get("CHEESE_DOCUMENT", "")
    if tool in _NEEDS_DOCUMENT and not document:
        raise ValueError("Missing CHEESE_DOCUMENT")
    if tool in _NEEDS_TOPIC and not topic:
        raise ValueError("Missing CHEESE_TOPIC")
    if tool in _NEEDS_PROJECT and not project:
        raise ValueError("Missing CHEESE_PROJECT")
    task = f"/topics/{topic}/tasks/{args.get('task')}"
    if tool == "platform_request":
        method = (args.get("method") or "GET").upper()
        path = args.get("path") or ""
        parsed = urllib.parse.urlsplit(path)
        # The room's credential goes wherever this points, so it may only point
        # at the platform: a path under the API root, never another host.
        if (
            method not in _HTTP_METHODS
            or not path.startswith("/")
            or parsed.scheme
            or parsed.netloc
            or parsed.fragment
        ):
            raise ValueError(
                "platform_request needs an HTTP method and a relative API path, "
                "such as /topics/<room id>/members"
            )
        plan = {"method": method, "path": path}
        if args.get("body") is not None:
            plan["body"] = args["body"]
        return plan
    if tool == "chat_send":
        body = {
            "content": args["content"],
            "request_id": str(uuid.UUID(args["request_id"]))
            if args.get("request_id")
            else str(uuid.uuid4()),
            **_given(args, "reply_to"),
        }
        return {"method": "POST", "path": f"/topics/{topic}/messages", "body": body}
    if tool == "chat_edit":
        return {
            "method": "PATCH",
            "path": "/blocks/" + urllib.parse.quote(args["message_id"], safe=""),
            "body": {"content": args["content"]},
        }
    if tool == "todo_write":
        return {
            "method": "PUT",
            "path": f"/topics/{topic}/progress",
            "body": {
                "todos": args["todos"],
                **({"new": True} if args.get("new") is True else {}),
                **_given(args, "task", "result"),
            },
        }
    if tool == "cheese_doc_get":
        return {"method": "GET", "path": f"/documents/{document}"}
    if tool == "cheese_doc_edit":
        return {
            "method": "POST",
            "path": f"/documents/{document}/edits",
            "body": {
                "edits": [
                    {"old": str(e["old"]), "new": str(e.get("new") or "")}
                    for e in args["edits"]
                ],
                **({"mode": "suggest"} if args.get("suggest") is True else {}),
                **_given(args, "reason"),
            },
        }
    if tool == "cheese_task":
        return {
            "method": "POST",
            "path": f"/topics/{topic}/split",
            "body": {
                "title": args["title"],
                **_given(
                    args,
                    "brief",
                    "reviewer:reviewer_handle",
                    "base_task:base_task_id",
                    "reported_by:reporter_handle",
                    "contributor:contributor_handles",
                ),
            },
        }
    if tool == "cheese_close_task":
        return {
            "method": "POST",
            "path": task + "/close",
            "body": {
                "conclusion": args.get("conclusion") or "",
                **_given(
                    args,
                    "reported_by:reporter_handle",
                    "contributor:contributor_handles",
                ),
            },
        }
    if tool == "cheese_accept_request":
        return {
            "method": "POST",
            "path": task + "/accept-card",
            "body": {
                "routing_reason": args.get("reason") or "",
                "change_subject": args["subject"],
                **_given(
                    args,
                    "reviewer:reviewer_handle",
                    "body:change_body",
                    "artifact",
                    "new_artifact",
                    "about",
                    "deliver",
                    "deliver_url",
                ),
            },
        }
    if tool == "cheese_describe":
        body = _given(args, "subject:change_subject", "body:change_body")
        if not body:
            raise ValueError("describe 至少要给 subject 或 body")
        return {"method": "POST", "path": task + "/accept-card/describe", "body": body}
    if tool == "cheese_ready":
        return {"method": "POST", "path": task + "/ready"}
    if tool in {"cheese_lock", "cheese_unlock"}:
        verb = tool.removeprefix("cheese_")
        return {
            "method": "POST",
            "path": f"/topics/{topic}/{verb}",
            "body": {"kind": args.get("kind") or "heavy", "task_id": args["task"]},
        }
    if tool == "cheese_library_ls":
        # 带上话题：沙箱 token 是为一轮、一个地方铸的，后端要凭它确认这个凭据属于谁。
        where = urllib.parse.quote(topic)
        return {"method": "GET", "path": f"/projects/{project}/library?topic={where}"}
    if tool == "cheese_title":
        path = (
            f"/topics/{topic}/tasks/{args['task']}/title"
            if args.get("task")
            else f"/topics/{topic}/title"
        )
        return {"method": "POST", "path": path, "body": {"title": args["text"]}}
    if tool == "cheese_docs_search":
        return {
            "method": "POST",
            "path": "/docs/agent/search",
            "body": {"query": args["query"], **({"topic": topic} if topic else {})},
        }
    if tool == "cheese_docs_read":
        return {
            "method": "POST",
            "path": "/docs/agent/read",
            "body": {"page": args["page"], **({"topic": topic} if topic else {})},
        }
    if tool == "cheese_project_search":
        query = urllib.parse.urlencode({"q": args["query"], "limit": 8})
        return {"method": "GET", "path": f"/projects/{project}/context/search?{query}"}
    if tool == "cheese_memory_read":
        query = urllib.parse.urlencode({"project_id": project, "scope": "team"})
        return {"method": "GET", "path": f"/memory/files?{query}"}
    if tool == "cheese_attachment_read":
        query = urllib.parse.urlencode({"path": args["path"].strip()})
        return {"method": "GET", "path": f"/topics/{topic}/preview/file?{query}"}
    if tool == "cheese_my_tasks":
        return {"method": "GET", "path": "/tasks/joined"}
    if tool == "cheese_fetch":
        # 带上话题：不带的话每一次调用都会被判成 "Agent credential is invalid or
        # expired"——沙箱 token 是带作用域的。
        body = {"url": args["url"], "topic": topic, "project": project}
        if args.get("prompt"):
            body["prompt"] = args["prompt"]
        return {"method": "POST", "path": "/fetch", "body": body}
    if tool == "cheese_ask":
        return {
            "method": "POST",
            "path": f"/topics/{topic}/asks",
            "body": _ask_body(args),
        }
    if tool == "cheese_notify":
        options = [
            value.strip() for value in args.get("options") or [] if value.strip()
        ]
        return {
            "method": "POST",
            "path": f"/projects/{project}/alerts",
            "body": {
                "level": args.get("level") or "light",
                "kind": args.get("kind") or "change_alert",
                "title": args["title"],
                "body": args.get("body") or "",
                "target_handle": args.get("to") or None,
                "topic_id": topic or None,
                "payload": {"options": options} if options else {},
            },
        }
    if tool == "cheese_feedback_propose":
        # 话题级:配额、指纹去重、拒绝的记忆全挂在话题上,而「这个人能不能在这个
        # 话题里提」的答案就是 authorize_topic 已经算过的那个。
        body = {
            "title": args["title"],
            "kind": args["kind"],
            "visibility": args["visibility"],
            **_given(
                args,
                "why",
                "what_happened",
                "expectation",
                "repro",
                "evidence",
                "summary",
                "problem",
                "session_id",
                "environment",
                "user_said",
            ),
        }
        if args.get("tags"):
            body["tags"] = [
                value.strip() for value in args["tags"].split(",") if value.strip()
            ]
        return {
            "method": "POST",
            "path": f"/topics/{topic}/feedback-proposals",
            "body": body,
        }
    # 反馈不属于房间（`/feedback` 下面），但读的、领的人是你：你的凭据只在这个房间
    # 里认得出你，所以带上房间，后端在房间里认人，再拿房间的项目判你是不是在做这个
    # 平台本身。
    if tool == "cheese_feedback_list":
        params = {
            "topic": topic,
            **_given(
                args,
                "query:q",
                "tab",
                "status",
                "kind",
                "author",
                "since",
                "offset:page_start",
            ),
        }
        return {"method": "GET", "path": "/feedback?" + urllib.parse.urlencode(params)}
    if tool == "cheese_feedback_get":
        ref = urllib.parse.quote(str(args["feedback"]).strip(), safe="")
        return {"method": "GET", "path": f"/feedback/{ref}?topic={topic}"}
    if tool in ("cheese_feedback_claim", "cheese_feedback_release"):
        ref = urllib.parse.quote(str(args["feedback"]).strip(), safe="")
        return {
            "method": "POST" if tool == "cheese_feedback_claim" else "DELETE",
            "path": f"/feedback/{ref}/claim?topic={topic}",
        }
    if tool == "cheese_machine":
        body = {"profile": args["profile"], **_given(args, "device_id")}
        return {
            "method": "PUT",
            "path": f"/topics/{topic}/compute-profile",
            "body": body,
        }
    if tool == "cheese_note":
        # 收件人是**那条线程**，不是一个 handle：同 handle 是守卫（I14②），由后端
        # 拿两条线程的席位比对出来，不由调用方声明。
        return {
            "method": "POST",
            "path": f"/topics/{topic}/note",
            "body": {"thread": args["thread"], "content": args["content"]},
        }
    if tool == "cheese_deliver_at":
        return {
            "method": "POST",
            "path": f"/topics/{topic}/deliveries",
            "body": {"at": args["at"], "content": args["content"]},
        }
    if tool == "cheese_routine_draft":
        body = {
            "title": args["title"],
            "instructions": args["instructions"],
            "trigger": args.get("trigger") or "schedule",
            "spec": args.get("spec") or {},
            "timezone": args.get("timezone") or "Asia/Shanghai",
            **_given(
                args,
                "context_scope",
                "output_dir",
                "owner_handle",
                "agent_handle",
            ),
        }
        routine_spec_checked(
            trigger=body["trigger"], spec=body["spec"], timezone=body["timezone"]
        )
        return {"method": "POST", "path": f"/topics/{topic}/routines", "body": body}
    if tool == "cheese_routine_list":
        # 带上话题：沙箱 token 是为一轮、一个地方铸的，后端要凭它确认这个凭据属于谁。
        where = urllib.parse.quote(topic)
        return {
            "method": "GET",
            "path": f"/projects/{project}/routines?topic={where}",
        }
    if tool == "cheese_routine_update":
        body = _given(
            args,
            "title",
            "instructions",
            "context_scope",
            "output_dir",
            "trigger",
            "spec",
            "timezone",
            "agent_handle",
        )
        if not body:
            raise ValueError("没有要改的字段：至少给一项")
        routine_spec_checked(
            trigger=body.get("trigger"),
            spec=body.get("spec"),
            timezone=body.get("timezone"),
        )
        return {
            "method": "PATCH",
            "path": "/routines/" + urllib.parse.quote(args["routine"], safe=""),
            "body": body,
        }
    if tool == "cheese_routine_pause":
        return {
            "method": "POST",
            "path": f"/routines/{urllib.parse.quote(args['routine'], safe='')}/pause",
        }
    if tool == "cheese_routine_report":
        return {
            "method": "POST",
            "path": f"/routine-runs/{urllib.parse.quote(args['run'], safe='')}/report",
            "body": {
                "status": args["status"],
                "summary": args.get("summary") or "",
                "outputs": args.get("outputs") or [],
            },
        }
    if tool == "cheese_skill_draft":
        body = {
            "name": args["name"],
            "title": args["title"],
            "description": args["description"],
            "body": args["body"],
            "taught": args.get("taught") or [],
            "accepted": args.get("accepted") or "",
            **_given(args, "files", "related", "absorbs"),
        }
        return {"method": "POST", "path": f"/topics/{topic}/skills", "body": body}
    if tool == "cheese_skill_update":
        where = urllib.parse.quote(topic)
        skill = urllib.parse.quote(args["skill"], safe="")
        body = {
            "reason": args["reason"],
            **_given(args, "title", "description", "body", "files"),
        }
        return {
            "method": "PATCH",
            "path": f"/skills/{skill}?topic={where}",
            "body": body,
        }
    if tool == "cheese_members":
        return {"method": "GET", "path": f"/topics/{topic}/members"}
    if tool == "cheese_status":
        return {"method": "GET", "path": f"/topics/{topic}/status"}
    raise ValueError(f"No direct platform request plan for {tool}")


class PlatformToolError(Exception):
    """A refusal the agent reads as written: what happened and what to do next."""


class PlatformHTTPError(RuntimeError):
    """The backend answered, and not with success. `status` is what callers branch
    on; the message keeps the backend's own words for the agent."""

    def __init__(self, status: int, body: str):
        super().__init__(f"Platform HTTP {status}: {body}")
        self.status = status
        self.body = body


def run_platform_tool(tool: str, args: dict, host) -> str:
    """Run one tool from `PLATFORM_TOOLS` or `DELEGATED_TOOLS` and say, in
    text, what came of it.

    `host` is where the session runs, and supplies the four things a tool can
    need: `environ` (the room's CHEESE_* values), `request(plan)` (one backend
    request, the parsed JSON back, `PlatformHTTPError` otherwise),
    `read_file(path)` and `sync_task(task_id)` (the two that need the machine),
    plus a `doc_versions` dict that outlives a single call. The text is what the
    agent acts on — ids, the next call to make — so it is written for that
    reader, not dumped JSON."""
    table = next(
        (t for t in (PLATFORM_TOOLS, DELEGATED_TOOLS) if tool in t), None
    )
    if table is None:
        raise ValueError(f"Unknown platform tool: {tool}")
    # 拒在发出任何请求、碰任何机器之前：一张已经递出去的卡收不回来。
    schema = next(t for t in table.schemas() if t["name"] == tool)
    missing = [
        name
        for name in schema["inputSchema"].get("required", ())
        if args.get(name) in (None, "", [])
    ]
    if missing:
        raise PlatformToolError(f"{tool} 缺少参数：{', '.join(missing)}")
    try:
        if tool in _STEPS:
            return _STEPS[tool](args, host)
        plan = request_plan(tool, args, host.environ)
    except ValueError as exc:
        raise PlatformToolError(str(exc)) from exc
    data = host.request(plan).get("data")
    return _SAY[tool](args, data, host.environ)


def _chat_message_text(block: dict) -> str:
    """Keep typed payloads visible, including fields added by future messages."""
    lines = [
        f"[{block.get('created_at', '')}] {block.get('author', '')} "
        f"({block.get('author_type', '')}, {block.get('kind', '')}) id={block['id']}"
    ]
    for key, value in block.items():
        if key in {"id", "created_at", "author", "author_type", "kind", "content"}:
            continue
        if value is not None and value != [] and value != {}:
            lines.append(
                f"{key}: {json.dumps(value, ensure_ascii=False, sort_keys=True)}"
            )
    lines.append(block.get("content") or "")
    return "\n".join(lines)


_CHAT_TEXT_BUDGET = 12000
_CHAT_PREVIEW = 1500


def _chat_call(name: str, **kwargs) -> str:
    """A continuation the agent can act on, written as the tool call it is."""
    args = ", ".join(
        f"{k}={json.dumps(v, ensure_ascii=False)}" for k, v in kwargs.items()
    )
    return f"{name}({args})"


def _chat_scope(args: dict) -> dict:
    return {key: args[key] for key in ("topic", "task") if args.get(key)}


def _chat_get(args: dict, host) -> str:
    offset = 0 if args.get("offset") is None else args["offset"]
    length = _CHAT_TEXT_BUDGET if args.get("length") is None else args["length"]
    if not 1 <= length <= _CHAT_TEXT_BUDGET or offset < 0:
        raise PlatformToolError(f"length 取 1..{_CHAT_TEXT_BUDGET}，offset 不小于 0")
    topic = args.get("topic") or host.environ.get("CHEESE_TOPIC", "")
    path = (
        f"/topics/{urllib.parse.quote(topic, safe='')}/history/"
        + urllib.parse.quote(args["message_id"], safe="")
    )
    block = host.request({"method": "GET", "path": path})["data"]
    if args.get("task") and block.get("task_id") != args["task"]:
        raise PlatformToolError("这条消息不属于那条任务卡")
    text = _chat_message_text(block)
    end = offset + length
    shown = text[offset:end]
    if end < len(text):
        more = _chat_call(
            "cheese_chat_get",
            message_id=args["message_id"],
            offset=end,
            **_chat_scope(args),
        )
        shown += f"\n\n[More text: {more}]"
    return shown


def _chat_page(tool: str):
    def run(args: dict, host) -> str:
        limit = 50 if args.get("limit") is None else args["limit"]
        if not 1 <= limit <= 500:
            raise PlatformToolError("limit 取 1..500")
        if args.get("before") and args.get("after"):
            raise PlatformToolError("before 和 after 只能给一个")
        topic = args.get("topic") or host.environ.get("CHEESE_TOPIC", "")
        params: dict = {"limit": limit}
        for key, name in (
            ("before", "before"),
            ("after", "after"),
            ("task", "task_id"),
            ("kind", "kind"),
            ("author", "author"),
        ):
            if args.get(key):
                params[name] = args[key]
        own: dict = {}
        if tool == "cheese_chat_search":
            params["q"] = own["query"] = args["query"]
        elif tool == "cheese_chat_replies":
            params["reply_to"] = own["message_id"] = args["message_id"]
        path = (
            f"/topics/{urllib.parse.quote(topic, safe='')}/history?"
            + urllib.parse.urlencode(params)
        )
        data = host.request({"method": "GET", "path": path})["data"]

        def preview(block):
            text = _chat_message_text(block)
            if len(text) > _CHAT_PREVIEW:
                more = _chat_call(
                    "cheese_chat_get", message_id=block["id"], **_chat_scope(args)
                )
                text = text[:_CHAT_PREVIEW] + f"\n[Truncated; {more}]"
            return text

        out = []
        remaining = _CHAT_TEXT_BUDGET
        if parent := data.get("reply_to"):
            parent_text = "Replying to:\n" + preview(parent) + "\n"
            out.append(parent_text)
            remaining -= len(parent_text) + 1
        blocks = data.get("data") or []
        if not blocks:
            out.append("No messages matched this conversation and filter.")
            return "\n".join(out)
        # Walk from the requested edge. The next cursor must refer to the last
        # displayed block, including when the text budget cuts a server page short.
        forward = bool(args.get("after"))
        selected = []
        for block in blocks if forward else reversed(blocks):
            text = preview(block)
            if selected and len(text) + 2 > remaining:
                break
            selected.append((block, text))
            remaining -= len(text) + 2
        if not forward:
            selected.reverse()
        out.append("\n\n".join(text for _, text in selected))
        if data.get("has_more") or len(selected) < len(blocks):
            cursor = selected[-1 if forward else 0][0]["id"]
            filters = {k: args[k] for k in ("kind", "author") if args.get(k)}
            more = _chat_call(
                tool,
                **own,
                **_chat_scope(args),
                **filters,
                limit=limit,
                **({"after": cursor} if forward else {"before": cursor}),
            )
            out.append(f"\n[More messages: {more}]")
        return "\n".join(out)

    return run


def _doc_get(args: dict, host) -> str:
    """Reading is what earns the right to write.

    The living doc has no partial write: `cheese_doc_set` replaces the whole
    thing, so a write has to say which version it replaces, and that number must
    be EVIDENCE OF A READ rather than something the caller states. An argument
    would let the agent assert a version it only heard about — the platform
    pushes 「文档已更新到第 7 版」 into a running session — and write ten-minute-old
    content over it claiming to be based on it, which is the exact overwrite the
    version exists to stop. So the version this read returned is kept by the
    host, and the write reads it back from there."""
    document = _document(host)
    plan = request_plan("cheese_doc_get", args, {**host.environ, **document})
    doc = host.request(plan).get("data") or {}
    version = doc.get("doc_version", 0)
    host.doc_versions[document["CHEESE_DOCUMENT"]] = version
    if not doc.get("content"):
        return "这份文档还是空的；cheese_doc_set 会写下第一版。"
    pending = doc.get("pending_suggestions") or []
    if not pending:
        return doc["content"]
    # 建议还不是正文：上面读到的是没有它们的文本。列出来，免得再提一遍。
    head = f"--- 待处理的修改建议（{len(pending)} 处，不在正文里）"
    lines = [doc["content"], "", head]
    for item in pending:
        why = f"（{item['reason']}）" if item.get("reason") else ""
        lines.append(
            f"- {item.get('author') or '?'}：「{item.get('old') or ''}」→"
            f"「{item.get('new') or ''}」{why}"
        )
    return "\n".join(lines)


def _document(host) -> dict:
    """本次要读写的文档：会话本来就是对着某份文档开的（CHEESE_DOCUMENT），
    或者是话题里的会话，用话题的实况文档。"""
    document = host.environ.get("CHEESE_DOCUMENT", "")
    if document:
        return {"CHEESE_DOCUMENT": document}
    topic = host.environ.get("CHEESE_TOPIC", "")
    if not topic:
        raise PlatformToolError("Missing CHEESE_DOCUMENT or CHEESE_TOPIC")
    found = host.request({"method": "GET", "path": f"/topics/{topic}/document"})
    return {"CHEESE_DOCUMENT": (found.get("data") or {})["id"]}


def _doc_edit(args: dict, host) -> str:
    plan = request_plan("cheese_doc_edit", args, {**host.environ, **_document(host)})
    try:
        answer = host.request(plan)
    except Exception as exc:
        status = getattr(exc, "status", None)
        if status not in (409, 422):
            raise
        try:
            why = json.loads(exc.body)["error"]["message"]  # type: ignore[attr-defined]
        except (ValueError, KeyError, TypeError):
            raise exc from None
        raise PlatformToolError(
            f"一处都没改，文档没有变：{why.rstrip('。')}。"
            "先 cheese_doc_get 重读，照读到的原文改好再试。"
        ) from exc
    data = answer.get("data") or {}
    edits = data.get("edits") or []
    if data.get("mode") == "suggest":
        return f"已提出 {len(edits)} 处修改建议，等人接受或拒绝；正文还没有变。"
    who = data.get("requested_by")
    done = f"已改了 {len(edits)} 处"
    if who:
        done = f"已按 {who} 的要求改了 {len(edits)} 处"
    version = data.get("doc_version")
    lines = [f"{done}（第 {version} 版）。" if version else f"{done}。"]
    # 和 cheese_doc_set 一样：格式警告跟着这次写入回来，改的机会就是现在。
    lines += [f"⚠️ {warning}" for warning in answer.get("warnings") or []]
    return "\n".join(lines)


def _doc_set(args: dict, host) -> str:
    document = _document(host)["CHEESE_DOCUMENT"]
    raw = host.read_file(args["path"])
    try:
        content = raw.decode("utf-8")
    except UnicodeError as exc:
        raise PlatformToolError(f"{args['path']} 不是 UTF-8 文本: {exc}") from exc
    # 0 —— 「我没读过」—— 是没有读过时的值，也是唯一允许**新建**文档的版本：
    # 没读过一份已经存在的文档，正是写入必须被拒的时候。
    based_on = host.doc_versions.get(document, 0)
    try:
        result = host.request(
            {
                "method": "PUT",
                "path": f"/documents/{document}",
                "body": {
                    "content": content,
                    "expected_version": based_on,
                },
            }
        )
    except Exception as exc:
        # Any host's HTTP error carries `status`/`body` (this file's
        # `PlatformHTTPError`, or the transport's, which this file cannot import).
        status = getattr(exc, "status", None)
        if status == 422:
            # The document is blocks and this file is Markdown: a write that
            # would lose text on the way in is refused, and the platform says
            # which line and what to write instead. Nothing was changed.
            try:
                why = json.loads(exc.body)["error"]["message"]  # type: ignore[attr-defined]
            except (ValueError, KeyError, TypeError):
                raise exc from None
            raise PlatformToolError(
                f"没写进去，文档没有变：{why} 改好 {args['path']} 再 cheese_doc_set。"
            ) from exc
        if status != 409:
            raise
        try:
            current = json.loads(exc.body)["error"]["data"]["doc_version"]  # type: ignore[attr-defined]
        except (ValueError, KeyError, TypeError):
            current = "?"
        raise PlatformToolError(
            f"没写进去：文档现在是第 {current} 版，你这份是照第 {based_on} 版改的。"
            "先 cheese_doc_get 重新读一遍，把别人的改动合进你的文件，再 "
            "cheese_doc_set。直接重试会原样被拒。"
        ) from exc
    version = (result.get("data") or {}).get("doc_version", 0)
    host.doc_versions[document] = version
    lines = [f"已更新实况文档（第 {version} 版）。"]
    # 格式警告（#1889 第 3 条）：写入照样成功，但「哪里不像状态」要当场改。
    # 它跟着这次写入回来，不另发一条通知——改的机会就是现在，而此刻在写字的人
    # 只看得见这次工具返回。
    for warning in result.get("warnings") or []:
        lines.append(f"⚠️ {warning}")
    return "\n".join(lines)


def _task_relative(path: str, task: str) -> str:
    """交付物的路径，写成后端认的那种：相对这条任务的工作目录。

    后端从任务目录里读它（`ProjectFiles.raw`），而 agent 手上常常是
    `cheese worktree` 打印的那个绝对路径——把那一截前缀剥掉，别让一次能读到的
    交付因为写法被打回。"""
    marker = f"/.cheese/tasks/{task}/"
    return path.split(marker, 1)[1] if marker in path else path


def _accept_request(args: dict, host) -> str:
    if args.get("deliver"):
        args = {**args, "deliver": _task_relative(args["deliver"], args["task"])}
    plan = request_plan("cheese_accept_request", args, host.environ)
    # 卡读的是 forge 上那条分支：先让机器把这条任务的提交推上去，推不上去就不递
    # ——递一张照着旧提交的卡，比一次「机器够不着」更糟，因为没人会发现。
    host.sync_task(args["task"])
    data = host.request(plan).get("data") or {}
    art = data.get("artifact") or {}
    named = art.get("name") or args.get("new_artifact") or args.get("artifact")
    reviewer = data.get("reviewer_handle") or args.get("reviewer") or "验收人"
    lines = [
        f"已把验收卡递给 {reviewer}" + (f"，本次更新《{named}》。" if named else "。")
    ]
    # 新建的那一次把 id 说出来：往后交付这一项就用它，而这里是它第一次存在的地方。
    if args.get("new_artifact") and art.get("id"):
        lines.append(f"这一项的 id 是 {art['id']}，以后交付它用 artifact={art['id']}。")
    # 交付物落没落下来当场说一句：字节只在这一刻读得到，没读到就再也读不到了。
    if args.get("deliver"):
        lines.append(f"这一版交出去的是 {args['deliver']}，已留存。")
    elif args.get("deliver_url"):
        lines.append(f"这一版交出去的是 {args['deliver_url']}。")
    # 递卡之后的那一段（等采纳、PR 红了怎么修）在这一刻最有用，所以跟着返回说。
    lines.append(
        "接下来等验收人采纳。PR 的检查失败或和目标分支冲突时平台会叫你：在这条任务"
        "的目录里修好、提交，用 cheese push-fix 更新原来的 PR，不要为这条任务再递一张卡。"
    )
    return "\n".join(lines)


def _tell(args: dict, host) -> str:
    """在一条活的时间线上说一句：和人在卡下面说话走同一条路由。

    说话的是房间的 AI 队友，所以后端只把这句落在那条活上，不叫醒谁。`target` 是
    id、`<#id>` 或标题；标题只在这个房间的活里找。"""
    topic = host.environ.get("CHEESE_TOPIC", "")
    if not topic:
        raise PlatformToolError("Missing CHEESE_TOPIC")
    room = urllib.parse.quote(topic, safe="")
    wanted = args["target"].strip()
    if wanted.startswith("<#") and wanted.endswith(">"):
        wanted = wanted[2:-1].strip()
    try:
        task_id, title = str(uuid.UUID(wanted)), None
    except ValueError:
        listing = host.request(
            {"method": "GET", "path": f"/topics/{room}/tasks?limit=1"}
        )
        tasks = ((listing.get("data") or {}).get("data")) or []
        exact = [t for t in tasks if (t.get("title") or "").strip() == wanted]
        loose = exact or [t for t in tasks if wanted in (t.get("title") or "")]
        if not loose:
            names = "、".join(t.get("title") or "" for t in tasks) or "（没有）"
            raise PlatformToolError(
                f"这个房间的活里没有叫「{wanted}」的。可选的是：{names}"
            )
        if len(loose) > 1:
            names = "、".join(t.get("title") or "" for t in loose)
            raise PlatformToolError(f"「{wanted}」对上了多条活（{names}），用 id 指明")
        task_id, title = loose[0]["id"], loose[0].get("title")
    host.request(
        {
            "method": "POST",
            "path": f"/topics/{room}/tasks/{urllib.parse.quote(task_id)}/messages",
            "body": {"content": args["message"]},
        }
    )
    return (
        f"已写在「{title or args['target']}」上。"
        "没有人被叫醒——做这条活的分身在你自己的会话里，要它动就直接给它发消息。"
    )


#: How many matches `platform_request(find=…)` spells out in full, and how many
#: more it names by method and path before saying how many it left out.
_FIND_DETAILED = 12
_FIND_NAMED = 40


def _platform_request(args: dict, host) -> str:
    """The rest of the platform API, on the room's own credential.

    With a method or a path it is one request and the backend's JSON comes back
    as written. Without one it is discovery, read from the backend's own OpenAPI
    document, so the catalogue is whatever this backend serves today and no
    list here can fall behind it."""
    if args.get("method") or args.get("path"):
        plan = request_plan("platform_request", args, host.environ)
        try:
            response = host.request(plan)
        except ValueError as exc:
            # Every host parses the body as JSON; a download is not JSON.
            raise PlatformToolError(
                "这个接口返回的不是 JSON（多半是文件下载）；"
                "文件用 cheese pull 或 cheese library get 取到机器上。"
            ) from exc
        return json.dumps(response, ensure_ascii=False)
    spec = host.request({"method": "GET", "path": "/openapi.json"})
    words = (args.get("find") or "").lower().split()
    where = (
        f"当前房间 {host.environ.get('CHEESE_TOPIC', '')}，"
        f"项目 {host.environ.get('CHEESE_PROJECT', '')}。"
    )
    return where + "\n" + _api_operations(spec, words)


def _api_operations(spec: dict, words: list[str]) -> str:
    operations = [
        (method.upper(), path, operation)
        for path, item in (spec.get("paths") or {}).items()
        for method, operation in item.items()
        if method.upper() in _HTTP_METHODS
    ]
    if not words:
        groups: dict[str, int] = {}
        for _, _, operation in operations:
            tag = (operation.get("tags") or ["other"])[0]
            groups[tag] = groups.get(tag, 0) + 1
        listed = "、".join(f"{tag}({n})" for tag, n in sorted(groups.items()))
        return (
            f"共 {len(operations)} 个接口，按分组：{listed}。\n"
            '按关键词找：platform_request(find="members role")。'
        )

    def text(operation: dict) -> str:
        return " ".join(
            [
                operation.get("summary") or "",
                operation.get("description") or "",
                operation.get("operationId") or "",
                *(operation.get("tags") or []),
            ]
        ).lower()

    # At the start of a word, so `ask` finds the ask routes and not every task.
    starts = [re.compile(r"(?<![a-z])" + re.escape(w)) for w in words]

    def hits(haystack: str) -> int:
        return sum(bool(s.search(haystack)) for s in starts)

    found = [
        (method, path, operation)
        for method, path, operation in operations
        if hits(f"{method} {path} {text(operation)}".lower()) == len(starts)
    ]
    if not found:
        return f"没有接口同时含有 {' '.join(words)}；少给几个词或换个说法。"
    # The words in the path and the summary are the strongest evidence. Among
    # equals, a route under a room, a project or a message comes first: the room
    # credential is bound to a project, so those are the ones it can open.
    found.sort(
        key=lambda op: (
            -hits(f"{op[1]} {op[2].get('summary') or ''}".lower()),
            not op[1].startswith(("/topics/", "/projects/", "/blocks/")),
        )
    )
    shown = [
        _describe_operation(method, path, operation, spec)
        for method, path, operation in found[:_FIND_DETAILED]
    ]
    rest = found[_FIND_DETAILED:]
    if rest:
        shown.append(
            "还匹配："
            + "；".join(f"{m} {p}" for m, p, _ in rest[:_FIND_NAMED])
            + (
                f"；另有 {len(rest) - _FIND_NAMED} 个，加关键词缩小范围"
                if len(rest) > _FIND_NAMED
                else ""
            )
        )
    return "\n\n".join(shown)


def _schema_type(schema: dict) -> str:
    if "$ref" in schema:
        return schema["$ref"].rsplit("/", 1)[-1]
    if "enum" in schema:
        return "|".join(str(v) for v in schema["enum"])
    for key in ("anyOf", "oneOf", "allOf"):
        if key in schema:
            return "|".join(
                _schema_type(s) for s in schema[key] if s.get("type") != "null"
            )
    if schema.get("type") == "array":
        return f"[{_schema_type(schema.get('items') or {})}]"
    return schema.get("type") or "any"


def _describe_operation(method: str, path: str, operation: dict, spec: dict) -> str:
    about = " ".join((operation.get("description") or "").split("\n\n")[0].split())
    if len(about) > 200:
        about = about[:200] + "…"
    lines = [f"{method} {path} — {operation.get('summary') or ''}"]
    if about:
        lines.append("  " + about)
    for place in ("path", "query"):
        params = [
            p["name"]
            + ("" if p.get("required") else "?")
            + f": {_schema_type(p.get('schema') or {})}"
            for p in operation.get("parameters") or []
            if p.get("in") == place
        ]
        if params:
            lines.append(f"  {place}: " + ", ".join(params))
    content = (operation.get("requestBody") or {}).get("content") or {}
    if "application/json" in content:
        schema = content["application/json"].get("schema") or {}
        name = ""
        if "$ref" in schema:
            name = schema["$ref"].rsplit("/", 1)[-1]
            schema = (spec.get("components") or {}).get("schemas", {}).get(name, {})
        fields = schema.get("properties") or {}
        required = set(schema.get("required") or ())
        if fields:
            lines.append(
                "  body: "
                + ", ".join(
                    f"{key}{'' if key in required else '?'}: {_schema_type(value)}"
                    for key, value in fields.items()
                )
            )
        else:
            lines.append("  body: JSON 对象，字段见上面的说明")
    elif content:
        lines.append(f"  body: {', '.join(content)}（这个工具发不了，只发 JSON）")
    return "\n".join(lines)


def _feedback_refusal(exc: Exception) -> str | None:
    """The backend's own sentence for a refused claim or release, if it sent one."""
    try:
        return json.loads(exc.body)["error"]["message"]  # type: ignore[attr-defined]
    except (AttributeError, ValueError, KeyError, TypeError):
        return None


def _feedback_read(tool: str, args: dict, host) -> dict:
    """One read of the feedback center, its refusals said to the agent."""
    try:
        return host.request(request_plan(tool, args, host.environ))
    except Exception as exc:
        status = getattr(exc, "status", None)
        why = _feedback_refusal(exc)
        if status == 404 and tool == "cheese_feedback_get":
            raise PlatformToolError(
                f"没有 {args['feedback']} 这条反馈，或者它是私密的、你看不见。"
                "核对编号；看不见的不要修。"
            ) from exc
        if status in (400, 403) and why:
            raise PlatformToolError(f"没读到：{why.rstrip('。')}。") from exc
        raise


