def artifact_kind_for(path: str) -> str:
    """The kind `path`'s extension implies; `html` when it implies none."""
    name = os.path.basename(path)
    _, dot, suffix = name.rpartition(".")
    return ARTIFACT_KIND_BY_SUFFIX.get("." + suffix.lower(), "html") if dot else "html"


class ToolTable:
    """平台的 MCP 工具表 —— 会话侧的一个常量（结论 21，由结论 63 修订）。

    以前这张表是**问出来的**：会话侧的 MCP 服务器收到 `tools/list`，就去执行器要一
    份，执行器再把机器上那棵 argparse 树翻成工具。于是一台执行机够不着，整个
    `cheese_*` 家族就从清单里消失，agent 被告知 `No such tool available:
    mcp__native__cheese_status` —— 而它这一刻最需要的恰恰是「跟房间说一句这里出事
    了」。这件事付过三轮（2026-09-13、-14、-15）。

    表在这里，它就不再问任何人。表上是**纯平台动作**：它们要的是平台，不是那台机器，
    所以从会话直接打后端，机器离线时一样不少——对话、文档、任务卡、验收都在。有两样
    还要机器上的一份东西：`cheese_doc_set` 读机器上那个文件，`cheese_accept_request`
    先让机器把任务的提交推上去；机器够不着时它们当场说够不着，不等超时。

    必须在机器上作为进程跑的（任务目录、同步与恢复、预览、读写工作区文件的转换、git
    凭据）才是这个文件的 CLI 子命令，跟文件、命令、项目 `.mcp.json` 一样随机器在、随
    机器没（结论 22）。
    """

    def __init__(self, tools):
        self._tools = tuple(tools)

    def names(self) -> tuple[str, ...]:
        return tuple(tool["name"] for tool in self._tools)

    def schemas(self) -> list[dict]:
        """MCP `tools/list` 要的那一份。"""
        return list(self._tools)

    def __contains__(self, name: object) -> bool:
        return name in self.names()


def _tool(name: str, description: str, properties=None, required=()) -> dict:
    schema: dict = {"type": "object", "properties": properties or {}}
    if required:
        schema["required"] = list(required)
    return {"name": name, "description": description, "inputSchema": schema}


def _text(description: str) -> dict:
    return {"type": "string", "description": description}


