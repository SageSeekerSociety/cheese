        f"request_id {(data or {}).get('request_id')}）。"
        "现在就停下，不要等：有人回复时，回复会作为新消息再把你叫起来。"
        "没人答的题 72 小时后自己收起、不再等人答；想早点收回某一道，"
        '用 platform_request(method="DELETE", path="/blocks/<消息 id>/question")。'
    )


def _say_todo(args, data, env) -> str:
    data = data or {}
    items = data.get("items") or []
    done = sum(1 for item in items if item.get("status") == "completed")
    counts = f"{len(items)} 项，完成 {done} 项"
    if not data.get("message_id"):
        return f"清单已记在卡上：{counts}。"
    if data.get("posted"):
        return f"已发出清单消息（id {data['message_id']}）：{counts}。"
    return f"已改清单消息（id {data['message_id']}）：{counts}。"


def _say_routine_draft(args, data, env) -> str:
    data = data or {}
    first = f"，第一次在 {data['next_run_at']}" if data.get("next_run_at") else ""
    title = data.get("title") or args.get("title") or ""
    project = data.get("project_id") or env.get("CHEESE_PROJECT") or ""
    # 点开是**这个频道**：右栏切到「例行事务」，这一条展开着。不去项目那一页 —— 规则
    # 长在这个房间里，人刚在这里说的事就在眼前做完，别把人带到别处去认路。
    room = data.get("topic_id") or ""
    name = (
        f"[{title}](/projects/{project}/channels/{room}?tab=routines&routine={data.get('id')})"
        if project and room and data.get("id")
        else f"「{title}」"
    )
    return (
        f"已为这个频道建了{name}，**它已经在跑了**，没有人再确认一次。\n"
        f"什么时候跑：{data.get('trigger_text') or args.get('trigger') or 'schedule'}"
        f"{first}\n"
        f"（id={data.get('id')}，你自己后面调用要用，别写给用户。）\n"
        "现在你自己说一句告诉用户建好了：把那上面的名字原样带上 —— 它是这条规则的"
        "标题，点开就是这个频道右边「例行事务」那一格上展开着的那一条。像平常说话那样"
        "说清楚建了什么、什么时候第一次跑就够了；别说是链接、别写 id、也别把这段说明"
        "抄过去。他要改或不要，就在那一格上改。"
    )


def _say_routine_list(args, data, env) -> str:
    rows = (data or {}).get("data") or []
    if not rows:
        return "这个频道还没有例行事务。"
    state = {"active": "启用中", "paused": "已暂停"}
    lines = []
    for row in rows:
        line = (
            f"- 「{row.get('title')}」(id={row.get('id')}) "
            f"{state.get(row.get('state'), row.get('state'))}；"
            f"{row.get('trigger_text') or row.get('trigger')}"
        )
        if row.get("room_archived"):
            # 规则自己没变，是频道归档了：取消归档后从下一个时刻继续。
            line += "（已随频道归档停止，取消归档后继续）"
        elif row.get("next_run_at"):
            line += f"；下次 {row['next_run_at']}"
        lines.append(line)
    return "\n".join(lines)


def _say_routine_update(args, data, env) -> str:
    data = data or {}
