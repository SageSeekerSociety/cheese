def _own_session(env) -> str:
    """This session's id: as its credential names it (``session`` in the
    claims its JWT carries), or, with no credential to read, as the platform
    socket answers it. Only ``ValueError`` when neither says."""
    body = (env.get("CHEESE_TOKEN", "").split(".") + ["", ""])[1]
    try:
        claims = json.loads(base64.urlsafe_b64decode(body + "=" * (-len(body) % 4)))
    except ValueError:
        claims = None
    session = claims.get("session") if isinstance(claims, dict) else None
    if session:
        return str(session)
    if _OPENER is not None and _platform_socket(env) == PLATFORM_SOCKET:
        try:
            with _urlopen(f"http://{_SOCKET_HOST}/whoami", timeout=20) as response:
                session = json.load(response).get("session")
        except (OSError, ValueError):
            session = None
        if session:
            return str(session)
    raise ValueError("Neither this credential nor the platform socket names a session")


