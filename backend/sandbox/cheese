#!/usr/bin/env python3
"""cheese — 芝士 的平台 CLI（在沙箱里调,平台动作走 REST,不用 MCP）。

代码/文件的事用原生工具（Bash/Write/Read）；改平台状态的事用本 CLI。
环境变量（容器注入）：
  CHEESE_API     平台 API 基址，如 http://host.docker.internal:8099/api
  CHEESE_PROJECT 当前项目 id
  CHEESE_TOPIC   当前话题 id
  CHEESE_AUTHOR  当前作者 handle（默认 cheese）

例:
  cheese doc set DOC.md            # 把 DOC.md 设为本话题活文档
  cheese doc get                   # 打印本话题活文档
  cheese split "数据清洗"           # 拆出子话题
  cheese decision "用 item-based CF" # 记一条决策
  cheese remember "技术栈=FastAPI"  # 记入项目记忆
  cheese notify --title "看下" --to mentor-1 --level strong --kind decision_request --options "A|B"
  cheese accept-request mentor-1 "中期验收"  # 递验收卡
  cheese conclude "原型完成,Recall@10=0.18"  # 子话题结论回流
  cheese milestone "中期汇报" --due 2026-06-20
  cheese artifact report.html               # 把产物设为本话题当前预览(进预览窗口)
  cheese artifact chart.svg --as svg        # SVG 同理
"""

from __future__ import annotations

import argparse
import json
import os
import sys
import urllib.error
import urllib.request

API = os.environ.get("CHEESE_API", "http://host.docker.internal:8099/api").rstrip("/")
PROJECT = os.environ.get("CHEESE_PROJECT", "")
TOPIC = os.environ.get("CHEESE_TOPIC", "")
AUTHOR = os.environ.get("CHEESE_AUTHOR", "cheese")
TOKEN = os.environ.get("CHEESE_TOKEN", "")
# The agent turn this CLI call belongs to — sent back so the blocks it creates
# share the turn's id (R4).
TURN = os.environ.get("CHEESE_TURN", "")
# In a private chat, `remember` writes the owner's personal memory (跟着人走).
MEMORY_SCOPE = os.environ.get("CHEESE_MEMORY_SCOPE", "project")
OWNER = os.environ.get("CHEESE_OWNER", "")


def _call(method: str, path: str, body: dict | None = None) -> dict:
    url = f"{API}{path}"
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method)
    req.add_header("Content-Type", "application/json")
    if TOKEN:
        req.add_header("X-Cheese-Token", TOKEN)
    if TURN:
        req.add_header("X-Cheese-Turn", TURN)
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        detail = e.read().decode(errors="replace")[:400]
        print(f"[cheese] {method} {path} 失败 HTTP {e.code}: {detail}", file=sys.stderr)
        sys.exit(1)
    except Exception as e:  # noqa: BLE001
        print(f"[cheese] {method} {path} 出错: {e}", file=sys.stderr)
        sys.exit(1)


def _need(name: str, value: str) -> str:
    if not value:
        print(f"[cheese] 缺少 {name}（环境变量未注入）", file=sys.stderr)
        sys.exit(2)
    return value


def main() -> None:
    p = argparse.ArgumentParser(prog="cheese", description="芝士 平台 CLI")
    sub = p.add_subparsers(dest="cmd", required=True)

    pd = sub.add_parser("doc", help="活文档")
    pdsub = pd.add_subparsers(dest="doccmd", required=True)
    pdset = pdsub.add_parser("set", help="把文件设为本话题活文档")
    pdset.add_argument("file")
    pdsub.add_parser("get", help="打印本话题活文档")

    ps = sub.add_parser("split", help="拆出子话题")
    ps.add_argument("title")

    pdec = sub.add_parser("decision", help="记录一条决策")
    pdec.add_argument("text")

    ptitle = sub.add_parser("title", help="给本话题起/改标题")
    ptitle.add_argument("text")

    prem = sub.add_parser("remember", help="记入项目记忆")
    prem.add_argument("fact")

    pn = sub.add_parser("notify", help="发通知")
    pn.add_argument("--title", required=True)
    pn.add_argument("--body", default="")
    pn.add_argument("--level", default="light", choices=["silent", "light", "strong"])
    pn.add_argument("--kind", default="change_alert")
    pn.add_argument("--to", default=None, help="target handle（不填=广播）")
    pn.add_argument("--options", default=None, help="决策选项,用 | 分隔")

    pa = sub.add_parser("accept-request", help="递验收卡给某人")
    pa.add_argument("reviewer")
    pa.add_argument("reason", nargs="?", default="")

    pc = sub.add_parser("conclude", help="子话题结论回流父话题")
    pc.add_argument("conclusion")

    pm = sub.add_parser("milestone", help="钉里程碑")
    pm.add_argument("title")
    pm.add_argument("--due", default=None, help="ISO 日期,如 2026-06-20")

    sub.add_parser("members", help="列出项目成员(名字+handle+角色)")

    part = sub.add_parser("artifact", help="把工作区文件设为可渲染产物(当前预览)")
    part.add_argument("path", help="工作区相对路径,如 report.html")
    part.add_argument("--as", dest="as_", default="html", choices=["html", "svg"],
                      help="渲染类型(默认 html)")

    a = p.parse_args()

    if a.cmd == "doc" and a.doccmd == "set":
        topic = _need("CHEESE_TOPIC", TOPIC)
        with open(a.file, encoding="utf-8") as f:
            content = f.read()
        _call("PUT", f"/topics/{topic}/doc", {"content": content, "author": AUTHOR})
        print("已更新活文档。")
    elif a.cmd == "doc" and a.doccmd == "get":
        topic = _need("CHEESE_TOPIC", TOPIC)
        d = _call("GET", f"/topics/{topic}/doc").get("data")
        print((d or {}).get("content", "") if d else "")
    elif a.cmd == "split":
        topic = _need("CHEESE_TOPIC", TOPIC)
        r = _call("POST", f"/topics/{topic}/split", {"title": a.title, "created_by": AUTHOR})
        print(f"已拆出子话题：{r['data']['title']}（id={r['data']['id']}）")
    elif a.cmd == "decision":
        topic = _need("CHEESE_TOPIC", TOPIC)
        _call("POST", f"/topics/{topic}/decision", {"decision": a.text})
        print("已记入决策记录。")
    elif a.cmd == "title":
        topic = _need("CHEESE_TOPIC", TOPIC)
        _call("POST", f"/topics/{topic}/title", {"title": a.text})
        print(f"话题标题已设为：{a.text}")
    elif a.cmd == "remember":
        proj = _need("CHEESE_PROJECT", PROJECT)
        body = {"content": a.fact}
        if MEMORY_SCOPE == "personal" and OWNER:
            body["scope"] = "user"
            body["owner"] = OWNER
            _call("POST", f"/projects/{proj}/memory", body)
            print("已记入个人记忆。")
        else:
            _call("POST", f"/projects/{proj}/memory", body)
            print("已记入项目记忆。")
    elif a.cmd == "notify":
        proj = _need("CHEESE_PROJECT", PROJECT)
        payload = {}
        if a.options:
            payload["options"] = [o.strip() for o in a.options.split("|") if o.strip()]
        body = {
            "level": a.level, "kind": a.kind, "title": a.title, "body": a.body,
            "target_handle": a.to, "topic_id": TOPIC or None, "payload": payload,
        }
        _call("POST", f"/projects/{proj}/notifications", body)
        print(f"已发送通知给 {a.to or '所有人'}。")
    elif a.cmd == "accept-request":
        topic = _need("CHEESE_TOPIC", TOPIC)
        _call("POST", f"/topics/{topic}/accept-card",
              {"reviewer_handle": a.reviewer, "routing_reason": a.reason})
        print(f"已把验收卡递给 {a.reviewer}。")
    elif a.cmd == "conclude":
        topic = _need("CHEESE_TOPIC", TOPIC)
        _call("POST", f"/topics/{topic}/return-conclusion", {"conclusion": a.conclusion})
        print("已把结论回流父话题。")
    elif a.cmd == "milestone":
        proj = _need("CHEESE_PROJECT", PROJECT)
        body = {"title": a.title}
        if a.due:
            body["due_date"] = a.due if "T" in a.due else f"{a.due}T00:00:00Z"
        _call("POST", f"/projects/{proj}/milestones", body)
        print(f"已钉里程碑：{a.title}")
    elif a.cmd == "members":
        proj = _need("CHEESE_PROJECT", PROJECT)
        d = _call("GET", f"/projects/{proj}/members").get("data", {})
        rows = d.get("data", d) if isinstance(d, dict) else d
        for m in rows:
            h = m.get("user_handle")
            print(f"- {m.get('name')}（{m.get('role')}）→ 在消息里写 <@{h}> 点名 ta")
    elif a.cmd == "artifact":
        topic = _need("CHEESE_TOPIC", TOPIC)
        _call("POST", f"/topics/{topic}/artifact", {"path": a.path, "as": a.as_})
        print(f"已把 {a.path} 设为当前预览（{a.as_}）。")


if __name__ == "__main__":
    main()
