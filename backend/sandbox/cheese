            "别把进度当决策记。记完平台会在对话里自动出一张可点的卡片——"
            "你不用再写一句「已记入决策记录」。"
        ),
    )
    pdec.add_argument("text", help="决策内容,一句话说清定了什么、为什么")

    ptitle = sub.add_parser(
        "title",
        help="给本话题起/改标题",
        description="话题还叫「新话题」时,据任务起一个 ≤12 字的标题。这是开工第一步。",
    )
    ptitle.add_argument("text", help="标题,≤12 字")

    prem = sub.add_parser(
        "remember",
        help="记入项目记忆",
        description=(
            "记一条事实进项目记忆,以后任何话题都能 recall 到。\n"
            "\n"
            "只记「跨话题还成立、且从代码/git 历史里读不出来」的东西。"
            "代码结构、改过什么 bug、本轮的临时状态都不要记。"
            "相对时间要换成绝对日期。"
