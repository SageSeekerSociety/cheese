def _say_routine_report(args, data, env) -> str:
    data = data or {}
    verdict = {"succeeded": "已完成", "failed": "失败"}.get(
        data.get("status"), data.get("status")
    )
    parts = [f"这次执行记成「{verdict}」"]
    if data.get("summary"):
        parts.append(data["summary"])
    if data.get("outputs"):
        parts.append("结果文件：" + "、".join(data["outputs"]))
    if data.get("error"):
        parts.append(f"失败原因：{data['error']}")
    parts.append("规则主人已经收到这条结果。")
    return "\n".join(parts)


