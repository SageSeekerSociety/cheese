class LocalHost:
    """A host for a session that runs ON the machine (the pi harness): the backend
    over plain HTTP, the file from this disk, the sync as this CLI's own
    subcommand."""

    def __init__(self, environ=None, doc_versions=None, cwd=None):
        self.environ = dict(os.environ if environ is None else environ)
        self.doc_versions = {} if doc_versions is None else doc_versions
        self.cwd = cwd or os.getcwd()

    def request(self, plan: dict) -> dict:
        api = self.environ.get("CHEESE_API", "").rstrip("/")
        body = plan.get("body")
        req = urllib.request.Request(
            api + plan["path"],
            data=json.dumps(body).encode() if body is not None else None,
            method=plan["method"],
        )
        req.add_header("Content-Type", "application/json")
        for header, name in (
            ("X-Cheese-Token", "CHEESE_TOKEN"),
            ("X-Cheese-Turn", "CHEESE_TURN"),
        ):
            if self.environ.get(name):
                req.add_header(header, self.environ[name])
        # Generous because one caller is slow: reading a web page can climb a
        # ladder of fetch strategies ending in a real browser, which measured
        # 22 s on a page that answered and longer on one that tried every rung.
        try:
            with urllib.request.urlopen(req, timeout=240) as response:
                return json.loads(response.read() or b"{}")
        except urllib.error.HTTPError as exc:
            raise PlatformHTTPError(
                exc.code, exc.read().decode(errors="replace")
            ) from None

    def read_file(self, path: str) -> bytes:
        with open(os.path.join(self.cwd, path), "rb") as stream:
            return stream.read()

    def wait_machine(self) -> None:
        """This session runs on its machine: it is there."""

    def sync_task(self, task_id: str) -> None:
        result = subprocess.run(
            [sys.executable, os.path.abspath(__file__), "sync", "--task", task_id],
            env=self.environ,
            capture_output=True,
            text=True,
            timeout=900,
        )
        if result.returncode:
            raise PlatformToolError(
                "任务的提交没能推上去，验收卡没有递：" + (result.stderr or "").strip()
            )


def _call(
    method: str,
    path: str,
    body: dict | None = None,
    *,
    token: str | None = None,
    tolerate: tuple[int, ...] = (),
    timeout: int = 20,
) -> dict:
    """Call the platform. Any HTTP error is fatal, except the statuses in
    `tolerate` — those come back as ``{"ok": False, "status": ..., "error": ...}``
    for a caller that has something better to say than the raw response.

    ``timeout`` is generous by default because these calls are small. A caller
    whose call is not (a document conversion) passes its own."""
    url = f"{API}{path}"
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method)
    req.add_header("Content-Type", "application/json")
    auth = token if token is not None else TOKEN
    if auth:
        req.add_header("X-Cheese-Token", auth)
    if TURN:
        req.add_header("X-Cheese-Turn", TURN)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        raw = e.read().decode(errors="replace")
        if e.code in tolerate:
            try:
                payload = json.loads(raw)
            except ValueError:
                payload = {}
            return {"ok": False, "status": e.code, "error": payload.get("error") or {}}
        print(
            f"[cheese] {method} {path} 失败 HTTP {e.code}: {raw[:400]}", file=sys.stderr
        )
        sys.exit(1)
    except Exception as e:  # noqa: BLE001
        print(f"[cheese] {method} {path} 出错: {e}", file=sys.stderr)
        sys.exit(1)


def _task_root() -> Path:
    return Path.home() / ".cheese" / "tasks"


# Which directory holds the environment runner depends on which launcher
# prepared this place, and that is not something the CLI can know: the machine
# launcher writes `.cheese/`, the claude-code remote-execution payload writes
# the harness config dir `.claude/`. The copies are byte-identical, so the
# first one on disk answers — the order matching the platform's own probe
# (`ENVIRONMENT_RUNNER_PATHS`). Naming one of them was how a room on a machine
# prepared by the other launcher could not create a task at all.
ENVIRONMENT_RUNNER_PATHS = (".cheese", ".claude")

# 平台放在这个会话自己 home 里的那一个目录:随消息发来的附件落在
# `~/attachments/<地址>`,`library get` 取下来的那一份也落在这里。它不是工作目录
# ——工作目录是被托管的那个检出,平台往里写一个字节,就是别人仓库里一个他没有加过、
# 而我们也不会去删的未跟踪文件(结论 49)。名字由 `app/domain/agent/place.py` 的
# `STAGED_DIR` 选定,这里是它的一份抄件,`backend/tests/unit/test_footprint_root.py`
# 把两边对住。
STAGED_DIR = "attachments"


def _environment_runner() -> Path | None:
    for directory in ENVIRONMENT_RUNNER_PATHS:
        candidate = Path.home() / directory / "cheese-environment.py"
        if candidate.is_file():
            return candidate
    return None


def _marked_task() -> str | None:
    """The task whose worktree this is, or None in any other checkout."""
    result = subprocess.run(
        ["git", "rev-parse", "--git-path", "cheese-task.json"],
        capture_output=True,
        text=True,
    )
    if result.returncode == 0:
        marker = Path(result.stdout.strip())
        if marker.is_file():
            return str(uuid.UUID(json.loads(marker.read_text())["task_id"]))
    return None


def _task_id(explicit: str | None = None) -> str:
    if explicit:
        return str(uuid.UUID(explicit))
    task_id = _marked_task()
    if task_id is None:
        raise SystemExit("[cheese] 请在任务工作目录内执行，或指定 --task <id>")
    return task_id


def _git_task(
    cwd: Path, *args: str, extra_env: dict | None = None, input_text: str | None = None
) -> str:
    env = {
        key: value for key, value in os.environ.items() if not key.startswith("GIT_")
    }
    env["GIT_TERMINAL_PROMPT"] = "0"
    if extra_env:
        env.update(extra_env)
    result = subprocess.run(
        ["git", "-C", str(cwd), *args],
        env=env,
        input=input_text,
        capture_output=True,
        text=True,
        timeout=300,
    )
    if result.returncode:
        raise RuntimeError(result.stderr.strip())
    return result.stdout.strip()


def _git_credential(operation: str) -> None:
    """Git invokes this at use time; only the bound host AND path receive a token."""
    if operation != "get":
        return
    fields = dict(line.rstrip("\n").split("=", 1) for line in sys.stdin if "=" in line)
    data = _call("GET", "/sandbox/forge-token")["data"]
    path = urllib.parse.unquote(fields.get("path", "")).strip("/").removesuffix(".git")
    destinations = [(data["url"], data["token"])]
    if data.get("kind") in ("forgejo", "github_app"):
        destinations.append(
            (
                _forge_git_relay(data["repo"]),
                TOKEN if data["kind"] == "github_app" else data["token"],
            )
        )
    for destination, credential in destinations:
        bound = urllib.parse.urlsplit(destination)
        wanted = urllib.parse.unquote(bound.path).strip("/").removesuffix(".git")
        if (
            fields.get("protocol") == bound.scheme
            and fields.get("host", "").lower() == bound.netloc.lower()
            and path == wanted
        ):
            print(f"username={data['username']}\npassword={credential}\n")
            return


def _forge_git_relay(repository: str) -> str:
    return f"{API}/sandbox/forge/{_need('CHEESE_PROJECT', PROJECT)}/{repository}.git"


def _configure_git_transport(repo: Path, data: dict) -> None:
    if data.get("forge_kind") not in ("forgejo", "github_app"):
        return
    relay = _forge_git_relay(data["forge_repo"])
    # Keep origin canonical so native tools retain the repository identity.
    key = f"url.{relay}.insteadOf"
    existing = _git_task(repo, "config", "--list").splitlines()
    if any(line.startswith(f"url.{relay}.insteadof=") for line in existing):
        _git_task(repo, "config", "--unset-all", key)
    reachable = True
    try:
        root = data["remote"].rsplit("/", 2)[0]
        probe = root + ("/api/v1/version" if data["forge_kind"] == "forgejo" else "/")
        request = urllib.request.Request(probe)
        with urllib.request.urlopen(request, timeout=5):
            pass
    except urllib.error.HTTPError:
        reachable = False
    except (OSError, urllib.error.URLError):
        reachable = False
    if not reachable:
        _git_task(repo, "config", "--replace-all", key, data["remote"])
        print("[cheese] 仓库无法直连，本次通过平台访问", file=sys.stderr)


def _git_attribution(message_file: str) -> None:
    # The hook belongs to the shared repository, so every worktree of it runs
    # it, including one made with `git worktree add` beside a task's. Only a
    # task's own worktree has someone to credit; any other commits as itself.
    task_id = _marked_task()
    if task_id is None:
        return
    project = _need("CHEESE_PROJECT", PROJECT)
    data = _call("GET", f"/projects/{project}/git/tasks/{task_id}")["data"]
    if data["room_id"] != TOPIC:
        raise RuntimeError("Task belongs to another room")
    trailers = []
    for person in data["coauthors"]:
        if "\n" in person or "\r" in person:
            raise ValueError("Invalid contributor identity")
        trailers.extend(["--trailer", f"Co-authored-by: {person}"])
    if trailers:
        subprocess.run(
            [
                "git",
                "interpret-trailers",
                "--in-place",
                "--if-exists",
                "addIfDifferent",
                *trailers,
                message_file,
            ],
            check=True,
        )


def _lock(file) -> None:
    """flock(LOCK_EX), or on Windows the byte-range lock beside this file."""
    if sys.platform == "win32":
        # This file is the executor release's `cheese`; the Windows primitives
        # are shipped in the same release.
        portable = Path(__file__).resolve().parent / "remote-execution/portable.py"
        runpy.run_path(str(portable))["lock"](file)
    else:
        fcntl.flock(file, fcntl.LOCK_EX)


def _worktree_relative(path: str) -> str:
    """`path` relative to the worktree root, as the platform resolves it; or
    `path` itself when it is outside, for the platform to judge.

    With `/` between the parts whatever the machine: the platform reads it as a
    POSIX path. And a path on another drive of a Windows machine is outside.
    """
    root = os.environ.get("CHEESE_WORKTREE_ROOT", "/work")
    try:
        rel = os.path.relpath(os.path.abspath(path), root)
    except ValueError:
        return path
    if rel.startswith(".."):
        return path
    return rel.replace(os.sep, "/")


def _prepare_repository(repo: Path, data: dict) -> None:
    """This machine's copy of the project's repository, able to reach its forge.

    Its caller holds `<project>.lock` beside it."""
    if not repo.exists():
        _git_task(repo.parent, "init", "--bare", str(repo))
    _git_task(repo, "config", "--replace-all", "credential.helper", "")
    _git_task(repo, "config", "--add", "credential.helper", "!cheese git-credential")
    _git_task(repo, "config", "credential.useHttpPath", "true")
    if "origin" not in _git_task(repo, "remote").splitlines():
        _git_task(repo, "remote", "add", "origin", data["remote"])
    else:
        _git_task(repo, "remote", "set-url", "origin", data["remote"])
    _configure_git_transport(repo, data)


def _task_worktree(task_id: str) -> Path:
    task_id = str(uuid.UUID(task_id))
    project = _need("CHEESE_PROJECT", PROJECT)
    data = _call("POST", f"/projects/{project}/git/tasks/{task_id}")["data"]
    if data["room_id"] != TOPIC:
        raise SystemExit("[cheese] 这条任务不属于当前房间")
    if data["closed"]:
        raise SystemExit("[cheese] 这条任务已结束，请创建新任务")
    cache = Path.home() / ".cheese" / "repositories"
    cache.mkdir(parents=True, exist_ok=True)
    repo = cache / f"{project}.git"
    task_dir = _task_root() / task_id
    task_dir.parent.mkdir(parents=True, exist_ok=True)
    # Native subagents can request worktrees concurrently. Serialize creation
    # so an interrupted clone cannot be mistaken for a complete repository.
    with (cache / f"{project}.lock").open("a") as lock:
        _lock(lock)
        _prepare_repository(repo, data)
        # The commits, not every version of every file. A project's repo is
        # mostly old blobs — measured on cheese's own: 195 MB whole, 9.6 MB
        # this way — and all of that crossed the platform's backend on the way
        # here, where one 169 MB fetch froze every other request for 3.7 s
        # (2026-09-20). The whole history is still here, so `git log` and a
        # diff against the base still work; a file's older contents are fetched
        # if something actually reads them.
        exists_on_forge = bool(
            _git_task(repo, "ls-remote", "--heads", "origin", data["branch"])
        )
        refs = [data["base"]] + ([data["branch"]] if exists_on_forge else [])
        for ref in refs:
            _git_task(
                repo,
                "fetch",
                "--filter=blob:none",
                "origin",
                f"refs/heads/{ref}:refs/remotes/origin/{ref}",
            )
        if not (task_dir / ".git").exists():
            existing = _git_task(repo, "branch", "--list", data["branch"])
            create = [] if existing else ["-b", data["branch"]]
            remote_start = data["branch"] if exists_on_forge else data["base"]
            start = (
                data["branch"] if existing else f"refs/remotes/origin/{remote_start}"
            )
            _git_task(repo, "worktree", "prune")
            _git_task(
                repo,
                "worktree",
                "add",
                *create,
                str(task_dir),
                start,
            )
        marker = Path(
            _git_task(task_dir, "rev-parse", "--git-path", "cheese-task.json")
        )
        if not marker.is_absolute():
            marker = task_dir / marker
        marker.write_text(json.dumps(data))
        _git_task(
            repo, "config", "user.name", os.environ.get("GIT_AUTHOR_NAME", AUTHOR)
        )
        _git_task(
            repo,
            "config",
            "user.email",
            os.environ.get("GIT_AUTHOR_EMAIL", f"{AUTHOR}@agent.cheese.local"),
        )
        hooks = repo / "hooks"
        prepare = hooks / "prepare-commit-msg"
        prepare.write_text('#!/bin/sh\nexec cheese git-attribution "$1"\n')
        prepare.chmod(0o755)
        hook = hooks / "post-commit"
        # Delivers the task whose worktree committed; another worktree of this
        # repository has no task to deliver, and `cheese sync` there would fail.
        hook.write_text(
            "#!/bin/sh\n"
            '[ -f "$(git rev-parse --git-path cheese-task.json)" ] || exit 0\n'
            "exec cheese sync\n"
        )
        hook.chmod(0o755)
    # The room has no checkout. Branch dependencies belong to this task and
    # must be prepared on every open, including after local branch changes.
    if (Path.home() / ".cheese-environment/config.json").exists():
        # That config is the runner's own output, so a place that has one had a
        # runner: it going missing is a broken place, not an unprepared one, and
        # silently skipping would hand back a task directory whose dependencies
        # were never installed.
        runner = _environment_runner()
        if runner is None:
            raise SystemExit("[cheese] 这台机器的环境准备脚本不见了，任务目录没法准备")
        result = subprocess.run([sys.executable, str(runner), "task", str(task_dir)])
        if result.returncode:
            raise SystemExit(result.returncode)
    return task_dir


class _BranchQueued(RuntimeError):
    """The task's PR is in the merge queue, which locks its branch."""

    def __init__(self, branch: str, pr: int):
        super().__init__(
            f"{branch} is locked: PR #{pr} is in the merge queue, so commits "
            "made since it was accepted cannot join it"
        )
        self.pr = pr


def _report_sync_failure(
    task_id: str, branch: str | None, queued_pr: int | None = None
) -> None:
    """Tell the room that a task's work did not reach its branch.

    Only the failure: a turn that ends with its work still on the machine looks
    identical to one that succeeded — that is what let a rejected push read as a
    completed turn until the machine was deleted and the work went with it. On
    success the work is already visible in the branch, and a message per turn
    saying so would be noise that trains people to skip it.
    """
    if not (API and TOPIC and TOKEN):
        return  # A human using the CLI directly already receives its exit status.
    where = branch or f"任务 {task_id}"
    content = (
        f"⚠️ 这轮的改动没能推回 {where}——它还留在那台机器上，采纳和 diff 现在"
        "看不到它。请重试本轮；若机器被回收，改动会丢失。"
    )
    if queued_pr:
        # Retrying cannot help: the branch stays locked until the queue is done.
        content = (
            f"⚠️ {where} 上采纳之后的新提交进不了 PR #{queued_pr}——它已在合并"
            "队列里，排队的分支不能再改。提交留在那台机器上并已备份；PR 合并后"
            "在新任务里交付它们，或由验收人退回这张卡、PR 撤出队列后再推。"
        )
    body = {
        "content": content,
        "request_id": str(uuid.uuid4()),
    }
    req = urllib.request.Request(
        f"{API}/topics/{TOPIC}/messages",
        data=json.dumps(body).encode(),
        method="POST",
    )
    req.add_header("Content-Type", "application/json")
    req.add_header("X-Cheese-Token", TOKEN)
    try:
        with urllib.request.urlopen(req, timeout=30):
            pass
    except Exception:  # noqa: BLE001 — the sync's own failure is what matters
        print(
            f"[cheese] 同步失败的通知未送达，任务 {task_id} 的 "
            "cheese-sync.log 保留了结果",
            file=sys.stderr,
        )


def _sync_task(task_id: str) -> None:
    task_id = str(uuid.UUID(task_id))
    worktree = _task_root() / task_id
    if not (worktree / ".git").exists():
        worktree = _task_worktree(task_id)
    admin = Path(_git_task(worktree, "rev-parse", "--absolute-git-dir"))
    log = admin / "cheese-sync.log"
    with log.open("a") as record:
        # A post-commit hook and the room's Stop hook can arrive together.
        _lock(record)
        record.write(f"{datetime.now(UTC).isoformat()} start task={task_id}\n")
        record.flush()
        branch = None
        closed = False
        try:
            project = _need("CHEESE_PROJECT", PROJECT)
            data = _call("GET", f"/projects/{project}/git/tasks/{task_id}")["data"]
            if data["room_id"] != TOPIC:
                raise RuntimeError("Task belongs to another room")
            closed = data["closed"]
            if not closed:
                # Only a delivery talks to the forge. A closed task is only
                # backed up, to the platform, so it skips the forge probe that
                # otherwise costs every one of a room's closed tasks a round
                # trip while a switch waits.
                _git_task(worktree, "config", "--replace-all", "credential.helper", "")
                _git_task(
                    worktree,
                    "config",
                    "--add",
                    "credential.helper",
                    "!cheese git-credential",
                )
                _git_task(worktree, "config", "credential.useHttpPath", "true")
                _git_task(worktree, "remote", "set-url", "origin", data["remote"])
                _configure_git_transport(worktree, data)
            head = _git_task(worktree, "rev-parse", "HEAD")
            # Keep unfinished work off the PR. An alternate index preserves the
            # worker's staging choices while backing up its files at turn end.
            snapshot_env = {"GIT_INDEX_FILE": str(admin / "cheese-snapshot-index")}
            _git_task(worktree, "read-tree", "HEAD", extra_env=snapshot_env)
            _git_task(worktree, "add", "-A", extra_env=snapshot_env)
            tree = _git_task(worktree, "write-tree", extra_env=snapshot_env)
            snapshot = (
                head
                if tree == _git_task(worktree, "rev-parse", "HEAD^{tree}")
                else _git_task(
                    worktree,
                    "commit-tree",
                    tree,
                    "-p",
                    head,
                    input_text=f"Work in progress for task {task_id}\n",
                )
            )
            _once_more_if_transient(
                lambda: _backup_task_snapshot(worktree, admin, data, head, snapshot)
            )
            if closed:
                # Kept, never delivered: what the checkout holds is in the
                # backup, on whichever branch an agent went on to use it for.
                record.write(
                    f"{datetime.now(UTC).isoformat()} archived snapshot={snapshot}; "
                    "delivery is closed\n"
                )
                return
            branch = data["branch"]
            found = _git_task(worktree, "symbolic-ref", "--short", "HEAD")
            if found != branch:
                raise RuntimeError(f"Expected task branch {branch}, found {found}")
            _once_more_if_transient(
                lambda: _deliver_task_branch(
                    worktree, branch, head, queued_pr=data.get("merge_queued_pr")
                )
            )
            record.write(
                f"{datetime.now(UTC).isoformat()} success head={head} "
                f"snapshot={snapshot}\n"
            )
        except BaseException as exc:
            record.write(
                f"{datetime.now(UTC).isoformat()} failed {type(exc).__name__}: {exc}\n"
            )
            if closed and isinstance(exc, Exception):
                # No room message from here: a closed task has no turn whose
                # work went missing, and when a room leaves this machine the
                # platform tells the room which task stayed behind and why.
                raise _ClosedTaskNotBackedUp(str(exc)) from exc
            queued = exc.pr if isinstance(exc, _BranchQueued) else None
            _report_sync_failure(task_id, branch, queued)
            raise


class _ClosedTaskNotBackedUp(RuntimeError):
    """A closed task's leftover work could not be backed up.

    Told apart from an open task's failed sync because the platform weighs it
    differently when a room moves off this machine: a machine that keeps its
    files still holds this work, a Cloud machine about to be deleted does not.
    """


# Words git prints when the connection, not the forge, failed.
_TRANSIENT_GIT = (
    "connection reset",
    "timed out",
    "the remote end hung up unexpectedly",
    "early eof",
)


def _transient(exc: BaseException) -> bool:
    """A reset or timed-out connection: the same request may well go through."""
    if isinstance(exc, urllib.error.HTTPError):
        return False  # The platform answered; asking again gets the same answer.
    if isinstance(exc, urllib.error.URLError):
        exc = exc.reason if isinstance(exc.reason, BaseException) else exc
    if isinstance(
        exc,
        (ConnectionResetError, ConnectionAbortedError, BrokenPipeError, TimeoutError),
    ):
        return True
    return isinstance(exc, RuntimeError) and any(
        words in str(exc).lower() for words in _TRANSIENT_GIT
    )


def _once_more_if_transient(action):
    """Run `action`, and once more if the network dropped it.

    One retry, not a loop: a single reset is the network, a second one in a
    row is usually something about the request (its size, a proxy's limit),
    and every retry lengthens the push a room switch waits two minutes for.
    """
    try:
        return action()
    except Exception as exc:
        if not _transient(exc):
            raise
    return action()


def _deliver_task_branch(
    worktree: Path, branch: str, head: str, *, queued_pr: int | None = None
) -> None:
    """Make the task's branch on the forge carry `head`.

    The branch has more than one writer: every checkout of the task (a
    teammate can work the same task from another), and whoever pushes to the
    PR. So the forge's tip is read first, and:

    - `head` already in it: this checkout has nothing the branch lacks.
      Another checkout went further; pushing the older head is refused and
      would say nothing true.
    - the tip in `head`'s history: an ordinary push.
    - neither, but the tip is a commit this checkout itself had on the branch
      and then amended or rebased away: replace it, leased on that tip, so a
      commit arriving meanwhile is refused and not overwritten. Tidying a
      task's commits is part of the work (dropping a dependency asks for it).
    - neither, and the tip carries commits this checkout never had: refuse.
      Replacing them would delete someone else's work from the PR.

    Anything to push while the PR is in the merge queue (`queued_pr`) is
    refused up front: the forge locks a queued branch.

    `head` already in the branch as this checkout last pushed or fetched it
    needs no forge call at all. Asking anyway turned a forge that could not be
    reached for a moment into "not pushed back" for work it already had, once
    for every sync while the outage lasted.
    """
    remote = f"refs/remotes/origin/{branch}"
    if _is_ancestor(worktree, head, remote):
        return
    if not _git_task(worktree, "ls-remote", "origin", f"refs/heads/{branch}"):
        _git_task(worktree, "push", "origin", f"{head}:refs/heads/{branch}")
        return
    _git_task(
        worktree,
        "fetch",
        "--filter=blob:none",
        "origin",
        f"+refs/heads/{branch}:{remote}",
    )
    tip = _git_task(worktree, "rev-parse", remote)
    if _is_ancestor(worktree, head, tip):
        return
    if queued_pr:
        raise _BranchQueued(branch, queued_pr)
    if _is_ancestor(worktree, tip, head):
        _git_task(worktree, "push", "origin", f"{head}:refs/heads/{branch}")
        return
    own = _git_task(
        worktree, "reflog", "show", "--format=%H", f"refs/heads/{branch}"
    ).split()
    if tip not in own:
        raise RuntimeError(
            f"{branch} on the forge has commits this checkout never had "
            f"(its tip is {tip[:12]}); merge or rebase onto {remote} and sync again"
        )
    _git_task(
        worktree,
        "push",
        f"--force-with-lease=refs/heads/{branch}:{tip}",
        "origin",
        f"{head}:refs/heads/{branch}",
    )


def _is_ancestor(worktree: Path, commit: str, of: str) -> bool:
    try:
        _git_task(worktree, "merge-base", "--is-ancestor", commit, of)
    except RuntimeError:
        return False
    return True


def _backed_up_already(worktree, task_id, head, snapshot) -> bool:
    """Whether the platform's latest backup of this task is these same files on
    this same commit.

    Without this a checkout that has not changed is uploaded again at every
    sync: its snapshot commit is made afresh each time, so the bundle is new
    even when nothing in it is, and a room switch waits for every such task.
    Any doubt goes to the upload: no backup yet, a call that fails, a snapshot
    this machine no longer has.
    """
    request = urllib.request.Request(
        f"{API}/projects/{PROJECT}/git/tasks/{task_id}/snapshots/latest"
    )
    request.add_header("X-Cheese-Token", TOKEN)
    try:
        with urllib.request.urlopen(request, timeout=20) as response:
            latest = json.load(response)["data"]
        if latest["head_sha"] != head:
            return False
        tree = _git_task(worktree, "rev-parse", f"{latest['snapshot_sha']}^{{tree}}")
        return tree == _git_task(worktree, "rev-parse", f"{snapshot}^{{tree}}")
    except (OSError, ValueError, KeyError, TypeError, RuntimeError):
        return False


def _backup_task_snapshot(worktree, admin, data, head, snapshot):
    task_id = data["task_id"]
    ref = f"refs/cheese/snapshots/{task_id}"
    base = f"refs/remotes/origin/{data['base']}"
    try:
        _git_task(worktree, "rev-parse", "--verify", "--quiet", base)
        known = [f"^{base}"]
    except RuntimeError:
        # A task stacked on another task's branch outlives that branch: it is
        # deleted once merged, and a fetch with --prune drops it here too. What
        # the backup holds is then what no branch of the forge was seen with.
        known = ["--not", "--remotes=origin"]
    if _git_task(worktree, "rev-list", "--count", snapshot, *known) == "0":
        return  # Every object is already on the forge; there is no unfinished work.
    if _backed_up_already(worktree, task_id, head, snapshot):
        return
    _git_task(worktree, "update-ref", ref, snapshot)
    bundle = admin / f"cheese-snapshot-{snapshot}.bundle"
    try:
        _git_task(worktree, "bundle", "create", str(bundle), ref, *known)
        digest = hashlib.sha256()
        with bundle.open("rb") as stream:
            for chunk in iter(lambda: stream.read(1024 * 1024), b""):
                digest.update(chunk)
        path = f"/projects/{PROJECT}/git/tasks/{task_id}/snapshots/{snapshot}"
        with bundle.open("rb") as stream:
            request = urllib.request.Request(f"{API}{path}", data=stream, method="PUT")
            request.add_header("Content-Type", "application/x-git-bundle")
            request.add_header("Content-Length", str(bundle.stat().st_size))
            request.add_header("X-Cheese-Token", TOKEN)
            request.add_header("X-Cheese-Head", head)
            request.add_header("X-Content-SHA256", digest.hexdigest())
            with urllib.request.urlopen(request, timeout=120) as response:
                receipt = json.load(response)["data"]
        if receipt["digest"] != digest.hexdigest():
            raise RuntimeError("Task backup acknowledgement did not match the bundle")
    finally:
        # Built afresh on every try: the base moves on, and a bundle kept from
        # a refused upload went out again unchanged, refused at every turn.
        bundle.unlink(missing_ok=True)


def _recover_task(task_id):
    task_id = str(uuid.UUID(task_id))
    data = _call("GET", f"/projects/{PROJECT}/git/tasks/{task_id}/snapshots/latest")[
        "data"
    ]
    recovery_root = Path.home() / ".cheese" / "recovered"
    recovery_root.mkdir(parents=True, exist_ok=True, mode=0o700)
    recovered = recovery_root / f"{task_id}-{data['snapshot_sha'][:12]}"
    if recovered.exists():
        raise RuntimeError(f"Recovery directory already exists: {recovered}")
    bundle = recovery_root / f".cheese-recovery-{data['id']}.bundle"
    _raw_request(
        "GET",
        f"/projects/{PROJECT}/git/tasks/{task_id}/snapshots/{data['id']}",
        None,
        str(bundle),
    )
    with bundle.open("rb") as stream:
        digest = hashlib.file_digest(stream, "sha256").hexdigest()
    if digest != data["digest"]:
        raise RuntimeError("Task backup checksum failed; no files were restored")
    # gitformat-bundle: prerequisite records start with '-', before the blank
    # line ending the header. Complete migration bundles need no live branch.
    prerequisites = []
    with bundle.open("rb") as stream:
        if stream.readline() not in (b"# v2 git bundle\n", b"# v3 git bundle\n"):
            raise RuntimeError("Invalid task backup format")
        while (line := stream.readline()) != b"\n":
            if not line:
                raise RuntimeError("Incomplete task backup header")
            if line.startswith(b"-"):
                prerequisites.append(line[1:].split()[0].decode())
    if prerequisites:
        project = _need("CHEESE_PROJECT", PROJECT)
        task = _call("GET", f"/projects/{project}/git/tasks/{task_id}")["data"]
        if task["room_id"] != TOPIC:
            raise SystemExit("[cheese] 这条任务不属于当前房间")
        cache = Path.home() / ".cheese" / "repositories"
        cache.mkdir(parents=True, exist_ok=True)
        repo = cache / f"{project}.git"
        with (cache / f"{project}.lock").open("a") as lock:
            _lock(lock)
            _prepare_repository(repo, task)
            # By commit, not by the task's base branch: a stacked task's base is
            # deleted once it merges, and a machine that never had the task has
            # nothing else to fetch it by. The forge keeps those commits (a
            # merged PR keeps its head), and this copy already fetches objects
            # by id whenever it reads a file it holds no contents for.
            _git_task(repo, "fetch", "--filter=blob:none", "origin", *prerequisites)
            _git_task(repo, "bundle", "verify", str(bundle))
            _git_task(repo, "bundle", "unbundle", str(bundle))
            _git_task(repo, "worktree", "prune")
            _git_task(
                repo,
                "worktree",
                "add",
                "--detach",
                str(recovered),
                data["snapshot_sha"],
            )
    else:
        with tempfile.TemporaryDirectory(dir=recovery_root) as temporary:
            staging = Path(temporary) / "files"
            _git_task(recovery_root, "init", str(staging))
            _git_task(staging, "bundle", "verify", str(bundle))
            _git_task(staging, "bundle", "unbundle", str(bundle))
            _git_task(staging, "checkout", "--detach", data["snapshot_sha"])
            staging.rename(recovered)
    bundle.unlink()
    print(f"已恢复到独立目录：{recovered}\n原工作目录和评审分支均未覆盖。")


def _has_work_to_sync(worktree: Path) -> bool:
    """Whether `_sync_task` would deliver or back up anything from this checkout.

    Nothing, when its files are exactly its commit and that commit is already
    its branch on the forge as this checkout last pushed or fetched it: the
    push would be a no-op and the backup is the commit itself, already on the
    forge. Answered from the checkout alone, with no network call, because
    `sync --all` asks it of every task the room ever opened and a room keeps
    them all (56 in one room on dev): pushing each one again made a switch's
    push outlast its two minutes once a room was old enough. Anything this
    cannot read goes to the full sync, which reports its own failures.
    """
    try:
        # No index refresh: an agent may be using this checkout right now.
        if _git_task(worktree, "--no-optional-locks", "status", "--porcelain"):
            return True
        branch = _git_task(worktree, "symbolic-ref", "--short", "HEAD")
        pushed = _git_task(
            worktree, "rev-parse", "--verify", f"refs/remotes/origin/{branch}"
        )
        return not _is_ancestor(worktree, "HEAD", pushed)
    except RuntimeError:
        return True


def _sync_all_tasks() -> None:
    root = _task_root()
    if not root.exists():
        return
    failed = []
    for worktree in sorted(root.iterdir()):
        if not (worktree / ".git").exists():
            continue
        if not _has_work_to_sync(worktree):
            continue
        try:
            _sync_task(worktree.name)
        except (Exception, SystemExit) as exc:
            failed.append(worktree.name)
            # The platform reads these lines (`session_work._failed_tasks`).
            closed = isinstance(exc, _ClosedTaskNotBackedUp)
            which = "已结束的任务" if closed else "任务"
            print(f"[cheese] {which} {worktree.name} 同步失败：{exc}", file=sys.stderr)
    if failed:
        raise SystemExit(1)


CHECK_DIR = os.path.expanduser("~/.cache/cheese-check")


def _check_page(a: argparse.Namespace) -> None:
    """`cheese check`: the platform's browser renders the page, this prints
    what it saw and leaves the screenshots where the agent can open them."""
    try:
        html = open(a.path, encoding="utf-8").read()
    except (OSError, UnicodeDecodeError) as exc:
        print(f"[cheese] 无法读取 {a.path}: {exc}", file=sys.stderr)
        sys.exit(1)
    widths = (a.widths or [400, 1280])[:3]
    if any(not 200 <= w <= 2000 for w in widths):
        print("[cheese] --width 要在 200 到 2000 之间", file=sys.stderr)
        sys.exit(2)
    if a.pdf and not re.fullmatch(
        r"[0-9.]+(mm|cm|in|px)?( [0-9.]+(mm|cm|in|px)?)?", a.margin
    ):
        print('[cheese] --margin 写一个或两个长度,如 "0" 或 "16mm 18mm"', file=sys.stderr)
        sys.exit(2)
    body = {
        "html": html,
        "widths": widths,
        "color_scheme": "dark" if a.dark else "light",
        "pdf_margin": a.margin if a.pdf else None,
        "topic": TOPIC or None,
        "project": PROJECT or None,
    }
    started = monotonic()
    resp = _call("POST", "/page-check", body, tolerate=(503,), timeout=120)
    if resp.get("ok") is False and resp.get("status"):
        reason = (resp.get("error") or {}).get("message") or "渲染服务不可用"
        print(f"[cheese] 平台现在渲染不了:{reason}", file=sys.stderr)
        sys.exit(1)
    data = resp.get("data") or {}
    if not data.get("ok"):
        print(f"[cheese] 渲染失败:{data.get('error') or '未知原因'}", file=sys.stderr)
        sys.exit(1)
    os.makedirs(CHECK_DIR, exist_ok=True)
    stem = os.path.splitext(os.path.basename(a.path))[0] or "page"
    print(f"已渲染 {a.path}(用时 {monotonic() - started:.1f} 秒)")
    problems = 0
    errors: list[str] = []
    for view in data.get("views") or []:
        width = view["width"]
        shot = os.path.join(CHECK_DIR, f"{stem}-{width}.png")
        with open(shot, "wb") as out:
            out.write(base64.b64decode(view["png_b64"]))
        cut = f",只截了前 {view['cut_at']}px" if view.get("cut_at") else ""
        print(f"\n{width}px:截图 {shot}(整页高 {view['page_height']}px{cut})")
        if view["page_width"] > view["viewport_width"] + 1:
            problems += 1
            print(
                f"  页面被撑宽到 {view['page_width']}px,读者要横向滚动整页。"
                "撑宽它的元素:"
            )
            for item in view.get("overflowing") or []:
                print(f"  - {item['element']}:右边缘在 {item['right']}px")
        else:
            print("  宽度正常,没有横向撑破。")
        for item in view.get("clipped") or []:
            problems += 1
            print(f"  内容被裁掉 {item['hidden_px']}px:{item['element']}")
        for src in view.get("broken_images") or []:
            errors.append(f"图片没加载出来:{src}(页面只能用内联图片)")
        for text in view.get("console_errors") or []:
            errors.append(f"脚本报错:{text}")
        for url in view.get("failed_requests") or []:
            errors.append(f"请求失败:{url}")
    if a.pdf and data.get("pdf_b64"):
        pdf = base64.b64decode(data["pdf_b64"])
        with open(a.pdf, "wb") as out:
            out.write(pdf)
        pages = len(re.findall(rb"/Type\s*/Page(?!s)", pdf))
        print(f"\nPDF:{a.pdf}(A4,{pages} 页)")
    if errors:
        print()
        for line in dict.fromkeys(errors):
            problems += 1
            print(f"- {line}")
    print(
        "\n没有发现问题。看一眼截图就可以摆出来。"
        if not problems
        else "\n按上面的问题改一轮,再看一眼截图;不需要反复跑。"
    )


def _need(name: str, value: str) -> str:
    if not value:
        print(f"[cheese] 缺少 {name}（环境变量未注入）", file=sys.stderr)
        sys.exit(2)
    return value


def _pulled_path() -> Path:
    return Path.home() / ".cheese" / "pulled-versions.json"


def _pulled_versions() -> dict:
    """Which version of each room file this machine last read or wrote.

    It is what `cheese show` sends as `base_version`: the platform refuses a
    write whose base has since been replaced, so an edit made on an old copy
    cannot silently overwrite what a person saved in the editor."""
    try:
        return json.loads(_pulled_path().read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}


def _remember_pulled(topic: str, rel: str, version: str) -> None:
    versions = _pulled_versions()
    versions[f"{topic}:{rel}"] = version
    target = _pulled_path()
    target.parent.mkdir(parents=True, exist_ok=True)
    temporary = target.with_name(target.name + ".next")
    temporary.write_text(json.dumps(versions, ensure_ascii=False), encoding="utf-8")
    temporary.replace(target)


def _raw_request(
    method: str, path: str, data: str | None, out: str | None = None
) -> None:
    """One backend request on the container's existing auth (CHEESE_TOKEN), its
    body printed or saved as it came — for the downloads (a library file, a task
    backup) that land on this machine.

    `out` writes the body to a file as BYTES. Without it the body is decoded as
    text, which is right for JSON and destroys anything else: `decode(errors=
    "replace")` turns every byte over 0x7f into U+FFFD, so a PNG arrives with
    its own signature (`\x89PNG`) mangled and no way to tell that happened
    apart from the file not opening. Attachments are reachable over this
    channel, so text-only was not a limitation of the API — only of this
    function."""
    if not path.startswith("/"):
        path = "/" + path
    body = data.encode() if data else None
    req = urllib.request.Request(f"{API}{path}", data=body, method=method.upper())
    req.add_header("Content-Type", "application/json")
    if TOKEN:
        req.add_header("X-Cheese-Token", TOKEN)
    if TURN:
        req.add_header("X-Cheese-Turn", TURN)
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            payload = r.read()
    except urllib.error.HTTPError as e:
        # Surface the backend's error body (auth failures, validation, etc.)
        # verbatim so the caller sees exactly why — then exit non-zero. Always
        # as text: an error body is JSON even when the success body would not
        # have been, and writing it to `out` would leave a file that looks like
        # the download succeeded.
        print(e.read().decode(errors="replace"))
        sys.exit(1)
    except Exception as e:  # noqa: BLE001
        print(f"[cheese] api {method} {path} 出错: {e}", file=sys.stderr)
        sys.exit(1)
    if out:
        with open(out, "wb") as f:
            f.write(payload)
        print(f"已写入 {out}（{len(payload)} 字节）")
    else:
        print(payload.decode(errors="replace"))


def _format_status(d: dict) -> str:
    """Human/agent-readable rendering of /topics/{id}/status (盲飞防护): the
    turn's state, every accept card with its gate tail, and the platform
    waterlines — the questions agents used to hand-poll the API for.

    A running turn is shown as 正常运行中 or 接近硬顶, never as a live countdown
    of seconds. A literal "还剩 Ns" figure was observed making the agent rush
    against what's only ever meant to be a wedged-turn safety net."""
    lines: list[str] = []
    topic = d.get("topic") or {}
    head = f"话题: {topic.get('title', '?')}（{topic.get('status', '?')}"
    if topic.get("branch"):
        head += f", 分支 {topic['branch']}"
    lines.append(head + "）")
    turn = d.get("turn")
    if turn:
        t = f"本轮: {turn.get('status')}"
        if turn.get("status") == "running":
            if turn.get("near_ceiling"):
                t += "，接近硬顶（即将触发兜底结束）"
            else:
                t += "，正常运行中"
        elif turn.get("duration_s") is not None:
            t += f"，用时 {turn['duration_s']}s"
        if turn.get("detail"):
            t += f"（{turn['detail']}）"
        lines.append(t)
    cards = d.get("cards") or []
    lines.append(f"验收卡: {len(cards)} 张" if cards else "验收卡: 无")
    for c in cards:
        row = f"- [{c.get('status')}] 递给 @{c.get('reviewer')}"
        if c.get("decided_by"):
            row += f"，{c['decided_by']} 处理于 {c.get('decided_at')}"
        if c.get("note"):
            row += f"；note: {c['note']}"
        lines.append(row)
        if c.get("pr_url"):
            lines.append(f"  PR: #{c.get('pr_number')} {c['pr_url']}")
            # The repo name is already sitting in the PR url — spell the CI
            # lookup out rather than leaving "用 gh 查" as an exercise.
            m = re.match(r"https://github\.com/([^/]+/[^/]+)/pull/", c["pr_url"])
            if m:
                lines.append(
                    f"  查 CI: gh api repos/{m.group(1)}/commits/<head_sha>/check-runs"
                )
        if c.get("status") == "gate_failed" and c.get("gate_output_tail"):
            lines.append("  闸门输出（尾部）:")
            lines.extend("    " + ln for ln in c["gate_output_tail"].splitlines()[-15:])
    bg = d.get("background") or {}
    for t in bg.get("tasks") or []:
        lines.append(
            f"后台任务: 「{t.get('label')}」已跑 {t.get('running_s')}s"
            f"（上限 {t.get('timeout_s')}s）；输出: {t.get('log_path')}"
        )
    plat = d.get("platform") or {}
    disk = plat.get("disk")
    if disk:
        lines.append(
            f"磁盘: 可用 {disk.get('free_gb')}G / {disk.get('total_gb')}G"
            f"（已用 {disk.get('used_pct')}%）"
        )
    credits = plat.get("credits") or {}
    cred = "不限" if credits.get("unlimited") else f"剩 {credits.get('remaining')}"
    lines.append(
        f"并发: 全站运行中 {plat.get('active_turns', '?')} 轮，"
        f"本项目排队 {plat.get('queued_turns', 0)}；额度: {cred}"
    )
    return "\n".join(lines)


# `cheese serve` 报端口之前先敲一次应用,敲通了才算「起来了」。
#
# 为什么:agent 习惯 `nohup vite &` 把 dev server 丢到后台,紧跟着就 `cheese serve`——
# 这时 vite 常常还没开始监听。平台那边敲端口敲不通会当场拒绝,用户看到的是一闪而过
# 的白框,agent 却以为报上去了。探一下就不会:应用已经在听的(常见情况)立刻返回;
# 还在起的,等它应答再报,最多等这么久。
_SERVE_WAIT_DEFAULT_S = 30.0
# 单次探测的超时和两次探测的间隔。前者要短:每个探测都得在超时前自己结束,不然一个
# 挂着不回的 socket 会把整段等待吃掉;后者别太密,免得对着还在启动的进程打满。
_SERVE_PROBE_TIMEOUT_S = 2.0
_SERVE_PROBE_INTERVAL_S = 0.5
# 浏览器式的请求头。有的服务器对 curl 和浏览器的应答不一样(vite dev 给浏览器发 SPA
# 外壳),探「应用起没起来」就得像浏览器那样问一次。
_SERVE_PROBE_HEADERS = {
    "User-Agent": "Mozilla/5.0 (cheese serve readiness probe)",
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
    "Accept-Language": "zh-CN,zh;q=0.9,en;q=0.8",
}


def _probe_app(port: int) -> int | None:
    """对 127.0.0.1:port 敲一次。

    通了就返回 HTTP 状态码(4xx/5xx 也算「在应答」,只是这个路径不对);连不上、
    超时、收了半截,或端口上坐的是个不讲 HTTP 的服务(SSH/数据库这类先打招呼
    的非 HTTP 监听)都返回 None。
    """
    request = urllib.request.Request(
        f"http://127.0.0.1:{port}/", headers=_SERVE_PROBE_HEADERS, method="GET"
    )
    try:
        with urllib.request.urlopen(
            request, timeout=_SERVE_PROBE_TIMEOUT_S
        ) as response:
            return response.status
    except urllib.error.HTTPError as exc:
        # 收到应答了,只是不是 2xx/3xx——应用在跑,但这个路径不是它的家。
        return exc.code
    except (
        urllib.error.URLError,
        OSError,
        ValueError,
        # 端口上是个非 HTTP 的监听:首行不是状态行,http.client 抛 BadStatusLine
        # (HTTPException,不是 OSError)。这类端口也是「敲不通」,不该把它抛给 caller
        # 炸掉整个 serve。
        http.client.HTTPException,
    ):
        return None


def _wait_for_app(port: int, timeout_s: float) -> int | None:
    """等应用应答,最多等 timeout_s 秒。

    任何 HTTP 应答(2xx/3xx/4xx/5xx 都算)就立刻返回——端口有人在听、能应答,
    平台那一敲就通,4xx/5xx 也只是根路径不对,再等下去纯属空等。返回最后看到的
    状态码;返回 None 表示这段时间里一直没人应答(端口没人听)。
    """
    deadline = monotonic() + timeout_s
    while True:
        status = _probe_app(port)
        if status is not None:
            return status
        remaining = deadline - monotonic()
        if remaining <= 0:
            return None
        sleep(min(_SERVE_PROBE_INTERVAL_S, remaining))


def source_fingerprint() -> str:
    """A short digest of THIS file's bytes.

    The box's `cheese` is bind-mounted from the backend's own copy, so the only
    way to tell — from inside a box — whether that plumbing actually worked is
    to compare what runs here against what the backend shipped. `cheese
    --version` prints this; a mismatch means the mount is stale."""
    try:
        with open(__file__, "rb") as f:
            return hashlib.sha256(f.read()).hexdigest()[:12]
    except OSError:
        return "unknown"


