def _tool(name: str, description: str, properties=None, required=()) -> dict:
    schema: dict = {"type": "object", "properties": properties or {}}
    if required:
        schema["required"] = list(required)
    return {"name": name, "description": description, "inputSchema": schema}


def _text(description: str) -> dict:
    return {"type": "string", "description": description}


def _verb(description: str, properties=None, required=()) -> dict:
    """One verb of a tool for one object (`_object`): what it does, and the
    parameters it takes."""
    return {
        "description": description,
        "properties": properties or {},
        "required": list(required),
    }


def _object(name: str, subject: str, actions: dict) -> dict:
    """One tool for one object: `action` picks the verb (`_verb`).

    `subject` names the object and nothing more ("文档", "这场会话自己"): the
    description is that name followed by one line per verb, so a tool narrowed
    to some of its verbs (`ToolTable.narrowed`) describes only what it kept.

    The schema stays flat: an `action` enum first, then every verb's
    parameters, each saying which verbs take it. No `oneOf` / `anyOf`: the same
    schema goes through three harnesses' tool mechanisms and the
    Anthropic-compatible gateways behind them, and the rest of the table uses
    none. What one verb takes is checked when it is called (`_checked`), so a
    parameter meant for another verb is refused rather than dropped."""
    properties: dict = {
        "action": {
            "type": "string",
            "enum": list(actions),
            "description": "做哪一件；每个参数的说明写着哪几件收它",
        }
    }
    takers: dict[str, list[tuple[str, dict, bool]]] = {}
    for verb, spec in actions.items():
        for param, schema in spec["properties"].items():
            takers.setdefault(param, []).append(
                (verb, schema, param in spec["required"])
            )
    for param, used in takers.items():
        shape = {k: v for k, v in used[0][1].items() if k != "description"}
        if any(
            {k: v for k, v in schema.items() if k != "description"} != shape
            for _, schema, _ in used
        ):
            raise ValueError(f"{name}.{param} is not one shape across its verbs")
        said: dict[tuple[str, bool], list[str]] = {}
        for verb, schema, required in used:
            said.setdefault((schema.get("description") or "", required), []).append(
                verb
            )
        properties[param] = {
            **shape,
            "description": "；".join(
                f"{'、'.join(verbs)}{'（必填）' if required else ''}：{text}"
                for (text, required), verbs in said.items()
            ),
        }
    lines = [f"- {verb}：{spec['description']}" for verb, spec in actions.items()]
    return {
        "name": name,
        "description": f"{subject}：\n" + "\n".join(lines),
        "inputSchema": {
            "type": "object",
            "properties": properties,
            "required": ["action"],
        },
        "actions": actions,
        "summary": subject,
    }


