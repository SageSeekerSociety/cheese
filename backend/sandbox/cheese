#!/usr/bin/env python3
"""cheese — 芝士 的平台 CLI（在沙箱里调,平台动作走 REST,不用 MCP）。

代码/文件的事用原生工具（Bash/Write/Read）；改平台状态的事用本 CLI。
环境变量（容器注入）：
  CHEESE_API     平台 API 基址，如 http://host.docker.internal:8099/api
  CHEESE_PROJECT 当前项目 id
  CHEESE_TOPIC   当前话题 id
  CHEESE_AUTHOR  当前作者 handle（默认 cheese）

例:
  cheese doc set DOC.md            # 把 DOC.md 设为本话题活文档
  cheese doc get                   # 打印本话题活文档
  cheese split "数据清洗"           # 拆出子话题
  cheese decision "用 item-based CF" # 记一条决策
  cheese remember "技术栈=FastAPI"  # 记入项目记忆
  cheese recall "技术选型"          # 按需检索记忆(语义搜索)
  cheese notify --title "看下" --to mentor-1 --level strong --kind decision_request --options "A|B"
  cheese accept-request mentor-1 "中期验收"  # 递验收卡
  cheese conclude "原型完成,Recall@10=0.18"  # 子话题结论回流
  cheese milestone "中期汇报" --due 2026-06-20
  cheese await "bash .claude/scripts/check.sh --full"  # 后台跑;跑完平台叫醒本话题
  cheese status                             # 平台状态快照(本轮运行状态/验收卡/闸门输出/水位)
  cheese artifact report.html               # 把产物设为本话题当前预览(进预览窗口)
  cheese serve "Vue dev server"             # 应用跑在 0.0.0.0:$CHEESE_APP_PORT 后,设为预览
  cheese artifact chart.svg --as svg        # SVG 同理
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import sys
import urllib.error
import urllib.request

API = os.environ.get("CHEESE_API", "http://host.docker.internal:8099/api").rstrip("/")
PROJECT = os.environ.get("CHEESE_PROJECT", "")
TOPIC = os.environ.get("CHEESE_TOPIC", "")
AUTHOR = os.environ.get("CHEESE_AUTHOR", "cheese")
TOKEN = os.environ.get("CHEESE_TOKEN", "")
# The agent turn this CLI call belongs to — sent back so the blocks it creates
# share the turn's id (R4).
TURN = os.environ.get("CHEESE_TURN", "")
# In a private chat, `remember` writes the owner's personal memory (跟着人走).
MEMORY_SCOPE = os.environ.get("CHEESE_MEMORY_SCOPE", "project")
OWNER = os.environ.get("CHEESE_OWNER", "")


def _call(
    method: str, path: str, body: dict | None = None, *, token: str | None = None
) -> dict:
    url = f"{API}{path}"
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method)
    req.add_header("Content-Type", "application/json")
    auth = token if token is not None else TOKEN
    if auth:
        req.add_header("X-Cheese-Token", auth)
    if TURN:
        req.add_header("X-Cheese-Turn", TURN)
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        detail = e.read().decode(errors="replace")[:400]
        print(f"[cheese] {method} {path} 失败 HTTP {e.code}: {detail}", file=sys.stderr)
        sys.exit(1)
    except Exception as e:  # noqa: BLE001
        print(f"[cheese] {method} {path} 出错: {e}", file=sys.stderr)
        sys.exit(1)


def _need(name: str, value: str) -> str:
    if not value:
        print(f"[cheese] 缺少 {name}（环境变量未注入）", file=sys.stderr)
        sys.exit(2)
    return value


def _api_root() -> str:
    """The app root (where /openapi.json lives), i.e. CHEESE_API without the
    trailing /api mount prefix."""
    return API[: -len("/api")] if API.endswith("/api") else API


def _raw_request(method: str, path: str, data: str | None) -> None:
    """Raw API escape hatch (fusion-design §5.2): hit our backend directly with
    the container's existing auth (CHEESE_TOKEN), printing the response body
    verbatim. NOT a no-auth backdoor — it still carries the token, and the
    backend still authorizes the actor per call; it is just the low-ceremony
    channel for the 20% of cases the curated commands don't cover. Prefer the
    curated `cheese <verb>` commands (title/doc/ask/remember/...) — see SKILL.md."""
    if not path.startswith("/"):
        path = "/" + path
    body = data.encode() if data else None
    req = urllib.request.Request(f"{API}{path}", data=body, method=method.upper())
    req.add_header("Content-Type", "application/json")
    if TOKEN:
        req.add_header("X-Cheese-Token", TOKEN)
    if TURN:
        req.add_header("X-Cheese-Turn", TURN)
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            print(r.read().decode(errors="replace"))
    except urllib.error.HTTPError as e:
        # Surface the backend's error body (auth failures, validation, etc.)
        # verbatim so the caller sees exactly why — then exit non-zero.
        print(e.read().decode(errors="replace"))
        sys.exit(1)
    except Exception as e:  # noqa: BLE001
        print(f"[cheese] api {method} {path} 出错: {e}", file=sys.stderr)
        sys.exit(1)


def _format_status(d: dict) -> str:
    """Human/agent-readable rendering of /topics/{id}/status (盲飞防护): the
    turn's state, every accept card with its gate tail, and the platform
    waterlines — the questions agents used to hand-poll the API for.

    turn 活跃度检测 (2026-08-09): a running turn is shown as one of three states
    — 正常运行中 / 疑似卡死（已 X 分钟无活跃信号）/ 接近硬顶 — never as a live
    countdown of seconds. A literal "还剩 Ns" figure was observed making the
    agent rush against what's only ever meant to be a wedged-turn safety net."""
    lines: list[str] = []
    topic = d.get("topic") or {}
    head = f"话题: {topic.get('title', '?')}（{topic.get('status', '?')}"
    if topic.get("branch"):
        head += f", 分支 {topic['branch']}"
    lines.append(head + "）")
    turn = d.get("turn")
    if turn:
        t = f"本轮: {turn.get('status')}"
        if turn.get("status") == "running":
            activity = turn.get("activity") or {}
            suspect_s = activity.get("suspect_since_s_ago")
            if suspect_s is not None:
                t += f"，疑似卡死（已 {round(suspect_s / 60)} 分钟无活跃信号，正在探活确认）"
            elif turn.get("near_ceiling"):
                t += "，接近硬顶（即将触发兜底结束）"
            else:
                t += "，正常运行中"
        elif turn.get("duration_s") is not None:
            t += f"，用时 {turn['duration_s']}s"
        if turn.get("detail"):
            t += f"（{turn['detail']}）"
        lines.append(t)
    cards = d.get("cards") or []
    lines.append(f"验收卡: {len(cards)} 张" if cards else "验收卡: 无")
    for c in cards:
        row = f"- [{c.get('status')}] 递给 @{c.get('reviewer')}"
        if c.get("decided_by"):
            row += f"，{c['decided_by']} 处理于 {c.get('decided_at')}"
        if c.get("note"):
            row += f"；note: {c['note']}"
        lines.append(row)
        if c.get("pr_url"):
            lines.append(
                f"  PR: #{c.get('pr_number')} {c['pr_url']}"
                "（CI 状态: GH_TOKEN=$(cheese gh-token) 后用 gh 查）"
            )
        if c.get("status") == "gate_failed" and c.get("gate_output_tail"):
            lines.append("  闸门输出（尾部）:")
            lines.extend(
                "    " + ln for ln in c["gate_output_tail"].splitlines()[-15:]
            )
    plat = d.get("platform") or {}
    disk = plat.get("disk")
    if disk:
        lines.append(
            f"磁盘: 可用 {disk.get('free_gb')}G / {disk.get('total_gb')}G"
            f"（已用 {disk.get('used_pct')}%）"
        )
    credits = plat.get("credits") or {}
    cred = "不限" if credits.get("unlimited") else f"剩 {credits.get('remaining')}"
    lines.append(
        f"并发: 全站运行中 {plat.get('active_turns', '?')} 轮，"
        f"本项目排队 {plat.get('queued_turns', 0)}；额度: {cred}"
    )
    return "\n".join(lines)


# --- await: 后台跑长任务，跑完平台自动叫醒本话题 -------------------------------
#
# Why this exists: ending a turn to "wait for" a background command used to
# freeze the topic — nothing on the platform starts a new turn when a detached
# process exits. `cheese await` registers the command with the platform, runs it
# in a detached child here in the sandbox (where the venv/toolchain is warm), and
# the child reports the exit code + output tail back when it finishes; the
# platform lands that in the timeline and wakes the topic.
#
# The reporting token comes from registration, NOT from CHEESE_TOKEN: the
# container's own token expires in an hour and these tasks are longer than that.

_AWAIT_TAIL_BYTES = 4000
# Same cadence the backend uses for its own at-least-once deliveries.
_AWAIT_RETRY_DELAYS = (0, 5, 30)


def _await_log_path(run_id: str) -> str:
    """Where a backgrounded command's full output goes. Deliberately OUTSIDE the
    worktree: these logs would otherwise be committed with the topic's work."""
    home = os.environ.get("HOME") or "/tmp"
    log_dir = os.path.join(home, ".cheese", "await")
    os.makedirs(log_dir, exist_ok=True)
    return os.path.join(log_dir, f"{run_id}.log")


def _await_start(command: str, label: str, timeout_s: int) -> None:
    """Register the command, fork the detached runner, and return immediately."""
    import subprocess
    import time

    topic = _need("CHEESE_TOPIC", TOPIC)
    run_id = f"{int(time.time())}-{os.getpid()}"
    log_path = _await_log_path(run_id)
    data = _call(
        "POST",
        f"/topics/{topic}/background-task",
        {
            "command": command,
            "label": label,
            "timeout_s": timeout_s,
            "log_path": log_path,
        },
    ).get("data", {})
    task_id = data.get("task_id", "")

    child_env = dict(os.environ)
    # Via env, not argv: the wake token has a long life and `ps` is world-readable.
    child_env["CHEESE_AWAIT_TOKEN"] = data.get("wake_token", "")
    subprocess.Popen(  # noqa: S603 — our own script, fixed argv
        [
            sys.executable,
            os.path.abspath(__file__),
            "__await-child",
            task_id,
            command,
            log_path,
            str(timeout_s),
        ],
        env=child_env,
        cwd=os.getcwd(),
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        # Its own session, so it outlives this shell AND the turn that spawned it.
        start_new_session=True,
    )
    print(
        f"[cheese] 已在后台开跑：{data.get('label') or command}\n"
        f"  完整输出: {log_path}\n"
        f"  跑完平台会自动叫醒本话题，并带上退出码和输出尾巴——"
        f"你可以安心结束本轮，不用干等（上限 {timeout_s}s）。"
    )


def _await_child(task_id: str, command: str, log_path: str, timeout_s: int) -> None:
    """The detached runner: run the command, then report how it ended.

    Never raises past this frame — a crash here is a topic that never wakes up,
    which is the exact failure this whole path exists to remove."""
    import signal
    import subprocess
    import time

    started = time.time()
    exit_code = -1
    try:
        with open(log_path, "wb") as log:
            proc = subprocess.Popen(  # noqa: S602 — the agent's own command, by design
                ["bash", "-lc", command],
                stdout=log,
                stderr=subprocess.STDOUT,
                stdin=subprocess.DEVNULL,
                start_new_session=True,
            )
            try:
                exit_code = proc.wait(timeout=timeout_s)
            except subprocess.TimeoutExpired:
                # Kill the whole process group: a build/test runner's children
                # would otherwise survive and keep writing to the log.
                try:
                    os.killpg(os.getpgid(proc.pid), signal.SIGKILL)
                except OSError:
                    proc.kill()
                proc.wait()
                exit_code = 124  # `timeout(1)`'s convention
    except Exception as e:  # noqa: BLE001 — report the failure, never vanish
        with open(log_path, "a", encoding="utf-8") as log:
            log.write(f"\n[cheese await] 命令无法执行: {e}\n")

    _await_report(
        task_id,
        exit_code=exit_code,
        tail=_await_tail(log_path),
        duration_s=time.time() - started,
    )


def _await_tail(log_path: str) -> str:
    try:
        with open(log_path, "rb") as f:
            f.seek(0, os.SEEK_END)
            f.seek(max(0, f.tell() - _AWAIT_TAIL_BYTES))
            return f.read().decode(errors="replace")
    except OSError as e:
        return f"（读不到输出日志 {log_path}: {e}）"


def _await_report(
    task_id: str, *, exit_code: int, tail: str, duration_s: float
) -> None:
    """POST the result, retrying — a dropped report is a frozen topic."""
    import time

    topic = os.environ.get("CHEESE_TOPIC", "")
    token = os.environ.get("CHEESE_AWAIT_TOKEN", "")
    url = f"{API}/topics/{topic}/background-task/{task_id}/done"
    body = json.dumps(
        {"exit_code": exit_code, "tail": tail, "duration_s": duration_s}
    ).encode()
    for delay in _AWAIT_RETRY_DELAYS:
        if delay:
            time.sleep(delay)
        req = urllib.request.Request(url, data=body, method="POST")
        req.add_header("Content-Type", "application/json")
        if token:
            req.add_header("X-Cheese-Token", token)
        try:
            with urllib.request.urlopen(req, timeout=30) as r:
                r.read()
            return
        except Exception:  # noqa: BLE001 — retry, then give up quietly
            continue


def _print_api_index() -> None:
    """List available operations from our FastAPI /openapi.json (like Restish,
    but built from OUR live spec). Lets `cheese api` self-describe what raw calls
    are possible without hardcoding anything."""
    url = f"{_api_root()}/openapi.json"
    try:
        with urllib.request.urlopen(url, timeout=20) as r:
            spec = json.load(r)
    except Exception as e:  # noqa: BLE001
        print(f"[cheese] 拉取 openapi 失败: {e}", file=sys.stderr)
        sys.exit(1)
    print("可用的原始 API 操作（优先用 curated 命令，这些是兜底逃生口）：")
    for path in sorted(spec.get("paths", {})):
        methods = spec["paths"][path]
        for method in sorted(methods):
            if method.lower() in ("get", "post", "put", "delete", "patch"):
                print(f"  {method.upper():6} {path}")
    print("\n用法: cheese api <METHOD> <path> [--data '<json>']")
    print("例:   cheese api GET /topics/$CHEESE_TOPIC/blocks")


def source_fingerprint() -> str:
    """A short digest of THIS file's bytes.

    The box's `cheese` is bind-mounted from the backend's own copy, so the only
    way to tell — from inside a box — whether that plumbing actually worked is
    to compare what runs here against what the backend shipped. `cheese
    --version` prints this; a mismatch means the mount is stale."""
    try:
        with open(__file__, "rb") as f:
            return hashlib.sha256(f.read()).hexdigest()[:12]
    except OSError:
        return "unknown"


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="cheese",
        description=(
            "芝士 平台 CLI —— 改「平台状态」用它,改「文件/代码」用原生工具。\n"
            "\n"
            "每个子命令的 --help 是权威的那一份(它和代码同源,不会过期)。\n"
            "散文文档(SKILL.md / CLAUDE.md / .claude/rules/)只补 --help 说不了的东西。"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument(
        "--version",
        action="version",
        version=f"cheese {source_fingerprint()}",
        help="打印源码指纹,用来核对本容器里的 CLI 是不是后端那一份",
    )
    sub = p.add_subparsers(dest="cmd", required=True)

    pd = sub.add_parser(
        "doc",
        help="活文档",
        description=(
            "活文档 = 本话题的状态摘要,也是你跨轮的记忆。"
            "话题标题会被渲染成文档大标题,正文别再用一级标题重复一遍。"
        ),
    )
    pdsub = pd.add_subparsers(dest="doccmd", required=True)
    pdset = pdsub.add_parser(
        "set",
        help="把文件设为本话题活文档",
        description=(
            "整块覆盖,没有版本历史,也没有并发控制。人在文档面板上编辑是 2.5 秒"
            "自动保存的,你 set 上去就把人刚写的东西盖掉了、且捞不回来。"
            "所以:改之前先 doc get 看一眼,做增量改写,别拿一份旧内容直接覆盖。"
        ),
    )
    pdset.add_argument(
        "file",
        help="工作区里的 markdown 文件路径(放 docs/topics/ 下,别堆在仓库根目录)",
    )
    pdsub.add_parser(
        "get",
        help="打印本话题活文档",
        description="打印当前活文档原文。set 之前先跑一次,免得覆盖掉别人的改动。",
    )

    ps = sub.add_parser(
        "split",
        help="拆出子话题（分身自动开工）",
        description=(
            "拆出一个子话题,平台立刻起一个分身去做它。\n"
            "\n"
            "分身开工时能看到的只有两样东西,都来自本命令:\n"
            "  1. --brief 的原文(标题为「拆分意图」)\n"
            "  2. 本话题当前活文档的快照(平台自动附上,不用你复制)\n"
            "它看不到本话题的对话历史。简报里没写的前提,它就是不知道。\n"
            "\n"
            "分身跑在一个独立沙箱里,工作区是从 main 新建的 jj workspace:\n"
            "  - 本话题工作区里 gitignored 的东西(reference/、tmp/、clone 下来的\n"
            "    参照仓库、装好的依赖)都不会跟过去,要它用就在简报里写清怎么自己弄\n"
            "  - 它写的文件必须落在自己工作区的相对路径下,写 /tmp 会丢\n"
            "  - 它和你并行改同一个仓库,会撞车的地方(同一个文件/同一份配置)要在\n"
            "    简报里划成硬边界\n"
            "\n"
            "split 是唯一会生出另一个 agent 的动作,没有深度/频率上限。"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    ps.add_argument("title", help="子话题标题,≤12 字最好")
    ps.add_argument(
        "--brief",
        default=None,
        help=(
            "任务简报,分身的全部起点:要干什么、硬边界(别碰哪些文件/别做哪些事)、"
            "验收标准(做到什么程度算完)、已知但未核实的事实要标出来。"
            "不用重复父话题活文档(平台会自动附快照)。"
            "不填的话分身只有标题和那份快照,基本等于让它自己猜。"
        ),
    )

    paw = sub.add_parser(
        "await",
        help="把长命令丢到后台跑；跑完平台自动叫醒本话题并带上退出码+输出尾巴",
        description=(
            "要等几分钟以上的命令一律走它:全量检查、构建、长跑脚本。\n"
            "\n"
            "命令在后台跑,本命令立刻返回。跑完平台会自动开一轮新的把你叫醒,"
