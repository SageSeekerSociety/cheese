    if tool == "cheese_skill.update":
        where = urllib.parse.quote(topic)
        skill = urllib.parse.quote(args["skill"], safe="")
        body = {
            "reason": args["reason"],
            **_given(args, "title", "description", "body", "files"),
        }
        return {
            "method": "PATCH",
            "path": f"/skills/{skill}?topic={where}",
            "body": body,
        }
    if tool == "cheese_skill.search":
        # 房间是必须的：已装技能按这个项目、这台机器算，不带房间就不知道是谁的。
        return {
            "method": "POST",
            "path": "/agent/skills/search",
            "body": {"query": args["query"], "topic": topic},
        }
    if tool == "cheese_skill.read":
        return {
            "method": "POST",
            "path": "/agent/skills/read",
            "body": {"name": args["name"], "topic": topic},
        }
    if tool == "cheese_room.members":
        return {"method": "GET", "path": f"/topics/{topic}/members"}
    if tool == "cheese_session.status":
        return {"method": "GET", "path": f"/topics/{topic}/status"}
    raise ValueError(f"No direct platform request plan for {tool}")


class PlatformToolError(Exception):
    """A refusal the agent reads as written: what happened and what to do next."""


class Said(str):
    """What a tool says, with pictures for an agent that can look at them:
    `images` holds {"data": base64, "mimeType": ...}. Every caller takes it as
    the text it is; a session runner that can hand pictures to its model (pi,
    Codex) hands these over as well. `subject` is what the call acted on, the
    way a person knows it (「空间「操作系统」」): a person's 芝士 shows it as
    the call's step (`_subject`)."""

    images: tuple = ()
    subject: str = ""

    def __new__(cls, text: str, images=(), subject: str = ""):
        said = super().__new__(cls, text)
        said.images = tuple(images)
        said.subject = subject
        return said


class PlatformHTTPError(RuntimeError):
    """The backend answered, and not with success. `status` is what callers branch
    on; the message keeps the backend's own words for the agent."""

    def __init__(self, status: int, body: str):
        super().__init__(f"Platform HTTP {status}: {body}")
        self.status = status
        self.body = body


def run_platform_tool(tool: str, args: dict, host, *, delegated: bool = False) -> str:
    """Run one tool from `PLATFORM_TOOLS` or `DELEGATED_TOOLS` and say, in
    text, what came of it.

    `host` is where the session runs, and supplies the three things a tool can
    need: `environ` (the room's CHEESE_* values), `request(plan)` (one backend
    request, the parsed JSON back, `PlatformHTTPError` otherwise),
    `sync_task(task_id)` (the one that needs the machine),
    plus a `doc_versions` dict that outlives a single call. The text is what the
    agent acts on — ids, the next call to make — so it is written for that
    reader, not dumped JSON.

    `delegated` says the call is made under a delegated credential (a
    person's 芝士, a document's): an object both tables have (`cheese_task`)
    is then the delegated one, which acts for the person asking. Such a call
    runs only if its table says what it does (`ToolTable.effect`), and one that
    reaches others runs only once the gate takes it (`_reviewed`): this is the
    harness's check before the tool, as Claude Code's is, and the tool itself
    just acts as the person."""
    tables = (PLATFORM_TOOLS, DELEGATED_TOOLS)
    if delegated:
        tables = tables[::-1]
    table = next((t for t in tables if tool in t), None)
    if table is None:
        raise ValueError(f"Unknown platform tool: {tool}")
    if f"{tool}.{args.get('action')}" == COMPACT_TOOL and not switched_on(
        getattr(host, "environ", None)
    ):
        _, _, compact = COMPACT_TOOL.partition(".")
        offered = [verb for verb in table.actions(tool) or () if verb != compact]
        raise PlatformToolError(
            "这个部署没有给这个座位打开主动压缩上下文；" + ask_for_action(tool, offered)
        )
    # 拒在发出任何请求、碰任何机器之前：一张已经递出去的卡收不回来。
    actions = table.actions(tool)
    if actions is None:
        schema = next(t for t in table.schemas() if t["name"] == tool)
        _refuse_missing(tool, schema["inputSchema"].get("required", ()), args)
        key = tool
    else:
        key = f"{tool}.{_checked(tool, actions, args, table)}"
    if delegated:
        effect = table.effect(key)
        if effect is None:
            raise PlatformToolError(f"{key} 没有说明它做什么，不能替用户调用")
        if effect == REACHES_OTHERS:
            said = _reviewed(key, args, host)
            if said is not None:
                return said
    step = (
        _DELEGATED_STEPS.get(key) if table is DELEGATED_TOOLS else None
    ) or _STEPS.get(key)
    data = None
    try:
        if step is not None:
            said = step(args, host)
        else:
            plan = request_plan(key, args, host.environ)
    except ValueError as exc:
        raise PlatformToolError(str(exc)) from exc
    if step is None:
        data = host.request(plan).get("data")
        said = _SAY[key](args, data, host.environ)
    if not delegated or getattr(said, "subject", ""):
        return said
    return Said(said, getattr(said, "images", ()), _subject(key, args, data))


#: What a read that names nothing in particular read, by the ref it was given.
_READ_WHOLE = {
    "me": "你领取的题目",
    "settings": "你的通知设置",
    "library": "你的资料库",
}


def _subject(key: str, args: dict, data) -> str:
    """What one call of a person's 芝士 acted on, the way the person knows it:
    shown as its step in place of the reference it was given. Where the
    backend knows the name it says it (`subject` in its answer); what the
    call's own arguments name is named here. Empty when neither names one."""
    given = data.get("subject") if isinstance(data, dict) else None
    if isinstance(given, str) and given.strip():
        return given.strip()
    if key == "cheese_read":
        ref = (args.get("ref") or "").strip().strip("/")
        if ref in _READ_WHOLE:
            return _READ_WHOLE[ref]
        if ref.startswith("library/"):
            return f"资料库「{ref.rsplit('/', 1)[-1]}」"
        return ""
    if key in ("cheese_find", "cheese_project_search", "cheese_web.search"):
        return (args.get("query") or "").strip()
    if key == "cheese_help":
        if args.get("page"):
            title = data.get("title") if isinstance(data, dict) else None
            return f"帮助文档「{title or args['page']}」"
        return f"帮助文档：{(args.get('query') or '').strip()}"
    if key == "cheese_web.fetch":
        return _page_named(args.get("url") or "")
    if key in ("cheese_memory.read", "cheese_memory.save", "cheese_memory.forget"):
        return f"记忆「{(args.get('name') or '').strip()}」"
    if key == "cheese_memory.project":
        return f"项目记忆「{(args.get('name') or '').strip()}」"
    if key == "cheese_library.read":
        return f"资料库「{(args.get('path') or '').rstrip('/').rsplit('/', 1)[-1]}」"
    return ""


def _page_named(url: str) -> str:
    """A web page as a step names it: its site, or a documentation site's
    index (`llms.txt`) as that."""
    parts = urllib.parse.urlsplit(url.strip())
    if parts.path.rstrip("/").endswith("/llms.txt"):
        return (
            "帮助文档目录"
            if "okcheese" in parts.netloc
            else f"{parts.netloc} 的文档目录"
        )
    return parts.netloc or url.strip()


def _unsaid(value) -> bool:
    """「没说」：省略，或者给了个空的（`_given` 同样不发它）。"""
    return value in (None, "", [])


def _refuse_missing(call: str, required, args: dict) -> None:
    missing = [name for name in required if _unsaid(args.get(name))]
    if missing:
        raise PlatformToolError(f"{call} 缺少参数：{', '.join(missing)}")


def ask_for_action(tool: str, verbs) -> str:
    """What a call to `tool` is told when it names none of `verbs`, the ones
    this session has: the session may hold only some of the object's
    (`ToolTable.narrowed`), and those are the ones it can try instead."""
    return f"{tool} 要 action：{' / '.join(verbs)}"


def _checked(tool: str, actions: dict, args: dict, table: ToolTable) -> str:
    """The verb a call to `tool` (`_object`) asks for, once it is known to
    carry what that verb takes and nothing it does not.

    A parameter that belongs to another verb is refused, not dropped: dropped,
    the call does something other than what the agent meant and says it
    succeeded. Each refusal names what to pass instead."""
    action = args.get("action")
    if not isinstance(action, str) or action not in actions:
        raise PlatformToolError(ask_for_action(tool, actions))
    call = f"{tool}(action={action})"
    spec = actions[action]
    _refuse_missing(call, spec["required"], args)
    stray = [
        name
        for name, value in args.items()
        if name != "action" and name not in spec["properties"] and not _unsaid(value)
    ]
    if stray:
        where = []
        for name in stray:
            takers = [
                f"{other}(action={verb})"
                for other in table.names()
                for verb, taken in (table.actions(other) or {}).items()
                if name in taken["properties"]
            ]
            where.append(
                f"{name} 是 {'、'.join(takers)} 的参数"
                if takers
                else f"没有哪一件收 {name}"
            )
        takes = "、".join(spec["properties"]) or "不收参数"
        raise PlatformToolError(
            f"{call} 不收 {', '.join(stray)}：{'；'.join(where)}。"
            f"{call} 收的是：{takes}。"
        )
    return action


def _utc_stamp(value: str) -> str:
    """An instant from the API, written so its zone cannot be missed.

    A bare `2026-10-07T07:52:42Z` reads as a wall-clock time, and an agent copies
    `07:52` into a document for someone whose clock said 00:52. Spelled out with
    `UTC` it is a time to convert, not one to quote. Anything unparseable is
    passed through as given.
    """
    try:
        # `Z` is read by fromisoformat only from 3.11; this also runs on 3.9.
        moment = datetime.fromisoformat(value.replace("Z", "+00:00"))
    except (TypeError, ValueError):
        return value
    if moment.tzinfo is None:
        return value
    return moment.astimezone(UTC).strftime("%Y-%m-%d %H:%M:%S UTC")


def _chat_message_text(block: dict) -> str:
    """Keep typed payloads visible, including fields added by future messages."""
    lines = [
        f"[{_utc_stamp(block.get('created_at') or '')}] {block.get('author', '')} "
        f"({block.get('author_type', '')}, {block.get('kind', '')}) id={block['id']}"
    ]
    for key, value in block.items():
        if key in {"id", "created_at", "author", "author_type", "kind", "content"}:
            continue
        if value is not None and value != [] and value != {}:
            lines.append(
                f"{key}: {json.dumps(value, ensure_ascii=False, sort_keys=True)}"
            )
    lines.append(block.get("content") or "")
    return "\n".join(lines)


_CHAT_TEXT_BUDGET = 12000
_CHAT_PREVIEW = 1500


def _chat_call(key: str, **kwargs) -> str:
    """A continuation the agent can act on, written as the tool call it is:
    `cheese_chat.get` is `cheese_chat(action="get", …)`."""
    name, _, action = key.partition(".")
    if action:
        kwargs = {"action": action, **kwargs}
    args = ", ".join(
        f"{k}={json.dumps(v, ensure_ascii=False)}" for k, v in kwargs.items()
    )
    return f"{name}({args})"


def _chat_scope(args: dict) -> dict:
    return {key: args[key] for key in ("topic",) if args.get(key)}


def _chat_get(args: dict, host) -> str:
    offset = 0 if args.get("offset") is None else args["offset"]
    length = _CHAT_TEXT_BUDGET if args.get("length") is None else args["length"]
    if not 1 <= length <= _CHAT_TEXT_BUDGET or offset < 0:
        raise PlatformToolError(f"length 取 1..{_CHAT_TEXT_BUDGET}，offset 不小于 0")
    topic = args.get("topic") or host.environ.get("CHEESE_TOPIC", "")
    raw_id = (
        args["message_id"].removeprefix("record:")
        if args["message_id"].startswith("record:")
        else None
    )
    path = (
        f"/topics/{urllib.parse.quote(topic, safe='')}/history/"
        + urllib.parse.quote(args["message_id"], safe="")
    )
    if raw_id is not None:
        if ":" in raw_id:
            topic, raw_id = raw_id.split(":", 1)
        path = f"/topics/{urllib.parse.quote(topic, safe='')}/session-records/{urllib.parse.quote(raw_id, safe='')}"
    block = host.request({"method": "GET", "path": path})["data"]
    if raw_id is not None:
        block = _chat_record(block)
    text = _chat_message_text(block)
    end = offset + length
    shown = text[offset:end]
    if end < len(text):
        more = _chat_call(
            "cheese_chat.get",
            message_id=args["message_id"],
            offset=end,
            **_chat_scope(args),
        )
        shown += f"\n\n[More text: {more}]"
    return shown


def _chat_record(item: dict) -> dict:
    import base64

    cursor = (
        base64.urlsafe_b64encode(
            json.dumps(
                [item["at"], item["harness"], item["agent_handle"], item["sequence"]]
            ).encode()
        )
        .decode()
        .rstrip("=")
    )
    if "cursor" in item:
        cursor = item["cursor"]
    return {
        "id": f"record:{cursor}",
        "created_at": item["at"],
        "author": item["agent_handle"],
        "author_type": "participant",
        "kind": "event",
        "content": json.dumps(item["record"], ensure_ascii=False),
    }


def _chat_page(tool: str):
    def run(args: dict, host) -> str:
        limit = 50 if args.get("limit") is None else args["limit"]
        if not 1 <= limit <= 500:
            raise PlatformToolError("limit 取 1..500")
        if args.get("before") and args.get("after"):
            raise PlatformToolError("before 和 after 只能给一个")
        topic = args.get("topic") or host.environ.get("CHEESE_TOPIC", "")
        params: dict = {"limit": limit}
        for key, name in (
            ("before", "before"),
            ("after", "after"),
            ("kind", "kind"),
            ("author", "author"),
        ):
            if args.get(key):
                params[name] = args[key]
        own: dict = {}
        if tool == "cheese_chat.search":
            params["q"] = own["query"] = args["query"]
            if args.get("channel"):
                params["channel"] = own["channel"] = "true"
        elif tool == "cheese_chat.replies":
            params["reply_to"] = own["message_id"] = args["message_id"]
        path = (
            f"/topics/{urllib.parse.quote(topic, safe='')}/history?"
            + urllib.parse.urlencode(params)
        )
        if args.get("kind") == "event" and tool != "cheese_chat.replies":
            params.pop("kind", None)
            params["newest"] = "false" if args.get("after") else "true"
            for direction in ("before", "after"):
                if params.get(direction):
                    params[direction] = params[direction].removeprefix("record:")
            path = (
                f"/topics/{urllib.parse.quote(topic, safe='')}/session-records?"
                + urllib.parse.urlencode(params)
            )
        data = host.request({"method": "GET", "path": path})["data"]
        if args.get("kind") == "event" and tool != "cheese_chat.replies":
            data = {
                "data": [_chat_record(item) for item in data["items"]],
                "has_more": data["next"] is not None,
            }

        def preview(block):
            text = _chat_message_text(block)
            if len(text) > _CHAT_PREVIEW:
                more = _chat_call(
                    "cheese_chat.get", message_id=block["id"], **_chat_scope(args)
                )
                text = text[:_CHAT_PREVIEW] + f"\n[Truncated; {more}]"
            return text

        out = []
        remaining = _CHAT_TEXT_BUDGET
        if parent := data.get("reply_to"):
            parent_text = "Replying to:\n" + preview(parent) + "\n"
            out.append(parent_text)
            remaining -= len(parent_text) + 1
        blocks = data.get("data") or []
        if not blocks:
            out.append("No messages matched this conversation and filter.")
            return "\n".join(out)
        # Walk from the requested edge. The next cursor must refer to the last
        # displayed block, including when the text budget cuts a server page short.
        forward = bool(args.get("after"))
        selected = []
        for block in blocks if forward else reversed(blocks):
            text = preview(block)
            if selected and len(text) + 2 > remaining:
                break
            selected.append((block, text))
            remaining -= len(text) + 2
        if not forward:
            selected.reverse()
        out.append("\n\n".join(text for _, text in selected))
        if data.get("has_more") or len(selected) < len(blocks):
            cursor = selected[-1 if forward else 0][0]["id"]
            filters = {k: args[k] for k in ("kind", "author") if args.get(k)}
            more = _chat_call(
                tool,
                **own,
                **_chat_scope(args),
                **filters,
                limit=limit,
                **({"after": cursor} if forward else {"before": cursor}),
            )
            out.append(f"\n[More messages: {more}]")
        return "\n".join(out)

    return run


def _doc_get(args: dict, host) -> str:
    """Reading is what earns the right to write.

    The living doc has no partial write: `cheese_doc(action=set)` replaces the whole
    thing, so a write has to say which version it replaces, and that number must
    be EVIDENCE OF A READ rather than something the caller states. An argument
    would let the agent assert a version it only heard about — the platform
    pushes 「文档已更新到第 7 版」 into a running session — and write ten-minute-old
    content over it claiming to be based on it, which is the exact overwrite the
    version exists to stop. So the version this read returned is kept by the
    host, and the write reads it back from there."""
    document = _document(host, args)
    plan = request_plan("cheese_doc.get", args, {**host.environ, **document})
    answer = host.request(plan)
    doc = answer.get("data") or {}
    version = doc.get("doc_version", 0)
    host.doc_versions[document["CHEESE_DOCUMENT"]] = version
    if not doc.get("content"):
        return "这份文档还是空的；cheese_doc(action=set) 会写下第一版。"
    lines = _doc_links(document["CHEESE_DOCUMENT"], host) + [doc["content"]]
    pending = doc.get("pending_suggestions") or []
    if pending:
        # 建议还不是正文：上面读到的是没有它们的文本。列出来，免得再提一遍。
        lines += ["", f"--- 待处理的修改建议（{len(pending)} 处，不在正文里）"]
        for item in pending:
            why = f"（{item['reason']}）" if item.get("reason") else ""
            lines.append(
                f"- {item.get('author') or '?'}：「{item.get('old') or ''}」→"
                f"「{item.get('new') or ''}」{why}"
            )
    if ":::canvas " in doc["content"]:
        lines += _doc_canvases(document["CHEESE_DOCUMENT"], host)
    # 文档里此刻指不到东西的引用：读的时候就说，下一次写正好改掉。
    warnings = answer.get("warnings") or []
    if warnings:
        lines += [""] + [f"⚠️ {warning}" for warning in warnings]
    return "\n".join(lines)


def _document(host, args: dict | None = None) -> dict:
    """本次要读写的文档：点了名的那一份（按编号），会话本来就是对着
    某份文档开的（CHEESE_DOCUMENT），或者是任务里的会话，用任务的实况文档。"""
    named = str((args or {}).get("document") or "").strip()
    if named:
        return {"CHEESE_DOCUMENT": named}
    document = host.environ.get("CHEESE_DOCUMENT", "")
    if document:
        return {"CHEESE_DOCUMENT": document}
    topic = host.environ.get("CHEESE_TOPIC", "")
    if not topic:
        raise PlatformToolError("Missing CHEESE_DOCUMENT or CHEESE_TOPIC")
    path = f"/topics/{topic}/document"
    found = host.request({"method": "GET", "path": path})
    return {"CHEESE_DOCUMENT": (found.get("data") or {})["id"]}


#: What to do after a refused edit, where rereading the document is not it: a
#: change that cannot be a suggestion stays one however the original is quoted.
_EDIT_NEXT = {
    "structure": "要么不设 suggest 直接改；要么在对话里说。",
}


def _doc_edit(args: dict, host) -> str:
    document = _document(host, args)
    plan = request_plan("cheese_doc.edit", args, {**host.environ, **document})
    try:
        answer = host.request(plan)
    except Exception as exc:
        status = getattr(exc, "status", None)
        if status not in (409, 422):
            raise
        try:
            error = json.loads(exc.body)["error"]  # type: ignore[attr-defined]
            why = error["message"]
        except (ValueError, KeyError, TypeError):
            raise exc from None
        reason = (error.get("data") or {}).get("reason")
        raise PlatformToolError(
            f"一处都没改，文档没有变：{why.rstrip('。')}。"
            + _searched(args, host, document["CHEESE_DOCUMENT"])
            + _EDIT_NEXT.get(
                reason, "先 cheese_doc(action=get) 重读，照读到的原文改好再试。"
            )
        ) from exc
    data = answer.get("data") or {}
    edits = data.get("edits") or []
    if data.get("mode") == "suggest":
        return f"已提出 {len(edits)} 处修改建议，等人接受或拒绝；正文还没有变。"
    done = f"已改了 {len(edits)} 处"
    version = data.get("doc_version")
    lines = [f"{done}（第 {version} 版）。" if version else f"{done}。"]
    lines += _made_canvases(answer)
    # 和 cheese_doc(action=set) 一样：格式警告跟着这次写入回来，改的机会就是现在。
    lines += [f"⚠️ {warning}" for warning in answer.get("warnings") or []]
    return "\n".join(lines)


def _searched(args: dict, host, document: str) -> str:
    """A refused edit that named no document: which one it looked in. Without
    `document` the edit goes to this conversation's own document, and an agent
    that meant a library document cannot tell from 「原文找不到」 alone that it
    searched another one."""
    if str(args.get("document") or "").strip():
        return ""
    found = host.request({"method": "GET", "path": f"/documents/{document}"})
    title = str((found.get("data") or {}).get("title") or "").strip()
    named = f"《{title}》" if title else ""
    if host.environ.get("CHEESE_DOCUMENT"):
        where = f"这次会话对着的文档{named}"
    else:
        where = f"这里的实况文档{named}"
    return (
        f"这次没给 document，找的是{where}；要改别的文档，"
        "带上它的 document 编号（见 cheese_doc(action=list)）。"
    )


def _made_canvases(answer: dict) -> list[str]:
    """What a write that held `:::canvas new` blocks made: one line each."""
    return [
        f"新建了画布《{canvas.get('title') or '未命名'}》，编号 {canvas['id']}："
        f"用 cheese_canvas(action=edit, canvas={canvas['id']}) 往里加格子。"
        for canvas in answer.get("canvases") or []
    ]


#: How much of one canvas `cheese_doc(action=get)` shows after the document; the rest
#: is a `cheese_canvas(action=get)` away.
_DOC_CANVAS_CHARS = 6000


def _doc_links(document: str, host) -> list[str]:
    """Which documents this one links to and which documents and conversations
    link to it, by title, ahead of its text: what is around it, for reading
    only the one that matters. Nothing when there are none, or when the
    platform could not say."""
    try:
        found = host.request({"method": "GET", "path": f"/documents/{document}/links"})
    except Exception:
        return []
    data = found.get("data") or {}

    def doc_name(row: dict) -> str:
        title = row.get("title") or "无标题"
        if row.get("number"):
            return f"文档 {row['number']}《{title}》"
        return f"《{title}》（<#{row['id']}>）"

    def place_name(row: dict) -> str:
        where = row["conversation"]
        if where["kind"] == "room":
            name = f"#{where['title']}"
        elif where["kind"] == "task":
            name = f"任务「{where['title']}」"
        else:
            name = f"支线「{where['title']}」"
        return f"{name}（{row.get('count', 1)} 条）"

    to = [doc_name(r) for r in data.get("links_to") or []]
    by_docs = [
        doc_name(r) for r in data.get("linked_from") or [] if r["kind"] == "document"
    ]
    by_talk = [
        place_name(r)
        for r in data.get("linked_from") or []
        if r["kind"] == "conversation"
    ]
    if not (to or by_docs or by_talk):
        return []
    lines = ["--- 链接（只有标题；要读哪份用 cheese_doc(action=get, document=编号)）"]
    if to:
        lines.append("它引用的文档：" + "、".join(to))
    if by_docs:
        lines.append("引用它的文档：" + "、".join(by_docs))
    if by_talk:
        lines.append("引用它的对话：" + "、".join(by_talk))
    return [*lines, "---", ""]


def _doc_canvases(document: str, host) -> list[str]:
    """The document's canvases as text, to follow it: they are not in its
    Markdown, which names each one in a line."""
    found = host.request({"method": "GET", "path": f"/documents/{document}/canvases"})
    rows = found.get("data") or []
    if not rows:
        return []
    lines = [
        "",
        "--- 文档里的画布（文字版，不在正文里：改文档时别引用它；"
        "改画布用 cheese_canvas(action=edit)）",
    ]
    for row in rows:
        text = row.get("text") or ""
        if len(text) > _DOC_CANVAS_CHARS:
            text = (
                text[:_DOC_CANVAS_CHARS].rsplit("\n", 1)[0]
                + f"\n……（没列完，用 cheese_canvas(action=get, canvas={row['id']}) 读全部）"
            )
        lines += ["", text]
    return lines


def _canvas_edit(args: dict, host) -> str:
    plan = request_plan("cheese_canvas.edit", args, host.environ)
    try:
        answer = host.request(plan)
    except Exception as exc:
        if getattr(exc, "status", None) not in (404, 422):
            raise
        try:
            why = json.loads(exc.body)["error"]["message"]  # type: ignore[attr-defined]
        except (ValueError, KeyError, TypeError):
            raise exc from None
        raise PlatformToolError(
            f"一处都没改，画布没有变：{why.rstrip('。')}。"
            "先 cheese_canvas(action=get) 看看现在的样子，改好再试。"
        ) from exc
    data = answer.get("data") or {}
    added = data.get("added") or []
    named = {number: ref for ref, number in (data.get("refs") or {}).items()}
    lines = [f"已改画布，{len(args['changes'])} 处改动都生效了。"]
    if added:
        lines.append(
            "新格子："
            + "、".join(
                f"[{n}]（{named[n]}）" if n in named else f"[{n}]" for n in added
            )
            + "。"
        )
    canvas = urllib.parse.quote(str(args["canvas"]).strip(), safe="")
    now = host.request({"method": "GET", "path": f"/canvases/{canvas}/text"})
    lines += ["", (now.get("data") or {}).get("text") or ""]
    return "\n".join(lines)


def _doc_new(args: dict, host) -> str:
    project = host.environ.get("CHEESE_PROJECT", "")
    if not project:
        raise PlatformToolError("Missing CHEESE_PROJECT")
    body: dict = {"title": str(args["title"])}
    if args.get("content"):
        body["content"] = str(args["content"])
    try:
        answer = host.request(
            {"method": "POST", "path": f"/projects/{project}/documents", "body": body}
        )
    except Exception as exc:
        if getattr(exc, "status", None) != 422:
            raise
        try:
            why = json.loads(exc.body)["error"]["message"]  # type: ignore[attr-defined]
        except (ValueError, KeyError, TypeError):
            raise exc from None
        raise PlatformToolError(
            f"没建成，没有多出文档：{why} 改好正文再 cheese_doc(action=new)。"
        ) from exc
    doc = answer.get("data") or {}
    host.doc_versions[doc["id"]] = doc.get("doc_version", 0)
    shown = "当前对话里已经出现这份文档。" if host.environ.get("CHEESE_TOPIC") else ""
    lines = [
        f"已新建《{doc.get('title') or args['title']}》，编号 {doc['id']}"
        f"（第 {doc.get('doc_version', 0)} 版）。{shown}之后读写它都带上 document。"
    ]
    lines += _made_canvases(answer)
    lines += [f"⚠️ {warning}" for warning in answer.get("warnings") or []]
    return "\n".join(lines)


def _refusal(exc: Exception) -> str | None:
    """What the platform said when it refused a write (422), or None."""
    if getattr(exc, "status", None) != 422:
        return None
    try:
        return json.loads(exc.body)["error"]["message"]  # type: ignore[attr-defined]
    except (ValueError, KeyError, TypeError):
        return None


def _app_path(key: str) -> str:
    return "/apps/" + urllib.parse.quote(key.strip(), safe="")


def _app_save(args: dict, host) -> str:
    """A new app, or a new version of one; a new version also moves the
    document's blocks of it onto that version, so the reader sees what was
    just made and the document's history keeps which code it showed."""
    body = {"code": str(args["code"]), "note": str(args.get("note") or "")}
    key = str(args.get("app") or "").strip()
    # The pictures the platform took come back with the answer, for the writer
    # to look at what it made (`_LOOK`), when its model reads pictures
    # (CHEESE_PICTURES, which the platform sets from the gateway's word).
    pictures = "?pictures=true" if host.environ.get("CHEESE_PICTURES") == "1" else ""
    if key:
        path = _app_path(key) + "/versions" + pictures
    else:
        document = _document(host, args)["CHEESE_DOCUMENT"]
        path = f"/documents/{document}/apps" + pictures
    plan = {"method": "POST", "path": path, "body": body}
    try:
        answer = host.request(plan)
    except Exception as exc:
        why = _refusal(exc)
        if why is None:
            raise
        raise PlatformToolError(
            f"未保存：{why.rstrip('。')}。修改后重新调用 cheese_app(action=save)。"
        ) from exc
    saved = answer.get("data") or {}
    unchecked = (
        ""
        if saved.get("checked")
        else "平台的浏览器暂时不可用，这一版未经试运行，也没有截图。"
    )
    images = [
        {"data": data, "mimeType": "image/png"}
        for _, data in sorted(
            (saved.get("pictures") or {}).items(), key=lambda kv: -int(kv[0])
        )
    ]
    if not key:
        title = str(args.get("title") or "").strip() or "小程序"
        made = saved.get("key") or "?"
        said = (
            f"已保存小程序 {made} 的第 1 版。{unchecked}它还不在文档中：用 "
            "cheese_doc(action=edit) 把下面的块放到文档中合适的位置，并把第二行改写为一句说明，"
            "写明它展示什么、最重要的结论是什么。读者和你以后读文档时，都只读这一句。\n\n"
            f":::app {made}@1 {title}\n一句话说明\n:::"
        )
        if images:
            said += _LOOK.format(app=made) + "无论是否修改，最后都要把块放进文档。"
        return Said(said, images)
    version = saved.get("version") or 1
    said = f"已保存小程序 {key} 的第 {version} 版。{unchecked}" + _point_at(
        host, key, version
    )
    if images:
        said += _LOOK.format(app=key)
    return Said(said, images)


#: What the writer is asked to do with the pictures of what it just saved.
_LOOK = (
    "\n\n附上平台试运行这一版时拍下的截图，依次是桌面宽度和手机宽度（浅色），读者"
    "打开时看到的就是这样。看一眼：画面是否讲清楚了要讲的东西，数字和标注是否正确，"
    "手机宽度上是否挤在一起、重叠或被截断。有问题就改好后带上 app（{app}）再保存一版，"
    "文档中的块会改用新的一版。"
)


def _point_at(host, key: str, version: int) -> str:
    """Move the document's blocks of this app to ``version``; say what it did."""
    found = host.request({"method": "GET", "path": _app_path(key)})
    document = (found.get("data") or {}).get("document_id")
    doc = host.request({"method": "GET", "path": f"/documents/{document}"})
    content = (doc.get("data") or {}).get("content") or ""
    head = re.compile(rf"^:{{3,}}app[ \t]+{re.escape(key)}@(\d+)\b")
    edits = [
        {"old": line, "new": re.sub(r"@\d+", f"@{version}", line, count=1)}
        for line in sorted(set(content.splitlines()))
        if (m := head.match(line)) and int(m.group(1)) != version
    ]
    if not any(head.match(line) for line in content.splitlines()):
        return (
            "文档中还没有这个小程序的块，读者还看不到它。放进文档时写这一版："
            f":::app {key}@{version}。"
        )
    if not edits:
        return "文档中的块已经是这一版。"
    try:
        answer = host.request(
            {
                "method": "POST",
                "path": f"/documents/{document}/edits",
                "body": {"edits": edits},
            }
        )
    except Exception as exc:
        why = _refusal(exc)
        if why is None and getattr(exc, "status", None) != 409:
            raise
        return (
            f"未能更新文档中的块（{(why or '文档刚被修改过').rstrip('。')}）："
            f"用 cheese_doc(action=edit) 把「:::app {key}@旧版本号」改为 @{version}。"
        )
    if (answer.get("data") or {}).get("mode") == "suggest":
        return f"已提出修改建议，把文档中的块改为第 {version} 版，等待接受。"
    return f"文档中的块已改为第 {version} 版。"


def _app_get(args: dict, host) -> str:
    key = str(args["app"])
    found = host.request({"method": "GET", "path": _app_path(key)}).get("data") or {}
    versions = found.get("versions") or []
    if not versions:
        return "这个小程序还没有任何一版。"
    wanted = int(args.get("version") or versions[-1]["version"])
    one = host.request({"method": "GET", "path": f"{_app_path(key)}/versions/{wanted}"})
    data = one.get("data") or {}
    lines = [f"小程序 {found.get('key')}，属于文档 {found.get('document_id')}。各版："]
    for v in versions:
        mark = "" if v.get("checked") else "（没有试跑）"
        lines.append(
            f"- 第 {v['version']} 版 · {v.get('author')}{mark}：{v.get('note') or '—'}"
        )
    lines += [
        "",
        f"--- 第 {data.get('version')} 版的代码（外壳 v{data.get('shell')}）",
        data.get("code") or "",
    ]
    return "\n".join(lines)


def _doc_set(args: dict, host) -> str:
    document = _document(host, args)["CHEESE_DOCUMENT"]
    content = str(args["content"])
    # 0 —— 「我没读过」—— 是没有读过时的值，也是唯一允许**新建**文档的版本：
    # 没读过一份已经存在的文档，正是写入必须被拒的时候。
    based_on = host.doc_versions.get(document, 0)
    try:
        result = host.request(
            {
                "method": "PUT",
                "path": f"/documents/{document}",
                "body": {
                    "content": content,
                    "expected_version": based_on,
                },
            }
        )
    except Exception as exc:
        # Any host's HTTP error carries `status`/`body` (this file's
        # `PlatformHTTPError`, or the transport's, which this file cannot import).
        status = getattr(exc, "status", None)
        if status == 422:
            # The document is blocks and this text is Markdown: a write that
            # would lose text on the way in is refused, and the platform says
            # which line and what to write instead. Nothing was changed.
            try:
                why = json.loads(exc.body)["error"]["message"]  # type: ignore[attr-defined]
            except (ValueError, KeyError, TypeError):
                raise exc from None
            raise PlatformToolError(
                f"没写进去，文档没有变：{why} 改好正文再 cheese_doc(action=set)。"
            ) from exc
        if status != 409:
            raise
        try:
            error = json.loads(exc.body)["error"]  # type: ignore[attr-defined]
        except (ValueError, KeyError, TypeError):
            error = {}
        data = error.get("data") or {}
        if data.get("reason") == "suggestions":
            # 有人留的修改建议还挂着：整份覆盖会把它们一起丢掉，服务拒绝。
            why = str(
                error.get("message") or "文档里还有别人留下、没处理的修改建议"
            ).rstrip("。")
            raise PlatformToolError(
                f"没写进去，文档没有变：{why}。先请人接受或退回这些建议，"
                "或者改用 cheese_doc(action=edit) 逐处修改，别再整份覆盖。"
            ) from exc
        current = data.get("doc_version", "?")
        raise PlatformToolError(
            f"没写进去：文档现在是第 {current} 版，你这份是照第 {based_on} 版改的。"
            "先 cheese_doc(action=get) 重新读一遍，把别人的改动合进你的正文，再 "
            "cheese_doc(action=set)。直接重试会原样被拒。"
        ) from exc
    version = (result.get("data") or {}).get("doc_version", 0)
    host.doc_versions[document] = version
    lines = [f"已更新实况文档（第 {version} 版）。", *_made_canvases(result)]
    # 格式警告（#1889 第 3 条）：写入照样成功，但「哪里不像状态」要当场改。
    # 它跟着这次写入回来，不另发一条通知——改的机会就是现在，而此刻在写字的人
    # 只看得见这次工具返回。
    for warning in result.get("warnings") or []:
        lines.append(f"⚠️ {warning}")
    return "\n".join(lines)


def _task_relative(path: str, task: str) -> str:
    """交付物的路径，写成后端认的那种：相对这条任务的工作目录。

    后端从任务目录里读它（`ProjectFiles.raw`），而 agent 手上常常是
    `cheese worktree` 打印的那个绝对路径——把那一截前缀剥掉，别让一次能读到的
    交付因为写法被打回。"""
    marker = f"/.cheese/tasks/{task}/"
    return path.split(marker, 1)[1] if marker in path else path


def _accept_request(args: dict, host) -> str:
    if args.get("deliver"):
        task = host.environ.get("CHEESE_TOPIC", "")
        args = {**args, "deliver": _task_relative(args["deliver"], task)}
    plan = request_plan("cheese_card.request", args, host.environ)
    # 卡读的是 forge 上那条分支：先让机器把这条任务的提交推上去，推不上去就不递
    # ——递一张照着旧提交的卡，比一次「机器够不着」更糟，因为没人会发现。
    host.sync_task(host.environ.get("CHEESE_TOPIC", ""))
    data = host.request(plan).get("data") or {}
    art = data.get("artifact") or {}
    named = art.get("name") or args.get("new_artifact") or args.get("artifact")
    reviewer = data.get("reviewer_handle") or args.get("reviewer") or "验收人"
    lines = [
        f"已把验收卡递给 {reviewer}" + (f"，本次更新《{named}》。" if named else "。")
    ]
    # 递卡改了任务在看板上的样子，而这是它自己做的事：平台不会再另外告诉它，
    # 所以就在这里说（`room_task.heard`）。
    lines.append(
        "看板上这件任务现在显示「等审」；你之前用 cheese_task 的 state 报的状态和说明"
        "已经清掉。卡在等审阅的时候 state 报不了；卡被退回或作废，"
        "平台会叫你，任务回到「在做」，那时再接着报。"
    )
    # 新建的那一次把 id 说出来：往后交付这一项就用它，而这里是它第一次存在的地方。
    if args.get("new_artifact") and art.get("id"):
        lines.append(f"这一项的 id 是 {art['id']}，以后交付它用 artifact={art['id']}。")
    # 交付物落没落下来当场说一句：字节只在这一刻读得到，没读到就再也读不到了。
    if args.get("deliver"):
        lines.append(f"这一版交出去的是 {args['deliver']}，已留存。")
    elif args.get("deliver_url"):
        lines.append(f"这一版交出去的是 {args['deliver_url']}。")
    # 递卡之后的那一段（等采纳、PR 红了怎么修）在这一刻最有用，所以跟着返回说。
    lines.append(
        "接下来等验收人采纳。PR 的检查失败或和目标分支冲突时平台会叫你：在这条任务"
        "的目录里修好、提交，用 cheese push-fix 更新原来的 PR，这一步不要再递一张卡。"
    )
    if args.get("completes_task") is False:
        lines.append("这不是最后一步：采纳后任务还开着，平台会叫你接着做下一步。")
    return "\n".join(lines)


#: How many matches `platform_request(find=…)` spells out in full, and how many
#: more it names by method and path before saying how many it left out.
_FIND_DETAILED = 12
_FIND_NAMED = 40


def _platform_request(args: dict, host) -> str:
    """The rest of the platform API, on the room's own credential.

    With a method or a path it is one request and the backend's JSON comes back
    as written. Without one it is discovery, read from the backend's own OpenAPI
    document, so the catalogue is whatever this backend serves today and no
    list here can fall behind it."""
    if args.get("method") or args.get("path"):
        plan = request_plan("platform_request", args, host.environ)
        try:
            response = host.request(plan)
        except ValueError as exc:
            # Every host parses the body as JSON; a download is not JSON.
            raise PlatformToolError(
                "这个接口返回的不是 JSON（多半是文件下载）；"
                "文件用 cheese pull 或 cheese library get 取到机器上。"
            ) from exc
        return json.dumps(response, ensure_ascii=False)
    spec = host.request({"method": "GET", "path": "/openapi.json"})
    words = (args.get("find") or "").lower().split()
    where = (
        f"当前对话 {host.environ.get('CHEESE_TOPIC', '')}，"
        f"项目 {host.environ.get('CHEESE_PROJECT', '')}。"
    )
    return where + "\n" + _api_operations(spec, words)


def _api_operations(spec: dict, words: list[str]) -> str:
    operations = [
        (method.upper(), path, operation)
        for path, item in (spec.get("paths") or {}).items()
        for method, operation in item.items()
        if method.upper() in _HTTP_METHODS
    ]
    if not words:
        groups: dict[str, int] = {}
        for _, _, operation in operations:
            tag = (operation.get("tags") or ["other"])[0]
            groups[tag] = groups.get(tag, 0) + 1
        listed = "、".join(f"{tag}({n})" for tag, n in sorted(groups.items()))
        return (
            f"共 {len(operations)} 个接口，按分组：{listed}。\n"
            '按关键词找：platform_request(find="members role")。'
        )

    def text(operation: dict) -> str:
        return " ".join(
            [
                operation.get("summary") or "",
                operation.get("description") or "",
                operation.get("operationId") or "",
                *(operation.get("tags") or []),
            ]
        ).lower()

    # At the start of a word, so `ask` finds the ask routes and not every task.
    starts = [re.compile(r"(?<![a-z])" + re.escape(w)) for w in words]

    def hits(haystack: str) -> int:
        return sum(bool(s.search(haystack)) for s in starts)

    found = [
        (method, path, operation)
        for method, path, operation in operations
        if hits(f"{method} {path} {text(operation)}".lower()) == len(starts)
    ]
    if not found:
        return f"没有接口同时含有 {' '.join(words)}；少给几个词或换个说法。"
    # The words in the path and the summary are the strongest evidence. Among
    # equals, a route under a room, a project or a message comes first: the room
    # credential is bound to a project, so those are the ones it can open.
    found.sort(
        key=lambda op: (
            -hits(f"{op[1]} {op[2].get('summary') or ''}".lower()),
            not op[1].startswith(("/topics/", "/projects/", "/blocks/")),
        )
    )
    shown = [
        _describe_operation(method, path, operation, spec)
        for method, path, operation in found[:_FIND_DETAILED]
    ]
    rest = found[_FIND_DETAILED:]
    if rest:
        shown.append(
            "还匹配："
            + "；".join(f"{m} {p}" for m, p, _ in rest[:_FIND_NAMED])
            + (
                f"；另有 {len(rest) - _FIND_NAMED} 个，加关键词缩小范围"
                if len(rest) > _FIND_NAMED
                else ""
            )
        )
    return "\n\n".join(shown)


def _schema_type(schema: dict) -> str:
    if "$ref" in schema:
        return schema["$ref"].rsplit("/", 1)[-1]
    if "enum" in schema:
        return "|".join(str(v) for v in schema["enum"])
    for key in ("anyOf", "oneOf", "allOf"):
        if key in schema:
            return "|".join(
                _schema_type(s) for s in schema[key] if s.get("type") != "null"
            )
    if schema.get("type") == "array":
        return f"[{_schema_type(schema.get('items') or {})}]"
    return schema.get("type") or "any"


def _describe_operation(method: str, path: str, operation: dict, spec: dict) -> str:
    about = " ".join((operation.get("description") or "").split("\n\n")[0].split())
    if len(about) > 200:
        about = about[:200] + "…"
    lines = [f"{method} {path} — {operation.get('summary') or ''}"]
    if about:
        lines.append("  " + about)
    for place in ("path", "query"):
        params = [
            p["name"]
            + ("" if p.get("required") else "?")
            + f": {_schema_type(p.get('schema') or {})}"
            for p in operation.get("parameters") or []
            if p.get("in") == place
        ]
        if params:
            lines.append(f"  {place}: " + ", ".join(params))
    content = (operation.get("requestBody") or {}).get("content") or {}
    if "application/json" in content:
        schema = content["application/json"].get("schema") or {}
        name = ""
        if "$ref" in schema:
            name = schema["$ref"].rsplit("/", 1)[-1]
            schema = (spec.get("components") or {}).get("schemas", {}).get(name, {})
        fields = schema.get("properties") or {}
        required = set(schema.get("required") or ())
        if fields:
            lines.append(
                "  body: "
                + ", ".join(
                    f"{key}{'' if key in required else '?'}: {_schema_type(value)}"
                    for key, value in fields.items()
                )
            )
        else:
            lines.append("  body: JSON 对象，字段见上面的说明")
    elif content:
        lines.append(f"  body: {', '.join(content)}（这个工具发不了，只发 JSON）")
    return "\n".join(lines)


def _feedback_refusal(exc: Exception) -> str | None:
    """The backend's own sentence for a refused claim or release, if it sent one."""
    try:
        return json.loads(exc.body)["error"]["message"]  # type: ignore[attr-defined]
    except (AttributeError, ValueError, KeyError, TypeError):
        return None


def _feedback_read(tool: str, args: dict, host) -> dict:
    """One read of the feedback center, its refusals said to the agent."""
    try:
        return host.request(request_plan(tool, args, host.environ))
    except Exception as exc:
        status = getattr(exc, "status", None)
        why = _feedback_refusal(exc)
        if status == 404 and tool == "cheese_feedback.get":
            raise PlatformToolError(
                f"没有 {args['feedback']} 这条反馈，或者它是私密的、你看不见。"
                "核对编号；看不见的不要修。"
            ) from exc
        if status in (400, 403) and why:
            raise PlatformToolError(f"没读到：{why.rstrip('。')}。") from exc
        raise


def _run_records(args: dict, host) -> str:
    """The admin page's run records, as lines an agent reads."""
    try:
        data = host.request(request_plan("cheese_run_records", args, host.environ))
    except Exception as exc:
        status = getattr(exc, "status", None)
        why = _feedback_refusal(exc)
        if status == 404:
            raise PlatformToolError(
                "这段时间里没有这一种。核对 key 和 kind，或者把 window 放宽。"
            ) from exc
        if status in (400, 403) and why:
            raise PlatformToolError(f"没读到：{why.rstrip('。')}。") from exc
        raise
    body = data.get("data") or {}
    if args.get("turn_id"):
        return _turn_lines(body)
    if args.get("turns"):
        return _turns_lines(body)
    if args.get("key") and args.get("kind"):
        meta = body.get("meta") or {}
        lines = [
            f"[{body.get('kind')}] {body.get('content')}",
            f"最近一次：{body.get('at')}",
        ]
        if meta.get("stack"):
            lines += ["调用栈：", str(meta["stack"])[:_FEEDBACK_LOG_BUDGET]]
        lines.append("出现在：")
        for place in body.get("places") or []:
            lines.append(
                f"  {place.get('project') or place.get('project_id') or '（没有项目）'}"
                f" 对话 {place.get('conversation_id') or '—'}，最近 {place.get('at')}"
            )
        if body.get("more_places"):
            lines.append(f"  还有 {body['more_places']} 处")
        return "\n".join(lines)
    totals = body.get("totals") or {}
    groups = body.get("groups") or []
    if not groups:
        return "这段时间里没有运行记录。"
    lines = [
        f"{body.get('window')} 内：报错 {totals.get('error_kinds', 0)} 种、"
        f"{totals.get('errors', 0)} 次；平台自己处理 {totals.get('recovered', 0)} 次。"
    ]
    for g in groups:
        lines.append(
            f"[{g.get('kind')}] {g.get('title')} — {g.get('count')} 次，"
            f"{g.get('projects')} 个项目，最近 {g.get('last_at')}"
            f"（key={g.get('key')!r}）"
        )
    lines.append("读某一种的详情：给 cheese_run_records 传那一行的 key 和 kind。")
    return "\n".join(lines)


def _turns_lines(body: dict) -> str:
    """One line per turn: when it started, how it ended, what it was fed.

    「没记过失败」不写成「成功」：成功不写事件，这个读法只能证明平台没为这一轮落过
    终态事件（`domain/run_record/turns.py` 的模块 docstring）。
    """
    turns = body.get("turns") or []
    if not turns:
        return f"{body.get('window')} 内没有运行过。"
    lines = [
        f"{body.get('window')} 内一共 {body.get('total', len(turns))} 次运行，"
        f"这是最近的 {len(turns)} 次（新的在前）："
    ]
    for turn in turns:
        if turn.get("failure_event"):
            became = f"失败 {turn['failure_event']}"
        elif turn.get("stopped_at"):
            became = "没记过失败"
        else:
            became = "还在跑"
        line = (
            f"{turn.get('turn_id')}  起 {turn.get('started_at')}  "
            f"止 {turn.get('stopped_at') or '—'}  {became}"
        )
        if turn.get("prompt_attempts") is not None:
            line += f"  投喂 {turn['prompt_attempts']} 次"
        line += _frame_suffix(turn)
        lines.append(line)
    lines.append("没有失败事件的那几次是平台没为它记过，不是记了成功。")
    return "\n".join(lines)


def _frame_suffix(turn: dict) -> str:
    """最近一帧的种类和年龄；不知道就说不知道，不说 0。

    只补在还没结束的轮次上：一个已经关掉的轮次最近有没有帧是历史，不是活着的
    证据（`api/routes/run_records.py` 的 `_add_frames`）。
    """
    kind = turn.get("last_frame_kind")
    age = turn.get("last_frame_age_s")
    if kind is None or age is None:
        return "  最近帧 未知"
    return f"  最近帧 {kind}，{age}s 前"


def _turn_lines(turn: dict) -> str:
    """一轮的下钻：它怎么了，最近一帧，和它落下的运行记录。"""
    if turn.get("failure_event"):
        became = f"失败 {turn['failure_event']}"
    elif turn.get("status") == "unfinished":
        became = "没记过失败（不等于成功）"
    else:
        became = turn.get("status") or "未知"
    lines = [
        f"{turn.get('turn_id')}  起 {turn.get('started_at')}  "
        f"止 {turn.get('stopped_at') or '—'}  {became}",
        f"对话 {turn.get('conversation_id') or '—'}",
        "投喂 "
        + (
            f"{turn['prompt_attempts']} 次"
            if turn.get("prompt_attempts") is not None
            else "未知"
        ),
    ]
    lines[0] += _frame_suffix(turn)
    records = turn.get("records") or []
    if not records:
        lines.append("这次运行没有落下运行记录。")
        return "\n".join(lines)
    lines.append(f"运行记录 {len(records)} 条：")
    for record in records:
        lines.append(
            f"  [{record.get('kind')}] {record.get('content')}  {record.get('at')}"
        )
    return "\n".join(lines)


def _feedback_card_line(item: dict) -> str:
    status = _FEEDBACK_STATUS.get(item.get("status"), item.get("status"))
    line = (
        f"{item.get('display_id')} [{status}] {item.get('title')}"
        f" — {item.get('kind')}，支持 {item.get('supports', 0)}，"
        f"评论 {item.get('comments', 0)}"
    )
    if item.get("assignee_handle"):
        line += f"，{item['assignee_handle']} 领着"
    return line


_FEEDBACK_FILTERS = ("query", "tab", "status", "kind", "author", "since")


def _feedback_list(args: dict, host) -> str:
    data = _feedback_read("cheese_feedback.list", args, host).get("data") or {}
    items = data.get("data") or []
    if not items:
        return "没有符合条件的公开反馈。"
    offset = args.get("offset") or 0
    total = data.get("total", len(items))
    lines = [f"共 {total} 条，这是第 {offset + 1}–{offset + len(items)} 条："]
    lines += [_feedback_card_line(item) for item in items]
    if offset + len(items) < total:
        lines.append(
            "下一页："
            + _chat_call(
                "cheese_feedback.list",
                **{k: args[k] for k in _FEEDBACK_FILTERS if args.get(k)},
                offset=offset + len(items),
            )
        )
    lines.append("读某一条用 cheese_feedback(action=get, feedback=编号)。")
    return "\n".join(lines)


#: 日志可以很长（两万字），一次读回来会挤掉别的；前面这么多字通常够判断。
_FEEDBACK_LOG_BUDGET = 4000


def _feedback_get(args: dict, host) -> str:
    item = _feedback_read("cheese_feedback.get", args, host).get("data") or {}
    shown = item.get("display_id") or args["feedback"]
    status = _FEEDBACK_STATUS.get(item.get("status"), item.get("status"))
    lines = [
        f"{shown}「{item.get('title')}」",
        f"状态：{status}；类型：{item.get('kind')}；"
        f"{'私密' if item.get('visibility') == 'private' else '公开'}；"
        f"支持 {item.get('supports', 0)}",
        f"提的人：{item.get('author_handle')}"
        + (
            f"（{item['submitted_by_handle']} 发出）"
            if item.get("submitted_by_handle")
            else ""
        ),
        f"领取：{item.get('assignee_handle') or '没人领着'}",
    ]
    for label, key in (
        ("摘要", "summary"),
        ("问题", "problem"),
        ("为什么要紧", "why"),
        ("发生了什么", "what_happened"),
        ("怎么复现", "repro"),
        ("期望", "expectation"),
        ("证据", "evidence"),
        ("环境", "environment"),
    ):
        if item.get(key):
            lines.append(f"{label}：{item[key]}")
    logs = item.get("logs") or ""
    if logs:
        lines.append(f"日志：{logs[:_FEEDBACK_LOG_BUDGET]}")
        if len(logs) > _FEEDBACK_LOG_BUDGET:
            lines.append(
                f"（日志共 {len(logs)} 字，只给了前 {_FEEDBACK_LOG_BUDGET} 字）"
            )
    timeline = item.get("timeline") or []
    if timeline:
        lines.append("时间线：")
        for step in timeline:
            name = _FEEDBACK_STATUS.get(step.get("status"), step.get("status"))
            by = f" {step['by_handle']}" if step.get("by_handle") else ""
            note = f"（{step['note']}）" if step.get("note") else ""
            lines.append(f"  {step.get('at')} {name}{by}{note}")
    thread = list(item.get("thread") or [])
    cursor = item.get("thread_next_cursor")
    topic = host.environ.get("CHEESE_TOPIC", "")
    while cursor:
        query = urllib.parse.urlencode({"topic": topic, "after": cursor})
        path = f"/feedback/{item['id']}/comments?{query}"
        more = host.request({"method": "GET", "path": path}).get("data") or {}
        thread += more.get("items") or []
        cursor = more.get("next_cursor")
    if thread:
        lines.append(f"评论（{item.get('comments', len(thread))} 条）：")
        for comment in thread:
            indent = "    ↳ " if comment.get("parent_id") else "  "
            lines.append(
                f"{indent}{comment.get('author_handle')}：{comment.get('body')}"
            )
            hidden = comment.get("reply_count", 0) - sum(
                1 for c in thread if c.get("parent_id") == comment.get("id")
            )
            if not comment.get("parent_id") and hidden > 0:
                lines.append(f"    （还有 {hidden} 条回复没展开，到反馈中心看）")
    if item.get("assignee_handle"):
        lines.append(f"这一条 {item['assignee_handle']} 领着；不是你的就不要修。")
    elif item.get("can_claim"):
        lines.append(
            f'要修它，先 cheese_feedback(action=claim, feedback="{shown}") 领下来。'
        )
    return "\n".join(lines)


def _feedback_claim(args: dict, host) -> str:
    try:
        data = host.request(request_plan("cheese_feedback.claim", args, host.environ))
    except Exception as exc:
        status = getattr(exc, "status", None)
        why = _feedback_refusal(exc)
        if status == 404:
            raise PlatformToolError(
                f"没有 {args['feedback']} 这条反馈，或者它是私密的、你看不见。"
                "核对编号；看不见的不要修。"
            ) from exc
        if status in (403, 409) and why:
            raise PlatformToolError(
                f"没领到，**不要修这一条**：{why.rstrip('。')}。把这个原因告诉用户。"
            ) from exc
        raise
    item = data.get("data") or {}
    shown = item.get("display_id") or args["feedback"]
    status = _FEEDBACK_STATUS.get(item.get("status"), item.get("status"))
    return (
        f"{shown}「{item.get('title')}」记在你名下了，现在是「{status}」。"
        f"修它的提交在提交信息里单独写一行 `Fixes-feedback: {shown}`；"
        "不修了用 cheese_feedback(action=release) 放掉。"
    )


def _feedback_release(args: dict, host) -> str:
    try:
        data = host.request(request_plan("cheese_feedback.release", args, host.environ))
    except Exception as exc:
        status = getattr(exc, "status", None)
        why = _feedback_refusal(exc)
        if status in (403, 404, 409) and why:
            raise PlatformToolError(f"没放掉：{why.rstrip('。')}。") from exc
        raise
    item = data.get("data") or {}
    return f"{item.get('display_id') or args['feedback']} 现在没人领着，别人可以领了。"


def _wait_machine(args: dict, host) -> str:
    """Hands, once the room's machine is ready: one command that does nothing,
    sent the way every file and command tool's is, so it waits exactly as they
    do (`executor_transport.acquire`) and fails as they would."""
    started = datetime.now(UTC)
    host.wait_machine()
    waited = round((datetime.now(UTC) - started).total_seconds())
    return f"执行环境已就绪（等了 {waited} 秒）。" if waited else "执行环境已就绪。"


def _compact(args: dict, host) -> str:
    """Ask this session's harness to compact its own context.

    The request goes to the harness, not the platform: only the thing running
    the conversation can summarise it. It answers as soon as the request is
    taken — a compaction of a long conversation runs for minutes, and the room
    already shows when one starts and ends."""
    compact = getattr(host, "compact", None)
    if compact is None:
        raise PlatformToolError("这个会话的骨架不支持主动压缩上下文")
    if compact() == "already":
        return "这次回复已经请求过压缩了，等它跑完。"
    return (
        "已请求压缩当前会话的上下文：这次回复结束后开始整理，期间不会回复，"
        "整理完接着处理，上下文用量会降下来。"
    )


def _task(args: dict, host) -> str:
    """Creating a task, a refusal said to the agent in the open.

    Every refusal here is one the agent can act on — a title too wide for the
    sidebar (the backend answers with the width it allows and the width it
    read), an owner outside the project, ``here`` outside a 支线, a new task
    with nothing said of what it is for. Handed the raw body instead, it reads
    as a wall of JSON and makes the same call a second time."""
    try:
        answer = host.request(request_plan("cheese_task.open", args, host.environ))
    except Exception as exc:
        if getattr(exc, "status", None) != 422:
            raise
        try:
            why = json.loads(exc.body)["error"]["message"]  # type: ignore[attr-defined]
        except (ValueError, KeyError, TypeError):
            raise exc from None
        raise PlatformToolError(
            f"没有建出任务：{why.rstrip('。')}。改好了，再调一次 cheese_task(action=open)。"
        ) from exc
    return _say_task(args, answer.get("data"), host.environ)


#: 一条消息最多带几张图；后端 `topics_messages.ATTACHMENTS_PER_MESSAGE` 是同一个数。
_CHAT_ATTACHMENTS_PER_MESSAGE = 9
#: 一张随消息发出去的图片的上限，和后端 `library.MAX_FILE_BYTES` 是同一条线。
_CHAT_ATTACHMENT_MAX_BYTES = 10 * 1024 * 1024
#: 一次从机器上取回多少字节。构建对一条命令的 stdout 有 30000 字符的上限；
#: 21000 字节编码成 base64 是 28000 字符，每一片都完整回来。
_CHAT_ATTACHMENT_CHUNK_BYTES = 21000


def _machine_stdout(host, command, request_id, timeout_s: int = 60) -> str:
    invoke = getattr(host, "invoke", None)
    if invoke is None:
        raise PlatformToolError("这个会话没有可以读写文件的电脑")
    receipt = invoke(
        {"id": request_id, "tool": "Bash"},
        {"command": command, "timeout": timeout_s * 1000},
    )
    if "error" in receipt:
        raise PlatformToolError(str(receipt["error"]))
    stdout = (receipt.get("value") or {}).get("stdout") or ""
    if stdout.startswith("Exit code"):
        raise PlatformToolError(stdout.strip())
    return stdout


def _read_chat_attachment(host, path, request_id) -> bytes:
    """机器上这一份文件的字节，分片取回，不让一片超过构建的回传上限。"""
    quoted = shlex.quote(path)
    try:
        size = int(
            "".join(
                _machine_stdout(host, f"wc -c < {quoted}", f"{request_id}-size").split()
            )
        )
    except ValueError as exc:
        raise PlatformToolError(f"读不到文件：{path}") from exc
    if not size:
        raise PlatformToolError(f"文件是空的：{path}")
    if size > _CHAT_ATTACHMENT_MAX_BYTES:
        raise PlatformToolError(
            f"{path} 太大（上限 {_CHAT_ATTACHMENT_MAX_BYTES // (1024 * 1024)}MB）"
        )
    pieces = []
    for index in range(-(-size // _CHAT_ATTACHMENT_CHUNK_BYTES)):
        stdout = _machine_stdout(
            host,
            f"dd if={quoted} bs={_CHAT_ATTACHMENT_CHUNK_BYTES} skip={index} "
            "count=1 status=none | base64",
            f"{request_id}-{index}",
        )
        try:
            pieces.append(base64.b64decode("".join(stdout.split()), validate=True))
        except ValueError as exc:
            raise PlatformToolError(f"读到的不是文件内容：{path}") from exc
    raw = b"".join(pieces)
    if len(raw) != size:
        raise PlatformToolError(f"{path} 在读取时变了，再试一次")
    return raw


#: 一份文件（上传时是一段）在电脑和存储之间最多传多久。地址本身几分钟内开始传都有效。
_FILE_TRANSFER_S = 600

#: 电脑上算整份的 SHA-256 和每段的 MD5：Linux 有 sha256sum、md5sum，macOS 有
#: shasum、md5。只留十六进制那一列。
_DIGESTS_ON_MACHINE = (
    "_sha() { if command -v sha256sum >/dev/null 2>&1; then sha256sum; "
    "else shasum -a 256; fi | cut -c1-64; }; "
    "_md5() { if command -v md5sum >/dev/null 2>&1; then md5sum; "
    "else md5 -q; fi | cut -c1-32; }; "
)


def _file_give(args: dict, host) -> str:
    """`cheese_library(action=give)`：先问平台要一次只收这一份的上传，电脑自己把文件
    按段算好 MD5、按段传上去，再带着整份的 SHA-256 登记进用户的资料库。字节不经过这
    一侧，电脑里也不放凭据。"""
    path = args["path"].strip()
    quoted = shlex.quote(path)
    said = _machine_stdout(
        host, f"if [ -f {quoted} ]; then wc -c < {quoted}; fi", "give-size"
    )
    try:
        size = int("".join(said.split()))
    except ValueError as exc:
        raise PlatformToolError(f"电脑上没有这份文件：{path}") from exc
    if not size:
        raise PlatformToolError(f"文件是空的：{path}")
    name = (args.get("name") or "").strip() or path.rstrip("/").rsplit("/", 1)[-1]
    slot = host.request(
        {
            "method": "POST",
            "path": "/assistant/agent/files/slot",
            "body": {"name": name.rsplit("/", 1)[-1], "size": size},
        }
    )["data"]
    step, count = int(slot["part_bytes"]), int(slot["parts"])
    # 整份一行，然后每段一行。
    digests = _machine_stdout(
        host,
        _DIGESTS_ON_MACHINE + f"_sha < {quoted}; i=0; while [ $i -lt {count} ]; do "
        f"dd if={quoted} bs={step} skip=$i count=1 status=none | _md5; "
        "i=$((i+1)); done",
        "give-digest",
        _FILE_TRANSFER_S + 30,
    ).split()
    if len(digests) != count + 1:
        raise PlatformToolError(f"算不出 {path} 的哈希")
    whole, parts = digests[0], digests[1:]
    for number, digest in enumerate(parts, start=1):
        address = host.request(
            {
                "method": "POST",
                "path": "/assistant/agent/files/part",
                "body": {"upload": slot["upload"], "part": number, "md5": digest},
            }
        )["data"]
        # `--data-binary @-` 读完这一段再发，带着 Content-Length（预签名地址只收
        # 那么多字节），curl 自己的重试也重发得了这一段。
        headers = "".join(
            f" -H {shlex.quote(f'{key}: {value}')}"
            for key, value in address["headers"].items()
        )
        _machine_stdout(
            host,
            f"dd if={quoted} bs={step} skip={number - 1} count=1 status=none | "
            f"curl -sSf --retry 3 --max-time {_FILE_TRANSFER_S} -X PUT "
            f"--data-binary @- -H 'Content-Type:'{headers} "
            f"{shlex.quote(address['url'])} -o /dev/null",
            f"give-put-{number}",
            _FILE_TRANSFER_S + 30,
        )
    handed = host.request(
        {
            "method": "POST",
            "path": "/assistant/agent/files/handed",
            "body": {
                "upload": slot["upload"],
                "sha256": whole,
                "parts": parts,
                "name": name,
            },
        }
    )["data"]
    return (
        f"已交给用户：{handed['path'].rsplit('/', 1)[-1]}（{handed['bytes']} 字节），存进了"
        f"用户的资料库，以后用编号 library/{handed['path']} 读。回答下方会显示这份文件，"
        "用户点了就下载，回答里不必再贴内容、链接或编号。"
    )


def _file_to_computer(args: dict, host) -> str:
    """`cheese_library(action=take)`：问平台要这一份的地址，电脑自己取下来。"""
    link = host.request(
        {
            "method": "POST",
            "path": "/assistant/agent/files/link",
            "body": {"path": args["ref"]},
        }
    )["data"]
    # 相对路径落在工作目录里，和 read、write、bash 看到的是同一个地方。
    target = (args.get("path") or "").strip() or (
        "files/" + link["path"].rsplit("/", 1)[-1]
    )
    quoted = shlex.quote(target)
    _machine_stdout(
        host,
        f'mkdir -p "$(dirname {quoted})" && curl -sSf --max-time {_FILE_TRANSFER_S} '
        f"-o {quoted} {shlex.quote(link['url'])}",
        "fetch-get",
        _FILE_TRANSFER_S + 30,
    )
    return f"已放到电脑上：{target}（{link['bytes']} 字节）。"


def _chat_send(args: dict, host) -> str:
    """`chat_send`，先把图片在机器上读成字节，再随消息一起发出去。

    后端不认识执行机的路径：图片的字节必须和消息一起到。每张图在这里分片取回、
    编码进请求体，和 `send_user_file` 交给房间的是同一批字节。
    """
    paths = args.get("attachments") or []
    if not isinstance(paths, list):
        raise PlatformToolError("attachments 要是文件路径的列表")
    if len(paths) > _CHAT_ATTACHMENTS_PER_MESSAGE:
        # 后端只收前 9 张；说清楚，别让同一张图被默默丢掉。
        raise PlatformToolError(
            f"一次最多发 {_CHAT_ATTACHMENTS_PER_MESSAGE} 张图，分两次发"
        )
    # 执行器把每次 invoke 按 id 记进日志：同一个 id 再来一次，输入不同就拒
    # （"Request ID already belongs to different input"），输入相同则直接回放
    # 上一次的结果。所以每次调用要有自己的前缀，否则第二次 `chat_send` 要么
    # 失败，要么发出去的是同一路径上旧文件的字节。
    run = uuid.uuid4().hex
    files = []
    for index, path in enumerate(paths):
        if not isinstance(path, str) or not path.strip():
            raise PlatformToolError("attachments 里每一项都要是一个文件路径")
        raw = _read_chat_attachment(host, path, f"chat-send-{run}-{index}")
        name = path.replace("\\", "/").rstrip("/").rsplit("/", 1)[-1] or "image"
        files.append(
            {
                "path": path,
                "name": name,
                "content_b64": base64.b64encode(raw).decode("ascii"),
            }
        )
    plan = request_plan("chat_send", args, host.environ)
    if files:
        plan["body"]["attachments"] = files
    data = host.request(plan).get("data")
    return _say_chat_send(args, data, host.environ)


