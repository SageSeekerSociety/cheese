        description=(
            "两个用途。\n"
            "\n"
            "**老格式升级**:`.doc` / `.ppt` / `.xls` 不是 zip,这台机器读不了也写不了。"
            "用户要改这类文件时,用这条命令升级成 `.docx` / `.pptx` / `.xlsx` 再改,"
            "**并且明确告诉用户这是一次格式升级**——转出来的文件和原件不是同一个东西,"
            "他后面要发给别人的是哪一份,得由他决定。\n"
            "\n"
            "**自己看一眼版面**:转成 PDF,再用 `uv run --with pymupdf` 把某一页存成图片"
            "看看。排版错了不会报错,文字提取也照样正确,只有看一眼才发现。"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    pcv.add_argument("path", help="要转换的文件")
    pcv.add_argument(
        "--to",
        required=True,
        metavar="格式",
        help="目标格式,如 docx / pptx / xlsx / pdf",
    )
    pcv.add_argument(
        "--output", "-o", default=None, metavar="FILE", help="写到哪里(默认换扩展名)"
    )

    prc = sub.add_parser(
        "recalc",
        help="重算一份 .xlsx 里的公式,并报出算不出来的格",
        description=(
            "openpyxl 写进去的是公式本身,不是结果;改过一个格之后,依赖它的那些公式"
            "存的还是改动之前的数。两种情况文件都能正常打开,公式栏也对,只有数是错的,"
            "而且没有任何地方会报错。\n"
            "\n"
            "重算要在会算公式的程序里加载这份文件,这台机器上没有那个程序,"
            "平台那边有——这条命令就是去那边算完再写回来。算不出来的格"
            "(#DIV/0! #REF! 这些)会按 Sheet1!B7 的形式列出来;交付之前这张单子要是空的。"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    prc.add_argument("path", help="要重算的表格,如 预算表.xlsx")
    prc.add_argument(
        "--output",
        "-o",
        default=None,
        metavar="FILE",
        help="写到哪里(默认覆盖原文件)",
    )

    papi = sub.add_parser(
        "api",
        help="原始 API 逃生口(兜底,不推荐):直接打后端,带容器已有鉴权。无参=列可用操作",
        description=(
            "原始 API 通道。上面那些 curated 命令覆盖 80% 场景,语义清晰、有校验,"
            "**优先用它们**;只有当没有对应的 curated 命令时才用 api。\n"
            "\n"
            "它仍然走容器已有的鉴权(不是无鉴权后门,后端照样按你的身份授权),"
            "但校验少、易出错。裸 curl 和翻 session 文件依然是禁止的——"
            "这个逃生口只是「少校验的原始通道」,不改变鉴权纪律。"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    papi.add_argument("method", nargs="?", help="HTTP 方法,如 GET/POST/PUT/DELETE")
    papi.add_argument("path", nargs="?", help="API 路径,如 /topics/<id>/blocks")
    papi.add_argument("--data", "-d", default=None, help="请求体(JSON 字符串)")
    papi.add_argument(
        "--output",
        "-o",
        default=None,
        metavar="FILE",
        help=(
            "把响应体按**字节**写进这个文件,而不是当文本打印。"
            "下载附件/图片必须用它:不带 -o 的输出会把每个 >0x7f 的字节换成 U+FFFD,"
            "文件到手是坏的,而且看不出坏在哪"
