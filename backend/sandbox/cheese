def _given(args: dict, *keys: str) -> dict:
    """The optional fields the caller actually filled, under the backend's names.

    「没说」和「说了空的」在后端是两件事（例如省略验收人 = 用项目默认值），所以
    空值不发。"""
    body = {}
    for key in keys:
        name, _, field = key.partition(":")
        if args.get(name) not in (None, "", []):
            body[field or name] = args[name]
    return body


def _ask_body(args: dict) -> dict:
    """Validate every question before publishing the one HTTP request."""
    questions = args.get("questions")
    if not isinstance(questions, list) or not 1 <= len(questions) <= 3:
        raise ValueError("ask requires 1-3 questions")
    for question in questions:
        if not isinstance(question, dict):
            raise ValueError("each question must be an object")
        text = question.get("question")
        if not isinstance(text, str) or not text.strip():
            raise ValueError("each question requires nonempty question text")
        options = question.get("options")
        if not isinstance(options, list) or not 2 <= len(options) <= 3:
            raise ValueError("each question requires 2-3 object options")
        for option in options:
            if not isinstance(option, dict):
                raise ValueError("each option must be a {text, explain?} object")
            text = option.get("text")
            if not isinstance(text, str) or not text.strip():
                raise ValueError("each option requires nonempty text")
            if "explain" in option and not isinstance(option["explain"], str):
                raise ValueError("option explain must be a string")
    to = args.get("to")
    if to is not None and (
        not isinstance(to, list) or not to or not all(isinstance(h, str) for h in to)
    ):
        raise ValueError('to must be a nonempty list of handles, or ["all"]')
    # Identity is supplied by the host credential, never an author in args.
    return {
        "questions": questions,
        **({"to_owner": True} if args.get("to_owner") is True else {}),
        **({"to": to} if to is not None else {}),
        "request_id": str(uuid.UUID(args["request_id"]))
        if args.get("request_id")
        else str(uuid.uuid4()),
    }


def routine_spec_checked(
    *, trigger: str | None = None, spec: dict | None = None, timezone: str | None = None
) -> None:
    """拒在发出之前。

    这几样后端也会拒（`routine/schedule.py` 的 `normalize`，话是同一套），但那时
    agent 已经等了一个来回、还是不知道自己错在哪。这里只做**不用问平台就知道**的
    那部分：取值在不在枚举里、定时有没有说清什么时候跑（freq、HH:MM、星期几和几号）、
    事件触发的 scope 认不认识。

    时区是唯一一处「本机判不了」的：会话容器里可能没装 tzdata，那时每一个名字都
    查不到——查不到就是不知道，不知道就不该拒，交给后端。
    """
    if trigger is not None and trigger not in ROUTINE_TRIGGERS:
        raise ValueError("trigger 只能是 " + "、".join(ROUTINE_TRIGGERS) + " 之一")
    if timezone and not _zone_is_known(timezone):
        raise ValueError(f"不认识的时区：{timezone}")
    if spec is None:
        return
    if not isinstance(spec, dict):
        raise ValueError("spec 是一个对象，不是一个字符串")
    event = trigger is not None and trigger != "schedule"
    if "freq" not in spec:
        if event or trigger is None:
            # 事件触发（或改规则时没说触发方式）：spec 只说从哪儿算起。
            if spec.get("scope") not in (None, "room", "project"):
                raise ValueError("事件的 scope 只有 room 和 project 两个值")
            return
        # 起草时的默认触发方式就是定时：不说清什么时候跑，后端也只会拒。
        raise ValueError(
            "定时规则要写 freq（hourly、daily、weekly、monthly），"
            '例如 {"freq": "weekly", "weekdays": [0], "time": "09:00"}'
        )
    if event:
        raise ValueError(f"{trigger} 触发不用给 freq，spec 只写 scope")
    freq = spec["freq"]
    if freq not in ROUTINE_FREQS:
        raise ValueError("频率只能是 hourly、daily、weekly、monthly 之一")
    if freq == "hourly":
        if not _is_int(spec.get("minute"), 0, 59):
            raise ValueError("每小时执行要给出第几分钟（0–59）")
        return
    raw = str(spec.get("time") or "")
    try:
        # 24 小时制、当天以内的那一刻：`time()` 自己会拒 25:00 这种。
        hour, minute = (int(part) for part in raw.split(":"))
        time(hour, minute)
    except (ValueError, TypeError) as exc:
        raise ValueError("执行时间要写成 HH:MM，例如 09:00") from exc
    if freq == "weekly":
        days = spec.get("weekdays")
        if (
            not isinstance(days, list)
            or not days
            or any(not _is_int(day, 0, 6) for day in days)
        ):
            raise ValueError("每周执行要给出星期几（0=周一 … 6=周日）")
    if freq == "monthly" and not _is_int(spec.get("day"), 1, 31):
        raise ValueError("每月执行要给出几号（1–31）")


def _is_int(value, low: int, high: int) -> bool:
    # bool 是 int 的子类：`True` 当第 1 分钟收下就成了另一种意思。
    return (
        isinstance(value, int) and not isinstance(value, bool) and low <= value <= high
    )


def _zone_is_known(name: str) -> bool:
    """这个名字是个时区吗——**判不出来时算它是**。

    会话容器里可能没装 tzdata，那时每个名字都查不到，而「查不到」是这台机器不知
    道，不是这个名字错了。这样的名字交给后端判；后端那台有 tzdata。
    """
    try:
        ZoneInfo(name)
    except ZoneInfoNotFoundError:
        return not _has_tz_database()
    except ValueError:
        return False
    return True


def _has_tz_database() -> bool:
    """这台机器上有 tzdata 吗——没有的话「查不到」说明不了任何事。"""
    try:
        ZoneInfo("UTC")
    except Exception:
        return False
    return True


#: The fields each canvas change takes (`app/domain/canvas/schemas.py`); a
#: model that fills in one more is not refused for it.
_CANVAS_FIELDS = {
    "add": ("ref", "content", "task", "x", "y", "width", "height"),
    "update": ("card", "content", "task"),
    "move": ("card", "x", "y", "width", "height"),
    "delete": ("card",),
    "connect": ("from", "to", "label"),
    "disconnect": ("from", "to"),
}


def _canvas_change(change) -> dict:
    """One change of `cheese_canvas(action=edit)` the way the backend reads it."""
    if not isinstance(change, dict) or change.get("op") not in _CANVAS_FIELDS:
        raise ValueError(
            "changes 的每一项要有 op：add、update、move、delete、connect、disconnect"
        )
    op = change["op"]
    out: dict = {"op": op}
    for key in _CANVAS_FIELDS[op]:
        if key not in change:
            continue
        value = change[key]
        if key == "task":
            # 空字符串和 null 都是「不再关联」；后端要的是 null。
            out[key] = (str(value).strip() or None) if value is not None else None
        elif value is not None:
            out[key] = value
    return out


#: A 题目's material, by its name in the 题目's library.
_TASK_FILE = re.compile(r"spaces/(\d+)/tasks/(\d+)/files/(.+)")
#: What lives outside projects, read where the publish page's tools read it.
_READ_ELSEWHERE = (
    (re.compile(r"spaces/(\d+)/tasks/(\d+)"), "problem"),
    (re.compile(r"spaces/(\d+)/materials/(\d+)"), "material"),
    (re.compile(r"spaces/(\d+)"), "materials"),
    (re.compile(r"drafts/(\d+)"), "draft"),
    (re.compile(r"files/(\d+)"), "file"),
)
#: How many pages of a PDF one read says.
_PDF_PAGES = 20


def _read_kind(ref: str):
    """Which of `_READ_ELSEWHERE` ``ref`` is, with its numbers; None for a
    project's own things, which `/assistant/agent/read` reads."""
    text = ref.strip().strip("/")
    for pattern, kind in _READ_ELSEWHERE:
        m = pattern.fullmatch(text)
        if m:
            return kind, [int(g) for g in m.groups()]
    return None


def _pdf_pages(page: int) -> str:
    return f"{(page - 1) * _PDF_PAGES + 1}-{page * _PDF_PAGES}"


def _read_plan(args: dict) -> dict:
    page = args.get("page") or 1
    if not isinstance(page, int) or page < 1:
        raise ValueError("page 是从 1 开始的整数")
    if args["ref"].strip().strip("/") == "me":
        return {"method": "GET", "path": "/tasks/joined"}
    if args["ref"].strip().strip("/") == "settings":
        return {
            "method": "POST",
            "path": "/notifications/preferences/agent/read",
            "body": {},
        }
    if args["ref"].strip().strip("/").split("/", 1)[0] == "library":
        body = {"ref": args["ref"], "page": page}
        return {"method": "POST", "path": "/assistant/agent/library", "body": body}
    material = _TASK_FILE.fullmatch(args["ref"].strip().strip("/"))
    if material:
        body = {
            "task": int(material.group(2)),
            "name": material.group(3),
            "pages": _pdf_pages(page),
        }
        return {"method": "POST", "path": "/task-drafts/agent/file", "body": body}
    found = _read_kind(args["ref"])
    if found is None:
        body = {"ref": args["ref"], "page": page}
        return {"method": "POST", "path": "/assistant/agent/read", "body": body}
    kind, ids = found
    if kind == "problem":
        body = {"task": ids[1]}
        return {"method": "POST", "path": "/task-drafts/agent/read", "body": body}
    if kind == "draft":
        body = {"draft": ids[0]}
        return {"method": "POST", "path": "/task-drafts/agent/read", "body": body}
    if kind == "file":
        body = {"file": ids[0], "pages": _pdf_pages(page)}
        return {"method": "POST", "path": "/task-drafts/agent/file", "body": body}
    body = {"space": ids[0]}
    if kind == "material":
        body.update(material=ids[1], pages=_pdf_pages(page))
    return {"method": "POST", "path": "/task-drafts/agent/materials", "body": body}


def _say_read(args: dict, data, environ) -> str:
    if args["ref"].strip().strip("/") == "me":
        return _say_joined_problems(args, data, environ)
    found = _read_kind(args["ref"])
    kind = found[0] if found else None
    if kind == "file" or _TASK_FILE.fullmatch(args["ref"].strip().strip("/")):
        return _say_document(args, data, environ)
    if kind in ("material", "materials"):
        return _say_materials(args, data, environ)
    return (data or {}).get("text") or ""


def request_plan(tool: str, args: dict, environ: dict | None = None) -> dict:
    """The one backend request a platform tool is, as data.

    Pure: nothing here reads the machine or the network, so a plan can be built
    and checked with no session around it. Tools that take more than one request
    (`_STEPS`) build theirs from the same pieces."""
    env = os.environ if environ is None else environ
    topic = env.get("CHEESE_TOPIC", "")
    project = env.get("CHEESE_PROJECT", "")
    document = env.get("CHEESE_DOCUMENT", "")
    # `tool` is a key: a tool's name, or `<name>.<action>` for one of an
    # object's verbs (`_object`); what each needs is listed by key.
    if tool in _NEEDS_DOCUMENT and not document:
        raise ValueError("Missing CHEESE_DOCUMENT")
    if tool in _NEEDS_TOPIC and not topic:
        raise ValueError("Missing CHEESE_TOPIC")
    if tool in _NEEDS_PROJECT and not project:
        raise ValueError("Missing CHEESE_PROJECT")
    here = f"/topics/{topic}"
    if tool == "platform_request":
        method = (args.get("method") or "GET").upper()
        path = args.get("path") or ""
        parsed = urllib.parse.urlsplit(path)
        # The room's credential goes wherever this points, so it may only point
        # at the platform: a path under the API root, never another host.
        if (
            method not in _HTTP_METHODS
            or not path.startswith("/")
            or parsed.scheme
            or parsed.netloc
            or parsed.fragment
        ):
            raise ValueError(
                "platform_request needs an HTTP method and a relative API path, "
                "such as /topics/<room id>/members"
            )
        plan = {"method": method, "path": path}
        if args.get("body") is not None:
            plan["body"] = args["body"]
        return plan
    if tool == "chat_send":
        body = {
            "content": args.get("content") or "",
            "request_id": str(uuid.UUID(args["request_id"]))
            if args.get("request_id")
            else str(uuid.uuid4()),
            **_given(args, "reply_to"),
        }
        return {"method": "POST", "path": here + "/messages", "body": body}
    if tool == "cheese_chat.edit":
        return {
            "method": "PATCH",
            "path": "/blocks/" + urllib.parse.quote(args["message_id"], safe=""),
            "body": {"content": args["content"]},
        }
    if tool == "todo_write":
        return {
            "method": "PUT",
            "path": f"/topics/{topic}/progress",
            "body": {
                "todos": args["todos"],
                **({"new": True} if args.get("new") is True else {}),
                **_given(args, "result"),
            },
        }
    if tool == "cheese_doc.get":
        return {"method": "GET", "path": f"/documents/{document}"}
    if tool == "cheese_doc.edit":
        return {
            "method": "POST",
            "path": f"/documents/{document}/edits",
            "body": {
                "edits": [
                    {"old": str(e["old"]), "new": str(e.get("new") or "")}
                    for e in args["edits"]
                ],
                **({"mode": "suggest"} if args.get("suggest") is True else {}),
                **_given(args, "reason"),
            },
        }
    if tool == "cheese_task.open":
        return {
            "method": "POST",
            "path": f"/topics/{topic}/teammate-tasks",
            "body": {
                "title": args["title"],
                "summary": args.get("brief") or "",
                "here": args.get("here") is True,
                **_given(args, "owner:owner_handle", "source_message_id"),
            },
        }
    if tool == "cheese_task.state":
        return {
            "method": "PUT",
            "path": here + "/task/progress",
            "body": {"state": args["state"], **_given(args, "note")},
        }
    if tool == "cheese_task.reopen":
        return {"method": "POST", "path": here + "/reopen"}
    if tool == "cheese_task.close":
        return {
            "method": "POST",
            "path": here + "/close",
            "body": {
                "conclusion": args.get("conclusion") or "",
                **_given(
                    args,
                    "reported_by:reporter_handle",
                    "contributor:contributor_handles",
                ),
            },
        }
    if tool == "cheese_card.request":
        return {
            "method": "POST",
            "path": here + "/accept-card",
            "body": {
                "focus": args.get("focus") or "",
                "change_subject": args["subject"],
                **_given(
                    args,
                    "reviewer:reviewer_handle",
                    "body:change_body",
                    "artifact",
                    "new_artifact",
                    "about",
                    "deliver",
                    "deliver_url",
                    "completes_task",
                    "comment_outcomes",
                ),
            },
        }
    if tool == "cheese_card.describe":
        body = _given(args, "subject:change_subject", "body:change_body", "focus")
        if not body:
            raise ValueError("describe 至少要给 subject、body 或 focus")
        return {"method": "POST", "path": here + "/accept-card/describe", "body": body}
    if tool == "cheese_card.redeliver":
        body = _given(args, "deliver", "deliver_url")
        if not body:
            raise ValueError("redeliver 要给 deliver 或 deliver_url")
        if "deliver" in body:
            body["deliver"] = _task_relative(body["deliver"], topic)
        return {
            "method": "POST",
            "path": here + "/accept-card/redeliver",
            "body": body,
        }
    if tool == "cheese_card.ready":
        return {"method": "POST", "path": here + "/ready"}
    if tool == "cheese_doc.list":
        return {"method": "GET", "path": f"/projects/{project}/documents"}
    if tool == "cheese_canvas.get":
        canvas = urllib.parse.quote(str(args["canvas"]).strip(), safe="")
        query = "?positions=true" if args.get("positions") is True else ""
        return {"method": "GET", "path": f"/canvases/{canvas}/text{query}"}
    if tool == "cheese_canvas.edit":
        canvas = urllib.parse.quote(str(args["canvas"]).strip(), safe="")
        return {
            "method": "POST",
            "path": f"/canvases/{canvas}/changes",
            "body": {"changes": [_canvas_change(c) for c in args["changes"]]},
        }
    if tool == "cheese_library.list":
        folder = str(args.get("dir") or "").strip().strip("/")
        query = f"?{urllib.parse.urlencode({'dir': folder})}" if folder else ""
        return {"method": "GET", "path": f"/projects/{project}/library{query}"}
    if tool == "cheese_room.rename":
        body = {"title": args["text"]}
        return {"method": "POST", "path": here + "/title", "body": body}
    if tool == "cheese_project_search":
        query = urllib.parse.urlencode({"q": args["query"], "limit": 8})
        return {"method": "GET", "path": f"/projects/{project}/context/search?{query}"}
    if tool == "cheese_memory.project":
        query = urllib.parse.urlencode({"project_id": project, "scope": "team"})
        return {"method": "GET", "path": f"/memory/files?{query}"}
    if tool == "cheese_library.read":
        path = args["path"].strip()
        # 资料库是项目的：不在哪个房间里的会话（项目总览的文档芝士）也读得到，
        # PDF 读成文字。房间里自己的文件才要话题。
        if path.startswith("library/") and project:
            query = urllib.parse.urlencode({"path": path})
            return {
                "method": "GET",
                "path": f"/projects/{project}/library/text?{query}",
            }
        if not topic:
            raise ValueError("Missing CHEESE_TOPIC")
        query = urllib.parse.urlencode({"path": path})
        return {"method": "GET", "path": f"/topics/{topic}/preview/file?{query}"}
    if tool == "cheese_inbox.list":
        return {
            "method": "POST",
            "path": "/assistant/agent/inbox",
            "body": _given(args, "project"),
        }
    if tool == "cheese_read":
        return _read_plan(args)
    if tool == "cheese_settings":
        where = (args.get("where") or "").strip()
        if where and where != "me":
            body = {"where": where, "level": args["value"]}
            return {"method": "POST", "path": "/assistant/agent/notify", "body": body}
        body = {"key": args["key"], "value": args["value"]}
        return {
            "method": "POST",
            "path": "/notifications/preferences/agent/set",
