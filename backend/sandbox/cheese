            ]
        return {
            "method": "POST",
            "path": f"/topics/{topic}/feedback-proposals",
            "body": body,
        }
    # 反馈不属于房间（`/feedback` 下面），但读的、领的人是你：你的凭据只在这个房间
    # 里认得出你，所以带上房间，后端在房间里认人，再拿房间的项目判你是不是在做这个
    # 平台本身。
    if tool == "cheese_feedback.list":
        params = {
            "topic": topic,
            **_given(
                args,
                "query:q",
                "tab",
                "status",
                "kind",
                "author",
                "since",
                "offset:page_start",
            ),
        }
        return {"method": "GET", "path": "/feedback?" + urllib.parse.urlencode(params)}
    if tool == "cheese_run_records":
        params = {"topic": topic, **_given(args, "window")}
        if args.get("turn_id"):
            ref = urllib.parse.quote(str(args["turn_id"]).strip(), safe="")
