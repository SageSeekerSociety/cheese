# share the turn's id (R4).
TURN = os.environ.get("CHEESE_TURN", "")
# In a private chat, `remember` writes the owner's personal memory (跟着人走).
MEMORY_SCOPE = os.environ.get("CHEESE_MEMORY_SCOPE", "project")
OWNER = os.environ.get("CHEESE_OWNER", "")


def _preview_base(port: int) -> str:
    """Recognize a server mounted at the platform's advertised preview base."""
    base = os.environ.get("CHEESE_APP_BASE", "")
    if not base:
        return ""
    conn = http.client.HTTPConnection("127.0.0.1", port, timeout=5)
    try:
        conn.request("GET", "/")
        response = conn.getresponse()
        # Vite redirects / to its configured base. Do not follow redirects:
        # an application's login redirect must not change the preview mount.
        if response.status in (301, 302, 303, 307, 308) and response.getheader("Location") == base:
            return base.rstrip("/")
        return ""
    finally:
        conn.close()


def _call(
    method: str,
    path: str,
    body: dict | None = None,
    *,
    token: str | None = None,
    tolerate: tuple[int, ...] = (),
) -> dict:
    """Call the platform. Any HTTP error is fatal, except the statuses in
    `tolerate` — those come back as ``{"ok": False, "status": ..., "error": ...}``
    for a caller that has something better to say than the raw response."""
    url = f"{API}{path}"
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method)
    req.add_header("Content-Type", "application/json")
    auth = token if token is not None else TOKEN
    if auth:
        req.add_header("X-Cheese-Token", auth)
    if TURN:
        req.add_header("X-Cheese-Turn", TURN)
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        raw = e.read().decode(errors="replace")
        if e.code in tolerate:
            try:
                payload = json.loads(raw)
            except ValueError:
                payload = {}
            return {"ok": False, "status": e.code, "error": payload.get("error") or {}}
        print(
            f"[cheese] {method} {path} 失败 HTTP {e.code}: {raw[:400]}", file=sys.stderr
        )
        sys.exit(1)
    except Exception as e:  # noqa: BLE001
        print(f"[cheese] {method} {path} 出错: {e}", file=sys.stderr)
        sys.exit(1)


def _doc_version_path(topic: str) -> str:
    """Where the version `cheese doc get` last showed for this topic is kept.

    The living doc has no partial write: `doc set` replaces the whole thing. So
    a write has to say which version it is replacing, and that number must be
    EVIDENCE OF A READ rather than something the caller states. A flag would let
    you assert a version you only heard about — the platform pushes 「文档已更新
    到第 7 版」 into a running session — and write ten-minute-old content over it
    claiming to be based on it, which is the exact overwrite the version exists
    to stop.

    Lives on the session mount (host-backed, survives a container rebuild): a
    rebuild mid-turn must not turn a read the agent really did into a read the
    CLI has forgotten.
    """
    home = os.environ.get("HOME") or "/tmp"
    session = os.path.join(home, ".claude")
    base = (
        os.path.join(session, "cheese-doc")
        if os.path.isdir(session)
        else os.path.join(home, ".cheese", "doc")
    )
    os.makedirs(base, exist_ok=True)
    return os.path.join(base, f"{topic}.version")


def _remember_doc_version(topic: str, version: int) -> None:
    try:
        with open(_doc_version_path(topic), "w", encoding="utf-8") as f:
            f.write(str(version))
    except OSError:
        # Losing the note costs a rejected `doc set` and a re-read, which is the
        # safe direction. Failing the `doc get` over it is not.
        pass


def _read_doc_version(topic: str) -> int:
    """The version this CLI last showed the agent. 0 — "I have not read it" —
    when there is no note, which is also the only version under which `doc set`
    may CREATE a doc. Not having read a doc that exists is exactly when a write
    must be refused."""
    try:
        with open(_doc_version_path(topic), encoding="utf-8") as f:
            return int(f.read().strip() or 0)
    except (OSError, ValueError):
        return 0


def _need(name: str, value: str) -> str:
    if not value:
        print(f"[cheese] 缺少 {name}（环境变量未注入）", file=sys.stderr)
        sys.exit(2)
    return value


def _api_root() -> str:
    """The API surface base exactly as the launcher supplied it.

    A direct backend URL is the app root. A public URL includes the gateway's
    ``/api`` mount, which nginx strips before forwarding. Removing that suffix
    here makes device calls to ``/openapi.json`` and ``/sandbox/github-token``
    miss the gateway and hit the frontend instead.
    """
    return API


def _raw_request(method: str, path: str, data: str | None, out: str | None = None) -> None:
    """Raw API escape hatch (fusion-design §5.2): hit our backend directly with
    the container's existing auth (CHEESE_TOKEN), printing the response body
    verbatim. NOT a no-auth backdoor — it still carries the token, and the
    backend still authorizes the actor per call; it is just the low-ceremony
    channel for the 20% of cases the curated commands don't cover. Prefer the
    curated `cheese <verb>` commands (title/doc/ask/remember/...) — see SKILL.md.

    `out` writes the body to a file as BYTES. Without it the body is decoded as
    text, which is right for JSON and destroys anything else: `decode(errors=
    "replace")` turns every byte over 0x7f into U+FFFD, so a PNG arrives with
    its own signature (`\x89PNG`) mangled and no way to tell that happened
    apart from the file not opening. Attachments are reachable over this
    channel, so text-only was not a limitation of the API — only of this
    function."""
    if not path.startswith("/"):
        path = "/" + path
    body = data.encode() if data else None
    req = urllib.request.Request(f"{API}{path}", data=body, method=method.upper())
    req.add_header("Content-Type", "application/json")
    if TOKEN:
        req.add_header("X-Cheese-Token", TOKEN)
    if TURN:
        req.add_header("X-Cheese-Turn", TURN)
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            payload = r.read()
    except urllib.error.HTTPError as e:
        # Surface the backend's error body (auth failures, validation, etc.)
        # verbatim so the caller sees exactly why — then exit non-zero. Always
        # as text: an error body is JSON even when the success body would not
        # have been, and writing it to `out` would leave a file that looks like
        # the download succeeded.
        print(e.read().decode(errors="replace"))
        sys.exit(1)
    except Exception as e:  # noqa: BLE001
        print(f"[cheese] api {method} {path} 出错: {e}", file=sys.stderr)
        sys.exit(1)
    if out:
        with open(out, "wb") as f:
            f.write(payload)
        print(f"已写入 {out}（{len(payload)} 字节）")
    else:
        print(payload.decode(errors="replace"))


def _format_status(d: dict) -> str:
    """Human/agent-readable rendering of /topics/{id}/status (盲飞防护): the
    turn's state, every accept card with its gate tail, and the platform
    waterlines — the questions agents used to hand-poll the API for.

    A running turn is shown as 正常运行中 or 接近硬顶, never as a live countdown
    of seconds. A literal "还剩 Ns" figure was observed making the agent rush
    against what's only ever meant to be a wedged-turn safety net."""
    lines: list[str] = []
    topic = d.get("topic") or {}
    head = f"话题: {topic.get('title', '?')}（{topic.get('status', '?')}"
    if topic.get("branch"):
        head += f", 分支 {topic['branch']}"
    lines.append(head + "）")
    turn = d.get("turn")
    if turn:
        t = f"本轮: {turn.get('status')}"
        if turn.get("status") == "running":
            if turn.get("near_ceiling"):
                t += "，接近硬顶（即将触发兜底结束）"
            else:
                t += "，正常运行中"
        elif turn.get("duration_s") is not None:
            t += f"，用时 {turn['duration_s']}s"
        if turn.get("detail"):
            t += f"（{turn['detail']}）"
        lines.append(t)
    cards = d.get("cards") or []
    lines.append(f"验收卡: {len(cards)} 张" if cards else "验收卡: 无")
    for c in cards:
        row = f"- [{c.get('status')}] 递给 @{c.get('reviewer')}"
        if c.get("decided_by"):
            row += f"，{c['decided_by']} 处理于 {c.get('decided_at')}"
        if c.get("note"):
            row += f"；note: {c['note']}"
        lines.append(row)
        if c.get("pr_url"):
            lines.append(f"  PR: #{c.get('pr_number')} {c['pr_url']}")
            # The repo name is already sitting in the PR url — spell the CI
            # lookup out rather than leaving "用 gh 查" as an exercise.
            m = re.match(r"https://github\.com/([^/]+/[^/]+)/pull/", c["pr_url"])
            if m:
                lines.append(
                    f"  查 CI: export GH_TOKEN=$(cheese gh-token); "
                    f"gh api repos/{m.group(1)}/commits/<head_sha>/check-runs"
                )
        if c.get("status") == "gate_failed" and c.get("gate_output_tail"):
            lines.append("  闸门输出（尾部）:")
            lines.extend(
                "    " + ln for ln in c["gate_output_tail"].splitlines()[-15:]
            )
    bg = d.get("background") or {}
    for t in bg.get("tasks") or []:
        lines.append(
            f"后台任务: 「{t.get('label')}」已跑 {t.get('running_s')}s"
            f"（上限 {t.get('timeout_s')}s）；输出: {t.get('log_path')}"
        )
    plat = d.get("platform") or {}
    disk = plat.get("disk")
    if disk:
        lines.append(
            f"磁盘: 可用 {disk.get('free_gb')}G / {disk.get('total_gb')}G"
            f"（已用 {disk.get('used_pct')}%）"
        )
    credits = plat.get("credits") or {}
    cred = "不限" if credits.get("unlimited") else f"剩 {credits.get('remaining')}"
    lines.append(
        f"并发: 全站运行中 {plat.get('active_turns', '?')} 轮，"
        f"本项目排队 {plat.get('queued_turns', 0)}；额度: {cred}"
    )
    return "\n".join(lines)


def _print_api_index() -> None:
    """List available operations from our FastAPI /openapi.json (like Restish,
    but built from OUR live spec). Lets `cheese api` self-describe what raw calls
    are possible without hardcoding anything."""
    url = f"{_api_root()}/openapi.json"
    try:
        with urllib.request.urlopen(url, timeout=20) as r:
            spec = json.load(r)
    except Exception as e:  # noqa: BLE001
        print(f"[cheese] 拉取 openapi 失败: {e}", file=sys.stderr)
        sys.exit(1)
    print("可用的原始 API 操作（优先用 curated 命令，这些是兜底逃生口）：")
    for path in sorted(spec.get("paths", {})):
        methods = spec["paths"][path]
        for method in sorted(methods):
            if method.lower() in ("get", "post", "put", "delete", "patch"):
                print(f"  {method.upper():6} {path}")
    print("\n用法: cheese api <METHOD> <path> [--data '<json>']")
    print("例:   cheese api GET /topics/$CHEESE_TOPIC/blocks")


def source_fingerprint() -> str:
    """A short digest of THIS file's bytes.

    The box's `cheese` is bind-mounted from the backend's own copy, so the only
    way to tell — from inside a box — whether that plumbing actually worked is
    to compare what runs here against what the backend shipped. `cheese
    --version` prints this; a mismatch means the mount is stale."""
    try:
        with open(__file__, "rb") as f:
            return hashlib.sha256(f.read()).hexdigest()[:12]
    except OSError:
        return "unknown"


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="cheese",
        description=(
            "芝士 平台 CLI —— 改「平台状态」用它,改「文件/代码」用原生工具。\n"
            "\n"
            "每个子命令的 --help 是权威的那一份(它和代码同源,不会过期)。\n"
            "散文文档(SKILL.md / CLAUDE.md / .claude/rules/)只补 --help 说不了的东西。"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument(
        "--version",
        action="version",
        version=f"cheese {source_fingerprint()}",
        help="打印源码指纹,用来核对本容器里的 CLI 是不是后端那一份",
    )
    sub = p.add_subparsers(dest="cmd", required=True)

    pd = sub.add_parser(
        "doc",
        help="实况文档",
        description=(
            "实况文档 = 本话题的状态摘要,也是你跨轮的记忆。"
            "话题标题会被渲染成文档大标题,正文别再用一级标题重复一遍。"
        ),
    )
    pdsub = pd.add_subparsers(dest="doccmd", required=True)
    pdset = pdsub.add_parser(
        "set",
        help="把文件设为本话题实况文档",
        description=(
            "整块覆盖:写的是你这个文件的全文,不是补丁。所以写之前必须先 "
            "doc get 读一遍——平台按你读到的那一版收这次写入,期间别人改过就"
            "直接拒了,不会悄悄盖掉。被拒之后重新 doc get、把别人的改动合进你"
            "的文件、再 set,别原样重试。"
        ),
    )
    pdset.add_argument(
        "file",
        help="工作区里的 markdown 文件路径(放 docs/topics/ 下,别堆在仓库根目录)",
    )
    pdsub.add_parser(
        "get",
        help="打印本话题实况文档",
        description=(
            "打印当前实况文档原文。这一步同时决定了你接下来能写回哪一版:"
            "没 get 过就 set,平台当你没读过,只有本话题还没有文档时才让你建。"
        ),
    )

    ps = sub.add_parser(
        "split",
        help="在这个房间里开一条活（开完你自己起分身去做）",
        description=(
            "开一条活并给它建好任务简报文档。**它不会自己动起来**——起分身是你的事:\n"
            "\n"
            "  1. cheese split \"标题\" --brief \"...\"   → 拿到 task id\n"
            "  2. 用你自己的 Agent 工具起一个分身,把 --brief 的原文放进 prompt\n"
            "  3. cheese bind <task_id> <agent_id>   → 告诉平台这条活归哪个分身\n"
            "\n"
            "第 3 步不做,这条活在界面上就永远是「没人做」,分身干的每一件事都记在\n"
            "你(房间)头上,谁也分不出来。\n"
            "\n"
            "分身和你共用同一个工作区、同一条分支,所以:\n"
            "  - 装好的依赖、clone 下来的参照仓库它都直接能用,不用重来一遍\n"
            "  - 两条活整块改同一个文件会互相盖掉,拿 --paths 划开\n"
            "\n"
            "分身能看到的只有你放进 prompt 的东西。--brief 会存成它的任务简报文档,\n"
            "但**它不会自动读**,记得在 prompt 里把简报原文带上。"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    ps.add_argument("title", help="这条活的标题,≤12 字最好")
