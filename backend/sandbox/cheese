    )
    pct.add_argument("task_id", help="这条活的 id")
    pct.add_argument(
        "--conclusion", default="", help="覆盖分身交回的那句话(默认保留它的)"
    )

    sub.add_parser(
        "push-fix",
        help="把工作区现在的样子推到本话题正在等 CI 的那个 PR 上",
        description=(
            "把工作区**现在**的样子折成提交,推到本话题正在等 CI 的那个 PR。\n\n"
            "为什么要有这条命令:平台的 CI 轮询**不再**每 60 秒替你提交一次了。\n"
            "它以前会,后果是你在等 CI 期间随便写个文件(哪怕只是改实况文档)都会\n"
            "变成一个提交、推上去、把正在跑的那轮 CI 掐掉重排——实测一个 PR 上\n"
