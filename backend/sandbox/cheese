def _task_step(tool: str, args: dict, host) -> str:
    plan = request_plan(tool, args, host.environ)
    try:
        data = host.request(plan).get("data") or {}
    except Exception as exc:
        why = _said_by_platform(exc)
        if why is None:
            raise
        raise PlatformToolError(f"未完成：{why.rstrip('。')}。") from exc
    if tool == "cheese_problem.publish":
        task = data.get("task") or {}
        if data.get("saved"):
            return f"已保存题目 {task.get('id')}「{task.get('name')}」的修改。"
        state = "已上线" if task.get("approved") == "APPROVED" else "待空间管理员审核"
        return f"已发布题目 {task.get('id')}「{task.get('name')}」，{state}。"
    changed = list(
        dict.fromkeys(
            _TASK_FIELD_WORDS[k]
            for k in data.get("changed") or []
            if k in _TASK_FIELD_WORDS
        )
    )
    said = (
        f"已新建草稿 {data.get('draft')}"
        if data.get("created")
        else f"已写入草稿 {data.get('draft')}"
    )
    said += f"（version {data.get('version')}）。"
    said += f"改了：{'、'.join(changed)}。" if changed else "没有字段变化。"
    if data.get("kept"):
        said += (
            f"用户在你读草稿之后改过 {'、'.join(data['kept'])}，这些保持用户的版本；"
            "要改先用 cheese_read 读这份草稿（drafts/<草稿 id>）最新的内容。"
        )
    if data.get("missing"):
        said += f"发布前还缺：{'、'.join(data['missing'])}。"
    if data.get("stageEffect"):
        said += (
            f"保存这些阶段的影响：{str(data['stageEffect']).rstrip('。')}。"
            "发布前把这句原样告诉用户，等他确认再发布。"
        )
    if data.get("description"):
        said += (
            "套用模板后的详情如下，按它的小标题往下填（用 description_edits 或"
            "保留小标题整篇写入）：\n" + str(data["description"])
        )
    return said


