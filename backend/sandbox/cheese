#: What one tool call does, as the harness of a person's 芝士 weighs it before
#: running it (`run_platform_tool`), the way Claude Code's permission check reads
#: a tool's own declaration: it reads; it changes only what is the person's own,
#: or what they asked it to work on, and they can undo; or it reaches others —
#: a message, a task, a decision, a member, a page fetched from a host — which its
#: gate weighs first (`/assistant/agent/review`).
READS = "reads"
CHANGES = "changes"
REACHES_OTHERS = "reaches others"


class ToolTable:
    """平台的 MCP 工具表 —— 会话侧的一个常量（结论 21，由结论 63 修订）。

    以前这张表是**问出来的**：会话侧的 MCP 服务器收到 `tools/list`，就去执行器要一
    份，执行器再把机器上那棵 argparse 树翻成工具。于是一台执行机够不着，整个
    `cheese_*` 家族就从清单里消失，agent 被告知 `No such tool available:
    mcp__native__cheese_status` —— 而它这一刻最需要的恰恰是「跟房间说一句这里出事
    了」。这件事付过三轮（2026-09-13、-14、-15）。

    表在这里，它就不再问任何人。表上是**纯平台动作**：它们要的是平台，不是那台机器，
    所以从会话直接打后端，机器离线时一样不少——对话、文档、任务卡、验收都在。只有
    `cheese_card` 递卡（request）还要机器：它先让机器把任务的提交推上去；机器够不着时当场
    说够不着，不等超时。

    必须在机器上作为进程跑的（任务目录、同步与恢复、预览、读写工作区文件的转换、git
    凭据）才是这个文件的 CLI 子命令，跟文件、命令、项目 `.mcp.json` 一样随机器在、随
    机器没（结论 22）。
    """

    def __init__(self, tools, effects=None, *, every_call=False):
        tools = tuple(tools)
        #: What each call does (`READS`, `CHANGES`, `REACHES_OTHERS`), by key
        #: (`<tool>` or `<tool>.<action>`), for the harness of a person's 芝士 to
        #: read before it runs one (`run_platform_tool`). `every_call`: a table
        #: whose every call must say, so a verb added without saying what it
        #: does fails here rather than running unweighed.
        self._effects = dict(effects or {})
        #: 一个对象一样工具的那几行，各自的动词（`_object`）：调用时按它查这一个
        #: 动词收哪些参数。它不进清单——清单上只有 MCP 认得的那三个字段。
        self._actions = {t["name"]: t["actions"] for t in tools if "actions" in t}
        self._summaries = {t["name"]: t["summary"] for t in tools if "actions" in t}
        self._tools = tuple(
            {k: v for k, v in t.items() if k not in ("actions", "summary")}
            for t in tools
        )
        keys = {
            key
            for t in tools
            for key in (
                [f"{t['name']}.{verb}" for verb in t["actions"]]
                if "actions" in t
                else [t["name"]]
            )
        }
        unknown = sorted(set(self._effects) - keys)
        unsaid = sorted(keys - set(self._effects)) if every_call else []
        if unknown or unsaid:
            raise ValueError(
                f"tool effects name no call: {unknown}; calls that say no effect: {unsaid}"
            )

    def names(self) -> tuple[str, ...]:
        return tuple(tool["name"] for tool in self._tools)

    def schemas(self) -> list[dict]:
        """MCP `tools/list` 要的那一份。"""
        return list(self._tools)

    def effect(self, key: str) -> str | None:
        """What the call `key` (`<tool>` or `<tool>.<action>`) does; None when
        it does not say."""
        return self._effects.get(key)

    def calls_that(self, effect: str) -> frozenset[str]:
        return frozenset(k for k, e in self._effects.items() if e == effect)

    def actions(self, name: str) -> dict | None:
        """The verbs of the tool `name`, each with what it takes; None for a
        tool that does one thing."""
        return self._actions.get(name)

    def narrowed(self, name: str, verbs) -> dict:
        """The entry for `name` offering only `verbs`: a session that may do
        some of what an object does (a document's 芝士 reads and edits the
        document but makes none) is handed a tool that lists no more."""
        actions = self._actions[name]
        unknown = [verb for verb in verbs if verb not in actions]
        if unknown:
            raise ValueError(f"{name} has no verb {', '.join(unknown)}")
        row = _object(
            name, self._summaries[name], {v: actions[v] for v in actions if v in verbs}
        )
        return {k: v for k, v in row.items() if k not in ("actions", "summary")}

    def __contains__(self, name: object) -> bool:
        return name in self.names()


