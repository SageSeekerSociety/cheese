            "stderr 里就有;stdout 只有 token 本身,所以 `GH_TOKEN=$(cheese gh-token)` "
            "照常能用。"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )

    sub.add_parser(
        "status",
        help="平台状态快照:本轮运行状态/验收卡与闸门输出/磁盘与额度水位",
        description=(
            "想知道「卡到哪了 / 闸门为什么红」时先跑它,别去轮询原始 API。"
            "验收卡那一段带闸门的失败输出。"
        ),
    )

    psv = sub.add_parser(
        "serve",
        help="把这台机器上跑起来的应用设为当前预览(先起服务,再报端口)",
        description=(
            "把**已经跑起来的**应用设为当前预览。跑之前:\n"
            "  1. 把 dev server 起在 127.0.0.1 上,后台跑(nohup ... &)\n"
            "  2. 端口你自己挑,固定住(vite 要 --strictPort,否则端口被占时它会\n"
            "     静默跳到下一个,你以为起好了,报上来的那个却没人应答)\n"
            "  3. 把那个端口报给这条命令\n"
            "\n"
            "页面经后端反代挂在 $CHEESE_APP_BASE 这个子路径下。会发根绝对资源 URL\n"
            "的 dev server(vite 的 /@vite/client)要按这个 base 起,否则用户那边\n"
            "只有一个白框:\n"
            "  vite --base=$CHEESE_APP_BASE --strictPort --port <端口>\n"
            "\n"
            "平台会当场从自己这边敲一次那个端口;敲不通就直接拒绝,不会给用户留一个\n"
            "白框。这台机器不是平台的,预览走的是这台机器主动拨出去的一条隧道——所以\n"
            "只有你报上来的这一个端口会被带出去,别的端口平台碰不到。"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    psv.add_argument("port", type=int, help="应用监听的端口,如 5173")
    psv.add_argument("note", nargs="?", default="app",
                     help="一句话说明在跑什么,如 'Vue dev server'")

    part = sub.add_parser(
        "artifact",
        help="把工作区文件设为可渲染产物(当前预览)",
        description=(
            "做出了能直接「看」的东西(网页/可视化/SVG)就点名它,用户在右侧预览里"
            "就能看到。平台不会去猜该显示哪个文件——你显式指定。"
            "每次调用都会把预览指向最新那个。"
        ),
    )
    part.add_argument("path", help="工作区相对路径,如 report.html")
    part.add_argument("--as", dest="as_", default="html", choices=["html", "svg"],
                      help="渲染类型(默认 html)")

    papi = sub.add_parser(
        "api",
        help="原始 API 逃生口(兜底,不推荐):直接打后端,带容器已有鉴权。无参=列可用操作",
        description=(
            "原始 API 通道。上面那些 curated 命令覆盖 80% 场景,语义清晰、有校验,"
            "**优先用它们**;只有当没有对应的 curated 命令时才用 api。\n"
            "\n"
            "它仍然走容器已有的鉴权(不是无鉴权后门,后端照样按你的身份授权),"
            "但校验少、易出错。裸 curl 和翻 session 文件依然是禁止的——"
            "这个逃生口只是「少校验的原始通道」,不改变鉴权纪律。"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    papi.add_argument("method", nargs="?", help="HTTP 方法,如 GET/POST/PUT/DELETE")
    papi.add_argument("path", nargs="?", help="API 路径,如 /topics/<id>/blocks")
    papi.add_argument("--data", "-d", default=None, help="请求体(JSON 字符串)")
    papi.add_argument(
        "--output",
        "-o",
        default=None,
        metavar="FILE",
        help=(
            "把响应体按**字节**写进这个文件,而不是当文本打印。"
            "下载附件/图片必须用它:不带 -o 的输出会把每个 >0x7f 的字节换成 U+FFFD,"
            "文件到手是坏的,而且看不出坏在哪"
        ),
    )

    return p


def main() -> None:
    a = build_parser().parse_args()

    if a.cmd == "doc" and a.doccmd == "set":
        topic = _need("CHEESE_TOPIC", TOPIC)
        with open(a.file, encoding="utf-8") as f:
            content = f.read()
        based_on = _read_doc_version(topic)
        res = _call(
            "PUT",
            f"/topics/{topic}/doc",
            {"content": content, "author": AUTHOR, "expected_version": based_on},
            tolerate=(409,),
        )
        if res.get("ok") is False:
            current = (res.get("error") or {}).get("data", {}).get("doc_version")
            print(
                f"[cheese] 没写进去：文档现在是第 {current} 版，你这份是照第 "
                f"{based_on} 版改的。先 cheese doc get 重新读一遍，把别人的改动"
                "合进你的文件，再 cheese doc set。直接重试会原样被拒。",
                file=sys.stderr,
            )
            sys.exit(1)
        _remember_doc_version(topic, (res.get("data") or {}).get("doc_version", 0))
        print("已更新实况文档。")
    elif a.cmd == "doc" and a.doccmd == "get":
        topic = _need("CHEESE_TOPIC", TOPIC)
        d = _call("GET", f"/topics/{topic}/doc").get("data")
        # Reading is what earns the right to write: remember the version this
        # printed, and `doc set` writes against it.
        _remember_doc_version(topic, (d or {}).get("doc_version", 0))
        print((d or {}).get("content", "") if d else "")
    elif a.cmd == "split":
        topic = _need("CHEESE_TOPIC", TOPIC)
        body = {"title": a.title, "created_by": AUTHOR}
        if a.brief:
            body["brief"] = a.brief
        if a.paths:
            body["paths"] = a.paths
        # 不写 --reviewer = 用项目默认验收人。同 accept-request：别塞空串，
        # 「没说」和「说了空的」在后端是两件事。
        if a.reviewer:
            body["reviewer_handle"] = a.reviewer
        r = _call("POST", f"/topics/{topic}/split", body)["data"]
        who = r.get("reviewer_handle")
        print(
            f"已开一条活：{r['title']}（id={r['id']}）。**它还没人做**，接下来两步：\n"
            f"  1. 用你的 Agent 工具起一个分身，把 --brief 的原文放进 prompt\n"
            f"  2. cheese bind {r['id']} <分身的 agent_id>\n"
            + (
                f"验收人：{who}（递卡时不指定就用它）"
                if who
                else "这条活还没有验收人（项目也没设默认），递卡时要点名一个。"
            )
        )
    elif a.cmd == "bind":
        topic = _need("CHEESE_TOPIC", TOPIC)
        r = _call(
            "POST", f"/topics/{topic}/tasks/{a.task_id}/bind", {"agent_id": a.agent_id}
        )["data"]
        print(f"「{r['title']}」现在归分身 {r['subagent_id']}，它干的事会记到这条活上。")
    elif a.cmd == "conclude-task":
        topic = _need("CHEESE_TOPIC", TOPIC)
        r = _call(
            "POST",
            f"/topics/{topic}/tasks/{a.task_id}/conclude",
            {"conclusion": a.conclusion},
        )["data"]
        print(f"「{r['title']}」收了。结论：{(r.get('conclusion') or '（没有留话）')}")
    elif a.cmd == "claim":
        topic = _need("CHEESE_TOPIC", TOPIC)
        # 替一条活声明时走 /tasks/<id>/claim:那条会被记下来,房间自己那条只查不记
        # (声明记在卡上,房间没有卡)。两条都走房间的地址——这一轮的 token 是按房间
        # 签的,活没有自己的地址。
        path = (
            f"/topics/{topic}/tasks/{a.task}/claim"
            if a.task
            else f"/topics/{topic}/claim"
        )
        r = _call("POST", path, {"paths": a.paths})["data"]
        if r.get("refusals"):
            print("这些路径没能声明:")
            for line in r["refusals"]:
                print(f"  ✗ {line}")
            print("把范围缩窄一点,或者等对方先做完。")
        elif a.task:
            print(f"已声明:{'、'.join(r.get('claimed') or a.paths)}")
        else:
            print(f"没撞上别人:{'、'.join(a.paths)}(房间自己的声明不记录)")
        for line in r.get("warnings") or []:
            print(f"  ⚠ {line}")
    elif a.cmd == "lock":
        topic = _need("CHEESE_TOPIC", TOPIC)
        r = _call(
            "POST", f"/topics/{topic}/lock", {"kind": a.kind, "resource": a.resource}
        )["data"]
        if r.get("acquired"):
            print(f"占住了({a.kind} {a.resource or ''})".rstrip())
        else:
            print(f"没占到:{r.get('reason') or '别人占着'}")
            sys.exit(1)
    elif a.cmd == "unlock":
        topic = _need("CHEESE_TOPIC", TOPIC)
        r = _call(
            "POST", f"/topics/{topic}/unlock", {"kind": a.kind, "resource": a.resource}
        )["data"]
        print("已归还。" if r.get("released") else "你本来就没占着它。")
    elif a.cmd == "push-fix":
        topic = _need("CHEESE_TOPIC", TOPIC)
        r = _call("POST", f"/topics/{topic}/push-fix")["data"]
        if r.get("pushed"):
            print(f"已推到 PR #{r['pr_number']}：{r.get('pr_url') or ''}")
        else:
            print(f"没有推送：{r.get('reason') or '没有可推的东西'}")
    elif a.cmd == "decision":
        topic = _need("CHEESE_TOPIC", TOPIC)
        _call("POST", f"/topics/{topic}/decision", {"decision": a.text})
        print("已记入决策记录。")
    elif a.cmd == "title":
        topic = _need("CHEESE_TOPIC", TOPIC)
        if a.task:
            # 房间给它的活起名字。走房间的地址,因为这一轮的 token 是按房间签的,
            # 直接拿活的 id 当地址会被判成跨话题(403)。
            r = _call(
                "POST", f"/topics/{topic}/tasks/{a.task}/title", {"title": a.text}
            )["data"]
            print(f"这条活现在叫「{r['title']}」。")
        else:
            _call("POST", f"/topics/{topic}/title", {"title": a.text})
            print(f"话题标题已设为：{a.text}")
    elif a.cmd == "remember":
        proj = _need("CHEESE_PROJECT", PROJECT)
        # 带上话题：后端据此认出是哪个芝士在记，存进它自己的项目记忆
        # (同一个项目里的两个芝士各记各的，跟人一样)。
        body = {"content": a.fact, "topic": TOPIC}
        if a.core:
            body["layer"] = "core"
        kind = "核心记忆（每轮都在场）" if a.core else "记忆"
        if MEMORY_SCOPE == "personal" and OWNER:
            body["scope"] = "user"
            body["owner"] = OWNER
            _call("POST", f"/projects/{proj}/memory", body)
            print(f"已记入个人{kind}。")
        else:
            _call("POST", f"/projects/{proj}/memory", body)
            print(f"已记入项目{kind}。")
    elif a.cmd == "recall":
        proj = _need("CHEESE_PROJECT", PROJECT)
        body = {"query": a.query, "topic": TOPIC}
        if MEMORY_SCOPE == "personal" and OWNER:
            body["scope"] = "user"
            body["owner"] = OWNER
        hits = _call("POST", f"/projects/{proj}/memory/search", body).get("data", {}).get("hits", [])
        if not hits:
            # 关键词检索没命中 ≠ 没有这条记忆。说清楚这一点,否则一次空结果就会被
            # 当成"确认不存在",然后一头撞上那条记忆本来要拦住的坑。
            print("没有找到相关记忆。（关键词检索,不是语义检索：换个说法、"
                  "或只用其中一两个关键词再试一次）")
        for h in hits:
            print(f"- {h.get('abstract', '')}")
    elif a.cmd == "ask":
        topic = _need("CHEESE_TOPIC", TOPIC)
        opts = [o.strip() for o in a.option if o.strip()]
        if not 2 <= len(opts) <= 4:
            print("[cheese] ask 需要 2-4 个 --option", file=sys.stderr)
            sys.exit(2)
        _call("POST", f"/topics/{topic}/ask", {"question": a.question, "options": opts})
        print(f"[cheese] 已发出选项问题（{len(opts)} 个选项）")

    elif a.cmd == "notify":
        proj = _need("CHEESE_PROJECT", PROJECT)
        payload = {}
        if a.options:
            payload["options"] = [o.strip() for o in a.options.split("|") if o.strip()]
        body = {
            "level": a.level, "kind": a.kind, "title": a.title, "body": a.body,
            "target_handle": a.to, "topic_id": TOPIC or None, "payload": payload,
        }
        _call("POST", f"/projects/{proj}/alerts", body)
        print(f"已发送通知给 {a.to or '所有人'}。")
    elif a.cmd == "ready":
        topic = _need("CHEESE_TOPIC", TOPIC)
        r = _call("POST", f"/topics/{topic}/ready")["data"]
        if r.get("ready"):
            print(f"PR #{r['pr_number']} 已从 draft 翻成 ready：{r.get('pr_url') or ''}")
        else:
            print(r.get("reason") or "没有可以翻的 PR。")
    elif a.cmd == "describe":
        topic = _need("CHEESE_TOPIC", TOPIC)
        if a.subject is None and a.body is None:
            print("[cheese] describe 至少要给 --subject 或 --body", file=sys.stderr)
            sys.exit(2)
        body = {}
        if a.subject is not None:
            body["change_subject"] = a.subject
        if a.body is not None:
            body["change_body"] = a.body
        r = _call("POST", f"/topics/{topic}/accept-card/describe", body)["data"]
        print(
            f"验收卡的描述已更正（PR 正文同步改掉了）。现在的标题："
            f"{r.get('change_subject') or '（空）'}"
        )
    elif a.cmd == "accept-request":
        topic = _need("CHEESE_TOPIC", TOPIC)
        payload = {"routing_reason": a.reason, "change_subject": a.subject,
                   "change_body": a.body, "task_ids": a.task or []}
        # 不写验收人 = 用项目默认验收人。**不要**在这里塞一个空串:后端把
        # 「没说」和「说了空的」当同一件事处理会掩盖真正的空输入,而它给的
        # 那句打回文案正是这条命令唯一能帮上忙的地方。
        if a.reviewer:
            payload["reviewer_handle"] = a.reviewer
        r = _call("POST", f"/topics/{topic}/accept-card", payload)["data"]
        print(f"已把验收卡递给 {r.get('reviewer_handle') or a.reviewer}。")
        if not a.task:
            # 别在这里说「重递一次带上 --task」：卡已经 pending，同一棵树上再递
            # 一张会被 create_card 直接拒掉，照着做必然失败。声明只在递卡这一刻
            # 收，补声明没有入口，唯一走得通的补救要人来动手。
            print(
                "这次没有 --task，合并后的提交里不会有 Cheese-Task 行——"
                "以后翻 git log 的人查不到是哪个分身写的。\n"
                "声明只在递卡这一刻收，这张卡上补不了，直接再递一张会被"
                "「已有待处理的验收卡」拒掉。真要补：等这张卡进终态再带 --task 重递 —— "
                "**被驳回**和**被作废**都算，两条都是人的动作（你自己点不了），"
                "而驳回本来就是可以重递的。\n"
                "下次递卡一次带上。"
            )
    elif a.cmd == "tell":
        # URL 里的 topic 是**发方**（per-turn token 按它校验作用域）；收方在 body 里，
        # 由后端校验它确实是这个房间派出的活。
        topic = _need("CHEESE_TOPIC", TOPIC)
        data = _call(
            "POST", f"/topics/{topic}/tell",
            {"target": a.target, "content": a.message},
        ).get("data", {})
        where = data.get("target_title") or data.get("target_topic_id") or a.target
        print(
            f"已写在「{where}」上。**没有人被叫醒**——做这条活的分身在你自己的"
            "会话里，要它动就直接给它发消息。"
        )
    elif a.cmd == "milestone":
        proj = _need("CHEESE_PROJECT", PROJECT)
        body = {"title": a.title}
        if a.due:
            body["due_date"] = a.due if "T" in a.due else f"{a.due}T00:00:00Z"
        _call("POST", f"/projects/{proj}/milestones", body)
        print(f"已钉里程碑：{a.title}")
    elif a.cmd == "gh-token":
        # Same API surface as every other platform endpoint.
        # stdout carries ONLY the token so `GH_TOKEN=$(cheese gh-token)` works;
        # the expiry note goes to stderr.
        req = urllib.request.Request(f"{_api_root()}/sandbox/github-token")
        if TOKEN:
            req.add_header("X-Cheese-Token", TOKEN)
        try:
            with urllib.request.urlopen(req, timeout=20) as r:
                data = json.load(r).get("data", {})
        except urllib.error.HTTPError as e:
            detail = e.read().decode(errors="replace")[:300]
            print(f"[cheese] gh-token 失败 HTTP {e.code}: {detail}", file=sys.stderr)
            sys.exit(1)
        print(data.get("token", ""))
        # stderr, not stdout: `GH_TOKEN=$(cheese gh-token)` must keep working.
        # The repo name rides along because without it the token is useless —
        # `gh api repos/:owner/:repo/...` needs a name the workspace (not a
        # checkout of the repo) can't supply.
        repo = data.get("repo") or "<owner>/<repo>"
        # The permission line comes from the payload, never from a literal
        # here: what the token carries depends on what the GitHub App was
        # granted, and a hardcoded list went stale the moment that changed —
        # which is how agents ended up believing they couldn't read an issue
        # that the token could in fact read.
        perms = data.get("permissions") or "(权限未知)"
        lines = [
            f"[cheese] {perms}, 仓库 {repo}, 过期 {data.get('expires_at', '?')}",
            "[cheese] 看 CI: export GH_TOKEN=$(cheese gh-token) 然后",
            f"[cheese]   gh api repos/{repo}/commits/<sha>/check-runs  # 哪些检查挂了",
            f"[cheese]   gh api repos/{repo}/actions/jobs/<job_id>/logs  # 完整日志",
            "[cheese]   (<job_id> = check-run 的 html_url 里 /job/ 后面那串数字)",
        ]
        # Only advertise what this token can actually do. Printing the issue
        # recipe when `issues` was not granted just buys a 403 and a wasted turn.
        if "issues" in perms:
            lines.append(
                "[cheese] 读 issue 正文/评论(不用找人贴): "
                f"gh api repos/{repo}/issues/<n>  和  .../issues/<n>/comments"
            )
        if "pull_requests" in perms:
            lines.append(
                f"[cheese] 读 PR 正文/评审意见: gh api repos/{repo}/pulls/<n>  和  "
                f".../pulls/<n>/comments"
            )
        if "contents" in perms:
            lines.append(
                "[cheese] 读工作区以外的仓库文件: "
                f"gh api repos/{repo}/contents/<path>?ref=<branch>"
            )
        # 有写权限就把交付那一步也写出来。少了这两行,一个能推、能开 PR 的 agent 照样
        # 会以为最后一步得交给平台或者人 —— 而它并不会为了确认这件事去试一次。
        if "contents: write" in perms:
            lines.append(
                "[cheese] 推分支(凭据走 URL,token 一小时后自然失效): git push "
                f"https://x-access-token:$GH_TOKEN@github.com/{repo} HEAD:<分支>"
            )
        if "pull_requests: write" in perms:
            lines.append(
                f"[cheese] 开 PR: gh api repos/{repo}/pulls -f head=<分支> "
                "-f base=<主干> -f title=<标题> -f body=<正文>"
            )
        print("\n".join(lines), file=sys.stderr)
    elif a.cmd == "members":
        topic = _need("CHEESE_TOPIC", TOPIC)
        d = _call("GET", f"/topics/{topic}/members").get("data", {})
        rows = d.get("data", d) if isinstance(d, dict) else d
        for m in rows:
            h = m.get("member_handle")
            print(f"- {m.get('name')}（{m.get('role')}）→ 在消息里写 <@{h}> 点名 ta")
    elif a.cmd == "status":
        topic = _need("CHEESE_TOPIC", TOPIC)
        d = _call("GET", f"/topics/{topic}/status").get("data") or {}
        print(_format_status(d))
    elif a.cmd == "serve":
        topic = _need("CHEESE_TOPIC", TOPIC)
        if not (1 <= a.port <= 65535):
            print(f"[cheese] {a.port} 不是一个端口号。", file=sys.stderr)
            sys.exit(2)
        up = os.environ.get("CHEESE_PREVIEW_UP", "")
        if not up:
            # No preview channel in this runtime — the launcher exports this only
            # when it has shipped the helper. A running app cannot reach the
            # panel from here, so say so instead of filing a record that would
            # render as a white frame.
            print("[cheese] 这个运行环境没有预览通道,运行中的应用到不了预览面板。\n"
                  "[cheese] 要给人看结果,用 cheese artifact <文件> 点名一个网页或 SVG。",
                  file=sys.stderr)
            sys.exit(2)
        # Declare the port and bring the tunnel up in one step. The port is
        # written on THIS machine and read from disk by the helper — it never
        # travels on the wire, which is what keeps the platform unable to point
        # a machine at any other port.
        try:
            base = _preview_base(a.port)
        except (OSError, http.client.HTTPException) as exc:
            print(f"[cheese] :{a.port} 无法访问: {exc}", file=sys.stderr)
            sys.exit(1)
        rc = subprocess.call(["sh", up, str(a.port), base])
        if rc != 0:
            print(f"[cheese] 预览通道没能起来（{up} 退出码 {rc}）。", file=sys.stderr)
            sys.exit(1)
        # The backend knocks on the port through the tunnel before accepting; a
        # dead server is refused there, with the reason.
        _call("POST", f"/topics/{topic}/artifact", {"path": a.note, "as": "app"})
        print(f"已把 :{a.port} 上的应用设为当前预览（{a.note}）。")
    elif a.cmd == "artifact":
        topic = _need("CHEESE_TOPIC", TOPIC)
        # The platform resolves artifact paths against the worktree ROOT (/work),
        # but the agent's cwd may be a subdir (e.g. after `cd backend`). Normalize
        # the given path to worktree-root-relative so `cheese artifact x.html` from
        # /work/backend points at backend/x.html, not a missing /work/x.html.
        root = os.environ.get("CHEESE_WORKTREE_ROOT", "/work")
        rel = os.path.relpath(os.path.abspath(a.path), root)
        if rel.startswith(".."):  # outside the worktree — let the backend validate
            rel = a.path
        try:
            with open(a.path, encoding="utf-8") as source:
                content = source.read()
        except (OSError, UnicodeError) as exc:
            print(f"[cheese] 无法读取 {a.path}: {exc}", file=sys.stderr)
            sys.exit(1)
        _call("POST", f"/topics/{topic}/artifact", {"path": rel, "as": a.as_, "content": content})
        print(f"已把 {rel} 设为当前预览（{a.as_}）。")
    elif a.cmd == "api":
        if not a.method:
            _print_api_index()
            return
        if not a.path:
            print("[cheese] api 需要一个路径,如 cheese api GET /topics/<id>/blocks",
                  file=sys.stderr)
            sys.exit(2)
        if a.data is not None:
            try:
                json.loads(a.data)  # fail fast on malformed JSON
            except ValueError as e:
                print(f"[cheese] --data 不是合法 JSON: {e}", file=sys.stderr)
                sys.exit(2)
        _raw_request(a.method, a.path, a.data, a.output)


if __name__ == "__main__":
    main()
