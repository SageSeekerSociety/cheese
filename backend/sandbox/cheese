def main() -> None:
    parser = build_parser()
    a = parser.parse_args()

    if a.cmd == "worktree":
        print(_task_worktree(a.task_id, reinstall=a.prepare))
    elif a.cmd == "checkout":
        print(_checkout())
    elif a.cmd == "sync":
        if a.all:
            _sync_all_tasks()
        else:
            task = _task_id(a.task)
            # Run by hand right after a commit, whose own hook has just synced
            # it, this used to ask the platform and probe the forge again to
            # find nothing to do (dev, 10-12..10-17: 169 such calls, 5.2 s at
            # the median). A checkout on the task's branch with nothing to
            # deliver is done after asking only for that branch.
            if not _synced_already(task):
                _sync_task(task)
    elif a.cmd == "push-fix":
        topic = _need("CHEESE_TOPIC", TOPIC)
        task = _task_id(a.task)
        _sync_task(task)
        path = f"/topics/{task}/push-fix"
        if a.drop_dependency:
            path += "?drop_dependency=true"
        r = _call("POST", path)["data"]
        if r.get("pushed"):
            print(f"已推到 PR #{r['pr_number']}：{r.get('pr_url') or ''}")
        else:
            print(f"没有推送：{r.get('reason') or '没有可推的东西'}")
    elif a.cmd == "library":
        project = _need("CHEESE_PROJECT", PROJECT)
        if a.libcmd == "get":
            # 默认落在自己 home 下,和随消息发来的那份同一个位置;不落在工作目录
            # ——那是被托管的检出,资料库那一份写进去就是别人仓库里一个未跟踪文件
            # (结论 49)。`Path.home()` 按这个会话自己的 `$HOME` 解,正是执行器
            # 落附件时用的那一个。
            out = a.out or str(Path.home() / STAGED_DIR / "library" / a.name)
            parent = os.path.dirname(out)
            if parent:
                os.makedirs(parent, exist_ok=True)
            _library_get(project, a.name, out)
    elif a.cmd == "mail":
        topic = _need("CHEESE_TOPIC", TOPIC)
        if a.mailcmd == "attachment":
            base = (
                f"/integrations/{urllib.parse.quote(a.integration)}/mail/messages/"
                f"{urllib.parse.quote(a.uid)}"
            )
            where = f"?topic={urllib.parse.quote(topic)}&folder={urllib.parse.quote(a.folder)}"
            message = _call("GET", base + where)["data"]
            names = [x["filename"] for x in message.get("attachments", [])]
            if not 0 <= a.index < len(names):
                print(
                    f"[cheese] 这封邮件只有 {len(names)} 个附件:{names}",
                    file=sys.stderr,
                )
                sys.exit(1)
            name = os.path.basename(names[a.index]) or f"附件{a.index + 1}"
            out = a.out or str(Path.home() / STAGED_DIR / "mail" / a.uid / name)
            parent = os.path.dirname(out)
            if parent:
                os.makedirs(parent, exist_ok=True)
            _raw_request("GET", f"{base}/attachments/{a.index}{where}", None, out=out)
    elif a.cmd == "serve":
        if a.restore_spec:
            sys.exit(_restore_served_app(a.restore_spec, a.wait))
        topic = _need("CHEESE_TOPIC", TOPIC)
        if not (1 <= a.port <= 65535):
            print(f"[cheese] {a.port} 不是一个端口号。", file=sys.stderr)
            sys.exit(2)
        up = os.environ.get("CHEESE_PREVIEW_UP", "")
        if not up:
            # No preview channel in this runtime — the launcher exports this only
            # when it has shipped the helper. A running app cannot reach the
            # panel from here, so say so instead of filing a record that would
            # render as a white frame.
            print(
                "[cheese] 这个运行环境没有预览通道,运行中的应用到不了预览面板。\n"
                "[cheese] 要给人看结果,用 cheese show 点名一个文件——网页、图片,"
                "或报告、表格这类文档。",
                file=sys.stderr,
            )
            sys.exit(2)
        if a.serve_cmd and _probe_app(a.port) is None:
            _start_detached_serve_cmd(a.serve_cmd, os.getcwd(), a.port)
        # 报之前先敲门:应用已经在听(常见情况)就立刻过;还在起的,等它应答再报——
        # 不然平台那边敲不通会当场拒绝,用户看到的是一闪而过的白框。等超了仍然照报,
        # 只是提醒一声,平台那一敲是权威。
        probed_status = None
        if a.wait and a.wait > 0:
            probed_status = _wait_for_app(a.port, a.wait)
            if probed_status is None:
                print(
                    f"[cheese] 等了 {a.wait:g} 秒,127.0.0.1:{a.port} 还是没有应答。"
                    "应用可能没起来、没监听这个端口,或者起来的是另一个端口"
                    "(vite 没加 --strictPort 时会静默换端口)。仍然照报,"
                    "平台那边敲不通还会退回来。",
                    file=sys.stderr,
                )
            elif not 200 <= probed_status < 400:
                print(
                    f"[cheese] 127.0.0.1:{a.port} 在应答,但返回 {probed_status},不是 2xx/3xx。"
                    "应用大概起来了,只是根路径 / 不是它的入口。仍然照报。",
                    file=sys.stderr,
                )
        cmd_str, cwd_str = (
            (a.serve_cmd, os.getcwd())
            if a.serve_cmd
            else _detect_listening_process(a.port)
        )
        serve_meta = _build_serve_meta(a.port, cmd_str, cwd_str)
        if serve_meta is not None:
            with contextlib.suppress(OSError):
                preview_json = Path.home() / ".cheese" / "cheese-preview.json"
                preview_json.parent.mkdir(parents=True, exist_ok=True)
                preview_json.write_text(json.dumps(serve_meta, ensure_ascii=False))
        # Declare the port and bring the tunnel up in one step. The port is
        # written on THIS machine and read from disk by the helper — it never
        # travels on the wire, which is what keeps the platform unable to point
        # a machine at any other port.
        rc = subprocess.call(["sh", up, str(a.port)])
        if rc != 0:
            print(f"[cheese] 预览通道没能起来（{up} 退出码 {rc}）。", file=sys.stderr)
            sys.exit(1)
        # The backend knocks on the port through the tunnel before accepting; a
        # dead server is refused there, with the reason.
        shown_body: dict = {"path": a.note, "as": "app"}
        if serve_meta is not None:
            shown_body["serve"] = serve_meta
        _call("POST", f"/topics/{topic}/shown", shown_body)
        print(f"已把 :{a.port} 上的应用设为当前预览（{a.note}）。")
    elif a.cmd == "show":
        topic = _need("CHEESE_TOPIC", TOPIC)
        # The platform resolves these paths against the worktree ROOT (/work),
        # but the agent's cwd may be a subdir (e.g. after `cd backend`). Normalize
        # the given path to worktree-root-relative so `cheese show x.html` from
        # /work/backend points at backend/x.html, not a missing /work/x.html.
        rel = _worktree_relative(a.path)
        kind = a.as_ or artifact_kind_for(a.path)
        try:
            raw = open(a.path, "rb").read()
        except OSError as exc:
            print(f"[cheese] 无法读取 {a.path}: {exc}", file=sys.stderr)
            sys.exit(1)
        # Read as bytes either way — a .docx is a zip, and decoding it as text
        # used to fail the command outright. Text kinds still travel as text so
        # the request stays readable and this stays compatible with what the
        # backend already accepted.
        if kind in BINARY_ARTIFACT_KINDS:
            payload = {"content_b64": base64.b64encode(raw).decode("ascii")}
        else:
            try:
                payload = {"content": raw.decode("utf-8")}
            except UnicodeError as exc:
                print(f"[cheese] {a.path} 不是文本文件: {exc}", file=sys.stderr)
                sys.exit(1)
        assets = (
            _page_assets(a.path) if a.path.lower().endswith((".html", ".htm")) else []
        )
        if assets:
            folder = posixpath.dirname(rel)
            payload["assets"] = [
                {
                    "path": posixpath.join(folder, asset),
                    "content_b64": base64.b64encode(
                        open(os.path.join(os.path.dirname(a.path), asset), "rb").read()
                    ).decode("ascii"),
                }
                for asset in assets
            ]
        base = _pulled_versions().get(f"{topic}:{rel}")
        extra = {"note": a.note} if a.note else {}
        if base:
            extra["base_version"] = base
        res = _call(
            "POST",
            f"/topics/{topic}/shown",
            {"path": rel, "as": kind, **payload, **extra},
            tolerate=(409,),
        )
        if res.get("ok") is False:
            print(
                f"[cheese] 没有摆出来：文件区里的 {rel} 在你取到之后被人保存过"
                "（多半是用户在编辑器里改了）。直接写会盖掉他的修改。\n"
                f"[cheese] 先 cheese pull {rel} 取最新一版，在那一版上重做你的改动，"
                "再 show。",
                file=sys.stderr,
            )
            sys.exit(1)
        _remember_pulled(topic, rel, hashlib.sha256(raw).hexdigest()[:16])
        if (res.get("data") or {}).get("already_shown"):
            print(f"{rel} 和刚摆出来的那一份一样，对话里已经有这张卡，没有再摆一张。")
            return
        brought = f"，连同它加载的 {len(assets)} 个文件" if assets else ""
        print(f"已把 {rel} 摆出来给对话里的人看（{kind}）{brought}。")
    elif a.cmd == "template":
        topic = _need("CHEESE_TOPIC", TOPIC)
        if a.tplcmd == "list":
            rows = _call("GET", f"/topics/{topic}/files/templates").get("data") or {}
            for row in rows.get("data") or []:
                print(
                    f"{row['id']:<14} {row['name']}（.{row['suffix']}）  {row['about']}"
                )
            return
        rel = _worktree_relative(a.path)
        made = _call(
            "POST",
            f"/topics/{topic}/files/new",
            {"template": a.template, "path": rel},
        )
        version = (made.get("data") or {}).get("version") or ""
        req = urllib.request.Request(
            f"{API}/topics/{topic}/files/raw?path={urllib.parse.quote(rel)}"
        )
        if TOKEN:
            req.add_header("Authorization", f"Bearer {TOKEN}")
        with _urlopen(req, timeout=60) as r:
            body = r.read()
        parent = os.path.dirname(a.path)
        if parent:
            os.makedirs(parent, exist_ok=True)
        with open(a.path, "wb") as f:
            f.write(body)
        _remember_pulled(topic, rel, version)
        print(
            f"已从模板 {a.template} 在文件区新建 {rel}，并取到本地 {a.path}。"
            "填好占位后 cheese show 它。"
        )
    elif a.cmd == "check":
        _check_page(a)
    elif a.cmd == "pull":
        topic = _need("CHEESE_TOPIC", TOPIC)
        rel = _worktree_relative(a.path)
        out = a.output or a.path
        parent = os.path.dirname(out)
        if parent:
            os.makedirs(parent, exist_ok=True)
        req = urllib.request.Request(
            f"{API}/topics/{topic}/files/raw?path={urllib.parse.quote(rel)}"
        )
        if TOKEN:
            req.add_header("Authorization", f"Bearer {TOKEN}")
        try:
            with _urlopen(req, timeout=60) as r:
                body = r.read()
                version = r.headers.get("X-Cheese-Version") or ""
        except urllib.error.HTTPError as e:
            print(
                f"[cheese] 取不到 {rel}：HTTP {e.code} "
                f"{e.read().decode(errors='replace')[:300]}",
                file=sys.stderr,
            )
            sys.exit(1)
        with open(out, "wb") as f:
            f.write(body)
        _remember_pulled(topic, rel, version or hashlib.sha256(body).hexdigest()[:16])
        print(f"已取到 {rel} 的最新一版（{version}，{len(body)} 字节），写入 {out}。")
    elif a.cmd == "convert":
        topic = _need("CHEESE_TOPIC", TOPIC)
        try:
            raw = open(a.path, "rb").read()
        except OSError as exc:
            print(f"[cheese] 无法读取 {a.path}: {exc}", file=sys.stderr)
            sys.exit(1)
        rel = _worktree_relative(a.path)
        res = _call(
            "POST",
            f"/topics/{topic}/documents/convert",
            {
                "path": rel,
                "to": a.to,
                "content_b64": base64.b64encode(raw).decode("ascii"),
            },
            timeout=150,
        )
        data = res.get("data") or {}
        # The platform names the converted file by swapping the extension; a
        # local -o wins, and the fallback keeps the original beside it rather
        # than writing over the user's file.
        suggested = data.get("path") or f"{a.path}.{a.to}"
        out = a.output or os.path.basename(suggested)
        try:
            with open(out, "wb") as f:
                f.write(base64.b64decode(data.get("content_b64") or ""))
        except OSError as exc:
            print(f"[cheese] 无法写入 {out}: {exc}", file=sys.stderr)
            sys.exit(1)
        print(f"已把 {a.path} 转成 {out}。原文件没有改动。")
        if a.path.lower().endswith((".doc", ".ppt", ".xls")):
            print(
                "这是一次格式升级——转出来的文件和原件不是同一个东西。"
                "改完要告诉用户这件事，让他决定往后发哪一份。"
            )
    elif a.cmd == "recalc":
        topic = _need("CHEESE_TOPIC", TOPIC)
        try:
            raw = open(a.path, "rb").read()
        except OSError as exc:
            print(f"[cheese] 无法读取 {a.path}: {exc}", file=sys.stderr)
            sys.exit(1)
        # The platform resolves paths against the worktree ROOT, and the agent's
        # cwd may be a subdir — same normalization as `show`, for the same
        # reason: an absolute path is refused outright there.
        rel = _worktree_relative(a.path)
        # Recalculation loads the whole workbook, so give it more than the
        # default 20s: a sheet with a few thousand formulas is ordinary.
        res = _call(
            "POST",
            f"/topics/{topic}/documents/recalc",
            {
                "path": rel,
                "content_b64": base64.b64encode(raw).decode("ascii"),
            },
            timeout=150,
        )
        data = res.get("data") or {}
        out = a.output or a.path
        try:
            with open(out, "wb") as f:
                f.write(base64.b64decode(data.get("content_b64") or ""))
        except OSError as exc:
            print(f"[cheese] 无法写入 {out}: {exc}", file=sys.stderr)
            sys.exit(1)
        bad = data.get("errors") or []
        print(f"已重算 {a.path}，写出 {out}。")
        if not bad:
            print("没有算不出来的格。")
        else:
            print(f"有 {len(bad)} 个格算不出来，交付前要处理掉：")
            for cell in bad[:20]:
                print(f"  {cell.get('address')}  {cell.get('value')}")
            if len(bad) > 20:
                print(f"  …… 还有 {len(bad) - 20} 个")
            sys.exit(1)


if __name__ == "__main__":
    if len(sys.argv) == 3 and sys.argv[1] == "git-credential":
        _git_credential(sys.argv[2])
    elif len(sys.argv) == 3 and sys.argv[1] == "git-attribution":
        _git_attribution(sys.argv[2])
    else:
        main()
