_UNWRITTEN = (
    DELEGATED_TOOLS.calls_that(REACHES_OTHERS)
    | PLATFORM_TOOLS.calls_that(REACHES_OTHERS)
) ^ set(_ACTIONS)
if _UNWRITTEN:
    raise ValueError(f"calls that reach others and their actions differ: {_UNWRITTEN}")


def _action(key: str, args: dict) -> dict:
    kind, *fields = _ACTIONS[key]
    return {"kind": kind, **_given(args, *fields, "confirm")}


def _reviewed(key: str, args: dict, host) -> str | None:
    """Ask the gate whether to take this call (`/assistant/agent/review`),
    before it runs: None to take it; else what 芝士 is told instead — handed
    back with the reason, or how the card the person was shown ended."""
    data = (
        host.request(
            {
                "method": "POST",
                "path": "/assistant/agent/review",
                "body": _action(key, args),
            }
        ).get("data")
        or {}
    )
    if data.get("allowed"):
        return None
    if data.get("returned"):
        return data["said"]
    card = data.get("card")
    if card:
        return _decided(card, host)
    return f"没有做：{data.get('reason') or '需要用户确认'}。"


def _carry_out(key: str, args: dict, host):
    """Make the calls the person's own pages make for this action
    (`/assistant/agent/plan`), as the person. What the last call answered, and
    what 芝士 is told."""
    data = (
        host.request(
            {
                "method": "POST",
                "path": "/assistant/agent/plan",
                "body": _action(key, args),
            }
        ).get("data")
        or {}
    )
    answered, made = None, None
    for call in data.get("calls") or []:
        plan = dict(call)
        if made is not None:
            plan["path"] = plan["path"].replace("{prev}", str(made))
        answered = host.request(plan).get("data")
        made = answered.get("id") if isinstance(answered, dict) else None
    return answered, Said(
        data.get("said") or "已完成。", subject=data.get("subject") or ""
    )


def _decided(card: dict, host) -> str:
    """Wait, as the person reads the card in the panel, for them to confirm
    it or not (`/assistant/agent/wait`), and say how it ended; or, when they
    have not decided for long, that it still waits (the next question tells
    how it ended)."""
    while True:
        got = (
            host.request(
                {
                    "method": "POST",
                    "path": "/assistant/agent/wait",
                    "body": {"card": card["id"]},
                }
            ).get("data")
            or {}
        )
        if got.get("said"):
            return got["said"]


def _carried(key: str):
    def step(args: dict, host) -> str:
        return _carry_out(key, args, host)[1]

    return step


def _web_fetch(args: dict, host):
    answered, said = _carry_out("cheese_web.fetch", args, host)
    if answered is None:
        return said
    return Said(
        _say_fetch(args, answered, host.environ), subject=_page_named(args["url"])
    )


