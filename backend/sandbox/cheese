def _said_by_platform(exc: Exception) -> str | None:
    """What the platform said when it refused a request (any 4xx), or None."""
    status = getattr(exc, "status", None)
    if not isinstance(status, int) or not 400 <= status < 500:
        return None
    try:
        return json.loads(exc.body)["error"]["message"]  # type: ignore[attr-defined]
    except (ValueError, KeyError, TypeError):
        return None


