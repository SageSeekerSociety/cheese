def _urlopen(request, *args, **kwargs):
    """`urllib.request.urlopen`, through the platform socket when there is one."""
    if _OPENER is None:
        return urllib.request.urlopen(request, *args, **kwargs)
    return _OPENER.open(request, *args, **kwargs)


