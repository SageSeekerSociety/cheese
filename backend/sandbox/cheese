        }
    if tool == "cheese_routine":
        return {"method": "POST", "path": "/assistant/agent/routine", "body": args}
    if tool == "cheese_todo":
        return {
            "method": "POST",
            "path": "/assistant/agent/todo",
            "body": _given(args, "todos"),
        }
    if tool in ("cheese_memory.save", "cheese_memory.read", "cheese_memory.forget"):
        body = _given(args, "action", "name", "description", "type", "text")
        return {"method": "POST", "path": "/assistant/agent/memory", "body": body}
    if tool == "cheese_find":
        where = (args.get("where") or "").strip().strip("/")
        space = re.fullmatch(r"spaces/(\d+)", where)
        if space:
            body = {"space": int(space.group(1)), "query": args.get("query") or ""}
            return {"method": "POST", "path": "/task-drafts/agent/search", "body": body}
        if not (args.get("query") or "").strip():
            raise ValueError("cheese_find 需要 query（只有搜空间里的题目时可以留空）")
        body = {"query": args["query"], **({"project": where} if where else {})}
        return {"method": "POST", "path": "/assistant/agent/search", "body": body}
    if tool == "cheese_help":
        # 房间里的带上话题：知是自己的项目读得到开发文档，看的是这个话题在哪。
        scope = {"topic": topic} if topic else {}
        if args.get("page"):
            return {
                "method": "POST",
                "path": "/docs/agent/read",
                "body": {"page": args["page"], **scope},
            }
        if not args.get("query"):
            raise ValueError("cheese_help 要 query 或 page 之一")
        return {
            "method": "POST",
            "path": "/docs/agent/search",
            "body": {"query": args["query"], **scope},
        }
    if tool == "cheese_problem.write":
        return {"method": "POST", "path": "/task-drafts/agent/write", "body": args}
    if tool == "cheese_problem.publish":
        body = {"draft": args["draft"]}
        return {"method": "POST", "path": "/task-drafts/agent/publish", "body": body}
    if tool == "cheese_web.search":
        query = {"q": args["query"], "topic": topic, "project": project}
        if args.get("limit"):
            query["limit"] = int(args["limit"])
        params = urllib.parse.urlencode({k: v for k, v in query.items() if v})
        return {"method": "GET", "path": f"/web-search?{params}"}
    if tool == "cheese_web.fetch":
        # 带上话题：不带的话每一次调用都会被判成 "Agent credential is invalid or
        # expired"——沙箱 token 是带作用域的。
        body = {"url": args["url"], "topic": topic, "project": project}
        if args.get("prompt"):
            body["prompt"] = args["prompt"]
        if args.get("render"):
            body["render"] = True
        return {"method": "POST", "path": "/fetch", "body": body}
    if tool == "cheese_ask":
        return {
            "method": "POST",
            "path": f"/topics/{topic}/asks",
            "body": _ask_body(args),
        }
    if tool == "cheese_notify":
        options = [
            value.strip() for value in args.get("options") or [] if value.strip()
        ]
        return {
            "method": "POST",
            "path": f"/projects/{project}/alerts",
            "body": {
                "level": args.get("level") or "light",
                "kind": args.get("kind") or "change_alert",
                "title": args["title"],
                "body": args.get("body") or "",
                "target_handle": args.get("to") or None,
                "topic_id": topic or None,
                "payload": {"options": options} if options else {},
            },
        }
    if tool == "cheese_feedback.propose":
        # 话题级:配额、指纹去重、拒绝的记忆全挂在话题上,而「这个人能不能在这个
        # 话题里提」的答案就是 authorize_topic 已经算过的那个。
        body = {
