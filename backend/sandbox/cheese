COMPACT_ENV = "CHEESE_COMPACT_TOOL"


def switched_on(environ=None) -> bool:
    """Whether this session's deployment offers `cheese_session(action=compact)`."""
    env = os.environ if environ is None else environ
    return str(env.get(COMPACT_ENV) or "").strip() not in ("", "0", "false", "False")


def offered_tools(environ=None) -> list[dict]:
    """The table's rows this session is offered: everything, minus the tool a
    deployment has not turned on."""
    if switched_on(environ):
        return PLATFORM_TOOLS.schemas()
    tool, _, verb = COMPACT_TOOL.partition(".")
    others = [v for v in PLATFORM_TOOLS.actions(tool) or () if v != verb]
    return [
        PLATFORM_TOOLS.narrowed(tool, others) if row["name"] == tool else row
        for row in PLATFORM_TOOLS.schemas()
    ]


