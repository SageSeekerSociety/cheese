#: The host name a request to the sandbox's platform socket is addressed to; it
#: names no machine and is never resolved.
_SOCKET_HOST = "platform.cheese"


def _platform_socket(environ=None) -> str:
    """The sandbox's platform socket (``CHEESE_PLATFORM_SOCKET``), when there is
    one to dial: the platform knows whose a request on it is without a token."""
    path = (os.environ if environ is None else environ).get(
        "CHEESE_PLATFORM_SOCKET", ""
    )
    try:
        return path if path and stat.S_ISSOCK(os.stat(path).st_mode) else ""
    except OSError:
        return ""


class _SocketConnection(http.client.HTTPConnection):
    def __init__(self, host, *, socket_path, **kwargs):
        super().__init__(host, **kwargs)
        self._socket_path = socket_path

    def connect(self):
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.settimeout(self.timeout)
        sock.connect(self._socket_path)
        self.sock = sock


class _ToThePlatformSocket(urllib.request.BaseHandler):
    """Sends a request addressed to ``_SOCKET_HOST`` down the platform socket,
    ahead of any proxy the environment names (`ProxyHandler` is 100)."""

    handler_order = 50

    def __init__(self, socket_path: str):
        self._socket_path = socket_path

    def http_open(self, req):
        if req.host != _SOCKET_HOST:
            return None
        # The socket says whose the request is; a token is not sent down it.
        for headers in (req.headers, req.unredirected_hdrs):
            for name in [n for n in headers if n.lower() == "authorization"]:
                del headers[name]
        handler = urllib.request.AbstractHTTPHandler()
        return handler.do_open(
            lambda host, **kwargs: _SocketConnection(
                host, socket_path=self._socket_path, **kwargs
            ),
            req,
        )


