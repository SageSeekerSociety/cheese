class LocalHost:
    """A host for a session that runs ON the machine (the pi harness): the backend
    over plain HTTP, the sync as this CLI's own subcommand."""

    def __init__(self, environ=None, doc_versions=None):
        self.environ = dict(os.environ if environ is None else environ)
        self.doc_versions = {} if doc_versions is None else doc_versions

    def request(self, plan: dict) -> dict:
        api = (
            f"http://{_SOCKET_HOST}/api"
            if PLATFORM_SOCKET and _platform_socket(self.environ) == PLATFORM_SOCKET
            else self.environ.get("CHEESE_API", "").rstrip("/")
        )
        body = plan.get("body")
        req = urllib.request.Request(
            api + plan["path"],
            data=json.dumps(body).encode() if body is not None else None,
            method=plan["method"],
        )
        req.add_header("Content-Type", "application/json")
        credential = self.environ.get("CHEESE_TOKEN")
        if credential:
            req.add_header("Authorization", f"Bearer {credential}")
        if self.environ.get("CHEESE_TURN"):
            req.add_header("X-Cheese-Turn", self.environ["CHEESE_TURN"])
        # Generous because one caller is slow: reading a web page can climb a
        # ladder of fetch strategies ending in a real browser, which measured
        # 22 s on a page that answered and longer on one that tried every rung.
        try:
            with _urlopen(req, timeout=240) as response:
                return json.loads(response.read() or b"{}")
        except urllib.error.HTTPError as exc:
            raise PlatformHTTPError(
                exc.code, exc.read().decode(errors="replace")
            ) from None

    def wait_machine(self) -> None:
        """This session runs on its machine: it is there."""

    def sync_task(self, task_id: str) -> None:
        result = subprocess.run(
            [sys.executable, os.path.abspath(__file__), "sync", "--task", task_id],
            env=self.environ,
            capture_output=True,
            text=True,
            timeout=900,
        )
        if result.returncode:
            raise PlatformToolError(
                "任务的提交没能推上去，验收卡没有递：" + (result.stderr or "").strip()
            )


def _call(
    method: str,
    path: str,
    body: dict | None = None,
    *,
    token: str | None = None,
    tolerate: tuple[int, ...] = (),
    timeout: int = 20,
) -> dict:
    """Call the platform. Any HTTP error is fatal, except the statuses in
    `tolerate` — those come back as ``{"ok": False, "status": ..., "error": ...}``
    for a caller that has something better to say than the raw response.

    ``timeout`` is generous by default because these calls are small. A caller
    whose call is not (a document conversion) passes its own."""
    url = f"{API}{path}"
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method)
    req.add_header("Content-Type", "application/json")
    auth = token if token is not None else TOKEN
    if auth:
        req.add_header("Authorization", f"Bearer {auth}")
    if TURN:
        req.add_header("X-Cheese-Turn", TURN)
    try:
        with _urlopen(req, timeout=timeout) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        raw = e.read().decode(errors="replace")
        if e.code in tolerate:
            try:
                payload = json.loads(raw)
            except ValueError:
                payload = {}
            return {"ok": False, "status": e.code, "error": payload.get("error") or {}}
        print(
            f"[cheese] {method} {path} 失败 HTTP {e.code}: {raw[:400]}", file=sys.stderr
        )
        sys.exit(1)
    except Exception as e:
        print(f"[cheese] {method} {path} 出错: {e}", file=sys.stderr)
        sys.exit(1)


def _task_root() -> Path:
    return Path.home() / ".cheese" / "tasks"


# Which directory holds the environment runner depends on which launcher
# prepared this place, and that is not something the CLI can know: the machine
# launcher writes `.cheese/`, the claude-code remote-execution payload writes
# the harness config dir `.claude/`. The copies are byte-identical, so the
# first one on disk answers — the order matching the platform's own probe
# (`ENVIRONMENT_RUNNER_PATHS`). Naming one of them was how a room on a machine
# prepared by the other launcher could not create a task at all.
ENVIRONMENT_RUNNER_PATHS = (".cheese", ".claude")

# 平台放在这个会话自己 home 里的那一个目录:随消息发来的附件落在
# `~/attachments/<地址>`,`library get` 取下来的那一份也落在这里。它不是工作目录
# ——工作目录是被托管的那个检出,平台往里写一个字节,就是别人仓库里一个他没有加过、
# 而我们也不会去删的未跟踪文件(结论 49)。名字由 `app/domain/agent/place.py` 的
# `STAGED_DIR` 选定,这里是它的一份抄件,`backend/tests/unit/test_footprint_root.py`
# 把两边对住。
STAGED_DIR = "attachments"


def _environment_runner() -> Path | None:
    for directory in ENVIRONMENT_RUNNER_PATHS:
        candidate = Path.home() / directory / "cheese-environment.py"
        if candidate.is_file():
            return candidate
    return None


def _marked_task() -> str | None:
    """The task whose worktree this is, or None in any other checkout."""
    result = subprocess.run(
        ["git", "rev-parse", "--git-path", "cheese-task.json"],
        capture_output=True,
        text=True,
    )
    if result.returncode == 0:
        marker = Path(result.stdout.strip())
        if marker.is_file():
            return str(uuid.UUID(json.loads(marker.read_text())["task_id"]))
    return None


def _task_id(explicit: str | None = None) -> str:
    if explicit:
        return str(uuid.UUID(explicit))
    task_id = _marked_task()
    if task_id is None:
        raise SystemExit("[cheese] 请在任务工作目录内执行，或指定 --task <id>")
    return task_id


# `git` calls here run a hook only on a delivery push, and that one runs the
# checkout's `.cheese/pre-push` inside the same process: a script allowed 240 s
# of its own (`CI_FAST_PRE_PUSH_TIMEOUT`) needs a budget with room left for the
# transfer after it. The rest run no hook and keep the shorter one.
_PUSH_TIMEOUT = 300
_HOOKED_PUSH_TIMEOUT = 600


def _git_task(
    cwd: Path,
    *args: str,
    extra_env: dict | None = None,
    input_text: str | None = None,
    raw: bool = False,
    pre_push_report: Path | None = None,
) -> str:
    env = {
        key: value
        for key, value in os.environ.items()
        if not key.startswith("GIT_") or key == "GIT_SSL_CAINFO"
    }
    env["GIT_TERMINAL_PROMPT"] = "0"
    if extra_env:
        env.update(extra_env)
    if pre_push_report is not None:
        # A push is the one git call here that runs the project's own pre-push
        # entry point (the hook `cheese worktree` installs), and that script's
        # whole output is a report. It writes to a pipe on this path, and a
        # pipe on a delivery push has no reader: the commit that triggered it
        # was made by an agent, whose terminal is gone by the time the
        # post-commit hook pushes. So the report is asked for by name here and
        # read back below, for `_flush_pre_push_reports` to hand to the room.
        env["CI_FAST_PRE_PUSH_REPORT"] = str(pre_push_report)
        try:
            pre_push_report.unlink()
        except OSError:
            pass
    # One wall clock covers the hook and the transfer both: a delivery push runs
    # the checkout's `.cheese/pre-push` inside this same process, and that
    # script may spend `CI_FAST_PRE_PUSH_TIMEOUT` (240 s by default) before git
    # starts sending anything. The calls that run no hook keep the shorter one.
    try:
        result = subprocess.run(
            ["git", "-C", str(cwd), *args],
            env=env,
            input=input_text,
            capture_output=True,
            text=True,
            timeout=_PUSH_TIMEOUT if pre_push_report is None else _HOOKED_PUSH_TIMEOUT,
        )
    finally:
        if pre_push_report is not None:
            # Read whichever way the push went, and read before the exit status
            # is judged. Git runs the hook, and the entry point writes its
            # report, before the push reaches the remote, so a push that then
            # fails — a refusal, a cut connection, or this very call being
            # killed for outrunning the budget above — has produced the same
            # report as one that lands. On this path the file is the only copy,
            # since the next attempt unlinks it before it runs. Kept for
            # `_sync_task` to hand over either way.
            #
            # A missing file is an answer too, and it is not "no answer": this
            # attempt unlinked whatever the last one left, so nothing there
            # means this attempt's own hook ran and passed. `_keep_pre_push_report`
            # drops the attempt before it, so a retry that passed is not
            # reported with the text of the attempt it replaced.
            #
            # `errors="replace"` because this is a message, not data: a
            # project's entry point could echo a path its filesystem holds in
            # some other encoding, and one undecodable byte must not turn a
            # push that landed into a reported delivery failure.
            try:
                report_text = pre_push_report.read_text(errors="replace").strip()
            except OSError:
                report_text = ""
            _keep_pre_push_report(pre_push_report, report_text)
    if result.returncode:
        raise RuntimeError(result.stderr.strip())
    # Raw for NUL-separated paths: a file name may begin with a space.
    return result.stdout if raw else result.stdout.strip()


def _pre_push_report_path(worktree: Path) -> Path:
    """Where this checkout's delivery push leaves the pre-push report.

    The worktree's own git dir, so two tasks on one machine never read each
    other's report; the file is written by `.cheese/pre-push` and only when
    that run did not pass, so its presence means there is something to say.
    """
    git_dir = _git_task(worktree, "rev-parse", "--absolute-git-dir")
    return Path(git_dir) / "cheese-pre-push-report"


# Reports read back from a delivery push, keyed by the checkout they came
# from and waiting for `_sync_task` to hand them over. Keyed and not a list
# because one sync can push the same checkout twice: `_once_more_if_transient`
# retries a delivery, and each attempt reads the file that attempt wrote.
_pending_pre_push_reports: dict[str, str] = {}


def _keep_pre_push_report(path: Path, text: str) -> None:
    """Record this attempt's report, or forget the last attempt's.

    Called once per delivery push, so silence has to be able to overwrite
    text: a retry whose hook passes writes no file, and the reader of the
    room message is owed the outcome of the push that landed, not of the one
    that was thrown away.
    """
    key = str(path)
    if text:
        _pending_pre_push_reports[key] = text
    else:
        _pending_pre_push_reports.pop(key, None)


class _RoomMessage:
    """One thing to say, and the second reader to say it to.

    The room is the reader that lasts, and stderr is the one that is still
    there when the room cannot be reached: `cheese sync` runs from the
    commit's own post-commit hook, whose stderr the committing command
    shows. Both are handed the same text — a message composed for the room
    and then composed again, slightly differently, for the fallback is how
    two reports of one event start to disagree.
    """

    def __init__(self, content: str) -> None:
        self.content = content

    def tell_room(self) -> None:
        if not _tell_room(self.content):
            self.tell_stderr()

    def tell_stderr(self) -> None:
        print(self.content, file=sys.stderr)


def _flush_pre_push_reports() -> None:
    """Send the delivery push's pre-push reports to the room.

    `git commit` reaches the push through the post-commit hook (`exec cheese
    sync`), so on this path the report is produced, paid for, and captured
    with nobody to read it — the author of the commit is the reader it was
    written for, and this is how it reaches them.

    Total on purpose: it runs in a `finally`, where raising would replace the
    push's own failure with a failure to report it.
    """
    if not _pending_pre_push_reports:
        return
    pending = list(_pending_pre_push_reports.values())
    _pending_pre_push_reports.clear()
    content = "⚠️ 这次提交的推前自检没过（它只是报告，不挡推送）：\n\n" + "\n\n".join(
        pending
    )
    try:
        message = _RoomMessage(content)
        if API and TOPIC and (TOKEN or PLATFORM_SOCKET):
            message.tell_room()
        else:
            # Nobody to tell: a checkout with no room has no author to reach.
            message.tell_stderr()
    except Exception:
        pass


def _git_credential(operation: str) -> None:
    """Git invokes this at use time; only the bound host AND path receive a token."""
    if operation != "get":
        return
    fields = dict(line.rstrip("\n").split("=", 1) for line in sys.stdin if "=" in line)
    data = _call("GET", "/sandbox/forge-token")["data"]
    path = urllib.parse.unquote(fields.get("path", "")).strip("/").removesuffix(".git")
    destinations = [(data["url"], data["token"])]
    if data.get("kind") in ("forgejo", "github_app"):
        destinations.append(
            (
                _forge_git_relay(data["repo"]),
                TOKEN
                if data["kind"] == "github_app" and not PLATFORM_SOCKET
                else data["token"],
            )
        )
    for destination, credential in destinations:
        bound = urllib.parse.urlsplit(destination)
        wanted = urllib.parse.unquote(bound.path).strip("/").removesuffix(".git")
        if (
            fields.get("protocol") == bound.scheme
            and fields.get("host", "").lower() == bound.netloc.lower()
            and path == wanted
        ):
            print(f"username={data['username']}\npassword={credential}\n")
            return


def _forge_git_relay(repository: str) -> str:
    return f"{_direct_api()}/sandbox/forge/{_need('CHEESE_PROJECT', PROJECT)}/{repository}.git"


def _configure_git_transport(repo: Path, data: dict) -> None:
    if data.get("forge_kind") not in ("forgejo", "github_app"):
        return
    relay = _forge_git_relay(data["forge_repo"])
    # Keep origin canonical so native tools retain the repository identity.
    key = f"url.{relay}.insteadOf"
    existing = _git_task(repo, "config", "--list").splitlines()
    if any(line.startswith(f"url.{relay}.insteadof=") for line in existing):
        _git_task(repo, "config", "--unset-all", key)
    if PLATFORM_SOCKET and (Path(PLATFORM_SOCKET).parent / "forge.sock").exists():
        # With the host-side forge proxy on `forge.sock`, git keeps the
        # canonical remote and the proxy outside the sandbox handles both
        # direct connections and platform fallback (#4896).
        return
    reachable = True
    try:
        root = data["remote"].rsplit("/", 2)[0]
        probe = root + ("/api/v1/version" if data["forge_kind"] == "forgejo" else "/")
        request = urllib.request.Request(probe)
        with _urlopen(request, timeout=5):
            pass
    except urllib.error.HTTPError:
        reachable = False
    except (OSError, urllib.error.URLError):
        reachable = False
    if not reachable:
        _git_task(repo, "config", "--replace-all", key, data["remote"])
        print("[cheese] 仓库无法直连，本次通过平台访问", file=sys.stderr)


def _commit_as(repo: Path, task_dir: Path, data: dict) -> None:
    """Make the task's commits by the author the platform names for it
    (`data["author"]`, `Name <address>`): the task owner on GitHub when the
    project credits owners, otherwise the AI teammate. Per worktree, because
    every task of the project shares one repository and each has its own
    author; an author the launch environment fixed would override it. The
    repository's own default is the teammate, for a worktree with no task of
    its own and a platform that names nobody."""
    _git_task(repo, "config", "user.name", AUTHOR)
    _git_task(repo, "config", "user.email", f"{AUTHOR}@agent.cheese.local")
    _git_task(repo, "config", "extensions.worktreeConfig", "true")
    # With per-worktree config on, the common config is every worktree's: the
    # project repository's `core.bare` there makes each task's checkout bare
    # too, and git refuses `add` in it. It belongs to the repository's own.
    bare = _git_task(
        repo,
        "config",
        "--local",
        "--type=bool",
        "--default=false",
        "--get",
        "core.bare",
    )
    if bare.strip() == "true":
        own = Path(_git_task(repo, "rev-parse", "--absolute-git-dir").strip())
        _git_task(
            repo, "config", "--file", str(own / "config.worktree"), "core.bare", "true"
        )
        _git_task(repo, "config", "--local", "--unset", "core.bare")
    author = data.get("author") or ""
    name, _, rest = author.partition(" <")
    email = rest.rstrip(">")
    if not name or not email:
        return
    _git_task(task_dir, "config", "--worktree", "user.name", name)
    _git_task(task_dir, "config", "--worktree", "user.email", email)


def _git_attribution(message_file: str) -> None:
    # The hook belongs to the shared repository, so every worktree of it runs
    # it, including one made with `git worktree add` beside a task's. Only a
    # task's own worktree has someone to credit; any other commits as itself.
    task_id = _marked_task()
    if task_id is None:
        return
    project = _need("CHEESE_PROJECT", PROJECT)
    data = _call("GET", f"/projects/{project}/git/tasks/{task_id}")["data"]
    # Too late for this commit, whose author is already fixed; the next one
    # follows an owner or a credit setting that changed since the checkout.
    here = Path.cwd()
    common = Path(_git_task(here, "rev-parse", "--git-common-dir").strip())
    _commit_as(common if common.is_absolute() else here / common, here, data)
    trailers = []
    for person in data["coauthors"]:
        if "\n" in person or "\r" in person:
            raise ValueError("Invalid contributor identity")
        trailers.extend(["--trailer", f"Co-authored-by: {person}"])
    if trailers:
        subprocess.run(
            [
                "git",
                "interpret-trailers",
                "--in-place",
                "--if-exists",
                "addIfDifferent",
                *trailers,
                message_file,
            ],
            check=True,
        )


def _lock(file) -> None:
    """flock(LOCK_EX), or on Windows the byte-range lock beside this file."""
    if sys.platform == "win32":
        # This file is the executor release's `cheese`; the Windows primitives
        # are shipped in the same release.
        portable = Path(__file__).resolve().parent / "remote-execution/portable.py"
        runpy.run_path(str(portable))["lock"](file)
    else:
        fcntl.flock(file, fcntl.LOCK_EX)


def _worktree_relative(path: str) -> str:
    """`path` relative to the worktree root, as the platform resolves it; or
    `path` itself when it is outside, for the platform to judge.

    With `/` between the parts whatever the machine: the platform reads it as a
    POSIX path. And a path on another drive of a Windows machine is outside.
    """
    root = os.environ.get("CHEESE_WORKTREE_ROOT", "/work")
    try:
        rel = os.path.relpath(os.path.abspath(path), root)
    except ValueError:
        return path
    if rel.startswith(".."):
        return path
    return rel.replace(os.sep, "/")


#: How many of its own files one shown page brings along — the platform's
#: `MAX_PAGE_ASSETS` — and the largest it takes (`library.MAX_FILE_BYTES`).
PAGE_ASSET_LIMIT = 200
PAGE_ASSET_MAX_BYTES = 10 * 1024 * 1024
_CSS_REF = re.compile(
    r"""url\(\s*['"]?([^'")\s]+)['"]?\s*\)|@import\s+['"]([^'"]+)['"]"""
)


def _css_refs(text: str) -> list[str]:
    return [m.group(1) or m.group(2) for m in _CSS_REF.finditer(text)]


class _PageRefs(HTMLParser):
    """Every address a page loads something from: stylesheets and icons
    (`<link href>`), scripts, images and media (`src`, `srcset`, `poster`), SVG
    `<image>`/`<use>`, and the `url()`/`@import` in its inline CSS. Links a
    reader follows (`<a href>`) are not loads, and stay out."""

    def __init__(self) -> None:
        super().__init__(convert_charrefs=True)
        self.refs: list[str] = []
        self._in_style = False

    def handle_starttag(self, tag, attrs):
        a = {k: v for k, v in attrs if v}
        if tag in ("link", "image", "use"):
            self.refs += [a[k] for k in ("href", "xlink:href") if k in a]
        self.refs += [a[k] for k in ("src", "poster") if k in a]
        if "srcset" in a:
            self.refs += [p.split()[0] for p in a["srcset"].split(",") if p.strip()]
        if "style" in a:
            self.refs += _css_refs(a["style"])
        self._in_style = tag == "style"

    def handle_endtag(self, tag):
        if tag == "style":
            self._in_style = False

    def handle_data(self, data):
        if self._in_style:
            self.refs += _css_refs(data)


def _page_assets(page: str) -> list[str]:
    """The files beside `page` that it loads, relative to the page's directory.

    `cheese show` sends one file, and the preview serves the page from the
    platform's copy of the room's files: a page that links `style.css` arrived
    alone and rendered unstyled. So a page brings the local files it loads —
    and those its stylesheets load in turn. The preview serves a page at its
    directory's root, so `/x` means the page's directory too. Anything outside
    that directory, hidden, missing, or larger than the platform takes stays
    behind: the preview could not serve it anyway.
    """
    top = os.path.dirname(os.path.abspath(page))
    found: list[str] = []
    seen = {os.path.abspath(page)}
    pending = [(os.path.abspath(page), True)]
    while pending and len(found) < PAGE_ASSET_LIMIT:
        current, is_html = pending.pop(0)
        try:
            text = open(current, encoding="utf-8", errors="replace").read()
        except OSError:
            continue
        if is_html:
            parser = _PageRefs()
            parser.feed(text)
            refs = parser.refs
        else:
            refs = _css_refs(text)
        for ref in refs:
            parts = urllib.parse.urlsplit(ref.strip())
            if parts.scheme or parts.netloc or not parts.path:
                continue
            path = urllib.parse.unquote(parts.path)
            base = top if path.startswith("/") else os.path.dirname(current)
            target = os.path.normpath(os.path.join(base, path.lstrip("/")))
            rel = os.path.relpath(target, top)
            if (
                target in seen
                or rel.startswith("..")
                or any(part.startswith(".") for part in rel.split(os.sep))
                or not os.path.isfile(target)
                or os.path.getsize(target) > PAGE_ASSET_MAX_BYTES
            ):
                continue
            seen.add(target)
            found.append(rel.replace(os.sep, "/"))
            if target.lower().endswith(".css"):
                pending.append((target, False))
            if len(found) >= PAGE_ASSET_LIMIT:
                break
    return found


def _prepare_repository(repo: Path, data: dict) -> None:
    """This machine's copy of the project's repository, able to reach its forge.

    Its caller holds `<project>.lock` beside it."""
    if not repo.exists():
        _git_task(repo.parent, "init", "--bare", str(repo))
    _wire_remote(repo, data)


def _wire_remote(repo: Path, data: dict) -> None:
    """`repo`'s origin is the project's forge, reached with this session's
    credential (`cheese git-credential`)."""
    _git_task(repo, "config", "--replace-all", "credential.helper", "")
    _git_task(repo, "config", "--add", "credential.helper", "!cheese git-credential")
    _git_task(repo, "config", "credential.useHttpPath", "true")
    if os.environ.get("GIT_SSL_CAINFO"):
        _git_task(repo, "config", "http.sslCAInfo", os.environ["GIT_SSL_CAINFO"])
    if "origin" not in _git_task(repo, "remote").splitlines():
        _git_task(repo, "remote", "add", "origin", data["remote"])
    else:
        _git_task(repo, "remote", "set-url", "origin", data["remote"])
    _configure_git_transport(repo, data)


def _checkout() -> Path:
    """A checkout of the project's default branch to read and try things in:
    how a 支线, or a task not yet started, sees the code. Brought up to date
    when nothing in it was changed. Its session's credential only reads, so
    what is changed here stays here."""
    data = _call("GET", "/sandbox/forge-token")["data"]
    branch = data.get("default_branch") or "main"
    target = Path.home() / ".cheese" / "checkout"
    target.parent.mkdir(parents=True, exist_ok=True)
    remote = {
        "remote": data["url"],
        "forge_kind": data.get("kind"),
        "forge_repo": data.get("repo"),
    }
    with (target.parent / "checkout.lock").open("a") as lock:
        _lock(lock)
        fresh = not (target / ".git").exists()
        if fresh:
            _git_task(target.parent, "init", "-q", str(target))
        _wire_remote(target, remote)
        tracking = f"refs/remotes/origin/{branch}"
        # The commits, not every version of every file (`_task_worktree`).
        _git_task(
            target,
            "fetch",
            "--filter=blob:none",
            "origin",
            f"refs/heads/{branch}:{tracking}",
        )
        if fresh:
            _git_task(target, "checkout", "-q", "-B", branch, tracking)
        elif _git_task(target, "status", "--porcelain"):
            print(
                f"[cheese] {target} 里有改动，没有更新；最新的 {branch} 在 {tracking}",
                file=sys.stderr,
            )
        else:
            _git_task(target, "checkout", "-q", "-B", branch, tracking)
    return target


def _task_worktree(task_id: str, *, reinstall: bool = False) -> Path:
    task_id = str(uuid.UUID(task_id))
    project = _need("CHEESE_PROJECT", PROJECT)
    data = _call("POST", f"/projects/{project}/git/tasks/{task_id}")["data"]
    if data["closed"]:
        raise SystemExit("[cheese] 这条任务已结束，请创建新任务")
    cache = Path.home() / ".cheese" / "repositories"
    cache.mkdir(parents=True, exist_ok=True)
    repo = cache / f"{project}.git"
    task_dir = _task_root() / task_id
    task_dir.parent.mkdir(parents=True, exist_ok=True)
    # Native subagents can request worktrees concurrently. Serialize creation
    # so an interrupted clone cannot be mistaken for a complete repository.
    with (cache / f"{project}.lock").open("a") as lock:
        _lock(lock)
        # A checkout already on the task's branch and wired to its forge is
        # used as it is: the forge round trips below were most of what opening
        # it again cost (dev, 2026-10-12..17: a reopen within ten minutes took
        # 16 s at the median, 76 s at p90, and changed nothing). Its remote
        # branches are as this checkout last fetched or pushed them; `git
        # fetch` brings them up to date.
        if not _opened_as_left(task_dir, data):
            _open_from_forge(repo, task_dir, data)
        marker = Path(
            _git_task(task_dir, "rev-parse", "--git-path", "cheese-task.json")
        )
        if not marker.is_absolute():
            marker = task_dir / marker
        marker.write_text(json.dumps(data))
        _commit_as(repo, task_dir, data)
        hooks = repo / "hooks"
        prepare = hooks / "prepare-commit-msg"
        prepare.write_text('#!/bin/sh\nexec cheese git-attribution "$1"\n')
        prepare.chmod(0o755)
        hook = hooks / "post-commit"
        # Delivers the task whose worktree committed; another worktree of this
        # repository has no task to deliver, and `cheese sync` there would fail.
        hook.write_text(
            "#!/bin/sh\n"
            '[ -f "$(git rev-parse --git-path cheese-task.json)" ] || exit 0\n'
            "exec cheese sync\n"
        )
        hook.chmod(0o755)
        # The project's own pre-push check, if it keeps one. What the check
        # IS belongs to the project and not here: `cheese worktree` serves
        # every project, and a project whose tree has no `.cheese/pre-push`
        # must not pay for a rule it never wrote — it does one `[ -x ]` and
        # nothing else.
        #
        # The hook runs the script and then exits 0 regardless of what it
        # said. That is not politeness: a push refused here is a commit the
        # platform has not delivered, and the checkout it lives in does not
        # survive to be retried, so the report must not be able to lose the
        # work it is reporting on. The script still owns its own exit code for
        # whoever runs it directly; this just stops a project's mistake from
        # turning a report into a gate. What must block a merge is CI, and
        # that is where the decision belongs.
        prepush = hooks / "pre-push"
        prepush.write_text(
            "#!/bin/sh\n"
            'script="$(git rev-parse --show-toplevel)/.cheese/pre-push"\n'
            '[ -x "$script" ] || exit 0\n'
            '"$script"\n'
            "exit 0\n"
        )
        prepush.chmod(0o755)
        _follow_task_branch(task_dir, data)
    # The room has no checkout. Branch dependencies belong to this task and
    # are prepared on every open whose dependency files or environment differ
    # from what was last prepared here, local branch changes included.
    config = Path.home() / ".cheese-environment/config.json"
    if config.exists():
        # That config is the runner's own output, so a place that has one had a
        # runner: it going missing is a broken place, not an unprepared one, and
        # silently skipping would hand back a task directory whose dependencies
        # were never installed.
        runner = _environment_runner()
        if runner is None:
            raise SystemExit("[cheese] 这台机器的环境准备脚本不见了，任务目录没法准备")
        admin = Path(_git_task(task_dir, "rev-parse", "--absolute-git-dir"))
        stamp = admin / _PREPARED_STAMP
        # Read before the run: a dependency file changed while it installs is
        # one this preparation may have missed, so the next open prepares again.
        wanted = _prepared_from(task_dir, config)
        if reinstall or not _still_prepared(task_dir, stamp, wanted):
            stamp.unlink(missing_ok=True)
            result = subprocess.run(
                [sys.executable, str(runner), "task", str(task_dir)]
            )
            if result.returncode:
                # Again: another open's run may have finished in between.
                stamp.unlink(missing_ok=True)
                raise SystemExit(result.returncode)
            stamp.write_text(
                json.dumps({"from": wanted, "made": _installed_dirs(task_dir)})
            )
    return task_dir


# In a task checkout's git directory, after the environment runner last
# prepared the checkout and succeeded: `_prepared_from` as it was before that
# run, and the installed directories there after it (`_installed_dirs`).
_PREPARED_STAMP = "cheese-environment-prepared"


#: What an install leaves behind, by directory name. Caches (`__pycache__`,
#: `.pytest_cache`) are not: removing one is no reason to install again.
_INSTALLED_DIRS = frozenset({"node_modules", ".venv", "venv", "vendor"})


def _installed_dirs(task_dir: Path) -> list[str]:
    """The installed directories the checkout does not track (`node_modules/`,
    `backend/.venv/`), each named once at its top."""
    listed = _git_task(
        task_dir,
        "ls-files",
        "-z",
        # Ignored or not: no exclude rules, so nothing is told apart.
        "--others",
        "--directory",
        raw=True,
    )
    return sorted(
        name
        for name in listed.split("\0")
        if name.endswith("/") and name.rstrip("/").rsplit("/", 1)[-1] in _INSTALLED_DIRS
    )


def _still_prepared(task_dir: Path, stamp: Path, wanted: str) -> bool:
    """Whether the last successful preparation was from `wanted`, and what it
    left behind is all still there: a `rm -rf node_modules` or a `git clean
    -xdf` since then prepares the checkout again."""
    try:
        last = json.loads(stamp.read_text())
        return last["from"] == wanted and all(
            (task_dir / name).is_dir() for name in last["made"]
        )
    except (OSError, ValueError, KeyError, TypeError):
        return False


# The files a project's dependencies are installed from, by name, wherever in
# the tree they sit. Which of them a project's startup script reads is the
# project's to know; a change to any one prepares the checkout again.
_DEPENDENCY_FILES = (
    # Python
    "uv.lock",
    "pyproject.toml",
    "setup.py",
    "setup.cfg",
    "poetry.lock",
    "pdm.lock",
    "Pipfile",
    "Pipfile.lock",
    "requirements*.txt",
    "requirements*.in",
    "requirements/**",
    "constraints*.txt",
    "environment.yml",
    "environment.yaml",
    "conda-lock.yml",
    "pixi.toml",
    "pixi.lock",
    ".python-version",
    # JavaScript
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "package-lock.json",
    "npm-shrinkwrap.json",
    "yarn.lock",
    ".yarnrc.yml",
    "bun.lock",
    "bun.lockb",
    "deno.json",
    "deno.jsonc",
    "deno.lock",
    ".npmrc",
    ".nvmrc",
    ".node-version",
    # Other ecosystems
    "Cargo.toml",
    "Cargo.lock",
    "rust-toolchain",
    "rust-toolchain.toml",
    "go.mod",
    "go.sum",
    "go.work",
    "Gemfile",
    "Gemfile.lock",
    "composer.json",
    "composer.lock",
    "pom.xml",
    "build.gradle",
    "build.gradle.kts",
    "settings.gradle",
    "settings.gradle.kts",
    "gradle.properties",
    "*.csproj",
    "Directory.Packages.props",
    "packages.lock.json",
    "flake.nix",
    "flake.lock",
    ".tool-versions",
    "mise.toml",
    ".mise.toml",
    "*.patch",
)


def _prepared_from(task_dir: Path, config: Path) -> str:
    """What a checkout's dependencies are prepared from: the environment the
    room pinned (its scripts and variables), and each dependency file as it is
    on disk, committed or not."""
    digest = hashlib.sha256(config.read_bytes())
    listed = _git_task(
        task_dir,
        "ls-files",
        "-z",
        "--cached",
        "--others",
        "--exclude-standard",
        "--",
        *(f":(glob)**/{name}" for name in _DEPENDENCY_FILES),
        raw=True,
    )
    for name in sorted(set(filter(None, listed.split("\0")))):
        path = task_dir / name
        digest.update(b"\0" + name.encode("utf-8", "surrogateescape") + b"\0")
        digest.update(path.read_bytes() if path.is_file() else b"\0deleted")
    return digest.hexdigest()


def _opened_as_left(task_dir: Path, data: dict) -> bool:
    """Whether opening the checkout from the forge would leave it as it is:
    there, on the task's current branch, and wired to the task's forge."""
    if not (task_dir / ".git").exists():
        return False
    try:
        branch = _git_task(task_dir, "symbolic-ref", "--short", "HEAD")
        remote = _git_task(task_dir, "config", "--get", "remote.origin.url")
        _git_task(
            task_dir,
            "rev-parse",
            "--verify",
            "--quiet",
            f"refs/remotes/origin/{data['base']}",
        )
    except RuntimeError:
        return False
    return branch == data["branch"] and remote == data["remote"]


def _open_from_forge(repo: Path, task_dir: Path, data: dict) -> None:
    """Fetch the task's branches into `repo`, and make the task's checkout if
    there is none. Its caller holds `<project>.lock`."""
    _prepare_repository(repo, data)
    # The commits, not every version of every file. A project's repo is
    # mostly old blobs — measured on cheese's own: 195 MB whole, 9.6 MB
    # this way — and all of that crossed the platform's backend on the way
    # here, where one 169 MB fetch froze every other request for 3.7 s
    # (2026-09-20). The whole history is still here, so `git log` and a
    # diff against the base still work; a file's older contents are fetched
    # if something actually reads them.
    exists_on_forge = bool(
        _git_task(repo, "ls-remote", "--heads", "origin", data["branch"])
    )
    refs = [data["base"]] + ([data["branch"]] if exists_on_forge else [])
    for ref in refs:
        _git_task(
            repo,
            "fetch",
            "--filter=blob:none",
            "origin",
            f"refs/heads/{ref}:refs/remotes/origin/{ref}",
        )
    if (task_dir / ".git").exists():
        return
    existing = _git_task(repo, "branch", "--list", data["branch"])
    create = [] if existing else ["-b", data["branch"]]
    remote_start = data["branch"] if exists_on_forge else data["base"]
    start = data["branch"] if existing else f"refs/remotes/origin/{remote_start}"
    _git_task(repo, "worktree", "prune")
    _git_task(repo, "worktree", "add", *create, str(task_dir), start)


def _follow_task_branch(worktree: Path, data: dict) -> None:
    """Move a checkout still on one of its task's earlier branches onto the
    current one.

    A task that delivers in steps gets a new branch, cut from the project's
    latest code, each time a step lands. What this checkout has that did not
    land comes along: the commits made after the landed head (`landed`), and
    the files not yet committed. A checkout an agent moved to a branch of its
    own is left alone; `cheese sync` refuses to deliver it as before.
    """
    branch = data["branch"]
    try:
        found = _git_task(worktree, "symbolic-ref", "--short", "HEAD")
    except RuntimeError:
        return
    earlier = "task/" + uuid.UUID(data["task_id"]).hex[:8]
    if found == branch or not (found == earlier or found.startswith(earlier + "-")):
        return
    head = _git_task(worktree, "rev-parse", "HEAD")
    landed = data.get("landed")
    since = landed if landed and _is_ancestor(worktree, landed, head) else head
    quiet = ("-c", "core.hooksPath=/dev/null")
    dirty = bool(_git_task(worktree, "status", "--porcelain", "--untracked-files=all"))
    if dirty:
        _git_task(worktree, "add", "-A")
        _git_task(
            worktree, *quiet, "commit", "-q", "--no-verify", "-m", "cheese: carry over"
        )
    _git_task(worktree, *quiet, "switch", "-q", "-C", branch)
    try:
        _git_task(
            worktree,
            *quiet,
            "rebase",
            "-q",
            "--onto",
            f"refs/remotes/origin/{data['base']}",
            since,
        )
    except RuntimeError as exc:
        try:
            _git_task(worktree, *quiet, "rebase", "--abort")
        except RuntimeError:
            pass
        _git_task(worktree, *quiet, "switch", "-q", found)
        _git_task(worktree, "branch", "-q", "-D", branch)
        if dirty:
            _git_task(worktree, "reset", "-q", "HEAD~1")
        raise SystemExit(
            f"[cheese] 这条任务上一次的交付已经合并，下一步要在新分支 {branch} 上做，"
            f"但这里还没合并的改动和最新代码冲突，没能带过去（{exc}）。"
            f"在 {found} 上把冲突解决掉（和 origin/{data['base']} 合并或变基），"
            "再执行一次 cheese worktree。"
        ) from exc
    if dirty:
        _git_task(worktree, "reset", "-q", "HEAD~1")


class _BranchQueued(RuntimeError):
    """The task's PR is in the merge queue, which locks its branch."""

    def __init__(self, branch: str, pr: int):
        super().__init__(
            f"{branch} is locked: PR #{pr} is in the merge queue, so commits "
            "made since it was accepted cannot join it"
        )
        self.pr = pr


def _report_sync_failure(
    task_id: str, branch: str | None, queued_pr: int | None = None
) -> None:
    """Report that a task's work did not reach its branch.

    Only the failure: a turn that ends with its work still on the machine looks
    identical to one that succeeded — that is what let a rejected push read as a
    completed turn until the machine was deleted and the work went with it. On
    success the work is already visible in the branch, and a note per turn
    saying so would be noise that trains people to skip it.

    An ordinary failed push goes into the 现场 of the conversation whose
    checkpoint ran — the only conversation this credential may write. The
    checkpoint names its turn (`CHEESE_TURN`), so the note joins that turn's
    process view; a sync with no turn behind it is drawn as a platform line.
    It names the branch, which is how a sibling task's commit is identified
    when a room's `sync --all` picked it up: a task credential may not write
    into another task's conversation. The queue case is different — retrying
    cannot help and a person has to choose — so that one is still said in the
    room.
    """
    if not (API and TOPIC and (TOKEN or PLATFORM_SOCKET)):
        return  # A human using the CLI directly already receives its exit status.
    where = branch or f"任务 {task_id}"
    if queued_pr:
        # Retrying cannot help: the branch stays locked until the queue is done.
        content = (
            f"⚠️ {where} 上采纳之后的新提交进不了 PR #{queued_pr}——它已在合并"
            "队列里，排队的分支不能再改。提交只留在那台机器上，机器回收就没了；PR 合并后"
            "在新任务里交付它们，或由验收人退回这张卡、PR 撤出队列后再推。"
        )
        delivered = _tell_room(content)
    else:
        content = (
            f"有改动没能推回 {where}——它还留在那台机器上，采纳和 diff 现在"
            "看不到它；若机器被回收，改动会丢失。"
        )
        delivered = _tell_site(content)
    if not delivered:
        print(
            f"[cheese] 同步失败的通知未送达，任务 {task_id} 的 "
            "cheese-sync.log 保留了结果",
            file=sys.stderr,
        )


def _tell_site(content: str) -> bool:
    """Put `content` in 现场 as the machine's own status line; whether it arrived.

    `CHEESE_TURN` is set by the platform for the one command that is a turn's
    checkpoint (`cheese sync --all`), so the note joins that turn and shows in
    its process view. A sync outside any turn (a commit's own) carries none and
    is drawn as a platform line of its own."""
    body = {"subtype": "sync_failed", "text": content}
    req = urllib.request.Request(
        f"{API}/topics/{TOPIC}/session-records",
        data=json.dumps(body).encode(),
        method="POST",
    )
    req.add_header("Content-Type", "application/json")
    req.add_header("Authorization", f"Bearer {TOKEN}")
    if TURN:
        req.add_header("X-Cheese-Turn", TURN)
    try:
        with _urlopen(req, timeout=30):
            pass
    except Exception:
        return False
    return True


def _tell_room(content: str) -> bool:
    """Post `content` to the room this machine works for; whether it arrived."""
    body = {
        "content": content,
        "request_id": str(uuid.uuid4()),
    }
    req = urllib.request.Request(
        f"{API}/topics/{TOPIC}/messages",
        data=json.dumps(body).encode(),
        method="POST",
    )
    req.add_header("Content-Type", "application/json")
    req.add_header("Authorization", f"Bearer {TOKEN}")
    try:
        with _urlopen(req, timeout=30):
            pass
    except Exception:
        return False
    return True


def _sync_task(task_id: str) -> None:
    """Deliver one task's commits. What it has not committed stays on this
    machine only: the platform keeps nothing but what was pushed."""
    task_id = str(uuid.UUID(task_id))
    worktree = _task_root() / task_id
    if not (worktree / ".git").exists():
        worktree = _task_worktree(task_id)
    admin = Path(_git_task(worktree, "rev-parse", "--absolute-git-dir"))
    log = admin / "cheese-sync.log"
    with log.open("a") as record:
        # A post-commit hook and the room's Stop hook can arrive together.
        _lock(record)
        record.write(f"{datetime.now(UTC).isoformat()} start task={task_id}\n")
        record.flush()
        branch = None
        closed = False
        try:
            project = _need("CHEESE_PROJECT", PROJECT)
            data = _call("GET", f"/projects/{project}/git/tasks/{task_id}")["data"]
            closed = data["closed"]
            if closed:
                # Delivery is closed, so there is nothing to push.
                record.write(
                    f"{datetime.now(UTC).isoformat()} skipped: delivery is closed\n"
                )
                _warm_task_diff(worktree, data)
                return
            _git_task(worktree, "config", "--replace-all", "credential.helper", "")
            _git_task(
                worktree,
                "config",
                "--add",
                "credential.helper",
                "!cheese git-credential",
            )
            _git_task(worktree, "config", "credential.useHttpPath", "true")
            if os.environ.get("GIT_SSL_CAINFO"):
                _git_task(
                    worktree,
                    "config",
                    "http.sslCAInfo",
                    os.environ["GIT_SSL_CAINFO"],
                )
            _git_task(worktree, "remote", "set-url", "origin", data["remote"])
            _configure_git_transport(worktree, data)
            head = _git_task(worktree, "rev-parse", "HEAD")
            branch = data["branch"]
            found = _git_task(worktree, "symbolic-ref", "--short", "HEAD")
            if found != branch:
                # A step of the task landed since this checkout was opened.
                _task_worktree(task_id)
                found = _git_task(worktree, "symbolic-ref", "--short", "HEAD")
            if found != branch:
                raise RuntimeError(f"Expected task branch {branch}, found {found}")
            try:
                _once_more_if_transient(
                    lambda: _deliver_task_branch(
                        worktree, branch, head, queued_pr=data.get("merge_queued_pr")
                    )
                )
            finally:
                # The report of the push that just ran, to the author of the
                # commit that triggered it. Only a push produces one, so a
                # sync that had nothing to deliver is silent here. In a
                # `finally` because a push that failed still ran the entry
                # point: its report is the reason to look, and the sync that
                # would carry it forward is the one being abandoned here.
                _flush_pre_push_reports()
            record.write(f"{datetime.now(UTC).isoformat()} success head={head}\n")
            _warm_task_diff(worktree, data)
        except BaseException as exc:
            record.write(
                f"{datetime.now(UTC).isoformat()} failed {type(exc).__name__}: {exc}\n"
            )
            if closed:
                # No room message from here: a closed task has no turn whose
                # work went missing.
                raise
            queued = exc.pr if isinstance(exc, _BranchQueued) else None
            _report_sync_failure(task_id, branch, queued)
            raise


def _warm_task_diff(worktree: Path, data: dict) -> None:
    """Fetch the old content the 改动 tab will need, before it is asked for.

    The worktree is a ``blob:none`` partial clone: a diff against the task's
    base reads the old version of every changed file, and git fetches the
    missing ones only when it gets there. The first reader pays for that
    fetch; on a slow machine it can outlast the browser's read budget, so the
    tab times out once and is fast afterwards. Pay it here, off the sync's
    path, at the end of a turn.
    """
    base = data.get("base") or "main"
    try:
        ancestor = _git_task(
            worktree, "merge-base", "HEAD", f"refs/remotes/origin/{base}"
        )
    except Exception:
        # No such base ref (a single-branch checkout, or a base branch that was
        # never fetched): there is nothing this can usefully warm.
        return
    env = {
        key: value
        for key, value in os.environ.items()
        if not key.startswith("GIT_") or key == "GIT_SSL_CAINFO"
    }
    env["GIT_TERMINAL_PROMPT"] = "0"
    command = [
        "git",
        "-C",
        str(worktree),
        "diff",
        "--no-ext-diff",
        "--no-textconv",
        ancestor,
        "--",
    ]
    kwargs = (
        {
            "creationflags": subprocess.CREATE_NEW_PROCESS_GROUP
            | subprocess.DETACHED_PROCESS
        }
        if os.name == "nt"
        else {"start_new_session": True}
    )
    with contextlib.suppress(OSError):
        subprocess.Popen(
            command,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            env=env,
            close_fds=True,
            **kwargs,
        )


# Words git prints when the connection, not the forge, failed.
_TRANSIENT_GIT = (
    "connection reset",
    "timed out",
    "the remote end hung up unexpectedly",
    "early eof",
)


def _transient(exc: BaseException) -> bool:
    """A reset or timed-out connection: the same request may well go through."""
    if isinstance(exc, urllib.error.HTTPError):
        return False  # The platform answered; asking again gets the same answer.
    if isinstance(exc, urllib.error.URLError):
        exc = exc.reason if isinstance(exc.reason, BaseException) else exc
    if isinstance(
        exc,
        (ConnectionResetError, ConnectionAbortedError, BrokenPipeError, TimeoutError),
    ):
        return True
    return isinstance(exc, RuntimeError) and any(
        words in str(exc).lower() for words in _TRANSIENT_GIT
    )


def _once_more_if_transient(action):
    """Run `action`, and once more if the network dropped it.

    One retry, not a loop: a single reset is the network, a second one in a
    row is usually something about the request (its size, a proxy's limit),
    and every retry lengthens the push a room switch waits two minutes for.
    """
    try:
        return action()
    except Exception as exc:
        if not _transient(exc):
            raise
    return action()


def _deliver_task_branch(
    worktree: Path, branch: str, head: str, *, queued_pr: int | None = None
) -> None:
    """Make the task's branch on the forge carry `head`.

    The branch has more than one writer: every checkout of the task (a
    teammate can work the same task from another), and whoever pushes to the
    PR. So the forge's tip is read first, and:

    - `head` already in it: this checkout has nothing the branch lacks.
      Another checkout went further; pushing the older head is refused and
      would say nothing true.
    - the tip in `head`'s history: an ordinary push.
    - neither, but the tip is a commit this checkout itself had on the branch
      and then amended or rebased away: replace it, leased on that tip, so a
      commit arriving meanwhile is refused and not overwritten. Tidying a
      task's commits is part of the work (dropping a dependency asks for it).
    - neither, and the tip carries commits this checkout never had: refuse.
      Replacing them would delete someone else's work from the PR.

    Anything to push while the PR is in the merge queue (`queued_pr`) is
    refused up front: the forge locks a queued branch.

    `head` already in the branch as this checkout last pushed or fetched it
    needs no forge call at all. Asking anyway turned a forge that could not be
    reached for a moment into "not pushed back" for work it already had, once
    for every sync while the outage lasted.
    """
    remote = f"refs/remotes/origin/{branch}"
    if _is_ancestor(worktree, head, remote):
        return
    # The pushes below run the project's pre-push entry point, whose report is
    # read back and handed to the room (`_flush_pre_push_reports`).
    pre_push_report = _pre_push_report_path(worktree)
    if not _git_task(worktree, "ls-remote", "origin", f"refs/heads/{branch}"):
        _git_task(
            worktree,
            "push",
            "origin",
            f"{head}:refs/heads/{branch}",
            pre_push_report=pre_push_report,
        )
        return
    _git_task(
        worktree,
        "fetch",
        "--filter=blob:none",
        "origin",
        f"+refs/heads/{branch}:{remote}",
    )
    tip = _git_task(worktree, "rev-parse", remote)
    if _is_ancestor(worktree, head, tip):
        return
    if queued_pr:
        raise _BranchQueued(branch, queued_pr)
    if _is_ancestor(worktree, tip, head):
        _git_task(
            worktree,
            "push",
            "origin",
            f"{head}:refs/heads/{branch}",
            pre_push_report=pre_push_report,
        )
        return
    own = _git_task(
        worktree, "reflog", "show", "--format=%H", f"refs/heads/{branch}"
    ).split()
    if tip not in own:
        raise RuntimeError(
            f"{branch} on the forge has commits this checkout never had "
            f"(its tip is {tip[:12]}); merge or rebase onto {remote} and sync again"
        )
    _git_task(
        worktree,
        "push",
        f"--force-with-lease=refs/heads/{branch}:{tip}",
        "origin",
        f"{head}:refs/heads/{branch}",
        pre_push_report=pre_push_report,
    )


def _is_ancestor(worktree: Path, commit: str, of: str) -> bool:
    try:
        _git_task(worktree, "merge-base", "--is-ancestor", commit, of)
    except RuntimeError:
        return False
    return True


def _has_work_to_sync(worktree: Path) -> bool:
    """Whether `_sync_task` would deliver anything from this checkout.

    Nothing, when its commit is already its branch on the forge as this
    checkout last pushed or fetched it: the push would be a no-op. Files not
    committed are not delivered, so they do not count. Answered from the checkout alone, with no network call, because
    `sync --all` asks it of every task the room ever opened and a room keeps
    them all (56 in one room on dev): pushing each one again made a switch's
    push outlast its two minutes once a room was old enough. Anything this
    cannot read goes to the full sync, which reports its own failures.
    """
    try:
        branch = _git_task(worktree, "symbolic-ref", "--short", "HEAD")
        pushed = _git_task(
            worktree, "rev-parse", "--verify", f"refs/remotes/origin/{branch}"
        )
        return not _is_ancestor(worktree, "HEAD", pushed)
    except RuntimeError:
        return True


def _synced_already(task_id: str) -> bool:
    """Whether the task's checkout here has nothing a sync would deliver
    (`_has_work_to_sync`) and is on the task's current branch.

    The branch is the platform's to say: once a step lands the task moves on
    to a new one, and the full sync carries the checkout over to it
    (`_task_worktree`) and delivers there. One call, and no forge probe."""
    worktree = _task_root() / task_id
    if not (worktree / ".git").exists() or _has_work_to_sync(worktree):
        return False
    try:
        branch = _git_task(worktree, "symbolic-ref", "--short", "HEAD")
    except RuntimeError:
        return False
    project = _need("CHEESE_PROJECT", PROJECT)
    data = _call("GET", f"/projects/{project}/git/tasks/{task_id}")["data"]
    return data["closed"] or data["branch"] == branch


def _sync_all_tasks() -> None:
    root = _task_root()
    if not root.exists():
        return
    failed = []
    for worktree in sorted(root.iterdir()):
        if not (worktree / ".git").exists():
            continue
        if not _has_work_to_sync(worktree):
            continue
        try:
            _sync_task(worktree.name)
        except (Exception, SystemExit) as exc:
            failed.append(worktree.name)
            # The platform logs these lines (`session_work.checkpoint`).
            print(f"[cheese] 任务 {worktree.name} 同步失败：{exc}", file=sys.stderr)
    if failed:
        raise SystemExit(1)


CHECK_DIR = os.path.expanduser("~/.cache/cheese-check")


def _check_page(a: argparse.Namespace) -> None:
    """`cheese check`: the platform's browser renders the page, this prints
    what it saw and leaves the screenshots where the agent can open them."""
    try:
        html = open(a.path, encoding="utf-8").read()
    except (OSError, UnicodeDecodeError) as exc:
        print(f"[cheese] 无法读取 {a.path}: {exc}", file=sys.stderr)
        sys.exit(1)
    widths = (a.widths or [400, 1280])[:3]
    if any(not 200 <= w <= 2000 for w in widths):
        print("[cheese] --width 要在 200 到 2000 之间", file=sys.stderr)
        sys.exit(2)
    if a.pdf and not re.fullmatch(
        r"[0-9.]+(mm|cm|in|px)?( [0-9.]+(mm|cm|in|px)?)?", a.margin
    ):
        print(
            '[cheese] --margin 写一个或两个长度,如 "0" 或 "16mm 18mm"', file=sys.stderr
        )
        sys.exit(2)
    body = {
        "html": html,
        "widths": widths,
        "color_scheme": "dark" if a.dark else "light",
        "pdf_margin": a.margin if a.pdf else None,
        "topic": TOPIC or None,
        "project": PROJECT or None,
    }
    started = monotonic()
    resp = _call("POST", "/page-check", body, tolerate=(503,), timeout=120)
    if resp.get("ok") is False and resp.get("status"):
        reason = (resp.get("error") or {}).get("message") or "渲染服务不可用"
        print(f"[cheese] 平台现在渲染不了:{reason}", file=sys.stderr)
        sys.exit(1)
    data = resp.get("data") or {}
    if not data.get("ok"):
        print(f"[cheese] 渲染失败:{data.get('error') or '未知原因'}", file=sys.stderr)
        sys.exit(1)
    os.makedirs(CHECK_DIR, exist_ok=True)
    stem = os.path.splitext(os.path.basename(a.path))[0] or "page"
    print(f"已渲染 {a.path}(用时 {monotonic() - started:.1f} 秒)")
    problems = 0
    errors: list[str] = []
    for view in data.get("views") or []:
        width = view["width"]
        shot = os.path.join(CHECK_DIR, f"{stem}-{width}.png")
        with open(shot, "wb") as out:
            out.write(base64.b64decode(view["png_b64"]))
        cut = f",只截了前 {view['cut_at']}px" if view.get("cut_at") else ""
        print(f"\n{width}px:截图 {shot}(整页高 {view['page_height']}px{cut})")
        if view["page_width"] > view["viewport_width"] + 1:
            problems += 1
            print(
                f"  页面被撑宽到 {view['page_width']}px,读者要横向滚动整页。"
                "撑宽它的元素:"
            )
            for item in view.get("overflowing") or []:
                print(f"  - {item['element']}:右边缘在 {item['right']}px")
        else:
            print("  宽度正常,没有横向撑破。")
        for item in view.get("clipped") or []:
            problems += 1
            print(f"  内容被裁掉 {item['hidden_px']}px:{item['element']}")
        for src in view.get("broken_images") or []:
            errors.append(f"图片没加载出来:{src}(页面只能用内联图片)")
        for text in view.get("console_errors") or []:
            errors.append(f"脚本报错:{text}")
        for url in view.get("failed_requests") or []:
            errors.append(f"请求失败:{url}")
    if a.pdf and data.get("pdf_b64"):
        pdf = base64.b64decode(data["pdf_b64"])
        with open(a.pdf, "wb") as out:
            out.write(pdf)
        pages = len(re.findall(rb"/Type\s*/Page(?!s)", pdf))
        print(f"\nPDF:{a.pdf}(A4,{pages} 页)")
    if errors:
        print()
        for line in dict.fromkeys(errors):
            problems += 1
            print(f"- {line}")
    print(
        "\n没有发现问题。看一眼截图就可以摆出来。"
        if not problems
        else "\n按上面的问题改一轮,再看一眼截图;不需要反复跑。"
    )


def _need(name: str, value: str) -> str:
    if not value:
        print(f"[cheese] 缺少 {name}（环境变量未注入）", file=sys.stderr)
        sys.exit(2)
    return value


def _pulled_path() -> Path:
    return Path.home() / ".cheese" / "pulled-versions.json"


def _pulled_versions() -> dict:
    """Which version of each room file this machine last read or wrote.

    It is what `cheese show` sends as `base_version`: the platform refuses a
    write whose base has since been replaced, so an edit made on an old copy
    cannot silently overwrite what a person saved in the editor."""
    try:
        return json.loads(_pulled_path().read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}


def _remember_pulled(topic: str, rel: str, version: str) -> None:
    versions = _pulled_versions()
    versions[f"{topic}:{rel}"] = version
    target = _pulled_path()
    target.parent.mkdir(parents=True, exist_ok=True)
    temporary = target.with_name(target.name + ".next")
    temporary.write_text(json.dumps(versions, ensure_ascii=False), encoding="utf-8")
    temporary.replace(target)


def _raw_request(
    method: str, path: str, data: str | None, out: str | None = None
) -> None:
    """One backend request on the container's existing auth (CHEESE_TOKEN), its
    body printed or saved as it came — for the downloads (a library file) that land
    on this machine.

    `out` writes the body to a file as BYTES. Without it the body is decoded as
    text, which is right for JSON and destroys anything else: `decode(errors=
    "replace")` turns every byte over 0x7f into U+FFFD, so a PNG arrives with
    its own signature (`\x89PNG`) mangled and no way to tell that happened
    apart from the file not opening. Attachments are reachable over this
    channel, so text-only was not a limitation of the API — only of this
    function."""
    if not path.startswith("/"):
        path = "/" + path
    body = data.encode() if data else None
    req = urllib.request.Request(f"{API}{path}", data=body, method=method.upper())
    req.add_header("Content-Type", "application/json")
    if TOKEN:
        req.add_header("Authorization", f"Bearer {TOKEN}")
    if TURN:
        req.add_header("X-Cheese-Turn", TURN)
    try:
        with _urlopen(req, timeout=30) as r:
            payload = r.read()
    except urllib.error.HTTPError as e:
        # Surface the backend's error body (auth failures, validation, etc.)
        # verbatim so the caller sees exactly why — then exit non-zero. Always
        # as text: an error body is JSON even when the success body would not
        # have been, and writing it to `out` would leave a file that looks like
        # the download succeeded.
        print(e.read().decode(errors="replace"))
        sys.exit(1)
    except Exception as e:
        print(f"[cheese] api {method} {path} 出错: {e}", file=sys.stderr)
        sys.exit(1)
    if out:
        with open(out, "wb") as f:
            f.write(payload)
        print(f"已写入 {out}（{len(payload)} 字节）")
    else:
        print(payload.decode(errors="replace"))


#: 一次 `cheese library get` 在取不完时最多从头要几回地址：每一回都接着已经取到的
#: 那里往下取，几 GB 的数据集断一次线不必重来。
_LIBRARY_GET_ATTEMPTS = 5


def _library_get(project: str, name: str, out: str) -> None:
    """`cheese library get`：先问平台要这一份的下载地址，再用 curl 把字节直接从存储
    取到 `out`——不经过平台，不整份进内存，也没有总时长的上限。

    地址几分钟内开始取都有效；取到一半断了，再要一个新地址，从已经取到的地方接着取
    （`-C -`）。取的过程写在旁边的 `.part` 里，取完、大小对上了才换成 `out`，所以
    `out` 要么是整份，要么不在。文件存在平台自己盘上时，地址是平台的一条路由
    （以 `/` 开头），照样这么取。"""
    query = urllib.parse.quote(name)
    partial = f"{out}.part"
    with contextlib.suppress(FileNotFoundError):
        os.remove(partial)
    size, failure = None, ""
    for _ in range(_LIBRARY_GET_ATTEMPTS):
        link = _call("GET", f"/projects/{project}/library/link?path={query}")["data"]
        size = int(link["bytes"])
        url = link["url"]
        if url.startswith("/"):
            # A signed link: curl dials the platform itself.
            url = f"{_direct_api()}{url}"
        done = subprocess.run(
            ["curl", "-sSf", "--retry", "3", "-C", "-", "-o", partial, url],
            capture_output=True,
            text=True,
        )
        got = os.path.getsize(partial) if os.path.exists(partial) else 0
        if done.returncode == 0 and got == size:
            os.replace(partial, out)
            print(f"已写入 {out}（{size} 字节）")
            return
        failure = (
            done.stderr.strip() or f"取到 {got} 字节，curl 退出码 {done.returncode}"
        )
    with contextlib.suppress(FileNotFoundError):
        os.remove(partial)
    print(
        f"[cheese] 没能取下 library/{name}（{size} 字节）：{failure}", file=sys.stderr
    )
    sys.exit(1)


def _format_status(d: dict) -> str:
    """Human/agent-readable rendering of /topics/{id}/status (盲飞防护): the
    turn's state, every accept card with its gate tail, and the platform
    waterlines — the questions agents used to hand-poll the API for.

    A running turn is shown as 正常运行中 or 接近硬顶, never as a live countdown
    of seconds. A literal "还剩 Ns" figure was observed making the agent rush
    against what's only ever meant to be a wedged-turn safety net."""
    lines: list[str] = []
    topic = d.get("topic") or {}
    head = f"对话: {topic.get('title', '?')}（{topic.get('status', '?')}"
    if topic.get("branch"):
        head += f", 分支 {topic['branch']}"
    lines.append(head + "）")
    turn = d.get("turn")
    if turn:
        t = f"这次运行: {turn.get('status')}"
        if turn.get("status") == "running":
            if turn.get("near_ceiling"):
                t += "，接近硬顶（即将触发兜底结束）"
            else:
                t += "，正常运行中"
        elif turn.get("duration_s") is not None:
            t += f"，用时 {turn['duration_s']}s"
        if turn.get("detail"):
            t += f"（{turn['detail']}）"
        lines.append(t)
    cards = d.get("cards") or []
    lines.append(f"验收卡: {len(cards)} 张" if cards else "验收卡: 无")
    for c in cards:
        row = f"- [{c.get('status')}] 递给 @{c.get('reviewer')}"
        if c.get("decided_by"):
            row += f"，{c['decided_by']} 处理于 {c.get('decided_at')}"
        if c.get("note"):
            row += f"；note: {c['note']}"
        lines.append(row)
        if c.get("pr_url"):
            lines.append(f"  PR: #{c.get('pr_number')} {c['pr_url']}")
            # The repo name is already sitting in the PR url — spell the CI
            # lookup out rather than leaving "用 gh 查" as an exercise.
            m = re.match(r"https://github\.com/([^/]+/[^/]+)/pull/", c["pr_url"])
            if m:
                lines.append(
                    f"  查 CI: gh api repos/{m.group(1)}/commits/<head_sha>/check-runs"
                )
        if c.get("status") == "gate_failed" and c.get("gate_output_tail"):
            lines.append("  闸门输出（尾部）:")
            lines.extend("    " + ln for ln in c["gate_output_tail"].splitlines()[-15:])
    bg = d.get("background") or {}
    for t in bg.get("tasks") or []:
        lines.append(
            f"后台任务: 「{t.get('label')}」已跑 {t.get('running_s')}s"
            f"（上限 {t.get('timeout_s')}s）；输出: {t.get('log_path')}"
        )
    plat = d.get("platform") or {}
    disk = plat.get("disk")
    if disk:
        lines.append(
            f"磁盘: 可用 {disk.get('free_gb')}G / {disk.get('total_gb')}G"
            f"（已用 {disk.get('used_pct')}%）"
        )
    credits = plat.get("credits") or {}
    lines.append(
        f"并发: 全站运行中 {plat.get('active_turns', '?')} 个，"
        f"本项目排队 {plat.get('queued_turns', 0)}；额度: {_credits_line(credits)}"
    )
    return "\n".join(lines)


def _credits_line(credits: dict) -> str:
    """付费方那一层还剩多少、上限多少、几时恢复。

    芝士要的是「这一层用完我会不会被拒绝、几时恢复」，所以除了剩余还要带上另外
    两样；项目预算那一层不会自动恢复，单独说一句，别让它看起来像会按月回来。
    """
    if credits.get("unlimited"):
        return "不限"
    parts = [f"剩 {credits.get('remaining')}"]
    if credits.get("total") is not None:
        parts.append(f"上限 {credits['total']}")
    if credits.get("resets_at"):
        parts.append(f"{credits['resets_at']} 恢复")
    line = " / ".join(parts)
    # 先停的是项目预算时，上面那组数说的就是它，而且它不会自己回来；先停的是团队
    # 方案时，项目预算另算一笔，单独说一句，别让它看起来像会按月回来。
    if credits.get("layer") == "project_budget":
        line += "；这个上限不会自动恢复，要管理员调"
    elif (budget := credits.get("project_remaining")) is not None:
        line += f"；本项目预算还剩 {budget}（不会自动恢复）"
    return line


# `cheese serve` 报端口之前先敲一次应用,敲通了才算「起来了」。
#
# 为什么:agent 习惯 `nohup vite &` 把 dev server 丢到后台,紧跟着就 `cheese serve`——
# 这时 vite 常常还没开始监听。平台那边敲端口敲不通会当场拒绝,用户看到的是一闪而过
# 的白框,agent 却以为报上去了。探一下就不会:应用已经在听的(常见情况)立刻返回;
# 还在起的,等它应答再报,最多等这么久。
_SERVE_WAIT_DEFAULT_S = 30.0
# 单次探测的超时和两次探测的间隔。前者要短:每个探测都得在超时前自己结束,不然一个
# 挂着不回的 socket 会把整段等待吃掉;后者别太密,免得对着还在启动的进程打满。
_SERVE_PROBE_TIMEOUT_S = 2.0
_SERVE_PROBE_INTERVAL_S = 0.5
# 浏览器式的请求头。有的服务器对 curl 和浏览器的应答不一样(vite dev 给浏览器发 SPA
# 外壳),探「应用起没起来」就得像浏览器那样问一次。
_SERVE_PROBE_HEADERS = {
    "User-Agent": "Mozilla/5.0 (cheese serve readiness probe)",
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
    "Accept-Language": "zh-CN,zh;q=0.9,en;q=0.8",
}


def _probe_app(port: int) -> int | None:
    """对 127.0.0.1:port 敲一次。

    通了就返回 HTTP 状态码(4xx/5xx 也算「在应答」,只是这个路径不对);连不上、
    超时、收了半截,或端口上坐的是个不讲 HTTP 的服务(SSH/数据库这类先打招呼
    的非 HTTP 监听)都返回 None。
    """
    request = urllib.request.Request(
        f"http://127.0.0.1:{port}/", headers=_SERVE_PROBE_HEADERS, method="GET"
    )
    try:
        with _urlopen(request, timeout=_SERVE_PROBE_TIMEOUT_S) as response:
            return response.status
    except urllib.error.HTTPError as exc:
        # 收到应答了,只是不是 2xx/3xx——应用在跑,但这个路径不是它的家。
        return exc.code
    except (
        urllib.error.URLError,
        OSError,
        ValueError,
        # 端口上是个非 HTTP 的监听:首行不是状态行,http.client 抛 BadStatusLine
        # (HTTPException,不是 OSError)。这类端口也是「敲不通」,不该把它抛给 caller
        # 炸掉整个 serve。
        http.client.HTTPException,
    ):
        return None


def _wait_for_app(port: int, timeout_s: float) -> int | None:
    """等应用应答,最多等 timeout_s 秒。

    任何 HTTP 应答(2xx/3xx/4xx/5xx 都算)就立刻返回——端口有人在听、能应答,
    平台那一敲就通,4xx/5xx 也只是根路径不对,再等下去纯属空等。返回最后看到的
    状态码;返回 None 表示这段时间里一直没人应答(端口没人听)。
    """
    deadline = monotonic() + timeout_s
    while True:
        status = _probe_app(port)
        if status is not None:
            return status
        remaining = deadline - monotonic()
        if remaining <= 0:
            return None
        sleep(min(_SERVE_PROBE_INTERVAL_S, remaining))


def _detect_listening_process(port: int) -> tuple[str | None, str | None]:
    """Read (command, cwd) of the process listening on ``port`` on this machine.

    When an agent starts a dev server in the background and then runs ``cheese
    serve <port>`` without ``--cmd``, recording the listening process's command
    line and working directory lets the platform restart the app directly in a
    fresh sandbox without spending a model turn to ask the agent again.
    """
    inodes: set[str] = set()
    for net_file in ("/proc/net/tcp", "/proc/net/tcp6"):
        try:
            with open(net_file) as f:
                lines = f.read().splitlines()[1:]
        except OSError:
            continue
        for line in lines:
            parts = line.split()
            if len(parts) < 10 or parts[3] != "0A":
                continue
            try:
                local_port = int(parts[1].rsplit(":", 1)[-1], 16)
            except ValueError:
                continue
            if local_port == port:
                inodes.add(parts[9])
    if inodes and os.path.isdir("/proc"):
        self_pid = str(os.getpid())
        try:
            pids = [p for p in os.listdir("/proc") if p.isdigit() and p != self_pid]
        except OSError:
            pids = []
        targets = {f"socket:[{ino}]" for ino in inodes}
        for pid in pids:
            fd_dir = f"/proc/{pid}/fd"
            try:
                fds = os.listdir(fd_dir)
            except OSError:
                continue
            for fd in fds:
                try:
                    link = os.readlink(f"{fd_dir}/{fd}")
                except OSError:
                    continue
                if link not in targets:
                    continue
                try:
                    raw = open(f"/proc/{pid}/cmdline", "rb").read()
                    argv = [
                        part.decode("utf-8", "replace")
                        for part in raw.split(b"\0")
                        if part
                    ]
                    cwd = os.readlink(f"/proc/{pid}/cwd")
                except OSError:
                    continue
                if not argv:
                    continue
                prefix = cwd.rstrip("/") + "/"
                normalized = [
                    "./" + arg[len(prefix) :] if arg.startswith(prefix) else arg
                    for arg in argv
                ]
                return shlex.join(normalized), cwd
    return None, None


def _build_serve_meta(port: int, command: str | None, cwd: str | None) -> dict | None:
    """Build the portable launch metadata ``cheese serve`` sends with an app."""
    if not command or not command.strip():
        return None
    resolved_cwd = str(Path(cwd or os.getcwd()).resolve())
    home = str(Path.home().resolve())
    meta: dict = {
        "port": int(port),
        "command": command.strip(),
        "cwd": resolved_cwd,
        "home": home,
    }
    task_root = _task_root().resolve()
    cwd_path = Path(resolved_cwd)
    if cwd_path == task_root or task_root in cwd_path.parents:
        rel = cwd_path.relative_to(task_root).parts
        if rel:
            try:
                meta["task_id"] = str(uuid.UUID(rel[0]))
            except ValueError:
                pass
    checkout_dir = (Path.home() / ".cheese" / "checkout").resolve()
    if cwd_path == checkout_dir or checkout_dir in cwd_path.parents:
        meta["checkout"] = True
    return meta


def _start_detached_serve_cmd(command: str, cwd: str, port: int) -> None:
    """Start ``command`` in ``cwd`` detached in the background."""
    log_dir = Path.home() / ".cheese"
    log_dir.mkdir(parents=True, exist_ok=True)
    log_path = log_dir / f"cheese-serve-{port}.log"
    with open(log_path, "a") as log:
        subprocess.Popen(
            ["sh", "-c", command],
            cwd=cwd,
            stdin=subprocess.DEVNULL,
            stdout=log,
            stderr=log,
            start_new_session=True,
        )


def _relocate_home_in_command(command: str, old_home: str, new_home: str) -> str:
    """Replace ``old_home`` with ``new_home`` only on path/token boundaries."""
    if not command or not old_home or old_home == new_home:
        return command
    pattern = re.compile(
        r"(?<=^)"
        + re.escape(old_home)
        + r"(?=/|[\s'\":]|$)|(?<=[\s='\":])"
        + re.escape(old_home)
        + r"(?=/|[\s'\":]|$)"
    )
    return pattern.sub(new_home, command)


def _restore_served_app(raw_spec: str, wait_s: float | None) -> int:
    """Bring a previously declared app and its preview tunnel back up in place.

    Called by the platform when waking a sleeping preview without starting an
    agent turn: opens the task checkout (or default-branch checkout) when the
    sandbox is fresh, relocates paths from the previous sandbox home, starts
    the recorded command if the port is silent, and brings the tunnel up.
    """
    up = os.environ.get("CHEESE_PREVIEW_UP", "")
    if not up:
        return 2
    try:
        spec = json.loads(raw_spec)
        port = int(spec["port"])
    except (ValueError, KeyError, TypeError):
        return 2
    if not (1 <= port <= 65535):
        return 2
    raw_task_id = spec.get("task_id")
    task_id: str | None = None
    if isinstance(raw_task_id, str) and raw_task_id.strip():
        try:
            task_id = str(uuid.UUID(raw_task_id.strip()))
        except ValueError:
            return 2
    if task_id is not None:
        task_dir = _task_root() / task_id
        if not (task_dir / ".git").exists():
            try:
                _task_worktree(task_id)
            except (Exception, SystemExit):
                return 1
    elif spec.get("checkout") is True:
        checkout_dir = Path.home() / ".cheese" / "checkout"
        if not (checkout_dir / ".git").exists():
            try:
                _checkout()
            except (Exception, SystemExit):
                return 1
    old_home = str(spec.get("home") or "").strip().rstrip("/")
    new_home = str(Path.home().resolve()).rstrip("/")
    cwd = str(spec.get("cwd") or new_home).strip()
    command = str(spec.get("command") or "").strip()
    if old_home and old_home != new_home:
        if cwd == old_home:
            cwd = new_home
        elif cwd.startswith(old_home + "/"):
            cwd = new_home + cwd[len(old_home) :]
        if command:
            command = _relocate_home_in_command(command, old_home, new_home)
    if not os.path.isdir(cwd):
        fallback = _task_root() / task_id if task_id is not None else Path(new_home)
        cwd = str(fallback) if fallback.is_dir() else new_home
    if subprocess.call(["sh", up, str(port)]) != 0:
        return 1
    if _probe_app(port) is None:
        if not command:
            return 1
        try:
            _start_detached_serve_cmd(command, cwd, port)
        except OSError:
            return 1
    timeout = _SERVE_WAIT_DEFAULT_S if wait_s is None else wait_s
    if timeout > 0 and _wait_for_app(port, timeout) is None:
        return 1
    updated = _build_serve_meta(port, command, cwd)
    if updated is not None:
        with contextlib.suppress(OSError):
            (Path.home() / ".cheese" / "cheese-preview.json").write_text(
                json.dumps(updated, ensure_ascii=False)
            )
    return 0


def source_fingerprint() -> str:
    """A short digest of THIS file's bytes.

    The box's `cheese` is bind-mounted from the backend's own copy, so the only
    way to tell — from inside a box — whether that plumbing actually worked is
    to compare what runs here against what the backend shipped. `cheese
    --version` prints this; a mismatch means the mount is stale."""
    try:
        with open(__file__, "rb") as f:
            return hashlib.sha256(f.read()).hexdigest()[:12]
    except OSError:
        return "unknown"


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="cheese",
        description=(
            "芝士 平台 CLI —— 只放必须在这台机器上作为进程跑的动作:任务目录、同步与"
            "恢复、预览、读写工作区文件的转换。\n"
            "平台状态(聊天、文档、任务卡、验收、通知)走会话侧的平台工具,\n"
            "其余的平台接口走其中的 platform_request。\n"
            "\n"
            "每个子命令的 --help 是权威的那一份(它和代码同源,不会过期)。"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument(
        "--version",
        action="version",
        version=f"cheese {source_fingerprint()}",
        help="打印源码指纹,用来核对本容器里的 CLI 是不是后端那一份",
    )
    sub = p.add_subparsers(dest="cmd", required=True)

    pwork = sub.add_parser(
        "worktree",
        help="准备任务工作目录并输出路径",
        description=(
            "准备已有任务的工作目录，输出路径；不会改变当前 shell 的目录。"
            "任务的一步交付合并以后，再执行一次会把目录换到下一步的新分支上。"
        ),
    )
    pwork.add_argument("task_id", help="任务 UUID")
    pwork.add_argument(
        "--prepare",
        action="store_true",
        help="依赖文件没变也重新跑一遍项目的启动脚本",
    )
    sub.add_parser(
        "checkout",
        help="准备项目默认分支的代码并输出路径",
        description=(
            "在 ~/.cheese/checkout 准备项目默认分支的代码（已有且没改过就更新到最新），"
            "输出路径；不会改变当前 shell 的目录。支线里看代码、跑命令用它：这里的"
            "改动留不下，要改项目就转为任务（cheese_task 的 open）。"
        ),
    )
    psync = sub.add_parser(
        "sync",
        help="把任务的提交推上去",
        description=(
            "把任务已提交的代码推到它的分支；默认从当前目录识别任务。"
            "没提交的文件不上传，机器回收后就没有了。"
        ),
    )
    psync.add_argument("--task", help="任务 UUID；省略时取当前任务目录")
    psync.add_argument(
        "--all", action="store_true", help="同步本频道机器上已有的全部任务目录"
    )

    pfix = sub.add_parser(
        "push-fix",
        help="将任务的新提交同步到它的 PR",
        description="把指定任务的新提交推到其现有 PR 并刷新验收状态。",
    )
