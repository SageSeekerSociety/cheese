    paw.add_argument("--label", default="", help="一句话说明在跑什么（唤醒时会显示）")
    paw.add_argument(
        "--timeout", type=int, default=3600, help="秒，超时会被杀掉并按退出码 124 回报"
    )

    # Internal: the detached child _await_start forks. Not for humans/agents.
    pawc = sub.add_parser("__await-child")
    pawc.add_argument("task_id")
    pawc.add_argument("command")
    pawc.add_argument("log_path")
    pawc.add_argument("timeout_s", type=int)

