    return p


def main() -> None:
    parser = build_parser()
    a = parser.parse_args()

    if a.cmd == "chat" and a.chatcmd == "send":
        topic = _need("CHEESE_TOPIC", TOPIC)
        if (a.content is None) == (a.file is None):
            raise SystemExit("请提供消息正文或 --file，二选一。")
        if a.file == "-":
            content = sys.stdin.read()
        elif a.file:
            with open(a.file, encoding="utf-8") as source:
                content = source.read()
        else:
            content = a.content
        if not content.strip():
            raise SystemExit("消息不能为空。")
        request_id = str(a.request_id or uuid.uuid4())
        print(
            f"[cheese] request_id={request_id}；重试请带 --request-id {request_id}",
            file=sys.stderr,
        )
        body = {"content": content, "request_id": request_id}
        if a.reply_to:
            body["reply_to"] = a.reply_to
        result = _call("POST", f"/topics/{topic}/messages", body)
        print(json.dumps(result["data"], ensure_ascii=False))
    elif a.cmd == "chat":
        _chat_read(a, parser)
    elif a.cmd == "doc" and a.doccmd == "set":
        topic = _need("CHEESE_TOPIC", TOPIC)
        with open(a.file, encoding="utf-8") as f:
            content = f.read()
        based_on = _read_doc_version(topic)
        res = _call(
            "PUT",
            f"/topics/{topic}/doc",
            {"content": content, "author": AUTHOR, "expected_version": based_on},
            tolerate=(409,),
        )
        if res.get("ok") is False:
            current = (res.get("error") or {}).get("data", {}).get("doc_version")
            print(
                f"[cheese] 没写进去：文档现在是第 {current} 版，你这份是照第 "
                f"{based_on} 版改的。先 cheese doc get 重新读一遍，把别人的改动"
                "合进你的文件，再 cheese doc set。直接重试会原样被拒。",
                file=sys.stderr,
            )
            sys.exit(1)
        _remember_doc_version(topic, (res.get("data") or {}).get("doc_version", 0))
        print("已更新实况文档。")
    elif a.cmd == "doc" and a.doccmd == "get":
        topic = _need("CHEESE_TOPIC", TOPIC)
        d = _call("GET", f"/topics/{topic}/doc").get("data")
        # Reading is what earns the right to write: remember the version this
        # printed, and `doc set` writes against it.
        _remember_doc_version(topic, (d or {}).get("doc_version", 0))
        print((d or {}).get("content", "") if d else "")
    elif a.cmd == "split":
        topic = _need("CHEESE_TOPIC", TOPIC)
        body = {"title": a.title, "created_by": AUTHOR}
        if a.reported_by:
            body["reporter_handle"] = a.reported_by
        if a.contributor:
            body["contributor_handles"] = a.contributor
        if a.brief:
            body["brief"] = a.brief
        if a.base_task:
            body["base_task_id"] = a.base_task
        # 不写 --reviewer = 用项目默认验收人。同 accept-request：别塞空串，
        # 「没说」和「说了空的」在后端是两件事。
        if a.reviewer:
            body["reviewer_handle"] = a.reviewer
        r = _call("POST", f"/topics/{topic}/split", body)["data"]
        worktree = _task_worktree(r["id"])
        print(
            f"任务：{r['title']}\nid={r['id']}\n工作目录：{worktree}\n"
            f"验收人：{r.get('reviewer_handle') or '待指定'}"
        )
        print(
            "进入工作目录后执行任务。使用原生分身时，把任务简报和此目录交给它，"
            "再用 cheese bind 绑定。"
        )
    elif a.cmd == "worktree":
        print(_task_worktree(a.task_id))
    elif a.cmd == "sync":
        if a.all:
            _sync_all_tasks()
        else:
            _sync_task(_task_id(a.task))
    elif a.cmd == "bind":
        r = _planned_call("cheese_bind", a)["data"]
        print(
            f"「{r['title']}」现在归分身 {r['subagent_id']}，它干的事会记到这条活上。"
        )
    elif a.cmd == "close-task":
        r = _planned_call("cheese_close_task", a)["data"]
        print(f"「{r['title']}」收了。结论：{(r.get('conclusion') or '（没有留话）')}")
    elif a.cmd == "lock":
        topic = _need("CHEESE_TOPIC", TOPIC)
        r = _call(
            "POST",
            f"/topics/{topic}/lock",
            {"kind": a.kind, "task_id": _task_id(a.task)},
        )["data"]
        if r.get("acquired"):
            print(f"占住了({a.kind} {a.resource or ''})".rstrip())
        else:
            print(f"没占到:{r.get('reason') or '别人占着'}")
            sys.exit(1)
    elif a.cmd == "unlock":
        topic = _need("CHEESE_TOPIC", TOPIC)
        r = _call(
            "POST",
            f"/topics/{topic}/unlock",
            {"kind": a.kind, "task_id": _task_id(a.task)},
        )["data"]
        print("已归还。" if r.get("released") else "你本来就没占着它。")
    elif a.cmd == "push-fix":
        topic = _need("CHEESE_TOPIC", TOPIC)
        task = _task_id(a.task)
        _sync_task(task)
        r = _call("POST", f"/topics/{topic}/tasks/{task}/push-fix")["data"]
        if r.get("pushed"):
            print(f"已推到 PR #{r['pr_number']}：{r.get('pr_url') or ''}")
        else:
            print(f"没有推送：{r.get('reason') or '没有可推的东西'}")
    elif a.cmd == "decision":
        _planned_call("cheese_decision", a)
        print("已记入决策记录。")
    elif a.cmd == "feedback":
        r = _planned_call("cheese_feedback_propose", a).get("data") or {}
        # 卡片由平台渲染,所以这里只说结果。不要再写一句「已提交反馈」——
        # 那是 SKILL.md 明令避免的旁白,卡本身就是那句话。
        print(f"已提案(卡 id {r.get('block_id')}),等人按「提交反馈」。")
    elif a.cmd == "title":
        r = _planned_call("cheese_title", a).get("data") or {}
        if a.task:
            # 房间给它的活起名字。走房间的地址,因为这一轮的 token 是按房间签的,
            # 直接拿活的 id 当地址会被判成跨话题(403)。
            print(f"这条活现在叫「{r['title']}」。")
        else:
            print(f"话题标题已设为：{a.text}")
    elif a.cmd == "library":
        project = _need("CHEESE_PROJECT", PROJECT)
        # 带上话题:沙箱 token 是为一轮、一个地方铸的,后端要凭它确认这个凭据属于谁。
        where = f"?topic={urllib.parse.quote(_need('CHEESE_TOPIC', TOPIC))}"
        if a.libcmd == "ls":
            rows = _call("GET", f"/projects/{project}/library{where}")["data"]["data"]
            if not rows:
                print("资料库里还没有文件")
            for row in rows:
                size = row.get("bytes") or 0
                shown = f"{size / 1024:.0f}K" if size >= 1024 else f"{size}B"
                print(f"{row['path']}\t{shown}")
        else:
            out = a.out or f"library/{a.name}"
            parent = os.path.dirname(out)
            if parent:
                os.makedirs(parent, exist_ok=True)
            _raw_request(
                "GET",
                f"/projects/{project}/library/raw{where}"
                f"&path={urllib.parse.quote(a.name)}",
                None,
                out=out,
            )
    elif a.cmd == "fetch":
        # 带上话题:沙箱 token 是带作用域的,后端要凭它确认这个凭据属于谁。
        # 不带的话每一次调用都会被判成 "Agent credential is invalid or expired"。
        # Long, because this is the one slow call: the platform tries a ladder
        # of strategies and the last rung renders the page in a real browser.
        # The platform bounds every rung, so this only has to outlast them.
        data = _planned_call("cheese_fetch", a, timeout=240).get("data", {})
        if not data.get("ok"):
            # 逐级说清楚怎么失败的。只说"读不到"的话,下次没人知道该改哪一级。
            print(f"[cheese] 读不到 {a.url}", file=sys.stderr)
            print(f"[cheese] 各级结果: {data.get('trail', '(无)')}", file=sys.stderr)
            if data.get("text"):
                print(
                    "[cheese] 抓到的残缺内容如下(可能是验证页/登录墙):", file=sys.stderr
                )
                print(data["text"][:2000])
            sys.exit(1)
        print(data.get("text", ""))
        via = data.get("rung", "?")
        note = "答案" if data.get("distilled") else "整页"
        print(f"\n[cheese] 来源: {via}({note})", file=sys.stderr)
    elif a.cmd == "remember":
        # 带上话题：后端据此认出是哪个芝士在记，存进它自己的项目记忆
        # (同一个项目里的两个芝士各记各的，跟人一样)。
        kind = "核心记忆（每轮都在场）" if a.core else "记忆"
        _planned_call("cheese_remember", a)
        if MEMORY_SCOPE == "personal" and OWNER:
            print(f"已记入个人{kind}。")
        else:
            print(f"已记入项目{kind}。")
    elif a.cmd == "recall":
        hits = (
            _planned_call("cheese_recall", a)
            .get("data", {})
            .get("hits", [])
        )
        if not hits:
            # 关键词检索没命中 ≠ 没有这条记忆。说清楚这一点,否则一次空结果就会被
            # 当成"确认不存在",然后一头撞上那条记忆本来要拦住的坑。
            print(
                "没有找到相关记忆。（关键词检索,不是语义检索：换个说法、"
                "或只用其中一两个关键词再试一次）"
            )
        for h in hits:
            print(f"- {h.get('abstract', '')}")
    elif a.cmd == "ask":
        topic = _need("CHEESE_TOPIC", TOPIC)
        opts = [o.strip() for o in a.option if o.strip()]
        if not 2 <= len(opts) <= 4:
            print("[cheese] ask 需要 2-4 个 --option", file=sys.stderr)
            sys.exit(2)
        _planned_call("cheese_ask", a)
        print(f"[cheese] 已发出选项问题（{len(opts)} 个选项）")

    elif a.cmd == "notify":
        _planned_call("cheese_notify", a)
        print(f"已发送通知给 {a.to or '所有人'}。")
    elif a.cmd == "ready":
        topic = _need("CHEESE_TOPIC", TOPIC)
        task = _task_id(a.task)
        r = _call("POST", f"/topics/{topic}/tasks/{task}/ready")["data"]
        if r.get("ready"):
            print(
                f"PR #{r['pr_number']} 已从 draft 翻成 ready：{r.get('pr_url') or ''}"
            )
        else:
            print(r.get("reason") or "没有可以翻的 PR。")
    elif a.cmd == "describe":
        topic = _need("CHEESE_TOPIC", TOPIC)
        if a.subject is None and a.body is None:
            print("[cheese] describe 至少要给 --subject 或 --body", file=sys.stderr)
            sys.exit(2)
        body = {}
        if a.subject is not None:
            body["change_subject"] = a.subject
        if a.body is not None:
            body["change_body"] = a.body
        task = _task_id(a.task)
        r = _call("POST", f"/topics/{topic}/tasks/{task}/accept-card/describe", body)[
            "data"
        ]
        print(
            f"验收卡的描述已更正（PR 正文同步改掉了）。现在的标题："
            f"{r.get('change_subject') or '（空）'}"
        )
    elif a.cmd == "accept-request":
        topic = _need("CHEESE_TOPIC", TOPIC)
        payload = {
            "routing_reason": a.reason,
            "change_subject": a.subject,
            "change_body": a.body,
        }
        # 不写验收人 = 用项目默认验收人。**不要**在这里塞一个空串:后端把
        # 「没说」和「说了空的」当同一件事处理会掩盖真正的空输入,而它给的
        # 那句打回文案正是这条命令唯一能帮上忙的地方。
        if a.reviewer:
            payload["reviewer_handle"] = a.reviewer
        task = _task_id(a.task)
        _sync_task(task)
        r = _call("POST", f"/topics/{topic}/tasks/{task}/accept-card", payload)["data"]
        print(f"已把验收卡递给 {r.get('reviewer_handle') or a.reviewer}。")
    elif a.cmd == "tell":
        # URL 里的 topic 是**发方**（per-turn token 按它校验作用域）；收方在 body 里，
        # 由后端校验它确实是这个房间派出的活。
        data = _planned_call("cheese_tell", a).get("data", {})
        where = data.get("target_title") or data.get("target_topic_id") or a.target
        print(
            f"已写在「{where}」上。**没有人被叫醒**——做这条活的分身在你自己的"
            "会话里，要它动就直接给它发消息。"
        )
    elif a.cmd == "milestone":
        _planned_call("cheese_milestone", a)
        print(f"已钉里程碑：{a.title}")
    elif a.cmd == "gh-token":
        # Same API surface as every other platform endpoint.
        # stdout carries ONLY the token so `GH_TOKEN=$(cheese gh-token)` works;
        # the expiry note goes to stderr.
        plan = request_plan("cheese_gh_token", vars(a))
        req = urllib.request.Request(f"{_api_root()}{plan['path']}")
        if TOKEN:
            req.add_header("X-Cheese-Token", TOKEN)
        try:
            with urllib.request.urlopen(req, timeout=20) as r:
                data = json.load(r).get("data", {})
        except urllib.error.HTTPError as e:
            detail = e.read().decode(errors="replace")[:300]
            print(f"[cheese] gh-token 失败 HTTP {e.code}: {detail}", file=sys.stderr)
            sys.exit(1)
        print(data.get("token", ""))
        # stderr, not stdout: `GH_TOKEN=$(cheese gh-token)` must keep working.
        # The repo name rides along because without it the token is useless —
        # `gh api repos/:owner/:repo/...` needs a name the workspace (not a
        # checkout of the repo) can't supply.
        repo = data.get("repo") or "<owner>/<repo>"
        # The permission line comes from the payload, never from a literal
        # here: what the token carries depends on what the GitHub App was
        # granted, and a hardcoded list went stale the moment that changed —
        # which is how agents ended up believing they couldn't read an issue
        # that the token could in fact read.
        perms = data.get("permissions") or "(权限未知)"
        lines = [
            f"[cheese] {perms}, 仓库 {repo}, 过期 {data.get('expires_at', '?')}",
            "[cheese] 看 CI: export GH_TOKEN=$(cheese gh-token) 然后",
            f"[cheese]   gh api repos/{repo}/commits/<sha>/check-runs  # 哪些检查挂了",
            f"[cheese]   gh api repos/{repo}/actions/jobs/<job_id>/logs  # 完整日志",
            "[cheese]   (<job_id> = check-run 的 html_url 里 /job/ 后面那串数字)",
        ]
        # Only advertise what this token can actually do. Printing the issue
        # recipe when `issues` was not granted just buys a 403 and a wasted turn.
        if "issues" in perms:
            lines.append(
                "[cheese] 读 issue 正文/评论(不用找人贴): "
                f"gh api repos/{repo}/issues/<n>  和  .../issues/<n>/comments"
            )
        if "pull_requests" in perms:
            lines.append(
                f"[cheese] 读 PR 正文/评审意见: gh api repos/{repo}/pulls/<n>  和  "
                f".../pulls/<n>/comments"
            )
        if "contents" in perms:
            lines.append(
                "[cheese] 读工作区以外的仓库文件: "
                f"gh api repos/{repo}/contents/<path>?ref=<branch>"
            )
        lines.append(
            "[cheese] 任务交付：在任务目录提交后 cheese sync；"
            "已有 PR 用 cheese push-fix，平台沿用该任务的 PR。"
        )
        print("\n".join(lines), file=sys.stderr)
    elif a.cmd == "members":
        d = _planned_call("cheese_members", a).get("data", {})
        rows = d.get("data", d) if isinstance(d, dict) else d
        for m in rows:
            h = m.get("member_handle")
            print(f"- {m.get('name')}（{m.get('role')}）→ 在消息里写 <@{h}> 点名 ta")
    elif a.cmd == "status":
        d = _planned_call("cheese_status", a).get("data") or {}
        print(_format_status(d))
    elif a.cmd == "serve":
        topic = _need("CHEESE_TOPIC", TOPIC)
        if not (1 <= a.port <= 65535):
            print(f"[cheese] {a.port} 不是一个端口号。", file=sys.stderr)
            sys.exit(2)
        up = os.environ.get("CHEESE_PREVIEW_UP", "")
        if not up:
            # No preview channel in this runtime — the launcher exports this only
            # when it has shipped the helper. A running app cannot reach the
            # panel from here, so say so instead of filing a record that would
            # render as a white frame.
            print(
                "[cheese] 这个运行环境没有预览通道,运行中的应用到不了预览面板。\n"
                "[cheese] 要给人看结果,用 cheese_artifact 点名一个文件——网页、图片,"
                "或报告、表格这类文档。",
                file=sys.stderr,
            )
            sys.exit(2)
        # Declare the port and bring the tunnel up in one step. The port is
        # written on THIS machine and read from disk by the helper — it never
        # travels on the wire, which is what keeps the platform unable to point
        # a machine at any other port.
        rc = subprocess.call(["sh", up, str(a.port)])
        if rc != 0:
            print(f"[cheese] 预览通道没能起来（{up} 退出码 {rc}）。", file=sys.stderr)
            sys.exit(1)
        # The backend knocks on the port through the tunnel before accepting; a
        # dead server is refused there, with the reason.
        _call("POST", f"/topics/{topic}/artifact", {"path": a.note, "as": "app"})
        print(f"已把 :{a.port} 上的应用设为当前预览（{a.note}）。")
    elif a.cmd == "artifact":
        topic = _need("CHEESE_TOPIC", TOPIC)
        # The platform resolves artifact paths against the worktree ROOT (/work),
        # but the agent's cwd may be a subdir (e.g. after `cd backend`). Normalize
        # the given path to worktree-root-relative so `cheese artifact x.html` from
        # /work/backend points at backend/x.html, not a missing /work/x.html.
        root = os.environ.get("CHEESE_WORKTREE_ROOT", "/work")
        rel = os.path.relpath(os.path.abspath(a.path), root)
        if rel.startswith(".."):  # outside the worktree — let the backend validate
            rel = a.path
        kind = a.as_ or artifact_kind_for(a.path)
        try:
            raw = open(a.path, "rb").read()
        except OSError as exc:
            print(f"[cheese] 无法读取 {a.path}: {exc}", file=sys.stderr)
            sys.exit(1)
        # Read as bytes either way — a .docx is a zip, and decoding it as text
        # used to fail the command outright. Text kinds still travel as text so
        # the request stays readable and this stays compatible with what the
        # backend already accepted.
        if kind in BINARY_ARTIFACT_KINDS:
            payload = {"content_b64": base64.b64encode(raw).decode("ascii")}
        else:
            try:
                payload = {"content": raw.decode("utf-8")}
            except UnicodeError as exc:
                print(f"[cheese] {a.path} 不是文本文件: {exc}", file=sys.stderr)
                sys.exit(1)
        _call("POST", f"/topics/{topic}/artifact", {"path": rel, "as": kind, **payload})
        print(f"已把 {rel} 设为当前预览（{kind}）。")
    elif a.cmd == "convert":
        topic = _need("CHEESE_TOPIC", TOPIC)
        try:
            raw = open(a.path, "rb").read()
        except OSError as exc:
            print(f"[cheese] 无法读取 {a.path}: {exc}", file=sys.stderr)
            sys.exit(1)
        root = os.environ.get("CHEESE_WORKTREE_ROOT", "/work")
        rel = os.path.relpath(os.path.abspath(a.path), root)
        if rel.startswith(".."):
            rel = a.path
        res = _call(
            "POST",
            f"/topics/{topic}/documents/convert",
            {
                "path": rel,
                "to": a.to,
                "content_b64": base64.b64encode(raw).decode("ascii"),
            },
            timeout=150,
        )
        data = res.get("data") or {}
        # The platform names the converted file by swapping the extension; a
        # local -o wins, and the fallback keeps the original beside it rather
        # than writing over the user's file.
        suggested = data.get("path") or f"{a.path}.{a.to}"
        out = a.output or os.path.basename(suggested)
        try:
            with open(out, "wb") as f:
                f.write(base64.b64decode(data.get("content_b64") or ""))
        except OSError as exc:
            print(f"[cheese] 无法写入 {out}: {exc}", file=sys.stderr)
            sys.exit(1)
        print(f"已把 {a.path} 转成 {out}。原文件没有改动。")
        if a.path.lower().endswith((".doc", ".ppt", ".xls")):
            print(
                "这是一次格式升级——转出来的文件和原件不是同一个东西。"
                "改完要告诉用户这件事，让他决定往后发哪一份。"
            )
    elif a.cmd == "recalc":
        topic = _need("CHEESE_TOPIC", TOPIC)
        try:
            raw = open(a.path, "rb").read()
        except OSError as exc:
            print(f"[cheese] 无法读取 {a.path}: {exc}", file=sys.stderr)
            sys.exit(1)
        # The platform resolves paths against the worktree ROOT, and the agent's
        # cwd may be a subdir — same normalization as `artifact`, for the same
        # reason: an absolute path is refused outright there.
        root = os.environ.get("CHEESE_WORKTREE_ROOT", "/work")
        rel = os.path.relpath(os.path.abspath(a.path), root)
        if rel.startswith(".."):  # outside the worktree — let the backend judge
            rel = a.path
        # Recalculation loads the whole workbook, so give it more than the
        # default 20s: a sheet with a few thousand formulas is ordinary.
        res = _call(
            "POST",
            f"/topics/{topic}/documents/recalc",
            {
                "path": rel,
                "content_b64": base64.b64encode(raw).decode("ascii"),
            },
            timeout=150,
        )
        data = res.get("data") or {}
        out = a.output or a.path
        try:
            with open(out, "wb") as f:
                f.write(base64.b64decode(data.get("content_b64") or ""))
        except OSError as exc:
            print(f"[cheese] 无法写入 {out}: {exc}", file=sys.stderr)
            sys.exit(1)
        bad = data.get("errors") or []
        print(f"已重算 {a.path}，写出 {out}。")
        if not bad:
            print("没有算不出来的格。")
        else:
            print(f"有 {len(bad)} 个格算不出来，交付前要处理掉：")
            for cell in bad[:20]:
                print(f"  {cell.get('address')}  {cell.get('value')}")
            if len(bad) > 20:
                print(f"  …… 还有 {len(bad) - 20} 个")
            sys.exit(1)
    elif a.cmd == "api":
        if not a.method:
            _print_api_index()
            return
        if not a.path:
            print(
                "[cheese] api 需要一个路径,如 cheese api GET /topics/<id>/blocks",
                file=sys.stderr,
            )
            sys.exit(2)
        if a.data is not None:
            try:
                json.loads(a.data)  # fail fast on malformed JSON
            except ValueError as e:
                print(f"[cheese] --data 不是合法 JSON: {e}", file=sys.stderr)
                sys.exit(2)
        _raw_request(a.method, a.path, a.data, a.output)


if __name__ == "__main__":
    main()
