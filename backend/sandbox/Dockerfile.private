FROM mirror.gcr.io/library/node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 bash ca-certificates ripgrep \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g @anthropic-ai/claude-code@2.1.265 \
    && npm cache clean --force \
    && rm -rf /tmp && ln -s /work/.tmp /tmp
COPY backend/app/domain/agent/harness/claude_code/remote_execution/runtime.py /opt/cheese/runtime.py
COPY backend/app/domain/agent/harness/claude_code/remote_execution/private.py /opt/cheese/private.py
COPY --chmod=0555 backend/sandbox/cheese /usr/local/bin/cheese
ENV HOME=/work/.home TMPDIR=/work/.tmp PYTHONDONTWRITEBYTECODE=1
USER 1000:1000
WORKDIR /work
CMD ["python3", "/opt/cheese/private.py"]
