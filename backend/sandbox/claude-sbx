#!/bin/sh
# SDK cli_path shim: the Claude Agent SDK spawns this and talks stream-json over
# stdio; we pipe that into `claude` running INSIDE a LONG-LIVED per-topic sandbox
# container (one container per topic, reused across turns — faster than a fresh
# `docker run` each turn, and closer to "每话题一个 VM"). The SDK keeps streaming
# + session management; the agent (and its native Bash/Read/Write/Edit) runs
# jailed in the container.
#
# Per-turn env (set by AgentService):
#   SBX_CONTAINER  deterministic container name for this topic
#   SBX_WORKTREE   host path of the topic's git worktree → mounted at /work
#   SBX_SESSION    host path of the topic's persistent ~/.claude → session/--resume
#   ANTHROPIC_BASE_URL / ANTHROPIC_AUTH_TOKEN  → GLM gateway
#   CHEESE_API / CHEESE_PROJECT / CHEESE_TOPIC / CHEESE_AUTHOR / CHEESE_TOKEN → cheese CLI
SBX_IMAGE="${SBX_IMAGE:-cheesex-agent-sandbox:latest}"
NAME="${SBX_CONTAINER:?SBX_CONTAINER not set}"

# Ensure the topic's container exists and is running. Mounts are fixed at creation
# (the worktree + session dirs are stable per topic); it idles on `sleep infinity`.
if ! docker inspect "$NAME" >/dev/null 2>&1; then
  docker run -d --name "$NAME" --user node \
    -e HOME=/home/node \
    --add-host host.docker.internal:host-gateway \
    -v "${SBX_SESSION}":/home/node/.claude \
    -v "${SBX_WORKTREE}":/work -w /work \
    --network bridge \
    --memory 2g --cpus 2 --pids-limit 512 \
    --label cheesex-sandbox=1 \
    "$SBX_IMAGE" sleep infinity >/dev/null
elif [ "$(docker inspect -f '{{.State.Running}}' "$NAME" 2>/dev/null)" != "true" ]; then
  docker start "$NAME" >/dev/null
fi

# Per-turn env is passed on the exec (it can vary turn to turn, e.g. token rotation).
exec docker exec -i \
  -e ANTHROPIC_BASE_URL -e ANTHROPIC_AUTH_TOKEN \
  -e CHEESE_API -e CHEESE_PROJECT -e CHEESE_TOPIC -e CHEESE_AUTHOR -e CHEESE_TOKEN \
  "$NAME" claude "$@"
