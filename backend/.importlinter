[importlinter:contract:domains-acyclic]
# C3 — no cycles among sibling domains under app.domain.
#
# This is the one contract whose violations cannot be paid off one at a time:
# breaking a cycle means removing a dependency, and the frozen list below is the
# minimum feedback set — the edges whose removal makes the graph acyclic. It is
# also the most honest number in this file: it is what "untying the knot"
# actually costs. Expect it to shrink slowly, one real inversion at a time.
name = C3 sibling domains under app.domain are acyclic
type = acyclic_siblings
ancestors =
    app.domain
unmatched_ignore_imports_alerting = warn

# `app.domain.membership.services -> app.domain.delivery.*`: a project invitation
# is told to the invitee through the delivery ledger, the one way a notification
# leaves (I11) — the same two edges `team.membership_services` already has for
# team invitations.
#
# 下面多一条 `app.domain.review.nudges -> app.domain.agent.platform_notices`：三条
# 待发（CI 挂了、有人评审、和目标分支冲突）搬去 `review/nudges.py` 时，它们写的
# `EVENT_*` 常量跟着搬了，review -> agent.platform_notices 这条边换了导入方。
# services 那条仍在（它自己还发别的通知）——同一份债挪了地方，不是新欠的。
#
# 同理，第二片 `app.domain.review/room_notices.py`（一件事做完之后怎么说出去）
# 带走两条边：`review -> agent.announce` 换了导入方（services 那句 `announce(...)`
# 全在这一片里，所以 services 那条**随之消失**，不是被还掉），
# `review -> agent.platform_notices` 又多一个导入方（room_notices 自己写
# `EVENT_*` 与 `notice()`，services 那条仍在）。两条都是同一份债挪了地方。
#
# 再到 `app.domain.room_task.naming -> app.domain.agent.staleness`：房间改名之后
# 要告诉这个房间「侧栏里你那一行变了」的 `announce_stale`，原本住在
# `agent/runtime.py`。那个文件压在自己的行数上限上（只许变短），而目标架构本来就要
# 把发帧这件事拆出 runtime，所以它搬去了 `agent/staleness.py`；naming 那条函数内
# 导入还在原地，只是取的名字换了模块。同一份债挪了地方，C3 的条数当时没有变。
# --- frozen: existing violations, generated by scripts/boundary_baseline.py
# Refresh with `--update` (drops entries that no longer match; new ones need `--freeze-new`).
