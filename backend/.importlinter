# Module boundaries for backend/app, checked by import-linter.
#
# WHY THIS FILE EXISTS. Every rule below was already true of this codebase in
# prose — the layering, "routes go through services", "domains do not import
# each other in a cycle" — and none of it was held by anything that could fail.
# A boundary that only a reviewer remembers is followed until the first Tuesday
# somebody is in a hurry. Three hand-written guards already cover parts of this
# (see `tests/unit/test_domain_import_guard.py` for the repositories half); this
# file states the whole shape once, in the tool that reads the import graph.
#
# RUN IT
#     cd backend && uv run lint-imports          the ten contracts on their own,
#                                                exit 0/1. This file writes no
#                                                exemptions, so this is the raw
#                                                graph, not the verdict — every
#                                                debt the baseline holds open is
#                                                reported here too.
#     cd backend && uv run python scripts/check_boundaries.py
#                                                the verdict, exit 0/1/2 where
#                                                2 = could not judge
#     cd backend && uv run python scripts/check_boundaries.py --self-test
#                                                prove the check still fires
#     cd backend && uv run python scripts/check_boundaries.py --measure
#                                                print the baseline this tree
#                                                implies, as JSON
#
# THE BASELINE. These contracts did not pass on the tree they were written for
# and were never going to: the layering was held by 26 upward imports that exist
# *because* they dodge a cycle, the routes imported 56 model modules directly,
# and the knot under `app.domain` would have taken 178 dependency removals to
# untie (today's counts are in `docs/manual/dev/arch-metrics.md`). Turning the
# contracts on with no exceptions would have meant either a month of unfunded
# refactoring before anyone could merge, or a check switched off on day one.
#
# So the check grades two trees with these same contracts: this one, and the one
# at the merge base. Every violation the *other* tree has is one this tree may
# keep, and a violation only this tree has is the whole verdict. The baseline is
# therefore measured on every run and stored nowhere — no pull request has to
# carry a list of exemptions, and none of them can go stale. The prose below
# each contract still records what was paid down and when; the git log has the
# rest.
#
# WHAT AN `ignore_imports` LINE MEANS HERE. Not the baseline — an exception:
# a violation this tree knows about, accepts, and says why about, which the
# merge-base tree does not have. It is meant to be rare and short. Nothing here
# is a wildcard — a blanket exemption cannot be written into this format, which
# is the point. An exception that stops matching anything is a warning, never a
# failure, because paying a debt down must not go red; the measured half simply
# stops being in the baseline.
#
# STRUCTURE. Prose about a contract goes directly under its
# `[importlinter:contract:...]` header, above the first option. Notes about what
# a contract cost and what has already been paid down may also follow the
# options, where they are history and not settings.
#
# WHAT THESE CONTRACTS DO NOT DO. They are not a refactoring plan and their pass
# rate is not a measure of how coupled the tree is. Removing a violation by
# moving a dependency from the repository layer to the service layer changes the
# package graph by exactly zero edges — measured, in
# `docs/topics/领域包解环.md`. Breaking a cycle takes removing the dependency,
# not relocating it.

[importlinter]
root_package = app
# Third-party imports are not part of this graph; the boundaries below are all
# internal and an external edge can never violate one.
include_external_packages = False

[importlinter:contract:api-domain-core]
# C1 — the layer stack, highest first. A module may import downward (api may
# import domain, domain may import core) and never upward. This is the one
# direction every other rule here assumes.
#
# No upward imports are exempted here any more, which is the whole point of the
# ratchet. What was paid down last is recorded in the git log; the three that
# were exempted on 2026-10-12 were `core/errors.py` reading
# the device failures (now owned by `core/device_failures.py`),
# `platform_stats.services` calling the health route (the judging moved to
# `core/health.py`), and `review.pr_poll` importing `api.deps` for the work
# runner (now reached through the chat service the composition root built).
# Periodic jobs are explicitly registered by their owning domains and assembled
# in `app/periodic_jobs.py`, so `core/background.py` no longer imports the jobs
# it runs.
name = C1 layers: api -> domain -> core, no imports upward
type = layers
layers =
    app.api
    app.domain
    app.core
# An exception that stops matching (because the import was removed) is a
# warning. Paying this debt down must not turn the tree red.
unmatched_ignore_imports_alerting = warn

[importlinter:contract:routes-touch-no-models]
# C2 — a route handler must not read another domain's model modules directly.
# It has a session and an ORM in reach, so it can; the constraint it skips is
# the domain's own service layer (who may read this row, what else has to be
# written with it, what notification goes out).
#
# `app.api.deps` is a source too: it is where routes get their session and it is
# not part of any domain, so every model it imports is cross-domain by
# construction.
#
# DIRECT IMPORTS ONLY, deliberately. The transitive form of this contract
# ("routes can reach no model through any chain") is the stricter reading and
# was measured at 713 edges, most of them `app.domain.a -> app.domain.b`
# model edges that the project tolerates on purpose: ORM relationships need
# them, and `test_domain_import_guard.py` already ratified that stance for the
# repository half. Quoting a number nobody can pay down would make the contract
# unreadable and unownable. The reachability question is real; it is
# asked by `test_domain_import_guard.py` for repositories, where it is cheap.
#
# The repositories half of that rule is NOT repeated here. The existing guard
# already covers `(app.domain | app.api.routes) -> any domain's repositories`
# with a 151-entry ratchet, direct, at the same granularity — a second copy would
# be two places to keep in step, and one of them would go stale. What is new here
# is the `models` half (56 edges, previously unguarded) and `app.api.deps`, which
# is in neither of that guard's scanned trees.
#
# The route-shared dependency modules under `app/api/` are sources for the same
# reason as `app.api.deps`: they belong to no domain, so every model they import
# is cross-domain by construction. Until the 2026-10 move they sat under
# `app.api.routes` and C2 covered them by accident; naming them keeps that
# coverage after the move — 搬出路由不等于掉出管辖. Named one by one rather than
# sweeping in `app.api`: the rest of that package has direct model imports of its
# own, and pulling them in would grandfather every one of them without anybody
# looking at it. Keep this list in step with `test_domain_import_guard.py`'s
# `_SCANNED_MODULES`, which covers the repositories half of the same set.
#
# The 2026-10 round two moved the route-to-route shared names. The five entries
# after `topics_deps` are what it added: `awaiting_deps`, `legal_deps` and
# `teams_deps` are new homes for names one route module used to hand to its
# siblings (`waiting_items`; `client_context`; the team service and the
# application payload helpers), `topics_file_sources` left `routes/` whole, and
# `ws_pipe` is new, holding the tunnel's two pumps. Same rule as the six above:
# a module one route shares with another stays a source after the name moves.
#
# The 2026-10 round three — the one that took the last line out of C4 — moved the names
# still shared *through* an `app.api` helper. The five entries after `ws_pipe`
# are what it added: `topic_member_rows`, `topic_pin_rows`, `review_comment_rows`
# and `project_skill_rows` are new homes for the row builders `room_snapshot`
# used to reach back into their routes for (`roster_rows`, `pin_rows`,
# `review_comment_rows`, and the `_iso`/`_skill` pair), and `preview_relay` holds
# the browser end of a preview's tunnel and the hub both ends speak to, which
# `routes/app_preview.py` kept for the machine's end. Same rule once more: a
# module one route shares with another stays a source after the name moves.
# `app.api.doc_access` and `app.api.room_task_rows` are not here on purpose:
# both were created under `app/api/` before this refactor and are ordinary
# members of that package, not routes that moved out of it.
name = C2 routes do not import a domain's models directly
type = forbidden
source_modules =
    app.api.routes
    app.api.deps
    app.api.admin_deps
    app.api.users_deps
    app.api.space_deps
    app.api.space_payloads
    app.api.task_deps
    app.api.topics_deps
    app.api.awaiting_deps
    app.api.legal_deps
    app.api.teams_deps
    app.api.topics_file_sources
    app.api.ws_pipe
    app.api.preview_relay
    app.api.project_skill_rows
    app.api.review_comment_rows
    app.api.topic_member_rows
    app.api.topic_pin_rows
forbidden_modules =
    app.domain.*.models
allow_indirect_imports = true
unmatched_ignore_imports_alerting = warn

# Eighth topics_* slice: `topics_tasks.py` (a room's threads -- list, open,
# messages, title, close). `say_on_task` is the only reader of
# `app.domain.notification.models` in topics.py (a local import, where the
# delivery notice is built), so that edge follows the code: it leaves
# `app.api.routes.topics` for `app.api.routes.topics_tasks`.
# The same debt with a new importer, not new debt -- the shape #2196 took for
# `app.domain.review`. Nothing else moved, no pair was added, and no contract
# grew.
#
# Third projects_* slice: `projects_agents.py` (a project's roster of agents, one
# agent's name/configuration, and which of them a new room starts with). The
# `row: AgentInstance` annotation in `_holds_the_default` was the only reader of
# `app.domain.agent_instance.models` in projects.py, so that edge follows the
# code: it leaves `app.api.routes.projects` for
# `app.api.routes.projects_agents`. The same debt with a new importer, not new
# debt -- one pair moved, none was added.
#
# Ninth topics_* slice, and the one that closes C4 for `routes/topics.py`:
# `app/api/topics_deps.py` (the room's front door `_actor_in_place`, the ISO
# moment parser `_parse_moment`, and the six domain names topics.py used to
# forward to its siblings). `Block` / `BlockKind` are the only
# `app.domain.block.models` readers there, so one edge
# arrives under the new source -- 同一笔债换了发起方，不是新债. `routes/topics.py`
# still reads those models directly itself, so its own two pairs are still live.
# Nothing was paid off here; what changed is that the debt now has one importer
# instead of fifteen.
#

[importlinter:contract:domains-acyclic]
# C3 — no cycles among sibling domains under app.domain.
#
# This is the one contract whose violations cannot be paid off one at a time:
# breaking a cycle means removing a dependency, and the baseline's edges are its
# minimum feedback set — the ones whose removal makes the graph acyclic. It is
# also the most honest number this check produces: it is what "untying the knot"
# actually costs. Expect it to shrink slowly, one real inversion at a time.
name = C3 sibling domains under app.domain are acyclic
type = acyclic_siblings
ancestors =
    app.domain
unmatched_ignore_imports_alerting = warn

# **2026-10-15 拆包**：`app/domain/topic/repositories.py` 变成一个包（照 #3856 对
# `app.domain.feedback.services` 的做法）。读 project 的地址 / 环境 / 模型本来就写在
# 这一个文件里，合并进仓库的树记的是 `app.domain.topic.repositories`，而那个模块路径
# 现在归包的 `__init__`，它自己不读这些，所以旧的三条配对再也不会匹配；一个文件分成
# 几个，配对从三条变成四条。**2026-10-16**：这里曾为此手写四条豁免，现在
# `check_boundaries.py` 自己认得这种改名——某个模块在基线树里是一个文件、在本树里是
# 个包时，落在该包子模块上的配对按 `M -> Y` 认成 `M.<submod> -> Y`——四条一起删掉。

# `app.domain.membership.services -> app.domain.delivery.*`: a project invitation
# is told to the invitee through the delivery ledger, the one way a notification
# leaves (I11) — the same two edges `team.membership_services` already has for
# team invitations.
#
# `app.domain.review.nudges -> app.domain.agent.platform_notices`：三条待发（CI 挂
# 了、有人评审、和目标分支冲突）搬去 `review/nudges.py` 时，它们写的 `EVENT_*` 常量
# 跟着搬了，这条边换了导入方。services 那条仍在（它自己还发别的通知）——同一份债挪
# 了地方，不是新欠的。**2026-10-13**：码表下沉到第 1 层的 `notice_meta` 之后，这批
# 边都不在了（nudges、room_notices、services._shared 各一条）。
#
# 同理，第二片 `app.domain.review/room_notices.py`（一件事做完之后怎么说出去）
# 带走两条边：`review -> agent.announce` 换了导入方（services 那句 `announce(...)`
# 全在这一片里，所以 services 那条**随之消失**，不是被还掉），
# `review -> agent.platform_notices` 又多一个导入方（room_notices 自己写
# `EVENT_*` 与 `notice()`）。两条都是同一份债挪了地方；`platform_notices` 那条在
# 2026-10-13 随码表下沉消失，只剩 `review -> agent.announce`。
#
# 再到 `app.domain.room_task.naming -> app.domain.agent.staleness`：房间改名之后
# 要告诉这个房间「侧栏里你那一行变了」的 `announce_stale`，原本住在
# `agent/runtime.py`。那个文件压在自己的行数上限上（只许变短），而目标架构本来就要
# 把发帧这件事拆出 runtime，所以它搬去了 `agent/staleness.py`；naming 那条函数内
# 导入还在原地，只是取的名字换了模块。同一份债挪了地方，C3 的条数当时没有变。
#
# 2026-10-12 补入口文件：questions、answers、discussion、knowledge 四个包原来没有
# `__init__.py`，是命名空间包，import-linter 和依赖图都看不见它们，C3 没在守。补上
# 之后它们进了图：最大的环从 40 个包变成 44 个，包间依赖 403 条变成 421 条，要多冻结
# 23 条（C2 另多 2 条，是 answers、questions 两个路由读 discussion.models）。这些都
# 是早已存在的依赖，只是现在才看得见；冻结的是契约在补入口文件后重新提名的切口，
# 其中十来条落在老包之间，因为新的环要从环上任意一处切开。
#
# 2026-10-18 拆 `agent_instance -> agent`：这两包互相读，`agent_instance.configuration`
# 读 `agent` 的网关报价、订阅名单、供给策略和骨架，`agent.queries` / `gateway_usage` /
# `document.question` 又反过来读它；C3 提名的 27 条里，这四条是最便宜的一刀。
# 模型目录（「这个项目能用哪些模型」）整块搬进 `agent.model_catalog`——它答的是部署和
# 项目的事实，不是某个队友存下来的配置——`agent_instance` 只留 `AgentConfiguration`
# 这个形状，唯一要用目录的地方（建/改队友时校验模型）由调用方把 `model_choices` 递
# 进来。拆完 `--measure` 从 27 条降到 14 条。注意：基线是从 merge base 量的，主干树
# 里这四条边还在，把它们加回来检查不会红，所以由
# `tests/unit/test_agent_instance_does_not_read_the_agent_package.py` 钉住。

[importlinter:contract:turn-layers]
# T1 — every turn module belongs to one of these four layers.
name = T1 turn layers: intake -> steps -> store -> state
type = layers
containers = app.domain.agent.turn
layers =
    intake
    steps
    store
    state
exhaustive = true
# A measured baseline can stop matching a pair this tree paid down; that is a
# warning, never a red, exactly as for the C contracts below.
unmatched_ignore_imports_alerting = warn

[importlinter:contract:turn-no-composition-imports]
# T2 deliberately checks direct imports; intake can assemble cross-domain facts.
name = T2 turn code does not import its composition roots directly
type = forbidden
source_modules = app.domain.agent.turn
forbidden_modules =
    app.domain.agent.chat
    app.domain.agent.runtime
    app.api
allow_indirect_imports = true
unmatched_ignore_imports_alerting = warn

[importlinter:contract:realtime-no-turn]
# T3 checks the full reachable graph, not just imports in broker.py.
name = T3 realtime cannot reach turn execution or composition
type = forbidden
source_modules = app.domain.agent.realtime
forbidden_modules =
    app.domain.agent.turn
    app.domain.agent.chat
    app.domain.agent.runtime
    app.api
allow_indirect_imports = false
unmatched_ignore_imports_alerting = warn

[importlinter:contract:turn-storage-purity]
# T4 also checks transitively: a repository cannot smuggle in a publisher.
name = T4 turn storage and state cannot reach upper layers or realtime
type = forbidden
source_modules =
    app.domain.agent.turn.store
    app.domain.agent.turn.state
forbidden_modules =
    app.domain.agent.turn.intake
    app.domain.agent.turn.steps
    app.domain.agent.realtime
    app.domain.agent.chat
    app.domain.agent.runtime
    app.api
allow_indirect_imports = false
unmatched_ignore_imports_alerting = warn

[importlinter:contract:routes-independent]
# C4 — a route module does not import another route module, directly or through
# a helper. What two routes share lives in a dependency module under `app.api`
# (`request_deps` for the session and the signed-in user) or in the domain's
# service layer, never in a sibling route: a route that is another route's
# dependency cannot be moved, split or renamed without breaking its importers,
# which is how a two-symbol move once turned twenty checks red.
#
# `independence` reads the whole graph, so a chain `routes.a -> app.api.x ->
# routes.b` is a violation too; a helper that re-exports a route is not a way
# round. No exception is written here, and none is needed: the merge-base tree
# has no route-to-route path either, so every chain in this tree is one this
# tree added. The helper-to-route edges (`room_snapshot -> routes.*`) are not
# excepted either, so a new route importing such a helper is reported.
name = C4 route modules are independent of one another
type = independence
modules =
    app.api.routes.*
unmatched_ignore_imports_alerting = warn

# First turn: sixteen lines at once, and every one of them touched
# `routes/topics.py`: the module that incidentally served as the topics
# package's shared-dependency module. They went away by moving what it actually
# shared into `app/api/topics_deps.py` — the thirteen route modules that took a
# helper or a domain name from it, the two `app.api` modules that did the same
# (`task_instructions`, `task_origin`), and its own import of a sibling route
# (`routes.projects`, for `rail_tasks`, now in `app.api.room_task_rows`). The
# list went 32 -> 16. Of the seventeen edges in or out of this node,
# `routes.topics -> routes.topics_rows` was already gone — #3545 moved that file
# to `app/api/topics_rows.py`.
#
# Second turn: the eleven route-to-route lines, each a name one route module
# handed a sibling — `client_context`, the origin gate, `asked_of`, the tunnel's
# two pumps, `task_out`, the attachment bytes, `waiting_items`, the team service
# and the application payload helpers. Each moved into a module under `app.api`
# named for what it serves (`legal_deps`, `users_deps`, `doc_access`, `ws_pipe`,
# `room_task_rows`, `topics_file_sources`, `awaiting_deps`, `teams_deps`), never
# into a sibling route: the list went 16 -> 5. Three of the five are chains
# through an `app.api` helper (`chat -> room_snapshot`,
# `preview_sessions -> preview_host`, `topics_preview -> preview_host`); the two
# `app.main -> ...` lines are not route edges at all, removing them does not
# turn the contract red, and they stayed in the list because they still matched
# an import somewhere — they needed a later turn of the same hand.
#
# Third turn, and the last: those three chains and the two inert lines. The
# chains were the seven names the room snapshot and the preview-host middleware
# were reaching through — `roster_rows`, `pin_rows`, `proposals_in_room` (with
# the row shape `_skill` it is built from), `review_comment_rows`,
# `room_task_items`, `task_page_row` and `_opening`, `related_of` — and both of
# those askers are `app.api` modules, not routes. Each name moved to the
# `app.api` module named for the rows it makes (`topic_member_rows`,
# `topic_pin_rows`, `project_skill_rows`, `review_comment_rows`,
# `room_task_rows`, `task_origin`), as did the browser's end of the preview
# tunnel (`relay_http`, `relay_ws`, `connection_hub` and what they carry, to
# `preview_relay`), leaving `routes/app_preview.py` the machine's end alone. The
# list went 5 -> 0, and it is empty on purpose: with no route-to-route path
# left, the two `app.main -> ...` lines — never route edges, kept only because
# they still matched an import somewhere in the graph — came off by hand with
# the rest. A new chain is now reported the moment it appears.

[importlinter:contract:domain-layers]
# C5 — the seven layers of `app.domain`, highest first. A package may import
# downward and never upward. The packages on one line are one layer and may
# import each other (`:`, the layers contract's non-independent form): the
# architecture doc's 「同层兄弟用 `:` 连接」, which is what keeps the middle of
# the table a table instead of another set of mutually forbidden modules. The
# siblings still have to be acyclic — that is C3, and this contract does not
# repeat it.
#
# `exhaustive = true` is the point of writing the table down: every child of
# `app.domain` is named here, packages and top-level modules alike, so a new
# one of either is red until somebody says which layer it belongs to. An
# unplaced child is not a small hole in the rule — this contract reads the
# whole graph, so a module nobody placed sits between the layers as a channel,
# hiding an upward import that goes through it, or reporting a chain that
# exists only because the hole did.
#
# The 64 upward package edges measured under `app.domain` on 2026-10-12 (140
# import statements) are the debt this contract started life with, one module
# pair per line, and are paid down from there. The merge base carries them too,
# so they hold no branch back; what this contract reports is an upward edge a
# branch adds. Two packages were placed by this first
# version, and the doc's table now carries them: `onboarding` at layer 7 — it
# reads lower layers and nothing imports it, which is that layer's whole
# definition — and `canvas` at layer 4, where `living_doc` is (whose models it
# reads) and where `room_task` is (which reads it).
#
# `notice_meta` joined at layer 1 beside `skill_library` (2026-10-13), for the
# same reason that one did: the platform-notice codes (`SEVERITY_*`, `WHO_*`,
# `EVENT_*`) and the `notice()` that shapes their `meta` were read from every
# layer, but lived in the layer-5 `agent.platform_notices`, so each reader
# climbed four layers for a handful of strings. The codes and `notice()` moved
# down; `agent.platform_notices` keeps the sentences it says to people, which
# need block's row key and the memory tree's paths and so stay at layer 5.
#
# `web_snippet` joined at layer 4 beside `living_doc` and `canvas` (2026-10-13):
# a document's mini-apps are part of the document, it keeps its pictures in the
# `library` blob store on the same layer, and only routes import it.
#
# `reads` joined at layer 1 (2026-10-18): the shared batch-read primitive
# `get_by_ids` imports only SQLAlchemy and the standard library, and is called
# by repositories from layer 1 (`tag`, `avatars`) upward (`comments`, `groups`).
#
# `repositories` joined beside it (2026-10-18): the `Repository` base gives those
# same repositories `get_by_id` / `get_by_ids` on top of `reads`, and imports
# nothing else from the domain.
#
# `project_material_rows` joined at layer 1 (2026-10-17), by the same move one step
# further: `project_material` (layer 4) reads tasks and accept cards, and both
# `room_task` and `review` read back into this side, so importing their models
# from there is a C3 cycle. The columns it reads come down; the readers stay.
#
# `review_note_codes` joined at layer 1 (2026-10-17): the note code and the level it
# renders as are read by `room_task.presentation` (layer 4) to place a card on the
# board, and `review` reads `room_task` the other way — each importing the other is
# the C3 cycle this move removes. The vocabulary came down; the writers
# (`record` / `annotate` / `clear`) stayed in `review/notes.py`, which needs the
# card's two columns.
#
# `project_permissions` joined at layer 1 (2026-10-16): the roles of a project
# and what each may do (#3830) are asked by `topic`, `topic_membership`,
# `review` and `membership` alike, and `project` sits beside the first two, so
# the names live below all of them. The module imports nothing.
#
# `delivery_events` joined at layer 1 (2026-10-14), the same move once more:
# the notification codes (`NotificationType`) and the shape of one event
# (`DeliveryEvent`, `event_id_for`, `dedup_key`) are what every layer needs to
# say that something happened, but they lived at layer 5 — the codes in
# `notification.models`, the event in `delivery.ledger`. Writing the ledger
# itself stays at layer 5; whoever calls it hands the call in.
#
# `agent_session` moved from layer 5 down to layer 3 (2026-10-14). It is a leaf
# that everything above reads — `topic` at 2, `repository` at 3, `memory` and
# `room_task` at 4, its own layer-5 neighbours, `room_cleanup` at 6 — and what
# it reads is `common`, `conversation` (both layer 1) and `topic.models`, whose
# row is 2. Layer 3 is the lowest row that keeps that one import legal, and it
# is where four of the five upward edges into it stop being upward. The fifth,
# `topic -> agent_session`, has since been handed in as a value at construction
# instead: layer 2 sits below layer 3, so `topic` cannot reach the session row —
# it takes the store. (The join is what binds the row to layer 3 either way:
# `agent_session` still reads `topic.models` at layer 2.)
#
# `shell_catalog` joined at layer 1 (2026-10-14), the same move as `notice_meta`
# and `delivery_events`: what a 壳 DECLARES (`Nav`, `Shell`, `CATALOG`, `lookup`)
# and the shape it resolves to (`ShellOut`) is vocabulary, and `ShellOut` is a
# field of `ProjectOut` — so `project.schemas` at layer 2 read it at layer 2's
# neighbour `shell`, upward. The declarations and the wire shape moved down;
# resolving a project's 壳 stays in `app.domain.shell.service`, which reads
# `space.models`, `task.models` and `task.protocol` and so cannot follow. That
# split is what takes `project -> shell` off the graph, which is the one edge
# under `project` that was holding `shell` inside the largest cycle.
#
# `presentation_meta` joined at layer 1 (2026-10-16), the same move a fourth
# time: `PresentationOut` — the two codes of one 看板 cell — was a field of two
# response shapes at once, `room_task.schemas.TaskOut` (layer 4) and
# `topic.schemas.TopicOut` (layer 2), so `topic.schemas` climbed to layer 4 for
# a two-field wire shape. The shape moved down; computing it stays in
# `room_task/presentation.py`, which reads room and task rows.
#
# `event_about` joined at layer 1 (2026-10-16), the same move as `notice_meta`
# and `presentation_meta`: `EventAbout` — the four things one event can be about
# — and the `landing()` that turns one of them into where it lands (`Landing`:
# the project and the conversation) lived in `block/about.py` at layer 4, and
# they are pure vocabulary — the module imports `enum`, `uuid` and `dataclasses`
# and nothing else. Six packages read them — `topic` at layer 2, `review`,
# `room_task`, `pin` and `block` itself at layer 4, `agent` at layer 5 — and the
# table lived in `block` at layer 4, so the layer-2 reader climbed two layers
# for a closed four-row table. The table
# and `landing()` moved down. Writing the event row stays in `block`:
# whoever says something into a room now hands the call in (the `PlatformLine` port
# in `topic/ports.py`), and stepping through `landing()` is what that
# implementation does before it appends — the landing guard asks for exactly
# that, so the table keeps deciding where a line goes.
#
# `event_author` joined at layer 1 (2026-10-16), the next step of the same
# commit that took `topic -> block` to zero. `AuthorType` — participant or
# platform — lived in `block/models.py` at layer 4, and `topic` at layer 2 reads
# that column twice: the unread badge and 「回复了我」 both filter on it, through
# the bare `blocks` table that package declares itself. The vocabulary moved
# down; `block/models.py` imports it back for the mapped column, and the column's
# one judged landing place stays `app.domain.block.authorship`, which keeps the
# pair of twins (`is_participant` for a row, `participant_blocks` for a `WHERE`).
# Why the move was forced rather than merely tidy: the column may only be read as
# an enum member (`tests/unit/test_author_type_two_values.py`), and a package
# that cannot name the enum can only spell the member as a string literal — the
# exact thing that guard exists to catch. Importers were followed one by one and
# now take it from `app.domain.event_author`; `block/models.py` still imports it
# for its own mapped column, so the name is reachable as an attribute of that
# module — nobody imports it from there. `block.schemas` re-exports it on purpose
# for routes, and takes it from layer 1 the way every other importer does.
#
# `environment_diagnosis` joined at layer 3 (2026-10-14), out of the `project`
# package it was written in. It takes no project row — the route hands it two
# ids, the settings and the failure — and what it reads is `gateway_chat` and
# `usage.ledger`, both of this row. Living in `project` made `project ->
# gateway_chat` an upward edge for a module that never needed the layer.
#
# `project -> usage` came off the graph (2026-10-14) the way `project -> shell`
# did: what `project` wanted was two questions (has this 赛题 earmarked credits
# for this project yet? issue them), not the `Ledger` class, so
# `app.domain.project.ports.ComputeCredits` declares them and
# `app.domain.usage.adapters.ComputeCredits` answers them — the composition root
# hands one in at `ProjectService`'s four construction sites. `Ledger.earmarks`
# returns `ComputeGrant` rows, which is why the port folds them into a bool: a
# layer-2 package does not name a caller's class.
#
# `project -> preview` came off in the same breath, and here the port needed no
# implementation written at all: saving a room file warms the Office → PDF
# preview cache, which is `preview.office.prewarm` at layer 5, and its shape
# (`data, path`, returns at once, does nothing when no render service is
# configured) is already exactly what `project.ports.WarmPreview` asks for. The
# eight route call sites hand the function itself in, next to the bytes they are
# saving — 谁调用谁给, the `webhook/ports.py` `Poster` shape.
#
# `project -> library` came off the same way one step later (2026-10-15), and it
# needed two ports because `project` asks the layer-4 `library` two unrelated
# things. Saving, reading back, versioning and snapshotting a room file's bytes
# are address lookups on disk: `project.ports.FileStore` declares them and
# `app/domain/library/service.py` already answers every one, so the routes hand
# the module itself in — `integration.ports.RoomFiles` again, right down to the
# constant (`MAX_FILE_BYTES`, half of the pair the routes read as
# `MAX_ARTIFACT_BYTES`; that name now lives in `library.service` beside the
# number it is, instead of in `project.room_files` pointing at it).
# `project.ports.LibraryFiles` is the other half — keeping a file in the
# project's 资料库 (`records.add`) and listing its blobs for the export archive
# (`records.stored`, plus a one-line `records.read_blob` so a caller does not
# have to know that bytes are addressed by `(location, key)`). `records.add`'s
# `data` is narrowed from `service.Content` to `bytes` in the port: it does not
# change a call, and it keeps `BinaryIO` from leaking into a layer-2 signature.
#
# Only the six *imports* left; the two packages keep their rows. `library` could
# not sink — `records._follow_references` (it rewrites `<&library/…>` chips and
# attachment block contents when a file is renamed) and `listing` both read
# `block.models` — and the artifact *rules* stayed in `project.room_files`
# because they are pure functions over a path, not over bytes:
# `ARTIFACT_MIME`, `artifact_kind_for`, `clean_artifact_path`. That ceiling
# alone moved, because a ceiling is the number the landing layer writes down.
#
# `project_material` joined at layer 4 and `project_situation` at layer 1
# (2026-10-16). The material — a project's goal, recent and open tasks, and what
# people said in its public channels — reads `room_task`, `review`, `block` and
# `library` and is read by two callers at different heights: the overview's
# 「现状」 (`project_situation`, which also needs `agent.harness.prompt.WRITING`
# and so sits above `agent`) and the document agent drafting the overview
# (`agent`, layer 3). It sits below both so that neither reaches up.
# `repository` lost its last three upward edges (2026-10-17). They were one
# mistake in two shapes. Three of them read a task's row — is it still open,
# which branch and last landed head, what did the card's declared work turn out
# to be — through `room_task.models.Task` and `room_task.services.TaskService`,
# because `repository` is layer 3 and `room_task` is layer 4 and nobody had
# written down what it actually needed: columns. So `repository/task_rows.py`
# declares those columns as a bare `table(...)`, the way
# `topic/repositories/statements.py` declares `tasks`, `threads` and `blocks`,
# and the three readers take it from there. Only reads go through the copy; a
# write or a decision still comes from `room_task.services`, which owns the
# table. `tests/unit/test_repository_task_rows_match_their_rows.py` pins the
# copy to the real table, and its opposite number in `topic` does the same
# there — both compare which table a statement's columns belong to, because
# `find_tables` hands back an annotated copy of an ORM table that `is` never
# matches, which is also why the `topic` guard's "borrowed a model table"
# assertion had never been able to go red until now.
#
# The fourth was a path, not a row: `repository.service.session_dir` copies a
# project's confirmed skills out of `project_skill`'s mirror directory and
# therefore imported `project_skill.service.mirror_root` to learn where that
# directory is. Where a path is is a convention, not a query, and it now sits
# at layer 1 in `skill_library.project_skills_root` — the same move as
# `event_author` and `event_about`, for the same reason: one writer and one
# other reader, three layers apart, needing one string. `mirror_root` stays in
# `project_skill.service` as a one-line wrapper; it is the name its own callers
# and the tests that patch it use.
#
# `chapter` joined at layer 4 beside `pin` (2026-10-21): it reads a block by id
# and the conversation's place, and is read by the room snapshot and the routes
# only — nothing below reads it back.
name = C5 domain packages form seven layers, dependencies point down
type = layers
layers =
    platform_stats : feature_stats : dashboard : project_progress : project_situation : onboarding : account
    routine : task_quiet : task_notices : admin : room_cleanup
    agent : agent_instance : machine : device : local_fs : shell : site : preview : assistant : delivery
    block : thread : pin : chapter : mentions : room_task : task : review : living_doc : documents : library : deliverables : memory : feedback : space : groups : questions : answers : comments : discussion : materials : project_skill : search : docs_site : canvas : web_snippet : project_material : voice : machine_skill : skill_market
    repository : integration : webhook : fetch : remote_mcp : gateway_chat : usage : notification : agent_session : environment_diagnosis
    identity : user : team : project : topic : membership : topic_membership : authz : policy : invite : passkey : oauth : agent_type : agent_credential : ci_activity
    common : day_windows : conversation : idempotency : addressing : delivery_events : happenings : run_record : session_record : attachment : avatars : textfile : service_keys : backend_log : frontend_log : tag : legal : skill_library : notice_meta : shell_catalog : presentation_meta : review_note_codes : project_material_rows : event_about : event_author : project_permissions : reads : repositories
containers =
    app.domain
exhaustive = true
unmatched_ignore_imports_alerting = warn

# **2026-10-15 拆包**，和 C3 那边同一件事：`app/domain/topic/repositories.py` 变成
# 一个包，读 `app.domain.block.models` 的 (Block / BlockKind) 原本是这一个文件顶上的
# 一条导入，包内三个子模块各自要用，于是多出两个导入方、配对从一条变三条。债是同一
# 笔（`topic -> block`），只是合并进仓库的树里记的模块路径不再是导入方了。
# **2026-10-16**：为此手写的三条豁免已删——`check_boundaries.py` 现在自己认得这种
# 改名（见 C3 那段），不必在声明里再写一遍。

[importlinter:contract:platform-not-claude-code]
# H1 — the platform side of the harness seam holds no Claude Code knowledge: it
# gets finished `AgentEvent`s from the room's session path, and stores and
# sends them; translating is the adapter's job (`docs/fusion-design.md`). Only
# the session-core drivers and the adapter's outer edges import its door.
# Direct imports only: reaching it through a driver is the seam working.
name = H1 the platform side does not import the Claude Code adapter
type = forbidden
source_modules =
    app.domain.agent.chat
    app.domain.agent.chat_admission
    app.domain.agent.chat_lifecycle
    app.domain.agent.chat_live_input
    app.domain.agent.chat_places
    app.domain.agent.room
    app.domain.agent.room_events
    app.domain.agent.runtime
    app.domain.agent.runtime_orphans
    app.domain.agent.turn
    app.domain.agent.turn_adoption
    app.domain.agent.turn_counts
    app.domain.agent.turn_inputs
    app.domain.agent.turn_ledger
    app.domain.agent.turn_speakers
    app.domain.agent.turn_times
    app.domain.agent.turn_usage
forbidden_modules = app.domain.agent.harness.claude_code
allow_indirect_imports = true
