    app.domain.usage.credits -> app.domain.agent.platform_notices
    app.domain.usage.ledger -> app.domain.project.services
    app.domain.usage.repositories -> app.domain.project.models
    app.domain.usage.subscription_ingest -> app.domain.project.repositories
