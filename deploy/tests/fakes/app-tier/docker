#!/usr/bin/env bash
set -euo pipefail

scenario="${APP_TIER_SCENARIO:-healthy}"
if [[ "$*" == *"scripts.forge_event_public_key"* ]]; then
  printf '{}\n'
  exit 0
fi
tag="${APP_TIER_MAIN_SHA:-testsha}"

# The rollout's probe for whether a backend catches the handover signal: by
# default it does; APP_TIER_NO_HANDOVER_SIGNAL=1 is a backend built before it.
if [ "${1:-}" = exec ] && [[ "$*" == *SigCgt* ]]; then
  [ -n "${APP_TIER_DOCKER_LOG:-}" ] && printf '%s\n' "$1 $2 handover-signal-probe" >> "$APP_TIER_DOCKER_LOG"
  [ "${APP_TIER_NO_HANDOVER_SIGNAL:-}" = 1 ] && exit 1
  exit 0
fi

# A script fed to `python -` in an image. deploy/migration-touches.py, run in the
# release (`compose … run … backend python -`), answers APP_TIER_PENDING_TOUCHES:
# `pending <revision>` and the tables and columns those migrations touch, nothing
# pending unless a test sets it, and the database's tables and columns,
# APP_TIER_DB_SCHEMA; APP_TIER_PENDING_TOUCHES_BROKEN=1 is a script
# that died before answering. deploy/schema-map.py answers the tables and
# columns an image maps: the release's APP_TIER_RELEASE_SCHEMA, a running
# owner's (`exec -i <owner> python -`) APP_TIER_OWNER_SCHEMA, the same as the
# release's unless a test sets it.
if [[ " $* " == *" python - "* ]]; then
  script="$(cat)"
  [ -n "${APP_TIER_DOCKER_LOG:-}" ] && printf '%s\n' "$*" >> "$APP_TIER_DOCKER_LOG"
  if [[ "$script" == *'print("migration-touches ok")'* ]]; then
    [ "${APP_TIER_PENDING_TOUCHES_BROKEN:-}" != 1 ] || exit 1
    # What the database has: everything both images map, unless a test says.
    for object in ${APP_TIER_DB_SCHEMA-${APP_TIER_OWNER_SCHEMA-} ${APP_TIER_RELEASE_SCHEMA-topics topics.id}}; do
      printf 'migration-touches present %s\n' "$object"
    done
    while IFS= read -r touched; do
      [ -z "$touched" ] || printf 'migration-touches %s\n' "$touched"
    done <<< "${APP_TIER_PENDING_TOUCHES:-}"
    printf 'migration-touches ok\n'
    exit 0
  fi
  # deploy/release-smoke.py: `provision` opens the smoke account's session and
  # prints it, `check` uses the new slots with it. APP_TIER_SMOKE_FAIL=<check>
  # makes that check fail. The check records the session it was handed through
  # the environment.
  if [[ "$script" == *'def check_backend('* ]]; then
    if [[ " $* " == *" provision "* ]]; then
      if [ "${APP_TIER_SMOKE_FAIL:-}" = provision ]; then
        printf 'smoke provision FAILED fake failure\n'
        exit 1
      fi
      printf 'smoke provision ok fake\n'
      printf 'smoke-session 42 fake-access-token-7f3a fake-refresh-token-9c1e\n'
      exit 0
    fi
    [ -z "${APP_TIER_DOCKER_LOG:-}" ] || printf 'smoke-session-seen %s %s %s\n' \
      "${DEPLOY_SMOKE_USER_ID:-missing}" "${DEPLOY_SMOKE_TOKEN:-missing}" "${DEPLOY_SMOKE_REFRESH:-missing}" \
      >> "$APP_TIER_DOCKER_LOG"
    checks="frontend-index frontend-asset login me task websocket logout"
    [[ " $* " == *" --frontend "* ]] || checks="${checks#frontend-index frontend-asset }"
    for check in $checks; do
      if [ "${APP_TIER_SMOKE_FAIL:-}" = "$check" ]; then
        printf 'smoke %s FAILED fake failure\n' "$check"
        exit 1
      fi
      printf 'smoke %s ok fake\n' "$check"
    done
    exit 0
  fi
  # deploy/code-digest.py: the code a running relay runs (`exec`) and the code
  # the release's image would run (`compose … run`).
  if [[ "$script" == *code-digest* ]]; then
    if [ "${1:-}" = exec ]; then
      printf 'code-digest %s\n' "${APP_TIER_RUNNING_CODE:-running-code}"
    else
      printf 'code-digest %s\n' "${APP_TIER_RELEASE_CODE:-release-code}"
    fi
    exit 0
  fi
  schema="${APP_TIER_RELEASE_SCHEMA-topics topics.id}"
  [ "${1:-}" != exec ] || schema="${APP_TIER_OWNER_SCHEMA-$schema}"
  for object in $schema; do printf 'schema-map %s\n' "$object"; done
  exit 0
fi

if [ "${1:-}" = exec ] && [ -n "${APP_TIER_CLOUD_DEVICES:-}" ]; then
  printf '%s\n' "$APP_TIER_CLOUD_DEVICES"
  exit 0
fi

if [ -n "${APP_TIER_DOCKER_LOG:-}" ]; then
  printf '%s\n' "$*" >> "$APP_TIER_DOCKER_LOG"
  if [ "${1:-}" = compose ] && [[ "$*" == *" up -d backend frontend"* ]]; then
    printf 'compose-up-env BACKEND_IMAGE=%s FRONTEND_IMAGE=%s IMAGE_TAG=%s APP_RELEASE=%s\n' \
      "${BACKEND_IMAGE:-}" "${FRONTEND_IMAGE:-}" "${IMAGE_TAG:-}" "${APP_RELEASE:-}" \
      >> "$APP_TIER_DOCKER_LOG"
  fi
  if [ "${1:-}" = compose ] && [[ "$*" == *" up -d --no-deps --force-recreate "* ]]; then
    printf 'slot-up-env %s BACKEND_IMAGE=%s FRONTEND_IMAGE=%s IMAGE_TAG=%s APP_RELEASE=%s\n' \
      "${!#}" "${BACKEND_IMAGE:-}" "${FRONTEND_IMAGE:-}" "${IMAGE_TAG:-}" "${APP_RELEASE:-}" \
      >> "$APP_TIER_DOCKER_LOG"
  fi
  case "$*" in
    *" up -d --no-deps collab"|*" up -d backend frontend collab")
      printf 'collab-up-env COLLAB_IMAGE=%s\n' "${COLLAB_IMAGE:-}" >> "$APP_TIER_DOCKER_LOG" ;;
    *" up -d --no-deps forge-events")
      printf 'forge-events-up-env FORGE_EVENTS_IMAGE=%s\n' "${FORGE_EVENTS_IMAGE:-}" >> "$APP_TIER_DOCKER_LOG" ;;
    *" up -d browser-render")
      printf 'browser-render-up-env BROWSER_RENDER_IMAGE=%s\n' "${BROWSER_RENDER_IMAGE:-}" >> "$APP_TIER_DOCKER_LOG" ;;
    *" up -d office-render")
      printf 'office-render-up-env OFFICE_RENDER_IMAGE=%s\n' "${OFFICE_RENDER_IMAGE:-}" >> "$APP_TIER_DOCKER_LOG" ;;
  esac
  if [ "${1:-}" = compose ] && [[ "$*" == *" up -d --no-deps device-connection"* ]]; then
    printf 'owner-up-env DEVICE_CONNECTION_IMAGE=%s\n' \
      "${DEVICE_CONNECTION_IMAGE:-}" >> "$APP_TIER_DOCKER_LOG"
  fi
  if [ "${1:-}" = compose ] && [[ "$*" == *" up -d --no-deps preview-connection"* ]]; then
    printf 'preview-owner-up-env PREVIEW_CONNECTION_IMAGE=%s\n' \
      "${PREVIEW_CONNECTION_IMAGE:-}" >> "$APP_TIER_DOCKER_LOG"
  fi
fi
# `docker login`: the password arrives on stdin, as with --password-stdin. The
# first APP_TIER_LOGIN_FAIL_COUNT logins fail on a dropped connection; a password
# other than APP_TIER_GHCR_TOKEN is refused the way ghcr refuses one. The
# password that arrived is kept in APP_TIER_LOGIN_SECRET_SEEN, if set.
if [ "${1:-}" = login ]; then
  password="$(cat)"
  [ -z "${APP_TIER_LOGIN_SECRET_SEEN:-}" ] || printf '%s\n' "$password" >> "$APP_TIER_LOGIN_SECRET_SEEN"
  if [ -n "${APP_TIER_LOGIN_FAIL_COUNT:-}" ] && [ -n "${APP_TIER_LOGIN_COUNTER:-}" ]; then
    seen=0
    [ -f "$APP_TIER_LOGIN_COUNTER" ] && seen="$(cat "$APP_TIER_LOGIN_COUNTER")"
    seen=$((seen + 1))
    printf '%s' "$seen" > "$APP_TIER_LOGIN_COUNTER"
    if [ "$seen" -le "$APP_TIER_LOGIN_FAIL_COUNT" ]; then
      echo 'Error response from daemon: Get "https://ghcr.io/v2/": read tcp 10.0.0.2:48428->10.0.0.3:443: read: connection reset by peer' >&2
      exit 1
    fi
  fi
  if [ "$password" != "${APP_TIER_GHCR_TOKEN:-}" ]; then
    echo 'Error response from daemon: Get "https://ghcr.io/v2/": denied: denied' >&2
    exit 1
  fi
  echo 'Login Succeeded'
  exit 0
fi
if [ -n "${APP_TIER_DOCKER_FAIL_MATCH:-}" ] && [[ "$*" == *"$APP_TIER_DOCKER_FAIL_MATCH"* ]]; then
  exit 1
fi
# Like the above, but only for a command that ENDS with the text — so one
# `up` can fail while a longer one (the rollback's) still succeeds.
if [ -n "${APP_TIER_DOCKER_FAIL_SUFFIX:-}" ] && [[ "$*" == *"$APP_TIER_DOCKER_FAIL_SUFFIX" ]]; then
  exit 1
fi
# APP_TIER_ROUTER_RELOAD_FAIL_FROM=N: app-router's Nth reload (counting from 1) and every one
# after it fail, as when nginx cannot bind a port the new config listens on.
if [ -n "${APP_TIER_ROUTER_RELOAD_FAIL_FROM:-}" ] && [ "$*" = "exec cheese-app-router nginx -s reload" ]; then
  reloads="$(grep -c '^exec cheese-app-router nginx -s reload$' "${APP_TIER_DOCKER_LOG:?}" || true)"
  [ "$reloads" -lt "$APP_TIER_ROUTER_RELOAD_FAIL_FROM" ] || exit 1
fi

# A successor an interrupted earlier release left behind exists only when a
# test names it in APP_TIER_LEFTOVERS.
if [ "${1:-}" = container ] && [ "${2:-}" = inspect ]; then
  case "${3:-}" in
    *-backend-next|*-frontend-next)
      [[ " ${APP_TIER_LEFTOVERS:-} " == *" $3 "* ]]
      exit
      ;;
  esac
fi

# With APP_TIER_REAL_DOCKER, compose's model comes from the real `docker compose
# config`, which needs no daemon: the second backend slot is then written from
# what compose really merges, and starting it records the model compose would
# create it from in APP_TIER_SLOT_MODEL.
if [ -n "${APP_TIER_REAL_DOCKER:-}" ] && [ "${1:-}" = compose ]; then
  compose_files=()
  args=("${@:2}")
  while [ "${#args[@]}" -gt 0 ]; do
    case "${args[0]}" in
      -f|-p) compose_files+=("${args[0]}" "${args[1]}"); args=("${args[@]:2}") ;;
      *) break ;;
    esac
  done
  if [ "${args[0]:-}" = config ]; then
    exec "$APP_TIER_REAL_DOCKER" compose "${compose_files[@]}" "${args[@]}"
  fi
  if [[ " ${args[*]} " == *" --force-recreate backend-b "* ]] && [ -n "${APP_TIER_SLOT_MODEL:-}" ]; then
    "$APP_TIER_REAL_DOCKER" compose "${compose_files[@]}" config --format json > "$APP_TIER_SLOT_MODEL"
  fi
fi

# The image names the daemon holds, as the containerd image store keeps them:
# each name is an image of its own, and `image prune -a` keeps only the names a
# container was created from — another name for the same content is pruned.
# Only when a test asks for it, in APP_TIER_IMAGE_STORE (names, and one
# "container image" line per container).
if [ -n "${APP_TIER_IMAGE_STORE:-}" ]; then
  names="$APP_TIER_IMAGE_STORE/names"
  roots="$APP_TIER_IMAGE_STORE/roots"
  touch "$names" "$roots"
  case "${1:-} ${2:-}" in
    "pull "*) printf '%s\n' "$2" >> "$names" ;;
    "tag "*) printf '%s\n' "$3" >> "$names" ;;
    "create "*)
      container=""
      previous=""
      for word in "$@"; do
        [ "$previous" = --name ] && container="$word"
        previous="$word"
      done
      printf '%s %s\n' "$container" "${!#}" >> "$roots"
      ;;
    "rm -f") grep -v "^${3:-} " "$roots" > "$roots.next" || true; mv "$roots.next" "$roots" ;;
    "rename "*)
      awk -v from="$2" -v to="$3" '$1 == from { $1 = to } { print }' "$roots" \
        > "$roots.next"
      mv "$roots.next" "$roots"
      ;;
    "image prune")
      awk 'NR == FNR { kept[$2] = 1; next } kept[$0]' "$roots" "$names" \
        > "$names.next"
      mv "$names.next" "$names"
      ;;
  esac
fi
if [[ "$*" == *"scripts.migrate_forge"* ]]; then
  if [[ "$*" == *" --check"* ]]; then
    exit "${APP_TIER_FORGE_CHECK:-0}"
  fi
  exit "${APP_TIER_FORGE_APPLY:-0}"
fi
if [ "${1:-}" = ps ] && [[ "$*" == *"com.docker.compose.service=git"* ]]; then
  printf 'legacy-git-container\n'
  exit 0
fi

# Fail the first APP_TIER_PULL_FAIL_COUNT pull invocations, counting across both
# `docker pull` and `docker compose pull`. Lets a test drive the retry path — and
# the failure path's disk reclaim — without a registry. A failed compose pull
# prints APP_TIER_PULL_FAIL_MESSAGE, so a test can make it a full disk.
pull_should_fail() {
  local counter="${APP_TIER_PULL_COUNTER:-}" seen=0
  [ -n "${APP_TIER_PULL_FAIL_COUNT:-}" ] && [ -n "$counter" ] || return 1
  [ -f "$counter" ] && seen="$(cat "$counter")"
  seen=$((seen + 1))
  printf '%s' "$seen" > "$counter"
  [ "$seen" -le "$APP_TIER_PULL_FAIL_COUNT" ]
}

emit_named_rows() {
  printf 'cheese-backend-1 repo/backend:%s\n' "$tag"
  if [ "$scenario" != "frontend_absent" ]; then
    frontend_tag="$tag"
    if [ "$scenario" = frontend_stale ] || [ "$scenario" = rollback ]; then
      frontend_tag="old9999"
    fi
    printf 'cheese-frontend-1 repo/frontend:%s\n' "$frontend_tag"
  fi
}

# How `docker ps` prints the image of a container created from a reference:
# a digest reference comes out as the image's short ID unless --no-trunc is
# given (Docker 29 with the containerd image store); a tag comes out as is.
shown() {
  if [ "$no_trunc" != true ] && [[ "$1" == *@sha256:* ]]; then
    printf '%s' "${1#*@sha256:}" | cut -c1-12
  else
    printf '%s' "$1"
  fi
}

emit_contract_rows() {
  if [ "${FORGE_EVENTS_LOCAL:-false}" = true ]; then
    printf 'forge-events\t%s\trunning\tUp 1 minute (healthy)\n' "$(shown "${FORGE_EVENTS_IMAGE:-repo/backend:$tag}")"
  fi
  if [ "$scenario" != forgejo_absent ]; then
    printf 'forgejo\tcodeberg.org/forgejo/forgejo:15.0.9-rootless\trunning\tUp 1 minute (healthy)\n'
  fi
  # On a box with two slots the backend app-router serves is listed under its
  # own slot, and the slot this release left beside it, on the previous image,
  # until the release removes it.
  local serving=backend other=backend-b
  if [ -n "${ACTIVE_BACKEND_DIR:-}" ] && [ -n "${BACKEND_PORT_NEXT:-}" ] \
    && grep -Fq "127.0.0.1:$BACKEND_PORT_NEXT;" "$ACTIVE_BACKEND_DIR/backend.conf" 2>/dev/null; then
    serving=backend-b other=backend
  fi
  printf '%s\trepo/backend:%s\trunning\tUp 1 minute (healthy)\n' "$serving" "$tag"
  if [ -n "${APP_TIER_DOCKER_LOG:-}" ] && grep -q -- "--force-recreate $serving\$" "$APP_TIER_DOCKER_LOG" 2>/dev/null \
    && ! grep -q -- " rm -f $other\$" "$APP_TIER_DOCKER_LOG" 2>/dev/null; then
    printf '%s\trepo/backend:oldsha\trunning\tUp 1 hour (healthy)\n' "$other"
  fi
  if [ "$scenario" != "frontend_absent" ]; then
    frontend_tag="$tag"
    if [ "$scenario" = frontend_stale ] || [ "$scenario" = rollback ]; then
      frontend_tag="old9999"
    fi
    printf 'frontend\trepo/frontend:%s\trunning\tUp 1 minute (healthy)\n' \
      "$frontend_tag"
  fi
  if [ "$scenario" != "collab_absent" ] && [ "$scenario" != "collab_unreleased" ]; then
    printf 'collab\t%s\trunning\tUp 1 minute (healthy)\n' "$(shown "${COLLAB_IMAGE:-repo/collab:$tag}")"
  fi
}

if [ "${1:-}" = "compose" ]; then
  shift
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -f|-p)
        shift 2
        ;;
      *)
        break
        ;;
    esac
  done

  case "${1:-}" in
    config)
      # `config --hash <service>`: the configuration compose would create it
      # from now, APP_TIER_CONFIG_HASH.
      if [ "${2:-}" = --hash ]; then
        printf '%s %s\n' "${3:-}" "${APP_TIER_CONFIG_HASH:-config}"
        exit 0
      fi
      # The merged model deploy-docker.sh copies the second slot from.
      printf '{"services": {"backend": {"image": "repo/backend:x", "ports": ["127.0.0.1:18081:8081"]}, "frontend": {"image": "repo/frontend:x", "depends_on": {"backend": {"condition": "service_healthy"}}}}}\n'
      ;;
    ps)
      # APP_TIER_RUNNING_SERVICES: services a previous release left running.
      if [ "${2:-}" = -q ] && [[ " ${APP_TIER_RUNNING_SERVICES:-} " == *" ${3:-} "* ]]; then
        printf '%s-container\n' "$3"
      fi
      if [ "${2:-}" = -q ] && [ "${3:-}" = forgejo ]; then
        printf 'forgejo-container\n'
      fi
      if [ "${2:-}" = -q ] && [ "$scenario" = stable_owner ] && \
        [ "${3:-}" = device-connection ]; then
        printf 'device-connection-container\n'
      fi
      if [ "${2:-}" = -q ] && [ "$scenario" = stable_owner ] && \
        [ "${3:-}" = preview-connection ]; then
        printf 'preview-connection-container\n'
      fi
      if [ "${2:-}" = -q ] && [ "${3:-}" = backend ] &&         [ -n "${APP_TIER_BACKEND_CONTAINER:-}" ]; then
        printf '%s\n' "$APP_TIER_BACKEND_CONTAINER"
      fi
      if [ "${2:-}" = -q ] && [ "${3:-}" = backend-b ] && [ -n "${APP_TIER_BACKEND_B_CONTAINER:-}" ]; then
        printf '%s\n' "$APP_TIER_BACKEND_B_CONTAINER"
      fi
      if [ "${2:-}" = -q ] && [ "${3:-}" = frontend ] && [ -n "${APP_TIER_FRONTEND_CONTAINER:-}" ]; then
        printf '%s\n' "$APP_TIER_FRONTEND_CONTAINER"
      fi
      if [ "${2:-}" = -q ] && [ "${3:-}" = frontend-b ] && [ -n "${APP_TIER_FRONTEND_B_CONTAINER:-}" ]; then
        printf '%s\n' "$APP_TIER_FRONTEND_B_CONTAINER"
      fi
      # APP_TIER_SERVING_SLOT=b: the previous release's backend serves from the
      # second slot, `backend-b`, as every other release's does. The frontend
      # stays in `frontend` on a box that does not roll it.
      if [ "${2:-}" = -q ] && [ "$scenario" = rollback ]; then
        case "${APP_TIER_SERVING_SLOT:-}:${3:-}" in
          :backend) printf 'backend-container\n' ;;
          :frontend) printf 'frontend-container\n' ;;
          b:backend-b) printf 'backend-b-container\n' ;;
          b:frontend) printf 'frontend-container\n' ;;
        esac
      fi
      ;;
    images)
      ;;
    pull)
      if pull_should_fail; then
        echo "${APP_TIER_PULL_FAIL_MESSAGE:-fake: compose pull failed: read: connection reset by peer}" >&2
        exit 1
      fi
      ;;
    run|up|exec)
      ;;
  esac
  exit 0
fi

if [ "${1:-}" = manifest ] && [ "${2:-}" = inspect ]; then
  if [ "$scenario" = collab_unreleased ] && [[ "${3:-}" == */collab:* ]]; then
    echo "manifest unknown: manifest unknown" >&2
    exit 1
  fi
  exit 0
fi

if [ "${1:-}" = pull ]; then
  if pull_should_fail; then
    echo "fake: pull failed for ${2:-}" >&2
    exit 1
  fi
  exit 0
fi

# The local name a pulled private-executor image carries as a label.
if [ "${1:-}" = image ] && [ "${2:-}" = inspect ] && \
  [[ "$*" == *com.cheese.local-image* ]]; then
  printf '%s\n' "${APP_TIER_PRIVATE_EXECUTOR_NAME-cheese-private-executor:9.9.9}"
  exit 0
fi

# The image a running service was created from is APP_TIER_RUNNING_IMAGE; a
# pulled tag has the registry digest APP_TIER_PULLED_DIGEST. What each contains
# (deploy-docker.sh's image_content) is APP_TIER_RUNNING_CONTENT and
# APP_TIER_PULLED_CONTENT: different unless a test makes them the same.
if [ "${1:-}" = image ] && [ "${2:-}" = inspect ] && [[ "$*" == *RepoDigests* ]]; then
  if [ "${!#}" = "${APP_TIER_RUNNING_IMAGE:-sha256:running}" ]; then
    for repository in collab browser-render office-render backend; do
      printf 'ghcr.io/sageseekersociety/cheese/%s@%s\n' "$repository" "${!#}"
    done
  else
    image="${!#}"
    printf '%s@%s\n' "${image%:*}" "${APP_TIER_PULLED_DIGEST:-sha256:pulled}"
  fi
  exit 0
fi
if [ "${1:-}" = image ] && [ "${2:-}" = inspect ] && [[ "$*" == *RootFS.Layers* ]]; then
  if [ "${!#}" = "${APP_TIER_RUNNING_IMAGE:-sha256:running}" ]; then
    printf '%s\n' "${APP_TIER_RUNNING_CONTENT:-old-layers}"
  else
    printf '%s\n' "${APP_TIER_PULLED_CONTENT:-new-layers}"
  fi
  exit 0
fi

if [ -n "${APP_TIER_IMAGE_STORE:-}" ] && [ "${1:-}" = image ] && \
  [ "${2:-}" = inspect ]; then
  grep -Fqx -- "${!#}" "$APP_TIER_IMAGE_STORE/names"
  exit
fi

if [ "${1:-}" = image ] && [ "${2:-}" = inspect ]; then
  # The image a release names, as the owner release compares it.
  if [[ "$*" == *'{{.Id}}'* ]]; then
    printf '%s\n' "${APP_TIER_RELEASE_IMAGE_ID:-sha256:release}"
    exit 0
  fi
  if [ "$scenario" = local_image_missing ] && \
    [ "${3:-}" = repo/frontend:testsha ]; then
    exit 1
  fi
  exit 0
fi

if [ "${1:-}" = inspect ] && [ "${2:-}" = --format ]; then
  case "${3:-}" in
    *Config.Image*)
      case "${4:-}" in
        backend-container|backend-b-container) printf 'repo/backend:oldsha\n' ;;
        frontend-container) printf 'repo/frontend:oldsha\n' ;;
        collab-container) printf 'ghcr.io/sageseekersociety/cheese/collab@sha256:previous\n' ;;
      esac
      ;;
    # The running backend's environment; APP_TIER_PREVIOUS_RELEASE is the
    # release it was started as, unset for one started before releases were passed.
    *Config.Env*)
      printf 'PATH=/usr/local/bin\n'
      [ -z "${APP_TIER_PREVIOUS_RELEASE:-}" ] || printf 'APP_RELEASE=%s\n' "$APP_TIER_PREVIOUS_RELEASE"
      ;;
    *State.Running*) printf 'true\n' ;;
    # The command a backend's image starts with: APP_TIER_BACKEND_CMD, or the
    # one images before backend/app/serve.py ran.
    *Config.Cmd*) printf '%s\n' "${APP_TIER_BACKEND_CMD:-[\"sh\",\"-c\",\"exec uvicorn app.main:app\"]}" ;;
    # The image a running container was created from.
    *'{{.Image}}'*) printf '%s\n' "${APP_TIER_RUNNING_IMAGE:-sha256:running}" ;;
    # The configuration hash compose labelled a running container with.
    *config-hash*) printf '%s\n' "${APP_TIER_RUNNING_CONFIG_HASH:-config}" ;;
  esac
  exit 0
fi

# deploy/app-container.sh: service and name of each running container.
if [ "${1:-}" = ps ] && [[ "$*" == *'{{.Names}}'* ]]; then
  printf 'backend %s\n' "${APP_TIER_BACKEND_CONTAINER:-cheese-backend-1}"
  printf 'frontend cheese-frontend-1\n'
  exit 0
fi

if [ "${1:-}" = "ps" ]; then
  no_trunc=false
  [[ " $* " != *" --no-trunc "* ]] || no_trunc=true
  if [[ "$*" == *com.docker.compose.service* ]]; then
    emit_contract_rows
  else
    emit_named_rows
  fi
fi

exit 0
