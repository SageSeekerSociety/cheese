#!/usr/bin/env bash
set -euo pipefail

case "${1:-}" in
  fetch)
    exit 0
    ;;
  rev-parse)
    if [ "${APP_TIER_REQUIRE_SHORT7:-false}" = true ]; then
      case " $* " in
        *" --short=7 "*) ;;
        *) exit 42 ;;
      esac
    fi
    printf '%s\n' "${APP_TIER_MAIN_SHA:-testsha}"
    exit 0
    ;;
esac

exec /usr/bin/git "$@"
