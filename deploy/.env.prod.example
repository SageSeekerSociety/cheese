# Production Environment Configuration
# Copy to .env.prod and fill in real values. NEVER commit .env.prod to git.

# ===== Image =====
IMAGE_TAG=main

# ===== Database =====
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME_STRONG_RANDOM_PASSWORD@postgres:5432/cheese

# ===== Redis =====
REDIS_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD
REDIS_URL=redis://:CHANGE_ME_STRONG_RANDOM_PASSWORD@valkey:6379/0

# ===== Application =====
ENVIRONMENT=production
APP_NAME=Cheese Backend

# ===== Authentication (REQUIRED — generate strong random values) =====
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
REALNAME_ENCRYPTION_KEY=
TOTP_ENCRYPTION_KEY=
SESSION_SECRET=

# Token expiration (seconds)
ACCESS_TOKEN_EXPIRES_SECONDS=900
REFRESH_TOKEN_EXPIRES_SECONDS=2592000

# ===== Frontend =====
FRONTEND_URL=https://cheese.example.com
AVATAR_BASE_URL=https://api.cheese.example.com
CORS_ORIGINS=https://cheese.example.com

# ===== WebAuthn =====
WEBAUTHN_RP_NAME=Cheese Community
WEBAUTHN_RP_ID=cheese.example.com
WEBAUTHN_ORIGIN=https://cheese.example.com

# ===== Email / SMTP =====
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=

# ===== Storage =====
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_LOCAL_URL=/uploads

# ===== OpenAI / LLM =====
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini
AI_DAILY_QUOTA=10.0
