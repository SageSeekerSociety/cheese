# Production Environment Configuration
# Copy to .env.prod and fill in real values. NEVER commit .env.prod to git.
#
# Only vars that MUST change per deployment (or are required secrets) are
# listed. Everything else has a sane default in app/core/config.py — override
# by adding the uppercase field name here.

# ===== Image =====
IMAGE_TAG=main

# ===== Agent sandbox (sibling containers via host docker.sock) =====
# Host docker group's gid — lets the backend's non-root user talk to the
# mounted docker.sock:   getent group docker | cut -d: -f3
DOCKER_GID=999
# WORKSPACE_ROOT + SANDBOX_IMAGE are pinned in docker-compose.prod.yml
# (they must stay coupled to its bind mounts / IMAGE_TAG).

# ===== Database =====
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME_STRONG_RANDOM_PASSWORD@postgres:5432/cheese

# ===== Redis =====
REDIS_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD
REDIS_URL=redis://:CHANGE_ME_STRONG_RANDOM_PASSWORD@valkey:6379/0

# ===== Application =====
ENVIRONMENT=production

# ===== Authentication (REQUIRED — generate strong random values) =====
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
REALNAME_ENCRYPTION_KEY=

# Token expiration (seconds)
ACCESS_TOKEN_EXPIRES_SECONDS=900
REFRESH_TOKEN_EXPIRES_SECONDS=2592000

# ===== Frontend =====
FRONTEND_URL=https://cheese.example.com
# Public origin of THIS backend (it serves /avatars itself)
AVATAR_BASE_URL=https://api.cheese.example.com
CORS_ORIGINS=https://cheese.example.com

# ===== WebAuthn / passkeys =====
WEBAUTHN_RP_NAME=Cheese Community
WEBAUTHN_RP_ID=cheese.example.com
WEBAUTHN_ORIGIN=https://cheese.example.com

# ===== OAuth login providers (optional) =====
# OAUTH_ENABLED_PROVIDERS=github,google,ruc
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# OAUTH_GITHUB_REDIRECT_URL=https://api.cheese.example.com/users/auth/oauth/callback/github

# ===== Email / SMTP =====
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=

# ===== Storage =====
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_LOCAL_URL=/uploads
# For STORAGE_TYPE=s3 also set: S3_BUCKET / S3_ENDPOINT_URL / S3_ACCESS_KEY /
# S3_SECRET_KEY / S3_REGION / S3_PUBLIC_URL

# ===== 知是 AI advice (OpenAI-compatible) =====
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini
AI_DAILY_QUOTA=10.0

# ===== 芝士 agent (Claude Agent SDK via gateway) =====
# Gateway credential — REQUIRED for the agent/chat features.
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
# AGENT_MODEL=glm-5.2
# Public origin connector devices call back to (device hooks, install.sh).
# With the bundled nginx (which proxies /connector/ to the backend) this is
# simply the site origin itself:
CONNECTOR_PUBLIC_BASE=https://cheese.example.com
# WS-stripping edge (e.g. a campus front proxy that only forwards plain HTTP):
# map the friendly origin to a WS-capable one. Devices keep installing and
# logging in at the friendly origin; only the persistent control channel and
# the browser's 现场 viewer socket are rerouted.
# CONNECTOR_WS_OVERRIDES={"https://cheese.example.com": "https://ws.example.com"}
# VITE_CONNECTOR_WS_BASE=https://ws.example.com
# Sandboxed agent turns (needs docker on the host):
# AGENT_SANDBOX_ENABLED=false
# SANDBOX_TOKEN=
# Memory backend: db (default) or openviking
# MEMORY_BACKEND=db
# Agent heartbeat scheduler (seconds; 0 = off)
# SCHEDULER_INTERVAL_SECONDS=0

# ===== Search (optional; empty = Postgres FTS fallback) =====
# MEILISEARCH_URL=
# MEILISEARCH_API_KEY=
