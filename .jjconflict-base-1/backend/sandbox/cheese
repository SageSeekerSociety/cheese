#!/usr/bin/env python3
"""cheese — 芝士 的平台 CLI（在沙箱里调,平台动作走 REST,不用 MCP）。

代码/文件的事用原生工具（Bash/Write/Read）；改平台状态的事用本 CLI。
环境变量（容器注入）：
  CHEESE_API     平台 API 基址，如 http://host.docker.internal:8099/api
  CHEESE_PROJECT 当前项目 id
  CHEESE_TOPIC   当前话题 id
  CHEESE_AUTHOR  当前作者 handle（默认 cheese）

例:
  cheese doc set DOC.md            # 把 DOC.md 设为本话题活文档
  cheese doc get                   # 打印本话题活文档
  cheese split "数据清洗"           # 拆出子话题
  cheese decision "用 item-based CF" # 记一条决策
  cheese remember "技术栈=FastAPI"  # 记入项目记忆
  cheese recall "技术选型"          # 按需检索记忆(语义搜索)
  cheese notify --title "看下" --to mentor-1 --level strong --kind decision_request --options "A|B"
  cheese accept-request mentor-1 "中期验收"  # 递验收卡
  cheese conclude "原型完成,Recall@10=0.18"  # 子话题结论回流
  cheese milestone "中期汇报" --due 2026-06-20
  cheese await "bash .claude/scripts/check.sh --full"  # 后台跑;跑完平台叫醒本话题
  cheese status                             # 平台状态快照(本轮运行状态/验收卡/闸门输出/水位)
  cheese artifact report.html               # 把产物设为本话题当前预览(进预览窗口)
  cheese serve "Vue dev server"             # 应用跑在 0.0.0.0:$CHEESE_APP_PORT 后,设为预览
  cheese artifact chart.svg --as svg        # SVG 同理
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import sys
import urllib.error
import urllib.request

API = os.environ.get("CHEESE_API", "http://host.docker.internal:8099/api").rstrip("/")
PROJECT = os.environ.get("CHEESE_PROJECT", "")
TOPIC = os.environ.get("CHEESE_TOPIC", "")
AUTHOR = os.environ.get("CHEESE_AUTHOR", "cheese")
TOKEN = os.environ.get("CHEESE_TOKEN", "")
# The agent turn this CLI call belongs to — sent back so the blocks it creates
# share the turn's id (R4).
TURN = os.environ.get("CHEESE_TURN", "")
# In a private chat, `remember` writes the owner's personal memory (跟着人走).
MEMORY_SCOPE = os.environ.get("CHEESE_MEMORY_SCOPE", "project")
OWNER = os.environ.get("CHEESE_OWNER", "")


def _call(
    method: str, path: str, body: dict | None = None, *, token: str | None = None
) -> dict:
    url = f"{API}{path}"
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method)
    req.add_header("Content-Type", "application/json")
    auth = token if token is not None else TOKEN
    if auth:
        req.add_header("X-Cheese-Token", auth)
    if TURN:
        req.add_header("X-Cheese-Turn", TURN)
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        detail = e.read().decode(errors="replace")[:400]
        print(f"[cheese] {method} {path} 失败 HTTP {e.code}: {detail}", file=sys.stderr)
        sys.exit(1)
    except Exception as e:  # noqa: BLE001
        print(f"[cheese] {method} {path} 出错: {e}", file=sys.stderr)
        sys.exit(1)


def _need(name: str, value: str) -> str:
    if not value:
        print(f"[cheese] 缺少 {name}（环境变量未注入）", file=sys.stderr)
        sys.exit(2)
    return value


def _api_root() -> str:
    """The app root (where /openapi.json lives), i.e. CHEESE_API without the
    trailing /api mount prefix."""
    return API[: -len("/api")] if API.endswith("/api") else API


def _raw_request(method: str, path: str, data: str | None) -> None:
    """Raw API escape hatch (fusion-design §5.2): hit our backend directly with
    the container's existing auth (CHEESE_TOKEN), printing the response body
    verbatim. NOT a no-auth backdoor — it still carries the token, and the
    backend still authorizes the actor per call; it is just the low-ceremony
    channel for the 20% of cases the curated commands don't cover. Prefer the
    curated `cheese <verb>` commands (title/doc/ask/remember/...) — see SKILL.md."""
    if not path.startswith("/"):
        path = "/" + path
    body = data.encode() if data else None
    req = urllib.request.Request(f"{API}{path}", data=body, method=method.upper())
    req.add_header("Content-Type", "application/json")
    if TOKEN:
        req.add_header("X-Cheese-Token", TOKEN)
    if TURN:
        req.add_header("X-Cheese-Turn", TURN)
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            print(r.read().decode(errors="replace"))
    except urllib.error.HTTPError as e:
        # Surface the backend's error body (auth failures, validation, etc.)
        # verbatim so the caller sees exactly why — then exit non-zero.
        print(e.read().decode(errors="replace"))
        sys.exit(1)
    except Exception as e:  # noqa: BLE001
        print(f"[cheese] api {method} {path} 出错: {e}", file=sys.stderr)
        sys.exit(1)


def _format_status(d: dict) -> str:
    """Human/agent-readable rendering of /topics/{id}/status (盲飞防护): the
    turn's state, every accept card with its gate tail, and the platform
    waterlines — the questions agents used to hand-poll the API for.

    turn 活跃度检测 (2026-08-09): a running turn is shown as one of three states
    — 正常运行中 / 疑似卡死（已 X 分钟无活跃信号）/ 接近硬顶 — never as a live
    countdown of seconds. A literal "还剩 Ns" figure was observed making the
    agent rush against what's only ever meant to be a wedged-turn safety net."""
    lines: list[str] = []
    topic = d.get("topic") or {}
    head = f"话题: {topic.get('title', '?')}（{topic.get('status', '?')}"
    if topic.get("branch"):
        head += f", 分支 {topic['branch']}"
    lines.append(head + "）")
    turn = d.get("turn")
    if turn:
        t = f"本轮: {turn.get('status')}"
        if turn.get("status") == "running":
            activity = turn.get("activity") or {}
            suspect_s = activity.get("suspect_since_s_ago")
            if suspect_s is not None:
                t += f"，疑似卡死（已 {round(suspect_s / 60)} 分钟无活跃信号，正在探活确认）"
            elif turn.get("near_ceiling"):
                t += "，接近硬顶（即将触发兜底结束）"
            else:
                t += "，正常运行中"
        elif turn.get("duration_s") is not None:
            t += f"，用时 {turn['duration_s']}s"
        if turn.get("detail"):
            t += f"（{turn['detail']}）"
        lines.append(t)
    cards = d.get("cards") or []
    lines.append(f"验收卡: {len(cards)} 张" if cards else "验收卡: 无")
    for c in cards:
        row = f"- [{c.get('status')}] 递给 @{c.get('reviewer')}"
        if c.get("decided_by"):
            row += f"，{c['decided_by']} 处理于 {c.get('decided_at')}"
        if c.get("note"):
            row += f"；note: {c['note']}"
        lines.append(row)
        if c.get("pr_url"):
            lines.append(
                f"  PR: #{c.get('pr_number')} {c['pr_url']}"
                "（CI 状态: GH_TOKEN=$(cheese gh-token) 后用 gh 查）"
            )
        if c.get("status") == "gate_failed" and c.get("gate_output_tail"):
            lines.append("  闸门输出（尾部）:")
            lines.extend(
                "    " + ln for ln in c["gate_output_tail"].splitlines()[-15:]
            )
    plat = d.get("platform") or {}
    disk = plat.get("disk")
    if disk:
        lines.append(
            f"磁盘: 可用 {disk.get('free_gb')}G / {disk.get('total_gb')}G"
            f"（已用 {disk.get('used_pct')}%）"
        )
    credits = plat.get("credits") or {}
    cred = "不限" if credits.get("unlimited") else f"剩 {credits.get('remaining')}"
    lines.append(
        f"并发: 全站运行中 {plat.get('active_turns', '?')} 轮，"
        f"本项目排队 {plat.get('queued_turns', 0)}；额度: {cred}"
    )
    return "\n".join(lines)


# --- await: 后台跑长任务，跑完平台自动叫醒本话题 -------------------------------
#
# Why this exists: ending a turn to "wait for" a background command used to
# freeze the topic — nothing on the platform starts a new turn when a detached
# process exits. `cheese await` registers the command with the platform, runs it
# in a detached child here in the sandbox (where the venv/toolchain is warm), and
# the child reports the exit code + output tail back when it finishes; the
# platform lands that in the timeline and wakes the topic.
#
# The reporting token comes from registration, NOT from CHEESE_TOKEN: the
# container's own token expires in an hour and these tasks are longer than that.

_AWAIT_TAIL_BYTES = 4000
# Same cadence the backend uses for its own at-least-once deliveries.
_AWAIT_RETRY_DELAYS = (0, 5, 30)


def _await_log_path(run_id: str) -> str:
    """Where a backgrounded command's full output goes. Deliberately OUTSIDE the
    worktree: these logs would otherwise be committed with the topic's work."""
    home = os.environ.get("HOME") or "/tmp"
    log_dir = os.path.join(home, ".cheese", "await")
    os.makedirs(log_dir, exist_ok=True)
    return os.path.join(log_dir, f"{run_id}.log")


def _await_start(command: str, label: str, timeout_s: int) -> None:
    """Register the command, fork the detached runner, and return immediately."""
    import subprocess
    import time

    topic = _need("CHEESE_TOPIC", TOPIC)
    run_id = f"{int(time.time())}-{os.getpid()}"
    log_path = _await_log_path(run_id)
    data = _call(
        "POST",
        f"/topics/{topic}/background-task",
        {
            "command": command,
            "label": label,
            "timeout_s": timeout_s,
            "log_path": log_path,
        },
    ).get("data", {})
    task_id = data.get("task_id", "")

    child_env = dict(os.environ)
    # Via env, not argv: the wake token has a long life and `ps` is world-readable.
    child_env["CHEESE_AWAIT_TOKEN"] = data.get("wake_token", "")
    subprocess.Popen(  # noqa: S603 — our own script, fixed argv
        [
            sys.executable,
            os.path.abspath(__file__),
            "__await-child",
            task_id,
            command,
            log_path,
            str(timeout_s),
        ],
        env=child_env,
        cwd=os.getcwd(),
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        # Its own session, so it outlives this shell AND the turn that spawned it.
        start_new_session=True,
    )
    print(
        f"[cheese] 已在后台开跑：{data.get('label') or command}\n"
        f"  完整输出: {log_path}\n"
        f"  跑完平台会自动叫醒本话题，并带上退出码和输出尾巴——"
        f"你可以安心结束本轮，不用干等（上限 {timeout_s}s）。"
    )


def _await_child(task_id: str, command: str, log_path: str, timeout_s: int) -> None:
    """The detached runner: run the command, then report how it ended.

    Never raises past this frame — a crash here is a topic that never wakes up,
    which is the exact failure this whole path exists to remove."""
    import signal
    import subprocess
    import time

    started = time.time()
    exit_code = -1
    try:
        with open(log_path, "wb") as log:
            proc = subprocess.Popen(  # noqa: S602 — the agent's own command, by design
                ["bash", "-lc", command],
                stdout=log,
                stderr=subprocess.STDOUT,
                stdin=subprocess.DEVNULL,
                start_new_session=True,
            )
            try:
                exit_code = proc.wait(timeout=timeout_s)
            except subprocess.TimeoutExpired:
                # Kill the whole process group: a build/test runner's children
                # would otherwise survive and keep writing to the log.
                try:
                    os.killpg(os.getpgid(proc.pid), signal.SIGKILL)
                except OSError:
                    proc.kill()
                proc.wait()
                exit_code = 124  # `timeout(1)`'s convention
    except Exception as e:  # noqa: BLE001 — report the failure, never vanish
        with open(log_path, "a", encoding="utf-8") as log:
            log.write(f"\n[cheese await] 命令无法执行: {e}\n")

    _await_report(
        task_id,
        exit_code=exit_code,
        tail=_await_tail(log_path),
        duration_s=time.time() - started,
    )


def _await_tail(log_path: str) -> str:
    try:
        with open(log_path, "rb") as f:
            f.seek(0, os.SEEK_END)
            f.seek(max(0, f.tell() - _AWAIT_TAIL_BYTES))
            return f.read().decode(errors="replace")
    except OSError as e:
        return f"（读不到输出日志 {log_path}: {e}）"


def _await_report(
    task_id: str, *, exit_code: int, tail: str, duration_s: float
) -> None:
    """POST the result, retrying — a dropped report is a frozen topic."""
    import time

    topic = os.environ.get("CHEESE_TOPIC", "")
    token = os.environ.get("CHEESE_AWAIT_TOKEN", "")
    url = f"{API}/topics/{topic}/background-task/{task_id}/done"
    body = json.dumps(
        {"exit_code": exit_code, "tail": tail, "duration_s": duration_s}
    ).encode()
    for delay in _AWAIT_RETRY_DELAYS:
        if delay:
            time.sleep(delay)
        req = urllib.request.Request(url, data=body, method="POST")
        req.add_header("Content-Type", "application/json")
        if token:
            req.add_header("X-Cheese-Token", token)
        try:
            with urllib.request.urlopen(req, timeout=30) as r:
                r.read()
            return
        except Exception:  # noqa: BLE001 — retry, then give up quietly
            continue


def _print_api_index() -> None:
    """List available operations from our FastAPI /openapi.json (like Restish,
    but built from OUR live spec). Lets `cheese api` self-describe what raw calls
    are possible without hardcoding anything."""
    url = f"{_api_root()}/openapi.json"
    try:
        with urllib.request.urlopen(url, timeout=20) as r:
            spec = json.load(r)
    except Exception as e:  # noqa: BLE001
        print(f"[cheese] 拉取 openapi 失败: {e}", file=sys.stderr)
        sys.exit(1)
    print("可用的原始 API 操作（优先用 curated 命令，这些是兜底逃生口）：")
    for path in sorted(spec.get("paths", {})):
        methods = spec["paths"][path]
        for method in sorted(methods):
            if method.lower() in ("get", "post", "put", "delete", "patch"):
                print(f"  {method.upper():6} {path}")
    print("\n用法: cheese api <METHOD> <path> [--data '<json>']")
    print("例:   cheese api GET /topics/$CHEESE_TOPIC/blocks")


def source_fingerprint() -> str:
    """A short digest of THIS file's bytes.

    The box's `cheese` is bind-mounted from the backend's own copy, so the only
    way to tell — from inside a box — whether that plumbing actually worked is
    to compare what runs here against what the backend shipped. `cheese
    --version` prints this; a mismatch means the mount is stale."""
    try:
        with open(__file__, "rb") as f:
            return hashlib.sha256(f.read()).hexdigest()[:12]
    except OSError:
        return "unknown"


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="cheese", description="芝士 平台 CLI")
    p.add_argument(
        "--version",
        action="version",
        version=f"cheese {source_fingerprint()}",
        help="打印源码指纹,用来核对本容器里的 CLI 是不是后端那一份",
    )
    sub = p.add_subparsers(dest="cmd", required=True)

    pd = sub.add_parser("doc", help="活文档")
    pdsub = pd.add_subparsers(dest="doccmd", required=True)
    pdset = pdsub.add_parser("set", help="把文件设为本话题活文档")
    pdset.add_argument("file")
    pdsub.add_parser("get", help="打印本话题活文档")

    ps = sub.add_parser("split", help="拆出子话题（分身自动开工）")
    ps.add_argument("title")
    ps.add_argument(
        "--brief",
        default=None,
        help="任务简报：这个子话题要干什么/约束/验收标准。会预置成分身的活文档，分身开工全靠它——尽量写",
    )

    paw = sub.add_parser(
        "await",
        help="把长命令丢到后台跑；跑完平台自动叫醒本话题并带上退出码+输出尾巴",
    )
    paw.add_argument("command", help="要跑的命令，如 'bash .claude/scripts/check.sh'")
    paw.add_argument("--label", default="", help="一句话说明在跑什么（唤醒时会显示）")
    paw.add_argument(
        "--timeout", type=int, default=3600, help="秒，超时会被杀掉并按退出码 124 回报"
    )

    # Internal: the detached child _await_start forks. Not for humans/agents.
    pawc = sub.add_parser("__await-child")
    pawc.add_argument("task_id")
    pawc.add_argument("command")
    pawc.add_argument("log_path")
    pawc.add_argument("timeout_s", type=int)

    pdec = sub.add_parser("decision", help="记录一条决策")
    pdec.add_argument("text")

    ptitle = sub.add_parser("title", help="给本话题起/改标题")
    ptitle.add_argument("text")

    prem = sub.add_parser("remember", help="记入项目记忆")
    prem.add_argument("fact")

    prec = sub.add_parser("recall", help="按需检索记忆（语义搜索,返回摘要级结果）")
    prec.add_argument("query")

    pn = sub.add_parser("notify", help="发通知")
    pn.add_argument("--title", required=True)
    pn.add_argument("--body", default="")
    pn.add_argument("--level", default="light", choices=["silent", "light", "strong"])
    pn.add_argument("--kind", default="change_alert")
    pn.add_argument("--to", default=None, help="target handle（不填=广播）")
    pn.add_argument("--options", default=None, help="决策选项,用 | 分隔")

    pask = sub.add_parser("ask", help="在对话里问一个带选项的问题（用户点按钮回答）")
    pask.add_argument("question")
    pask.add_argument("--option", action="append", required=True,
                      help="一个选项,可重复 2-4 次")

    pa = sub.add_parser("accept-request", help="递验收卡给某人")
    pa.add_argument("reviewer")
    pa.add_argument("reason", nargs="?", default="")

    pc = sub.add_parser("conclude", help="子话题结论回流父话题")
    pc.add_argument("conclusion")

    pm = sub.add_parser("milestone", help="钉里程碑")
    pm.add_argument("title")
    pm.add_argument("--due", default=None, help="ISO 日期,如 2026-06-20")

    sub.add_parser("members", help="列出项目成员(名字+handle+角色)")

    sub.add_parser("gh-token", help="铸一个只读 GitHub token(看 CI/CD 用,约1小时过期)")

    sub.add_parser(
        "status",
        help="平台状态快照:本轮运行状态/验收卡与闸门输出/磁盘与额度水位",
    )

    psv = sub.add_parser("serve", help="把容器里跑起来的应用设为当前预览(先起在 0.0.0.0:$CHEESE_APP_PORT)")
    psv.add_argument("note", nargs="?", default="app",
                     help="一句话说明在跑什么,如 'Vue dev server'")

    part = sub.add_parser("artifact", help="把工作区文件设为可渲染产物(当前预览)")
    part.add_argument("path", help="工作区相对路径,如 report.html")
    part.add_argument("--as", dest="as_", default="html", choices=["html", "svg"],
                      help="渲染类型(默认 html)")

    papi = sub.add_parser(
        "api",
        help="原始 API 逃生口(兜底,不推荐):直接打后端,带容器已有鉴权。无参=列可用操作",
    )
    papi.add_argument("method", nargs="?", help="HTTP 方法,如 GET/POST/PUT/DELETE")
    papi.add_argument("path", nargs="?", help="API 路径,如 /topics/<id>/blocks")
    papi.add_argument("--data", "-d", default=None, help="请求体(JSON 字符串)")

    return p


def main() -> None:
    a = build_parser().parse_args()

    if a.cmd == "doc" and a.doccmd == "set":
        topic = _need("CHEESE_TOPIC", TOPIC)
        with open(a.file, encoding="utf-8") as f:
            content = f.read()
        _call("PUT", f"/topics/{topic}/doc", {"content": content, "author": AUTHOR})
        print("已更新活文档。")
    elif a.cmd == "doc" and a.doccmd == "get":
        topic = _need("CHEESE_TOPIC", TOPIC)
        d = _call("GET", f"/topics/{topic}/doc").get("data")
        print((d or {}).get("content", "") if d else "")
    elif a.cmd == "split":
        topic = _need("CHEESE_TOPIC", TOPIC)
        body = {"title": a.title, "created_by": AUTHOR}
        if a.brief:
            body["brief"] = a.brief
        r = _call("POST", f"/topics/{topic}/split", body)
        print(f"已拆出子话题：{r['data']['title']}（id={r['data']['id']}），分身已带简报自动开工")
    elif a.cmd == "await":
        _await_start(a.command, a.label, a.timeout)
    elif a.cmd == "__await-child":
        _await_child(a.task_id, a.command, a.log_path, a.timeout_s)
    elif a.cmd == "decision":
        topic = _need("CHEESE_TOPIC", TOPIC)
        _call("POST", f"/topics/{topic}/decision", {"decision": a.text})
        print("已记入决策记录。")
    elif a.cmd == "title":
        topic = _need("CHEESE_TOPIC", TOPIC)
        _call("POST", f"/topics/{topic}/title", {"title": a.text})
        print(f"话题标题已设为：{a.text}")
    elif a.cmd == "remember":
        proj = _need("CHEESE_PROJECT", PROJECT)
        # 带上话题：后端据此认出是哪个芝士在记，存进它自己的项目记忆
        # (同一个项目里的两个芝士各记各的，跟人一样)。
        body = {"content": a.fact, "topic": TOPIC}
        if MEMORY_SCOPE == "personal" and OWNER:
            body["scope"] = "user"
            body["owner"] = OWNER
            _call("POST", f"/projects/{proj}/memory", body)
            print("已记入个人记忆。")
        else:
            _call("POST", f"/projects/{proj}/memory", body)
            print("已记入项目记忆。")
    elif a.cmd == "recall":
        proj = _need("CHEESE_PROJECT", PROJECT)
        body = {"query": a.query, "topic": TOPIC}
        if MEMORY_SCOPE == "personal" and OWNER:
            body["scope"] = "user"
            body["owner"] = OWNER
        hits = _call("POST", f"/projects/{proj}/memory/search", body).get("data", {}).get("hits", [])
        if not hits:
            print("没有找到相关记忆。")
        for h in hits:
            print(f"- {h.get('abstract', '')}")
    elif a.cmd == "ask":
        topic = _need("CHEESE_TOPIC", TOPIC)
        opts = [o.strip() for o in a.option if o.strip()]
        if not 2 <= len(opts) <= 4:
            print("[cheese] ask 需要 2-4 个 --option", file=sys.stderr)
            sys.exit(2)
        _call("POST", f"/topics/{topic}/ask", {"question": a.question, "options": opts})
        print(f"[cheese] 已发出选项问题（{len(opts)} 个选项）")

    elif a.cmd == "notify":
        proj = _need("CHEESE_PROJECT", PROJECT)
        payload = {}
        if a.options:
            payload["options"] = [o.strip() for o in a.options.split("|") if o.strip()]
        body = {
            "level": a.level, "kind": a.kind, "title": a.title, "body": a.body,
            "target_handle": a.to, "topic_id": TOPIC or None, "payload": payload,
        }
        _call("POST", f"/projects/{proj}/notifications", body)
        print(f"已发送通知给 {a.to or '所有人'}。")
    elif a.cmd == "accept-request":
        topic = _need("CHEESE_TOPIC", TOPIC)
        _call("POST", f"/topics/{topic}/accept-card",
              {"reviewer_handle": a.reviewer, "routing_reason": a.reason})
        print(f"已把验收卡递给 {a.reviewer}。")
    elif a.cmd == "conclude":
        topic = _need("CHEESE_TOPIC", TOPIC)
        _call("POST", f"/topics/{topic}/return-conclusion", {"conclusion": a.conclusion})
        print("已把结论回流父话题。")
    elif a.cmd == "milestone":
        proj = _need("CHEESE_PROJECT", PROJECT)
        body = {"title": a.title}
        if a.due:
            body["due_date"] = a.due if "T" in a.due else f"{a.due}T00:00:00Z"
        _call("POST", f"/projects/{proj}/milestones", body)
        print(f"已钉里程碑：{a.title}")
    elif a.cmd == "gh-token":
        # Root-mounted like /llm (not under /api): build from the api root.
        # stdout carries ONLY the token so `GH_TOKEN=$(cheese gh-token)` works;
        # the expiry note goes to stderr.
        req = urllib.request.Request(f"{_api_root()}/sandbox/github-token")
        if TOKEN:
            req.add_header("X-Cheese-Token", TOKEN)
        try:
            with urllib.request.urlopen(req, timeout=20) as r:
                data = json.load(r).get("data", {})
        except urllib.error.HTTPError as e:
            detail = e.read().decode(errors="replace")[:300]
            print(f"[cheese] gh-token 失败 HTTP {e.code}: {detail}", file=sys.stderr)
            sys.exit(1)
        print(data.get("token", ""))
        print(
            f"[cheese] 只读(actions/checks), 过期 {data.get('expires_at', '?')} — "
            "用法: GH_TOKEN=$(cheese gh-token) 然后 "
            'curl -H "Authorization: Bearer $GH_TOKEN" https://api.github.com/...',
            file=sys.stderr,
        )
    elif a.cmd == "members":
        proj = _need("CHEESE_PROJECT", PROJECT)
        d = _call("GET", f"/projects/{proj}/members").get("data", {})
        rows = d.get("data", d) if isinstance(d, dict) else d
        for m in rows:
            h = m.get("user_handle")
            print(f"- {m.get('name')}（{m.get('role')}）→ 在消息里写 <@{h}> 点名 ta")
    elif a.cmd == "status":
        topic = _need("CHEESE_TOPIC", TOPIC)
        d = _call("GET", f"/topics/{topic}/status").get("data") or {}
        print(_format_status(d))
    elif a.cmd == "serve":
        topic = _need("CHEESE_TOPIC", TOPIC)
        port = os.environ.get("CHEESE_APP_PORT", "3000")
        _call("POST", f"/topics/{topic}/artifact", {"path": a.note, "as": "app"})
        print(f"已把容器 :{port} 上的应用设为当前预览（{a.note}）。"
              f"确保它监听 0.0.0.0:{port}，别只绑 localhost。")
    elif a.cmd == "artifact":
        topic = _need("CHEESE_TOPIC", TOPIC)
        # The platform resolves artifact paths against the worktree ROOT (/work),
        # but the agent's cwd may be a subdir (e.g. after `cd backend`). Normalize
        # the given path to worktree-root-relative so `cheese artifact x.html` from
        # /work/backend points at backend/x.html, not a missing /work/x.html.
        root = os.environ.get("CHEESE_WORKTREE_ROOT", "/work")
        rel = os.path.relpath(os.path.abspath(a.path), root)
        if rel.startswith(".."):  # outside the worktree — let the backend validate
            rel = a.path
        _call("POST", f"/topics/{topic}/artifact", {"path": rel, "as": a.as_})
        print(f"已把 {rel} 设为当前预览（{a.as_}）。")
    elif a.cmd == "api":
        if not a.method:
            _print_api_index()
            return
        if not a.path:
            print("[cheese] api 需要一个路径,如 cheese api GET /topics/<id>/blocks",
                  file=sys.stderr)
            sys.exit(2)
        if a.data is not None:
            try:
                json.loads(a.data)  # fail fast on malformed JSON
            except ValueError as e:
                print(f"[cheese] --data 不是合法 JSON: {e}", file=sys.stderr)
                sys.exit(2)
        _raw_request(a.method, a.path, a.data)


if __name__ == "__main__":
    main()
