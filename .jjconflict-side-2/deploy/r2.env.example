# Cloudflare R2 credentials for off-site DB backups.
#
# Copy to the box as ~/ops/r2.env, fill in, then: chmod 600 ~/ops/r2.env
# This file (the .example) is a template ONLY — the real ~/ops/r2.env holds a
# live secret and MUST NEVER be committed to git.
#
# Create the token in the Cloudflare dashboard:
#   R2 -> Manage R2 API Tokens -> Create API token
#   Permissions: Object Read & Write, scoped to the cheese-db-backups bucket
# That yields the Access Key ID + Secret Access Key below.

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=cheese-db-backups
R2_PREFIX=db
