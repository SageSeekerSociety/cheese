@@ -8134,6 +8134,16 @@ const XmlStream = require('../../../utils/xml-stream');
 const BaseXform = require('../base-xform');
 const TwoCellAnchorXform = require('./two-cell-anchor-xform');
 const OneCellAnchorXform = require('./one-cell-anchor-xform');
+// Excel writes spreadsheetDrawing elements with the `xdr:` prefix, and every
+// name below is matched literally. openpyxl instead declares that namespace as
+// the default one, so its elements arrive named `wsDr`, `oneCellAnchor`, `from`
+// and so on. Such a part parsed to nothing, and the workbook-level reconcile
+// then read `.anchors` off the missing model and threw. The prefix is part of
+// how a document happens to be written, not of which element it is, so put the
+// conventional one back before matching.
+function xdrName(name) {
+  return name.indexOf(':') === -1 ? `xdr:${name}` : name;
+}
 function getAnchorType(model) {
   const range = typeof model.range === 'string' ? colCache.decode(model.range) : model.range;
   return range.br ? 'xdr:twoCellAnchor' : 'xdr:oneCellAnchor';
@@ -8168,6 +8178,7 @@ class DrawingXform extends BaseXform {
     xmlStream.closeNode();
   }
   parseOpen(node) {
+    node.name = xdrName(node.name);
     if (this.parser) {
       this.parser.parseOpen(node);
       return true;
@@ -8194,6 +8205,7 @@ class DrawingXform extends BaseXform {
     }
   }
   parseClose(name) {
+    name = xdrName(name);
     if (this.parser) {
       if (!this.parser.parseClose(name)) {
         this.model.anchors.push(this.parser.model);
