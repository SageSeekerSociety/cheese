VITE_API_BASE_URL=http://localhost:7777
VITE_NEW_API_BASE_URL=http://localhost:8080
VITE_AI_API_BASE_URL=http://localhost:4000
# PDF 上传/解析请求的超时时间（毫秒），默认 300000（5 分钟）
VITE_PDF_UPLOAD_TIMEOUT_MS=300000
# 可选：连接器「现场」屏幕 WebSocket 的 origin。留空（默认）= 用页面/API origin，行为不变。
# 当页面 origin 前面有一层会剥掉 WebSocket Upgrade 的边缘代理时，设成一个放行 WS 的 origin，
# 例如 https://119pve.ghg.org.cn（只用它的 origin，/connector 路径是绝对的）。
# VITE_CONNECTOR_WS_BASE=