# ONE merged backend serves everything: 知是 product routes at the root
# (/spaces, /tasks, /users, ...) AND the cheesex AI layer under /api/*.
VITE_API_BASE_URL=http://127.0.0.1:8799
# The NEW_/AI_ variants default to VITE_API_BASE_URL — only set them if you
# really are splitting the backend across hosts.
#VITE_NEW_API_BASE_URL=
#VITE_AI_API_BASE_URL=
# PDF 上传/解析请求的超时时间（毫秒），默认 300000（5 分钟）
VITE_PDF_UPLOAD_TIMEOUT_MS=300000
