# Generated by scripts/gen-api-types.mjs from backend/openapi.json. It is read
# only after scripts/typecheck.mjs regenerates it, and everything that runs the
# ratchet — `pnpm run typecheck`, the fast tier, the post-merge collector — goes
# through that file. Committing it made every route change rewrite 1.4 MB and
# collide with any other branch touching a route.
src/api/openapi.d.ts

