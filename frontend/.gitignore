# Generated by scripts/gen-api-types.mjs from the backend's OpenAPI document. It
# is read only after scripts/typecheck.mjs regenerates it, and everything that
# runs the ratchet — `pnpm run typecheck`, the fast tier, the post-merge
# collector — goes through that file. Committing it made every route change
# rewrite 1.4 MB and collide with any other branch touching a route; the document
# behind it (backend/openapi.json, 1.8 MB) was the same and left the repository
# with it — see the root .gitignore for that half.
src/api/openapi.d.ts

