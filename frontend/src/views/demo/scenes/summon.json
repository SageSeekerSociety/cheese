{
  "title": "什么时候会叫起一位队友",
  "project": "知是",
  "topic": "首页改版",
  "machine": "本话题运行在：云机器 cm-7f3a",
  "people": {
    "wang": { "name": "王长鑫" },
    "li": { "name": "李甘" },
    "cheese": { "name": "芝士", "agent": true },
    "cheese-k": { "name": "芝士K", "agent": true }
  },
  "seats": ["cheese", "cheese-k"],
  "steps": [
    {
      "label": "普通消息，不叫它",
      "focus": "chat",
      "tag": "没点名 AI 队友，消息只留在话题里",
      "events": [
        { "at": 300, "do": "seat", "who": "cheese", "dir": "~/tasks/a17c", "session": "会话 s-3f1", "state": "空闲" },
        { "at": 900, "do": "say", "who": "li", "text": "首页那个按钮颜色是不是太淡了？" },
        { "at": 1700, "do": "mark", "text": "没点名 AI 队友，不起一轮" }
      ]
    },
    {
      "label": "@ 它，或点「交给」",
      "focus": "chat",
      "tag": "点到它，才起一轮",
      "events": [
        { "at": 300, "do": "seat", "who": "cheese-k", "dir": "~/tasks/b42e", "state": "空闲" },
        { "at": 700, "do": "say", "who": "wang", "text": "<@cheese> 把首页主按钮改成琥珀色，字号也大一档" },
        { "at": 1300, "do": "turn", "who": "cheese", "turn": "t1" },
        { "at": 1300, "do": "seat", "who": "cheese", "state": "在跑一轮" },
        {
          "at": 1900,
          "do": "act",
          "who": "cheese",
          "turn": "t1",
          "tool": "Read",
          "arg": "frontend/src/views/home/Landing.vue"
        },
        { "at": 2500, "do": "say", "who": "cheese", "text": "收到，我先看一下首页那一段。" },
        { "at": 3000, "do": "mark", "text": "点「交给〈名字〉」按钮、按 ⌘/Ctrl+Enter，写进正文的也是同一个 @" }
      ]
    },
    {
      "label": "它在跑时再发，并进当前一轮",
      "focus": "site",
      "tag": "不排一队，直接送进正在跑的会话",
      "events": [
        { "at": 300, "do": "say", "who": "wang", "text": "手机上也看一下" },
        { "at": 900, "do": "note", "who": "cheese", "turn": "t1", "text": "收到补充：手机上也要看。" },
        {
          "at": 1500,
          "do": "act",
          "who": "cheese",
          "turn": "t1",
          "tool": "Edit",
          "arg": "frontend/src/views/home/landing.css"
        },
        { "at": 2100, "do": "say", "who": "cheese", "text": "主按钮改成琥珀色了，手机宽度下也不换行。" },
        { "at": 2700, "do": "end", "turn": "t1" },
        { "at": 2700, "do": "seat", "who": "cheese", "state": "空闲" }
      ]
    },
    {
      "label": "两位队友，点谁谁接",
      "focus": "seats",
      "tag": "点谁谁接；没点名的归被唤起的轮次",
      "events": [
        { "at": 300, "do": "say", "who": "li", "text": "<@cheese-k> 顺手把 README 的截图换成新版" },
        { "at": 900, "do": "turn", "who": "cheese-k", "turn": "t2" },
        { "at": 900, "do": "seat", "who": "cheese-k", "state": "在跑一轮" },
        { "at": 1400, "do": "act", "who": "cheese-k", "turn": "t2", "tool": "Read", "arg": "README.md" },
        { "at": 2000, "do": "say", "who": "wang", "text": "标题也顺手改一下吧" },
        {
          "at": 2500,
          "do": "note",
          "who": "cheese-k",
          "turn": "t2",
          "text": "这条没点名；我这轮是被点名唤起的，认领它。"
        },
        { "at": 3100, "do": "act", "who": "cheese-k", "turn": "t2", "tool": "Edit", "arg": "README.md" },
        { "at": 3600, "do": "say", "who": "cheese-k", "text": "截图和标题都换好了。" },
        { "at": 4100, "do": "end", "turn": "t2" },
        { "at": 4100, "do": "seat", "who": "cheese-k", "state": "空闲" }
      ]
    }
